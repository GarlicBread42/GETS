//#########################
//###Säuretopfwagen 1910###
//#########################			
	
	
//Spriteset Säuretopfwagen 1910 DRG

spriteset (spriteset_Topf_1938_DRG, "gfx\Topf_1938/Topf_1938_DRG_1x_8bpp.png")
					{template_68trains_1x(0, 0)}	
		alternative_sprites (spriteset_Topf_1938_DRG, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\Topf_1938/Topf_1938_DRG_1x_32bpp.png", "gfx\Topf_1938/Topf_1938_DRG_1x_mask.png")
					{template_68trains_1x(0, 0)}	
		alternative_sprites (spriteset_Topf_1938_DRG, ZOOM_LEVEL_IN_2X, BIT_DEPTH_32BPP, "gfx\Topf_1938/Topf_1938_DRG_2x_32bpp.png", "gfx\Topf_1938/Topf_1938_DRG_2x_mask.png")
					{template_68trains_2x(0, 0)}					
		alternative_sprites (spriteset_Topf_1938_DRG, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP, "gfx\Topf_1938/Topf_1938_DRG_4x_32bpp.png", "gfx\Topf_1938/Topf_1938_DRG_4x_mask.png")
					{template_68trains_4x(0, 0)}


//Spriteset Säuretopfwagen 1910 DB

spriteset (spriteset_Topf_1938_DB, "gfx\Topf_1938/Topf_1938_DB_1x_8bpp.png")
					{template_68trains_1x(0, 0)}	
		alternative_sprites (spriteset_Topf_1938_DB, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\Topf_1938/Topf_1938_DB_1x_32bpp.png", "gfx\Topf_1938/Topf_1938_DB_1x_mask.png")
					{template_68trains_1x(0, 0)}	
		alternative_sprites (spriteset_Topf_1938_DB, ZOOM_LEVEL_IN_2X, BIT_DEPTH_32BPP, "gfx\Topf_1938/Topf_1938_DB_2x_32bpp.png", "gfx\Topf_1938/Topf_1938_DB_2x_mask.png")
					{template_68trains_2x(0, 0)}					
		alternative_sprites (spriteset_Topf_1938_DB, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP, "gfx\Topf_1938/Topf_1938_DB_4x_32bpp.png", "gfx\Topf_1938/Topf_1938_DB_4x_mask.png")
					{template_68trains_4x(0, 0)}              

//Spriteset purchase

spriteset (spriteset_Topf_1938_DRG_purchase, "gfx\Topf_1938/Topf_1938_DRG_1x_8bpp.png")
					{template_purchase(0, 0)}	
		alternative_sprites (spriteset_Topf_1938_DRG_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\Topf_1938/Topf_1938_DRG_1x_32bpp.png", "gfx\Topf_1938/Topf_1938_DRG_1x_mask.png")
					{template_purchase(0, 0)}	

spriteset (spriteset_Topf_1938_DB_purchase, "gfx\Topf_1938/Topf_1938_DB_1x_8bpp.png")
					{template_purchase(0, 0)}	
		alternative_sprites (spriteset_Topf_1938_DB_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\Topf_1938/Topf_1938_DB_1x_32bpp.png", "gfx\Topf_1938/Topf_1938_DB_1x_mask.png")
					{template_purchase(0, 0)}	                    

//Switches

	switch (FEAT_TRAINS,SELF, switch_Topf_1938_purchase,current_year){
			0 .. 1945: spriteset_Topf_1938_DRG_purchase;
		1946 .. 2050: spriteset_Topf_1938_DB_purchase;
			spriteset_Topf_1938_DB_purchase;}

	switch (FEAT_TRAINS,SELF, switch_Topf_1938_current_year,current_year){
		1800 .. 1945: spriteset_Topf_1938_DRG;
		1946 .. 2050: spriteset_Topf_1938_DB;
			spriteset_Topf_1938_DB;}

    switch (FEAT_TRAINS, PARENT, switch_speed_Topf_1938,  switch_check_PWG_0()) {
        1: return 80;
        0: return 65;}

    switch(FEAT_TRAINS,PARENT,switch_running_cost_Topf_1938, 1){
        return 92;}	

item (FEAT_TRAINS , ITEM_TOPF_1938, 9414)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_TOPF_1938);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1938,01,01);
						model_life: 					65;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						cargo_allow_refit:              [ACID, DYES, RFPR, SULP, ACID, CHLO, NH3_,];
						loading_speed:					4;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							65 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						15 ton;
						dual_headed: 					0;
						default_cargo_type:				ACID;
						cargo_capacity:					17;
						ai_engine_rank: 				0;
						length: 						6;
												
			}
			
	//Vehicels Graphics
			graphics
			{
			default							: switch_Topf_1938_current_year;
			additional_text					: string(STR_DESC_GOODS);
			purchase						: switch_Topf_1938_purchase;
            speed							: switch_speed_Topf_1938;
			cost_factor						: 25;
			running_cost_factor				: switch_running_cost_Topf_1938;				
			}
		}       

