		0: spriteset_NWagen_480_3_verkehrsrot;
		1: spritegroup_NWagen_480_SST_loading;
		2: switch_BA_480_lights_front;
		3: switch_BA_480_lights_back;}

	switch(FEAT_TRAINS, SELF, switch_length_NWagen_480, position_in_vehid_chain % 3) {
		0: 4;
		1: 7;
		2: 4;}

	switch (FEAT_TRAINS,SELF,switch_build_year_NWagen_480,build_year) {
		   0 .. 1995 : switch_loadstack_NWagen_480_2_mint;
		1996 .. 1998 : switch_loadstack_NWagen_480_1_verkehrsrot;
		1999 .. 2050 : switch_loadstack_NWagen_480_3_verkehrsrot;
			switch_loadstack_NWagen_480_3_verkehrsrot;}					

	switch(FEAT_TRAINS, SELF, switch_NWagen_480_build, position_in_articulated_veh % 3) {
		0:	   spriteset_empty;
		1:     return switch_build_year_NWagen_480;
		2:	   spriteset_empty;}

	switch (FEAT_TRAINS, SELF, switch_articulated_NWagen_480_build, extra_callback_info1) {
		1 .. 2: return ITEM_NWAGEN_480_BUILD;
		return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}
	
	switch(FEAT_TRAINS, SELF, switch_running_cost_NWagen_480, extra_callback_info1) {
		return 3000;}

item (FEAT_TRAINS , ITEM_NWAGEN_480_BUILD, 7928)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_NWAGEN_480_BUILD);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1994,01,01);
						model_life: 					40;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);	
						refittable_cargo_classes:		bitmask(CC_PASSENGERS);
						cargo_allow_refit:				[PASS, TOUR];
						loading_speed:					15;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							140 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						34 ton;
						dual_headed: 					0;
						default_cargo_type:				PASS;
						cargo_capacity:					27;
						ai_engine_rank: 				0;
						length: 						8;
												
			}

	//Vehicles Graphics
			graphics
			{
			default:						switch_NWagen_480_build;
			additional_text:				string(STR_DESC_DVT_WIKO);
			length:							switch_length_NWagen_480;
			articulated_part:				switch_articulated_NWagen_480_build;
			purchase:						switch_purchase_N_Wagen_480;
			cost_factor:					615;
			running_cost_factor:			switch_running_cost_NWagen_480;					
			 }
		}


	switch (FEAT_TRAINS,SELF,switch_current_year_NWagen_480,current_year) {
		   0 .. 1995 : switch_loadstack_NWagen_480_2_mint;
		1996 .. 1998 : switch_loadstack_NWagen_480_1_verkehrsrot;
		1996 .. 1997 : switch_loadstack_NWagen_480_3_verkehrsrot;
			switch_loadstack_NWagen_480_3_verkehrsrot;}	


	switch(FEAT_TRAINS, SELF, switch_NWagen_480_current, position_in_articulated_veh % 3) {
		0:	   spriteset_empty;
		1:     return switch_current_year_NWagen_480;
		2:	   spriteset_empty;}

	switch (FEAT_TRAINS, SELF, switch_articulated_NWagen_480_current, extra_callback_info1) {
		1 .. 2: return ITEM_NWAGEN_480_CURRENT;
		return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}

