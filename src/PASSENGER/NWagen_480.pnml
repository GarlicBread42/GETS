//Switches

	switch (FEAT_TRAINS,SELF,switch_purchase_N_Wagen_480,current_year) {
		   0 .. 1995 : spriteset_NWagen_480_2_mint_purchase;
		1996 .. 1998 : spriteset_NWagen_480_1_purchase;
		1999 .. 2050 : spriteset_NWagen_480_3_purchase;
			spriteset_NWagen_480_3_purchase;}	

	switch(FEAT_TRAINS, SELF, switch_loadstack_NWagen_480_1_verkehrsrot, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: spriteset_NWagen_480_1_verkehrsrot;
		1: spritegroup_NWagen_480_SST_loading;
		2: switch_BA_480_lights_front;
		3: switch_BA_480_lights_back;}

	switch(FEAT_TRAINS, SELF, switch_loadstack_NWagen_480_2_mint, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
