	switch(FEAT_TRAINS, SELF, switch_loadstack_NWagen_483_0_mint, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: spriteset_NWagen_483_0_mint;
		1: spritegroup_NWagen_483_DT_loading;
		2: switch_BA_483_lights_front;
		3: switch_BA_483_lights_back;}

	switch(FEAT_TRAINS, SELF, switch_NWagen_483_0_graphics_mint, position_in_articulated_veh % 3) {
		0:	   spriteset_empty;
		1:     return switch_loadstack_NWagen_483_0_mint;
		2:	   spriteset_empty;}

	switch(FEAT_TRAINS, SELF, switch_length_NWagen_483, position_in_vehid_chain % 3) {
		0: 4;
		1: 7;
		2: 4;}

	switch (FEAT_TRAINS, SELF, switch_articulated_NWagen_483_0_mint, extra_callback_info1) {
		1 .. 2: return ITEM_NWAGEN_483_0_MINT;
		return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}
	
	switch(FEAT_TRAINS, SELF, switch_running_cost_NWagen_483_0, extra_callback_info1) {
		return 3000;}

item (FEAT_TRAINS , ITEM_NWAGEN_483_0_MINT, 7934)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_NWAGEN_483_0_MINT);
						variant_group:					7928;
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1994,01,01);
						model_life: 					40;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);	
						refittable_cargo_classes:		bitmask(CC_PASSENGERS);
						cargo_allow_refit:				[PASS, TOUR];
						loading_speed:					15;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							140 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						32 ton;
						dual_headed: 					0;
						default_cargo_type:				PASS;
						cargo_capacity:					25;
						ai_engine_rank: 				0;
						length: 						8;
												
			}

	//Vehicles Graphics
			graphics
			{
			default:						switch_NWagen_483_0_graphics_mint;
			additional_text:				string(STR_DESC_DVT_1GEN);
			length:							switch_length_NWagen_483;
			articulated_part:				switch_articulated_NWagen_483_0_mint;
			purchase:						spriteset_NWagen_483_0_purchase;
			cost_factor:					615;
			running_cost_factor:			switch_running_cost_NWagen_483_0;					
			 }
		}

//Switches 483_1

	switch(FEAT_TRAINS, SELF, switch_loadstack_NWagen_483_1_verkehrsrot, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: spriteset_NWagen_483_1_verkehrsrot;
		1: spritegroup_NWagen_483_DT_loading;
		2: switch_BA_483_lights_front;
		3: switch_BA_483_lights_back;}

	switch(FEAT_TRAINS, SELF, switch_NWagen_483_1_graphics_verkehrsrot, position_in_articulated_veh % 3) {
		0:	   spriteset_empty;
		1:     return switch_loadstack_NWagen_483_1_verkehrsrot;
		2:	   spriteset_empty;}

	switch (FEAT_TRAINS, SELF, switch_articulated_NWagen_483_1_verkehrsrot, extra_callback_info1) {
		1 .. 2: return ITEM_NWAGEN_483_1_VERKEHRSROT;
		return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}
	
	switch(FEAT_TRAINS, SELF, switch_running_cost_NWagen_483_1, extra_callback_info1) {
		return 3000;}

