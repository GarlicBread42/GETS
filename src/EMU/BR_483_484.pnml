        2: spriteset_empty;
        3: spriteset_empty;
        4: return switch_loadstack_BR_483_back;
        5: spriteset_empty;}
                        
    switch(FEAT_TRAINS, SELF, switch_BR_483_graphics_REV, position_in_vehid_chain % 6) {
