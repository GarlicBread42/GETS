			articulated_part				: switch_articulated_BR_483;
			purchase						: spriteset_BR_483_purchase;
			visual_effect_and_powered		: switch_FX_BR_483;
			cost_factor						: 180;
			running_cost_factor				: switch_running_cost_BR_483;			
			}
	}
						
