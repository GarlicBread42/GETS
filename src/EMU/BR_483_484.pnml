						speed: 							100 km/h;
						refit_cost: 					0;
						track_type: 					MTRO;	
						power:  						1142 hp;
						weight: 						69 ton;
						ai_engine_rank: 				0;
						engine_class: 					ENGINE_CLASS_ELECTRIC;
						visual_effect_and_powered: 		visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
						dual_headed: 					0;
						tractive_effort_coefficient: 	0.151;
						length: 						8;
			}

		//Vehicles Graphics
			graphics
			{
			default							: switch_graphics_BR_483;
			additional_text					: string(STR_CONCAT_2, 
											  string(STR_TRACTION_3RD), 
											  string(STR_DESC_SBAHN3RD),);
