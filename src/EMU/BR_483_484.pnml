		2 .. 255: return spriteset_empty;
		}

//spriteset Lights back

	spriteset(spriteset_BR_484_lights_back, "gfx\BR_483/BR_483_lights_back_1x_8bpp.png")
									{ template_118trains_1x(0, 0)}
				
		alternative_sprites (spriteset_BR_484_lights_back, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\BR_483/BR_483_lights_back_1x_32bpp.png", "gfx\BR_483/BR_483_lights_back_1x_mask.png")
									{ template_118trains_1x(0, 0)}
				
		alternative_sprites (spriteset_BR_484_lights_back, ZOOM_LEVEL_IN_2X, BIT_DEPTH_32BPP, "gfx\BR_483/BR_483_lights_back_2x_32bpp.png", "gfx\BR_483/BR_483_lights_back_2x_mask.png")
									{ template_118trains_2x(0, 0)}
				
		alternative_sprites (spriteset_BR_484_lights_back, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP, "gfx\BR_483/BR_483_lights_back_4x_32bpp.png", "gfx\BR_483/BR_483_lights_back_4x_mask.png")
									{ template_118trains_4x(0, 0)}

	switch(FEAT_TRAINS, SELF, switch_BR_484_lights_back, position_in_consist_from_end){
		1: return spriteset_BR_484_lights_back;
		2 .. 255: return spriteset_empty;
		}

//Spriteset purchase

	spriteset(spriteset_BR_484_purchase, "gfx\BR_483/BR_483_front_1x_8bpp.png")
									{ template_purchase(0, 0)}
				
		alternative_sprites (spriteset_BR_484_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\BR_483/BR_483_front_1x_32bpp.png", "gfx\BR_483/BR_483_front_1x_mask.png")
									{ template_purchase(0, 0)}

//spritegroups

	spritegroup spritegroup_BR_484_loading
        {loaded: 	[spriteset_empty];
        loading: 	[spriteset_BR_484_loading];}

	spritegroup spritegroup_BR_484_loading_REV
        {loaded: 	[spriteset_empty];
        loading: 	[spriteset_BR_484_loading_REV];}

	spritegroup spritegroup_BR_484_loading_middle
        {loaded: 	[spriteset_empty];
        loading: 	[spriteset_BR_484_loading_middle];}

	spritegroup spritegroup_BR_484_loading_middle_REV
        {loaded: 	[spriteset_empty];
        loading: 	[spriteset_BR_484_loading_middle_REV];}	

//Switches

	switch(FEAT_TRAINS, SELF, switch_loadstack_BR_484_front, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: spriteset_BR_484_front;
		1: spritegroup_BR_484_loading;
		2: switch_BR_484_lights_front;}
		
	switch(FEAT_TRAINS, SELF, switch_loadstack_BR_484_front_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: spriteset_BR_484_front_REV;
		1: spritegroup_BR_484_loading_REV;
		2: switch_BR_484_lights_back;}

	switch(FEAT_TRAINS, SELF, switch_loadstack_BR_484_middle1, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: spriteset_BR_484_middle;
		1: spritegroup_BR_484_loading_middle;}
		
	switch(FEAT_TRAINS, SELF, switch_loadstack_BR_484_middle1_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: spriteset_BR_484_middle_REV;
		1: spritegroup_BR_484_loading_middle_REV;}

	switch(FEAT_TRAINS, SELF, switch_loadstack_BR_484_middle2, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: spriteset_BR_484_middle_REV;
		1: spritegroup_BR_484_loading_middle_REV;}
		
	switch(FEAT_TRAINS, SELF, switch_loadstack_BR_484_middle2_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: spriteset_BR_484_middle;
		1: spritegroup_BR_484_loading_middle;}

	switch(FEAT_TRAINS, SELF, switch_loadstack_BR_484_back, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: spriteset_BR_484_front_REV;
		1: spritegroup_BR_484_loading_REV;
		2: switch_BR_484_lights_back;}
		
	switch(FEAT_TRAINS, SELF, switch_loadstack_BR_484_back_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: spriteset_BR_484_front;
		1: spritegroup_BR_484_loading;
		2: switch_BR_484_lights_front;}							

    switch(FEAT_TRAINS, SELF, switch_BR_484_graphics, position_in_vehid_chain % 12) {
        0: spriteset_empty;
        1: return switch_loadstack_BR_484_front;
        2: spriteset_empty;
        3: spriteset_empty;
        4: return switch_loadstack_BR_484_middle1;
        5: spriteset_empty;
        6: spriteset_empty;
        7: return switch_loadstack_BR_484_middle2;
        8: spriteset_empty;
        9: spriteset_empty;
        10: return switch_loadstack_BR_484_back;
        11: spriteset_empty;}
                        
    switch(FEAT_TRAINS, SELF, switch_BR_484_graphics_REV, position_in_vehid_chain % 12) {
        0: spriteset_empty;
        1: return switch_loadstack_BR_484_back_REV;
        2: spriteset_empty;
        3: spriteset_empty;
        4: return switch_loadstack_BR_484_middle2_REV;
        5: spriteset_empty;
        6: spriteset_empty;
        7: return switch_loadstack_BR_484_middle1_REV;
        8: spriteset_empty;
        9: spriteset_empty;
        10: return switch_loadstack_BR_484_front_REV;
        11: spriteset_empty;}								      												      							       			       			       

    switch (FEAT_TRAINS, PARENT, switch_graphics_BR_484, vehicle_is_reversed) {
        0: switch_BR_484_graphics;
            switch_BR_484_graphics_REV;}
                                
    switch(FEAT_TRAINS, SELF, switch_length_BR_484, position_in_vehid_chain % 12) {
        0: 4;
        1: 3;
        2: 4;
        3: 4;
        4: 3;
        5: 4;
        6: 4;
        7: 3;
        8: 4;
        9: 4;
        10: 3;
        11: 4;}	

	switch (FEAT_TRAINS, SELF, switch_articulated_BR_484, extra_callback_info1) {
		1 .. 11: return ITEM_BR_484; 
		return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}	
			
	switch(FEAT_TRAINS, SELF, switch_FX_BR_484, position_in_vehid_chain % 12) {
		 0 .. 12: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE,0, DISABLE_WAGON_POWER);}																																					

	switch(FEAT_TRAINS,PARENT,switch_running_cost_BR_484, 1){
		return 3700;}
				
item (FEAT_TRAINS , ITEM_BR_484, 4840)
