	switch(FEAT_TRAINS, SELF, switch_loadstack_ET_167_D_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: spriteset_ET_167_D_REV;
		1: spritegroup_ET_167_D_REV_loading;}  

    switch(FEAT_TRAINS, SELF, switch_ET_167_graphics, position_in_vehid_chain % 9) {
        0: spriteset_empty;
        1: return switch_loadstack_ET_167_A;
        2: spriteset_empty;
        3: spriteset_empty;
        4: return switch_loadstack_ET_167_B;
        5: spriteset_empty;
        6: return switch_loadstack_ET_167_C;
        7: spriteset_empty;
        8: return switch_loadstack_ET_167_D;
        9: spriteset_empty;}
                        
    switch(FEAT_TRAINS, SELF, switch_ET_167_REV_graphics, position_in_vehid_chain % 9) {
        0: spriteset_empty;
        1: return switch_loadstack_ET_167_D_REV;
        2: spriteset_empty;
        3: spriteset_empty;
        4: return switch_loadstack_ET_167_C_REV;
        5: spriteset_empty;
        6: return switch_loadstack_ET_167_B_REV;
        7: spriteset_empty;
        8: return switch_loadstack_ET_167_A_REV;
        9: spriteset_empty;}						      												      							       			       			       

    switch (FEAT_TRAINS, PARENT, switch_graphics_ET_167, vehicle_is_reversed) {
        0: switch_ET_167_graphics;
            switch_ET_167_REV_graphics;}

    switch(FEAT_TRAINS, SELF, switch_length_ET_167, position_in_vehid_chain % 9) {
        0: 4;
        1: 3;
        2: 4;
        3: 4;
        4: 6;
        5: 4;
        6: 6;
        7: 4;
        8: 3;
        9: 4;}	
			
	switch(FEAT_TRAINS, SELF, switch_FX_ET_167, position_in_vehid_chain % 9) {
        0 .. 9: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE,0, DISABLE_WAGON_POWER);}																																						

	switch(FEAT_TRAINS,PARENT,switch_running_cost_ET_167, 1){
        return 1325;}  

	switch (FEAT_TRAINS, SELF, switch_articulated_ET_167, extra_callback_info1) {
        1 .. 9: return ITEM_ET_167; 
        return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}	
          
item (FEAT_TRAINS , ITEM_ET_167, 4670)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_ET_167);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1938,01,01);
						model_life: 					65;
						vehicle_life: 					40;
						retire_early: 					-10;							
						reliability_decay: 				20;
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);						
						cargo_allow_refit:              [PASS, TOUR];
						cargo_capacity:                 36;
						loading_speed:					5;
						cost_factor: 					90;
						running_cost_base:				RUNNING_COST_STEAM;						
						running_cost_factor: 			90;

						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							80 km/h;
						refit_cost: 					0;
						track_type: 					MTRO;	
						power:  						490 hp;
						weight: 						134 ton;
						ai_engine_rank: 				0;
						engine_class: 					ENGINE_CLASS_ELECTRIC;
						visual_effect_and_powered: 		visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
