	switch(FEAT_TRAINS, SELF, switch_loadstack_ET_167_A, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: spriteset_ET_167_A;
		1: spritegroup_ET_167_A_loading;}

	switch(FEAT_TRAINS, SELF, switch_loadstack_ET_167_A_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
