		7: return switch_loadstack_BR_463_Gaby_back;
		8: spriteset_empty;}
                        
    switch(FEAT_TRAINS, SELF, switch_BR_463_Gaby_graphics_REV, position_in_vehid_chain % 9) {
        0: spriteset_empty;
        1: return switch_loadstack_BR_463_Gaby_back_REV;
        2: spriteset_empty;
        3: spriteset_empty;
        4: return switch_loadstack_BR_463_Gaby_middle_REV;
        5: spriteset_empty;
		6: spriteset_empty;
		7: return switch_loadstack_BR_463_Gaby_front_REV;
		8: spriteset_empty;}								      												      							       			       			       

    switch (FEAT_TRAINS, PARENT, switch_graphics_BR_463_Gaby, vehicle_is_reversed) {
        0: switch_BR_463_Gaby_graphics;
            switch_BR_463_Gaby_graphics_REV;}

	switch (FEAT_TRAINS, SELF, switch_articulated_BR_463_Gaby, extra_callback_info1) {
        1 .. 8: return ITEM_BR_463_GABY; 
        return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}	
					
