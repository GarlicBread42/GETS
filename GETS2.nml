					{template_128trains_4x(0,0)}		
						
spritegroup spritegroup_BP_35_loading
		{loaded: 	[spriteset_empty];
			loading: 	[spriteset_BP_35_LOADING];}

//Spriteset purchase		

spriteset (spriteset_BP_35_purchase_KPEV, "gfx/BP_35/BP_35_KPEV_1x_8bpp.png")
					{ template_purchase(0, 0)}	
		alternative_sprites (spriteset_BP_35_purchase_KPEV, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BP_35/BP_35_KPEV_1x_32bpp.png", "gfx/BP_35/BP_35_KPEV_1x_mask.png")
					{template_purchase(0,0)}					

spriteset (spriteset_BP_35_purchase_DRG, "gfx/BP_35/BP_35_DRG_1x_8bpp.png")
					{ template_purchase(0, 0)}	
		alternative_sprites (spriteset_BP_35_purchase_DRG, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BP_35/BP_35_DRG_1x_32bpp.png", "gfx/BP_35/BP_35_DRG_1x_mask.png")
					{template_purchase(0,0)}

spriteset (spriteset_BP_35_purchase_DB, "gfx/BP_35/BP_35_DB_1x_8bpp.png")
					{ template_purchase(0, 0)}	
		alternative_sprites (spriteset_BP_35_purchase_DB, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BP_35/BP_35_DB_1x_32bpp.png", "gfx/BP_35/BP_35_DB_1x_mask.png")
					{template_purchase(0,0)}
					
//Switches	

						switch (FEAT_TRAINS,SELF,switch_purchase_BP_35,current_year) {
							   0 .. 1919 : spriteset_BP_35_purchase_KPEV;
							1920 .. 1945 : spriteset_BP_35_purchase_DRG;
							1946 .. 2050 : spriteset_BP_35_purchase_DB;
								spriteset_BP_35_purchase_DB;}
						 
						switch(FEAT_TRAINS, SELF, switch_spritestack_BP_35_KPEV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BP_35_KPEV;
							1: spritegroup_BP_35_loading;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BP_35_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BP_35_DRG;
							1: spritegroup_BP_35_loading;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BP_35_DB, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BP_35_DB;
							1: spritegroup_BP_35_loading;}																					
										
						switch (FEAT_TRAINS,SELF,switch_build_year_BP_35,build_year) {
							   0 .. 1919 : switch_spritestack_BP_35_KPEV;
							1920 .. 1945 : switch_spritestack_BP_35_DRG;
							1946 .. 2050 : switch_spritestack_BP_35_DB;
								switch_spritestack_BP_35_DB;}

						switch (FEAT_TRAINS,SELF,switch_current_year_BP_35,current_year) {
							   0 .. 1919 : switch_spritestack_BP_35_KPEV;
							1920 .. 1945 : switch_spritestack_BP_35_DRG;
							1946 .. 2050 : switch_spritestack_BP_35_DB;
								switch_spritestack_BP_35_DB;}												
					
						switch(FEAT_TRAINS, SELF, switch_length_BP_35, position_in_vehid_chain % 3) {
							0: 4;
							1: 4;
							2: 4;}

						
						switch(FEAT_TRAINS,PARENT,switch_running_cost_BP_35, 1){
							return 187;}
							
						switch(FEAT_TRAINS, SELF, switch_BP_35_graphics_build, position_in_vehid_chain  % 3) {
							0:     spriteset_empty;
							1:     return switch_build_year_BP_35;
							2:     spriteset_empty;}

						switch (FEAT_TRAINS, SELF, switch_articulated_BP_35_build, extra_callback_info1) {
							1 .. 2: return ITEM_BP_35_BUILD;
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}
																					
