					{template_purchase(0, 0)}	
		alternative_sprites (spriteset_O_Schwerin_purchase1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\O_Schwerin/O_Schwerin_KPEV_MBH_1x_32bpp.png", "gfx\O_Schwerin/O_Schwerin_KPEV_MBH_1x_mask.png")
					{template_purchase(0, 0)}	

spriteset (spriteset_O_Schwerin_purchase2, "gfx\O_Schwerin/O_Schwerin_DRG_MBH_1x_8bpp.png")
					{template_purchase(0, 0)}		
		alternative_sprites (spriteset_O_Schwerin_purchase2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\O_Schwerin/O_Schwerin_DRG_MBH_1x_32bpp.png", "gfx\O_Schwerin/O_Schwerin_DRG_MBH_1x_mask.png")
					{template_purchase(0, 0)}	

spriteset (spriteset_O_Schwerin_purchase3, "gfx\O_Schwerin/O_Schwerin_DB_MBH_1x_8bpp.png")
					{template_purchase(0, 0)}		
		alternative_sprites (spriteset_O_Schwerin_purchase3, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\O_Schwerin/O_Schwerin_DB_MBH_1x_32bpp.png", "gfx\O_Schwerin/O_Schwerin_DB_MBH_1x_mask.png")
					{template_purchase(0, 0)}	


//Switches

					switch (FEAT_TRAINS,SELF, switch_O_Schwerin_purchase,current_year){
						1800 .. 1919: spriteset_O_Schwerin_purchase1;
						1920 .. 1945: spriteset_O_Schwerin_purchase2;
						1946 .. 2050: spriteset_O_Schwerin_purchase3;				 					 
							spriteset_O_Schwerin_purchase3;}

					switch(FEAT_TRAINS, SELF, switch_loadstack_O_Schwerin_KPEV_OBH, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_O_Schwerin_KPEV_OBH;
						1: spritegroup_O_Schwerin_OBH_load;}

					switch(FEAT_TRAINS, SELF, switch_loadstack_O_Schwerin_KPEV_MBH, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_O_Schwerin_KPEV_MBH;
						1: spritegroup_O_Schwerin_MBH_load;}

					switch(FEAT_TRAINS, SELF, switch_loadstack_O_Schwerin_DRG_OBH, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_O_Schwerin_DRG_OBH;
						1: spritegroup_O_Schwerin_OBH_load;}

					switch(FEAT_TRAINS, SELF, switch_loadstack_O_Schwerin_DRG_MBH, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_O_Schwerin_DRG_MBH;
						1: spritegroup_O_Schwerin_MBH_load;}
						
					switch(FEAT_TRAINS, SELF, switch_loadstack_O_Schwerin_DB_OBH, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_O_Schwerin_DB_OBH;
						1: spritegroup_O_Schwerin_OBH_load;}

					switch(FEAT_TRAINS, SELF, switch_loadstack_O_Schwerin_DB_MBH, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_O_Schwerin_DB_MBH;
						1: spritegroup_O_Schwerin_MBH_load;}						

					switch (FEAT_TRAINS, SELF, random_choose_O_Schwerin_KPEV, switch_alternative_var_random_bits(1, 1)) {
						1: switch_loadstack_O_Schwerin_KPEV_OBH;
							switch_loadstack_O_Schwerin_KPEV_MBH;}	

					switch (FEAT_TRAINS, SELF, random_choose_O_Schwerin_DRG, switch_alternative_var_random_bits(1, 1)) {
						1: switch_loadstack_O_Schwerin_DRG_OBH;
							switch_loadstack_O_Schwerin_DRG_MBH;}
							
					switch (FEAT_TRAINS, SELF, random_choose_O_Schwerin_DB, switch_alternative_var_random_bits(1, 1)) {
						1: switch_loadstack_O_Schwerin_DB_OBH;
							switch_loadstack_O_Schwerin_DB_MBH;}															

					switch (FEAT_TRAINS,SELF, switch_O_Schwerin_current_year,current_year){
						1800 .. 1919: random_choose_O_Schwerin_KPEV;
						1920 .. 1945: random_choose_O_Schwerin_DRG;
						1946 .. 2050: random_choose_O_Schwerin_DB;				 					 
							random_choose_O_Schwerin_DB;}

					switch (FEAT_TRAINS, PARENT, switch_speed_O_Schwerin,  switch_check_PWG_0()) {
						1: return 65;
						0: return 50;}
													
					switch(FEAT_TRAINS,PARENT,switch_running_cost_O_Schwerin, 1){
						return 72;}

item (FEAT_TRAINS , ITEM_O_SCHWERIN, 8651)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_O_SCHWERIN);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1892,01,01);
						model_life: 					70;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes: 		bitmask(CC_BULK);
						non_refittable_cargo_classes: 	bitmask(CC_COVERED, CC_LIQUID, CC_REFRIGERATED, CC_HAZARDOUS, CC_OVERSIZED);
						cargo_allow_refit:              [COAL, IORE, CORE, AORE, CLAY, FECR, GRVL, KAOL, LIME, PHOS, PORE, POTA, SAND, SULP, URAN, CASS, COKE, MNO2, NICK, NITR, NKOR, QLME, RCYC, SALT, SASH, SLAG, TOFF, RCYC, SCMT, SCRP, ];
						cargo_disallow_refit: 			[BDMT, CMNT, FERT, FICR, GRAI, SALT, SCRP, PEAT, BEAN, SUGR, SGBT, SGCN, TWOD, WDPR];
						misc_flags: 					bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_SPRITE_STACK);
						loading_speed:					10;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							50 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						9 ton;
						dual_headed: 					0;
						default_cargo_type:				COAL;
						cargo_capacity:					15;
						ai_engine_rank: 				0;
						length: 						5;
												
			}
			
	//Vehicels Graphics
			graphics
			{
			default							: switch_O_Schwerin_current_year;
			additional_text					: string(STR_DESC_CABOOSE_65);
			purchase						: switch_O_Schwerin_purchase;
			cost_factor						: 34;
			running_cost_factor				: switch_running_cost_O_Schwerin;
			speed							: switch_speed_O_Schwerin; 				
			colour_mapping					: switch_bulk_recolour;
			 }
		}	
