							0: spriteset_ET_87_back_DB;
							1: spritegroup_ET_87_back_loading;}		
							
						switch(FEAT_TRAINS, SELF, switch_ET_87_length, position_in_vehid_chain % 5) {
							0: 4;
							1: 6;
							2: 7;
							3: 4;
							4: 6;}									
						
						switch(FEAT_TRAINS, SELF, switch_FX_ET_87, position_in_vehid_chain % 5) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
							1: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
							2: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);
							3: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, -5, DISABLE_WAGON_POWER);
							return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}	
							
						switch(FEAT_TRAINS,PARENT,switch_running_cost_ET_87, 1){
							return 1275;}							
	
						switch (FEAT_TRAINS,SELF,switch_ET_87_front_build_year,build_year){
							   0 .. 1919 : switch_spritestack_ET_87_front_KPEV;
							1920 .. 1932 : switch_spritestack_ET_87_front_DRG2;
