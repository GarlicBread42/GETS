//Switches
						switch (FEAT_TRAINS, SELF, switch_animation_BR_78, motion_counter % 4) {
								0: spriteset_BR_78_anim1;
								1: spriteset_BR_78_anim2;
								2: spriteset_BR_78_anim3;
								3: spriteset_BR_78_anim4;}

						switch (FEAT_TRAINS, SELF, switch_animation_BR_78_REV, motion_counter % 4) {
								0: spriteset_BR_78_anim1_REV;
								1: spriteset_BR_78_anim2_REV;
								2: spriteset_BR_78_anim3_REV;
								3: spriteset_BR_78_anim4_REV;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_78_purchase1, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_78_purchase1;
							1: spriteset_BR_78_anim_purchase;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_78_purchase2, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_78_purchase2;
							1: spriteset_BR_78_anim_purchase;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_78_purchase3, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_78_purchase3;
							1: spriteset_BR_78_anim_purchase;}	
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_78_purchase4, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_78_purchase4;
							1: spriteset_BR_78_anim_purchase;}																			
						
						switch (FEAT_TRAINS,SELF, switch_BR_78_purchase,current_year){
							1900 .. 1919: switch_spritestack_BR_78_purchase1;
							1920 .. 1945: switch_spritestack_BR_78_purchase2;	
							1946 .. 2000: switch_spritestack_BR_78_purchase3;															 					 
								switch_spritestack_BR_78_purchase3;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_78_KPEV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_78_KPEV;
							1: return switch_animation_BR_78;}									

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_78_KPEV_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_78_KPEV_REV;
							1: return switch_animation_BR_78_REV;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_78_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_78_DRG;
							1: return switch_animation_BR_78;}									

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_78_DRG_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_78_DRG_REV;
							1: return switch_animation_BR_78_REV;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_78_RSV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_78_RSV;
							1: return switch_animation_BR_78;}									

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_78_RSV_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_78_RSV_REV;
							1: return switch_animation_BR_78_REV;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_78_DB, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_78_DB;
							1: return switch_animation_BR_78;}									

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_78_DB_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_78_DB_REV;
							1: return switch_animation_BR_78_REV;}

						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_78_KPEV, vehicle_is_reversed) {
							0: switch_spritestack_BR_78_KPEV;
								switch_spritestack_BR_78_KPEV_REV;}

						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_78_DRG, vehicle_is_reversed) {
							0: switch_spritestack_BR_78_DRG;
								switch_spritestack_BR_78_DRG_REV;}

						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_78_RSV, vehicle_is_reversed) {
							0: switch_spritestack_BR_78_RSV;
								switch_spritestack_BR_78_RSV_REV;}

						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_78_DB, vehicle_is_reversed) {
							0: switch_spritestack_BR_78_DB;
								switch_spritestack_BR_78_DB_REV;}								

						switch (FEAT_TRAINS,PARENT,switch_enginecheck_BR_78,(count_veh_id(8816))) {
							0: switch_reverse_BR_78_DRG; 
								switch_reverse_BR_78_RSV;}							

						switch (FEAT_TRAINS,SELF, switch_BR_78_build_year,build_year){
							 1900 .. 1919: switch_reverse_BR_78_KPEV;
							 1920 .. 1931: switch_reverse_BR_78_DRG;
							 1932 .. 1945: switch_enginecheck_BR_78;
							 1946 .. 1990: switch_reverse_BR_78_DB;						 					 
							 switch_reverse_BR_78_DB;}
							 
						switch (FEAT_TRAINS,SELF, switch_BR_78_current_year,current_year){
							 1900 .. 1919: switch_reverse_BR_78_KPEV;
							 1920 .. 1931: switch_reverse_BR_78_DRG;
							 1932 .. 1945: switch_enginecheck_BR_78;
							 1946 .. 1990: switch_reverse_BR_78_DB;						 					 
							 switch_reverse_BR_78_DB;}																		

						switch(FEAT_TRAINS, SELF, switch_length_BR_78, position_in_vehid_chain % 3) {
						0: 3;
						1: 3;
						2: 3;}
						
						switch(FEAT_TRAINS, SELF, switch_FX_BR_78_A, position_in_vehid_chain % 3) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_STEAM, -2, DISABLE_WAGON_POWER);
							1 .. 2 :return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}
							
						switch(FEAT_TRAINS, SELF, switch_FX_BR_78_B, position_in_vehid_chain % 3) {
							0 .. 1 : return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
							2: return visual_effect_and_powered(VISUAL_EFFECT_STEAM, -2, DISABLE_WAGON_POWER);}
							
						switch(FEAT_TRAINS, PARENT, switch_FX_BR_78, vehicle_is_reversed ) {
							0: switch_FX_BR_78_A;
								switch_FX_BR_78_B;}										
													
						switch(FEAT_TRAINS,PARENT,switch_running_cost_BR_78, 1){
						return 1625;}

						switch(FEAT_TRAINS, SELF, switch_BR_78_graphics_build, position_in_vehid_chain % 3) {
							0:	   spriteset_empty;
							1:     switch_BR_78_build_year;
							2:	   spriteset_empty;}	
							
						switch (FEAT_TRAINS, SELF, switch_articulated_BR_78_build, extra_callback_info1) {
							1 .. 2: return ITEM_BR_78; 
							return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}
																				
item (FEAT_TRAINS , ITEM_BR_78, 0780)
		{
			//property Block
					property 
					{
					//common properties
								name: 							string(STR_NAME_BR_78);
								extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
								climates_available: 			ALL_CLIMATES;
								introduction_date: 				date(1912,01,01);
								model_life: 					60;
								vehicle_life: 					40;
								retire_early: 					-10;								
								reliability_decay: 				20;
								cargo_allow_refit: 				[PASS] ;
								cargo_capacity: 				1 ;
								cost_factor: 					30;
								misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);									
								running_cost_base: 				RUNNING_COST_STEAM;
								running_cost_factor: 			90;
								
					//Train specific properties
								sprite_id: 						SPRITE_ID_NEW_TRAIN;
								speed: 							100 km/h;
								refit_cost: 					0;
								track_type: 					RAIL;
