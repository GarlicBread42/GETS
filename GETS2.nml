							0: spriteset_BR_14_0_Altona_purchase;
							1: spriteset_BR_14_0_Altona_purchase_anim;}

						switch (FEAT_TRAINS, SELF, switch_animation_BR_14_0_Altona, motion_counter % 4) {
							0: spriteset_BR_14_0_Altona_anim1;
							1: spriteset_BR_14_0_Altona_anim2;
							2: spriteset_BR_14_0_Altona_anim3;
							3: spriteset_BR_14_0_Altona_anim4;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_14_0_Altona, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_14_0_Altona;
							1: return switch_animation_BR_14_0_Altona;}

						switch(FEAT_TRAINS, SELF, switch_length_BR_14_0_Altona, position_in_vehid_chain % 4) {
							0: 3;
							1: 3;
							2: 3;
							3: 7;}
							
						switch(FEAT_TRAINS, SELF, switch_FX_BR_14_0_Altona, position_in_vehid_chain % 4) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_STEAM, -1, DISABLE_WAGON_POWER);
							return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}
													
						switch (FEAT_TRAINS, PARENT, switch_running_cost_BR_14_0_Altona, 1) {
							return 3350;}																									 						 

						switch(FEAT_TRAINS, SELF, switch_BR_14_0_Altona_graphics, position_in_vehid_chain % 4) {
							0:	   spriteset_empty;
							1:     switch_spritestack_BR_14_0_Altona;
							2:	   spriteset_empty;
							3:     return spriteset_BR_14_0_Altona_Tender;}
							
						switch (FEAT_TRAINS, SELF, switch_articulated_BR_14_0_Altona, extra_callback_info1) {
							1 .. 3: return ITEM_BR_14_0_ALTONA; 
							return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}								
							
