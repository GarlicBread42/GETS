spriteset(spriteset_BR_90_0_purchase2, "gfx/BR_90_0/BR_90_0_DRG_1x_8bpp.png")
									{ template_purchase(0, 0)}
	alternative_sprites (spriteset_BR_90_0_purchase2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BR_90_0/BR_90_0_DRG_1x_32bpp.png", "gfx/BR_90_0/BR_90_0_DRG_1x_mask.png")
									{ template_purchase(0, 0)}

spriteset(spriteset_BR_90_0_anim_purchase, "gfx/BR_90_0/BR_90_0_anim1_1x_8bpp.png")
									{ template_purchase(0, 0)}
	alternative_sprites (spriteset_BR_90_0_anim_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BR_90_0/BR_90_0_anim1_1x_32bpp.png", "gfx/BR_90_0/BR_90_0_anim1_1x_mask.png")
									{ template_purchase(0, 0)}

//Switches
						switch (FEAT_TRAINS, SELF, switch_animation_BR_90_0, motion_counter % 4) {
								0: spriteset_BR_90_0_anim1;
								1: spriteset_BR_90_0_anim2;
								2: spriteset_BR_90_0_anim3;
								3: spriteset_BR_90_0_anim4;}

						switch (FEAT_TRAINS, SELF, switch_animation_BR_90_0_REV, motion_counter % 4) {
								0: spriteset_BR_90_0_anim1_REV;
								1: spriteset_BR_90_0_anim2_REV;
								2: spriteset_BR_90_0_anim3_REV;
								3: spriteset_BR_90_0_anim4_REV;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_90_0_purchase1, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_90_0_purchase1;
							1: spriteset_BR_90_0_anim_purchase;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_90_0_purchase2, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_90_0_purchase2;
							1: spriteset_BR_90_0_anim_purchase;}								
	
							switch (FEAT_TRAINS,SELF, switch_BR_90_0_purchase,current_year){
							   0 .. 1919: switch_spritestack_BR_90_0_purchase1;
							1920 .. 2045: switch_spritestack_BR_90_0_purchase2;															 					 
								switch_spritestack_BR_90_0_purchase2;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_90_0_KPEV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_90_0_KPEV;
							1: return switch_animation_BR_90_0;}									

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_90_0_KPEV_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_90_0_KPEV_REV;
							1: return switch_animation_BR_90_0_REV;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_90_0_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_90_0_DRG;
							1: return switch_animation_BR_90_0;}									

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_90_0_DRG_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_90_0_DRG_REV;
							1: return switch_animation_BR_90_0_REV;}


						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_90_0_KPEV, vehicle_is_reversed) {
							0: switch_spritestack_BR_90_0_KPEV;
								switch_spritestack_BR_90_0_KPEV_REV;}

						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_90_0_DRG, vehicle_is_reversed) {
							0: switch_spritestack_BR_90_0_DRG;
								switch_spritestack_BR_90_0_DRG_REV;}																															

						switch (FEAT_TRAINS,SELF, switch_BR_90_0_current_year,current_year){
								1880 .. 1919: switch_reverse_BR_90_0_KPEV;
								1920 .. 1960: switch_reverse_BR_90_0_DRG;					 					 
								switch_reverse_BR_90_0_DRG;}		
							 
						switch (FEAT_TRAINS,SELF, switch_BR_90_0_build_year,build_year){
							 1880 .. 1919: switch_reverse_BR_90_0_KPEV;
							 1920 .. 1960: switch_reverse_BR_90_0_DRG;					 					 
							 switch_reverse_BR_90_0_DRG;}								 																																												

						switch(FEAT_TRAINS, PARENT, switch_FX_BR_90_0, vehicle_is_reversed) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_STEAM, -3, DISABLE_WAGON_POWER);
								return visual_effect_and_powered(VISUAL_EFFECT_STEAM, 2, DISABLE_WAGON_POWER);}	
																
						switch(FEAT_TRAINS,PARENT,switch_running_cost_BR_90_0, 1){
						return 700;}
						
item (FEAT_TRAINS , ITEM_BR_90_0, 0900)
		{
			//property Block
					property 
					{
					//common properties
								name: 							string(STR_NAME_BR_90_0);
								extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
								climates_available: 			ALL_CLIMATES;
								introduction_date: 				date(1892,01,01);
								model_life: 					52;
								vehicle_life: 					40;
								retire_early: 					-10;								
								reliability_decay: 				20;
								cargo_allow_refit: 				[PASS] ;
								cargo_capacity: 				1 ;
								cost_factor: 					30;
								misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);								
								running_cost_base: 				RUNNING_COST_STEAM;
								running_cost_factor: 			90;
								
					//Train specific properties
								sprite_id: 						SPRITE_ID_NEW_TRAIN;
								speed: 							60 km/h;
								refit_cost: 					0;
								track_type: 					RAIL;
								power:  						450 hp;
								weight: 						55 ton;
								ai_engine_rank: 				0;
								engine_class: 					ENGINE_CLASS_STEAM;
								visual_effect_and_powered: 		visual_effect_and_powered(VISUAL_EFFECT_STEAM, -3, DISABLE_WAGON_POWER);
								dual_headed: 					0;
								tractive_effort_coefficient: 	0.20;
								length: 						7;												
			}
			
			//Vehicels Graphics
					graphics
				{
						default						    : switch_BR_90_0_build_year;
			additional_text				   : string(STR_CONCAT_2, 
											string(STR_TRACTION_STEAM), 
											string(STR_DESC_GOODS),);
						purchase_cargo_capacity         : 0 ;
						cargo_capacity                  : return 0 ;
						purchase					    : switch_BR_90_0_purchase;
						visual_effect_and_powered		: switch_FX_BR_90_0;
						cost_factor						: 5;
						running_cost_factor				: switch_running_cost_BR_90_0;
			 }
		}

