									{ template_purchase(0, 0)}
				
		alternative_sprites (spriteset_VT_137_025_purchase2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\VT_137_025/VT_137_025_DB_1x_32bpp.png", "gfx\VT_137_025/VT_137_025_DB_1x_mask.png")
									{ template_purchase(0, 0)}																						

//Switches

						switch (FEAT_TRAINS,SELF, switch_VT_137_025_purchase,current_year){
							   0 .. 1945: spriteset_VT_137_025_purchase1;
							1946 .. 2050: spriteset_VT_137_025_purchase2;						
										spriteset_VT_137_025_purchase2;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_VT_137_025_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_VT_137_025_DRG;
							1: spritegroup_VT_137_025_loading;}

