//Spritesets purchase

spriteset (spriteset_Sahs_711_purchase_braun, "gfx\Sahs_711/Sahs_711_VAR1_braun_1x_8bpp.png")
					{template_purchase(0, 0)}	
				
		alternative_sprites (spriteset_Sahs_711_purchase_braun, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\Sahs_711/Sahs_711_VAR1_braun_1x_32bpp.png", "gfx\Sahs_711/Sahs_711_VAR1_braun_1x_mask.png")
					{template_purchase(0, 0)}	
					
spriteset (spriteset_Sahs_711_purchase_schwarz, "gfx\Sahs_711/Sahs_711_VAR1_schwarz_1x_8bpp.png")
					{template_purchase(0, 0)}	
				
		alternative_sprites (spriteset_Sahs_711_purchase_schwarz, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\Sahs_711/Sahs_711_VAR1_schwarz_1x_32bpp.png", "gfx\Sahs_711/Sahs_711_VAR1_schwarz_1x_mask.png")
					{template_purchase(0, 0)}


//Switches

					switch (FEAT_TRAINS,SELF, switch_Sahs_711_purchase,current_year){
						  00 .. 1986: spriteset_Sahs_711_purchase_schwarz;
						1987 .. 2050: spriteset_Sahs_711_purchase_braun;
							spriteset_Sahs_711_purchase_braun;}							

					switch(FEAT_TRAINS, SELF, switch_loadstack_Sahs_711_VAR1_schwarz, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_Sahs_711_VAR1_schwarz;
						1: spritegroup_Sahs_711_VAR1_loading;}	

					switch(FEAT_TRAINS, SELF, switch_loadstack_Sahs_711_VAR2_schwarz, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_Sahs_711_VAR2_schwarz;
						1: spritegroup_Sahs_711_VAR2_loading;}	

					switch(FEAT_TRAINS, SELF, switch_loadstack_Sahs_711_VAR1_braun, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_Sahs_711_VAR1_braun;
						1: spritegroup_Sahs_711_VAR1_loading;}	

					switch(FEAT_TRAINS, SELF, switch_loadstack_Sahs_711_VAR2_braun, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_Sahs_711_VAR2_braun;
						1: spritegroup_Sahs_711_VAR2_loading;}	

					switch (FEAT_TRAINS, SELF, random_choose_Sahs_711_schwarz, switch_alternative_var_random_bits(1, 1)) {
						1: switch_loadstack_Sahs_711_VAR1_schwarz;
							switch_loadstack_Sahs_711_VAR2_schwarz;}	

					switch (FEAT_TRAINS, SELF, random_choose_Sahs_711_braun, switch_alternative_var_random_bits(1, 1)) {
						1: switch_loadstack_Sahs_711_VAR1_braun;
							switch_loadstack_Sahs_711_VAR2_braun;}

					switch(FEAT_TRAINS, SELF, switch_length_Sahs_711, position_in_vehid_chain % 3) {
						0: 3;
						1: 4;
						2: 3;}							
																				
					switch(FEAT_TRAINS,PARENT,switch_running_cost_Sahs_711, 1){
						return 600;}

					switch (FEAT_TRAINS,SELF, switch_Sahs_711_current_year,current_year){
						00 .. 1986: random_choose_Sahs_711_schwarz;
					  1987 .. 2050: random_choose_Sahs_711_braun;					 					 
							random_choose_Sahs_711_braun;}
								
					switch(FEAT_TRAINS, SELF, switch_Sahs_711_current_graphics, position_in_articulated_veh % 3) {
						0:	   spriteset_empty;
						1:     return switch_Sahs_711_current_year;
						2:	   spriteset_empty;}

					switch (FEAT_TRAINS, SELF, switch_articulated_Sahs_711_current, extra_callback_info1) {
						1 .. 2: return ITEM_SAHS_711_CURRENT;
						return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}	
																			
item (FEAT_TRAINS , ITEM_SAHS_711_CURRENT, 9007)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_SAHS_711_CURRENT);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1974,01,01);
						model_life: 					40;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes: 		bitmask(CC_COVERED, CC_PIECE_GOODS);
						non_refittable_cargo_classes: 	bitmask(CC_LIQUID, CC_BULK);
						cargo_allow_refit:              [STAL, ALUM, STCB, STST, STSH, STWR, COPR,];
						cargo_disallow_refit: 			[LVST, FOOD, WATR, BEER, BOOM, FISH, IRON, ENSP, FMSP, FRUT, PAPR, MPTS, POWR, VPTS, WOOD, WOOL, PIPE, VEHI, VBOD, VENG, MNSP, ZINC, CSTI, GLAS, STSE, TYRE];
						misc_flags: 					bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_SPRITE_STACK);
						loading_speed:					6;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							100 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						31 ton;
						dual_headed: 					0;
						default_cargo_type:				STAL;
						cargo_capacity:					29;
						ai_engine_rank: 				0;
						length: 						8;
												
			}
			
	//Vehicels Graphics
			graphics
			{
			default							: switch_Sahs_711_current_graphics;
			additional_text					: string(STR_DESC_GOODS);
			articulated_part			  	: switch_articulated_Sahs_711_current;
			length							: switch_length_Sahs_711;
			purchase						: switch_Sahs_711_purchase;
			cost_factor						: 295;
			running_cost_factor				: switch_running_cost_Sahs_711;	
			colour_mapping					: switch_generic_recolour;
			 }
		}
								
					switch(FEAT_TRAINS, SELF, switch_Sahs_711_schwarz_graphics, position_in_articulated_veh % 3) {
						0:	   spriteset_empty;
						1:     random_choose_Sahs_711_schwarz;
						2:	   spriteset_empty;}

					switch (FEAT_TRAINS, SELF, switch_articulated_Sahs_711_schwarz, extra_callback_info1) {
						1 .. 2: return ITEM_SAHS_711_SCHWARZ;
						return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}	
																			
