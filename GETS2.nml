			cost_factor					    : 26;
			running_cost_factor				: switch_running_cost_BR_58_2;
			visual_effect_and_powered		: switch_FX_BR_58_2;
			
			}
	}						

					switch(FEAT_TRAINS, SELF, switch_BR_58_2_graphics_current, position_in_vehid_chain % 2) {
