			1: switch_loadstack_Om_Ludwigshafen_OBH_Timber;
				switch_loadstack_Om_Ludwigshafen_MBH_Timber;}
				
	switch (FEAT_TRAINS, SELF, random_choose_Om_Ludwigshafen_Wood, switch_alternative_var_random_bits(1, 1)) {
			1: switch_loadstack_Om_Ludwigshafen_OBH_Wood;
				switch_loadstack_Om_Ludwigshafen_MBH_Wood;}	

	switch(FEAT_TRAINS, SELF, switch_Om_Ludwigshafen_current_CC_Liquid, hasbit(cargo_classes, CC_LIQUID)) {
			0: random_choose_Om_Ludwigshafen_Box;
				random_choose_Om_Ludwigshafen_Fass;}	

	switch(FEAT_TRAINS, SELF, switch_Om_Ludwigshafen_current_CC_Piece, hasbit(cargo_classes, CC_PIECE_GOODS)) {
			0: switch_Om_Ludwigshafen_current_CC_Liquid;
				random_choose_Om_Ludwigshafen_Box;}		

	switch(FEAT_TRAINS, SELF, switch_Om_Ludwigshafen_current_CC_Bulk, hasbit(cargo_classes, CC_BULK)) {
		0: switch_Om_Ludwigshafen_current_CC_Piece;
			random_choose_Om_Ludwigshafen_Bulk;}

	switch(FEAT_TRAINS, SELF, switch_Om_Ludwigshafen_current_CC_Bulk_Covered, hasbit(cargo_classes, CC_COVERED & CC_BULK)) {
		0: switch_Om_Ludwigshafen_current_CC_Bulk;
			random_choose_Om_Ludwigshafen_Bulk_covered;}			

	switch (FEAT_TRAINS, SELF, switch_Om_Ludwigshafen_cargo_type, cargo_type_in_veh) {
			STEL: return random_choose_Om_Ludwigshafen_Barren;
			METL: return random_choose_Om_Ludwigshafen_Rohr;
			ZINC: return random_choose_Om_Ludwigshafen_Rohr;
			COPR: return random_choose_Om_Ludwigshafen_COPR;
			STST: return random_choose_Om_Ludwigshafen_Barren;
			STSH: return random_choose_Om_Ludwigshafen_Barren;
			STSE: return random_choose_Om_Ludwigshafen_Barren;
			STAL: return random_choose_Om_Ludwigshafen_Barren;
			STCB: return random_choose_Om_Ludwigshafen_Rohr;
			STWR: return random_choose_Om_Ludwigshafen_Rohr; 
			CSTI: return random_choose_Om_Ludwigshafen_Rohr;
			PIPE: return random_choose_Om_Ludwigshafen_Rohr;

			ENSP: return random_choose_Om_Ludwigshafen_Box;
			FMSP: return random_choose_Om_Ludwigshafen_Box;
			MNSP: return random_choose_Om_Ludwigshafen_Box;
			POWR: return random_choose_Om_Ludwigshafen_Box;
			VPTS: return random_choose_Om_Ludwigshafen_Box;
			MPTS: return random_choose_Om_Ludwigshafen_Box;
			GOOD: return random_choose_Om_Ludwigshafen_Box;
			PAPR: return random_choose_Om_Ludwigshafen_Box;
			TYRE: return random_choose_Om_Ludwigshafen_Box;
			WOOL: return random_choose_Om_Ludwigshafen_Box;
			TEXT: return random_choose_Om_Ludwigshafen_Box;	
			SEED: return random_choose_Om_Ludwigshafen_Box;	
			FERT: return random_choose_Om_Ludwigshafen_Box;

			FRVG: return random_choose_Om_Ludwigshafen_Bulk_covered;
			TATO: return random_choose_Om_Ludwigshafen_Bulk_covered;
			FRUT: return random_choose_Om_Ludwigshafen_Bulk_covered;
			CERE: return random_choose_Om_Ludwigshafen_Bulk_covered;
			FICR: return random_choose_Om_Ludwigshafen_Bulk_covered;
			OLSD: return random_choose_Om_Ludwigshafen_Bulk_covered;
			QLME: return random_choose_Om_Ludwigshafen_Bulk;
			MNO2: return random_choose_Om_Ludwigshafen_Bulk;

			BDMT: return random_choose_Om_Ludwigshafen_Timber;
			WDPR: return random_choose_Om_Ludwigshafen_Timber;
			WOOD: return random_choose_Om_Ludwigshafen_Wood;
			GLAS: return random_choose_Om_Ludwigshafen_Box;
			BRCK: return random_choose_Om_Ludwigshafen_Box;
				switch_Om_Ludwigshafen_current_CC_Bulk_Covered;}	


	switch (FEAT_TRAINS, PARENT, switch_speed_Om_Ludwigshafen,  switch_check_PWG_0()) {
		1: return 65;
		0: return 50;}								

	switch(FEAT_TRAINS,PARENT,switch_running_cost_Om_Ludwigshafen, 1){
		return 80;}

item (FEAT_TRAINS , ITEM_OM_LUDWIGSHAFEN, 8603)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_OM_LUDWIGSHAFEN);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1908,01,01);
						model_life: 					55;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes: 		bitmask(CC_BULK, CC_COVERED, CC_PIECE_GOODS, CC_LIQUID);
						non_refittable_cargo_classes: 	bitmask(CC_REFRIGERATED, CC_HAZARDOUS, CC_OVERSIZED);
						cargo_allow_refit:              [WOOD, BDMT, WDPR, TWOD, FRUT ];
						cargo_disallow_refit: 			[LVST, FOOD, WATR, BEER, BOOM, FISH, IRON];
						misc_flags: 					bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_SPRITE_STACK);
						loading_speed:					10;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							50 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						10 ton;
						dual_headed: 					0;
						default_cargo_type:				COAL;
						cargo_capacity:					20;
						ai_engine_rank: 				0;
						length: 						6;
												
			}
			
	//Vehicels Graphics
			graphics
			{
			default							: switch_Om_Ludwigshafen_cargo_type;
			additional_text					: string(STR_DESC_CABOOSE_65);
			purchase						: switch_Om_Ludwigshafen_purchase;
			speed							: switch_speed_Om_Ludwigshafen;
			cost_factor						: 39;
			running_cost_factor				: switch_running_cost_Om_Ludwigshafen;
			colour_mapping					: switch_bulk_recolour;
			 }
		}
