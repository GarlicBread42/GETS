							0: spriteset_BR_58_2_purchase4;
							1: spriteset_BR_58_2_purchase_anim;}							

						switch (FEAT_TRAINS,SELF, switch_BR_58_2_purchase,current_year){
							   0 .. 1919: switch_spritestack_BR_58_2_purchase1;
							1920 .. 1945: switch_spritestack_BR_58_2_purchase2;	
							1946 .. 2000: switch_spritestack_BR_58_2_purchase3;															 					 
								switch_spritestack_BR_58_2_purchase3;}						 

						switch (FEAT_TRAINS, SELF, switch_animation_BR_58_2, motion_counter % 4) {
							0: spriteset_BR_58_2_anim1;
							1: spriteset_BR_58_2_anim2;
							2: spriteset_BR_58_2_anim3;
							3: spriteset_BR_58_2_anim4;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_58_2_KPEV1, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_58_2_KPEV1;
							1: return switch_animation_BR_58_2;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_58_2_KPEV2, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
