						0: spriteset_SSK_Koeln;
						1: spritegroup_SSK_Koeln_load_Barren;}

					switch(FEAT_TRAINS, SELF, switch_loadstack_SSK_Koeln_Box, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
