							1950 .. 1974: spriteset_BR_151_gruen;
							1975 .. 1987: spriteset_BR_151_ozeanblau;
							1988 .. 1995: spriteset_BR_151_orientrot;
							1996 .. 2009: spriteset_BR_151_verkehrsrot;
							2010 .. 2100: spriteset_BR_151_cargo;
							spriteset_BR_151_cargo;}

						switch(FEAT_TRAINS, SELF, switch_length_BR_151, position_in_vehid_chain % 3) {
							0: 4;
							1: 4;
							2: 4;}
						
						switch(FEAT_TRAINS, SELF, switch_FX_BR_151, position_in_vehid_chain % 3) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
							return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}					

						switch(FEAT_TRAINS,PARENT,switch_running_cost_BR_151, 1){
							return 4500;}						
	
						switch(FEAT_TRAINS, SELF, switch_BR_151_graphics_build, position_in_vehid_chain % 3) {
							0:	   spriteset_empty;
							1:     return switch_BR_151_build_year;
							2:	   spriteset_empty;}

						switch (FEAT_TRAINS, SELF, switch_articulated_BR_151_build, extra_callback_info1) {
							1 .. 2: return ITEM_BR_151_BUILD; 
							return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}
						
item (FEAT_TRAINS , ITEM_BR_151_BUILD, 1506)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_BR_151_BUILD);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);						
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1973,01,01);
						model_life: 					56;
						vehicle_life: 					40;
						retire_early: 					-10;							
						reliability_decay: 				20;
						cargo_allow_refit: 				[PASS] ;
						cargo_capacity: 				1 ;
						cost_factor: 					108;
						running_cost_base: 				RUNNING_COST_STEAM;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							120 km/h;
						refit_cost: 					0;
						track_type: 					AC15;
						power:  						8130 hp;
						weight: 						118 ton;
						ai_engine_rank: 				0;
						engine_class: 					ENGINE_CLASS_ELECTRIC;
						visual_effect_and_powered: 		visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
						dual_headed: 					0;
						tractive_effort_coefficient: 	0.373;
						length: 						8;
												
			}

		//Vehicels Graphics
			graphics
			{
			default							: switch_BR_151_graphics_build;
			additional_text					: string(STR_CONCAT_2, 
											  string(STR_TRACTION_ELECTRIC), 
											  string(STR_DESC_GOODS),);
			length							: switch_length_BR_151;
			articulated_part				: switch_articulated_BR_151_build;
			purchase_cargo_capacity		    : 0 ;
			cargo_capacity	                : return 0 ;
			purchase						: switch_purchase_BR_151;
			cost_factor						: 234;
			running_cost_factor				: switch_running_cost_BR_151;			
			visual_effect_and_powered		: switch_FX_BR_151;
			}
	}


						switch(FEAT_TRAINS, SELF, switch_BR_151_graphics_current, position_in_vehid_chain % 3) {
