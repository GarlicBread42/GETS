											string(STR_TRACTION_STEAM), 
											string(STR_DESC_BR_41),);
			length						   : switch_length_BR_41;
			articulated_part			   : switch_articulated_BR_41_NBK;
			purchase_cargo_capacity        : 0 ;
			cargo_capacity                 : return 0 ;
			purchase					   : switch_spritestack_BR_41_purchase3;
			cost_factor					    :35;
			running_cost_factor				:switch_running_cost_BR_41;
			visual_effect_and_powered		:switch_FX_BR_41;
			power							: switch_power_BR_41;	
			
			}
	}
