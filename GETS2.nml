//Switches
						 switch (FEAT_TRAINS,SELF, switch_Rilns_654_purchase,current_year){
							1900 .. 1995: spriteset_Rilns_654_purchase_DB;
							1996 .. 1999: spriteset_Rilns_654_purchase_Cargo;
							2000 .. 2009: spriteset_Rilns_654_purchase_Railion;	
							2010 .. 2100: spriteset_Rilns_654_purchase_Cargo;				 					 
								spriteset_Rilns_654_purchase_Cargo;}


						 switch (FEAT_TRAINS,SELF, switch_Rilns_654_current_year,current_year){
							1900 .. 1995: spritegroup_Rilns_654_DB;
							1996 .. 1999: spritegroup_Rilns_654_Cargo;
							2000 .. 2009: spritegroup_Rilns_654_Railion;	
							2010 .. 2100: spritegroup_Rilns_654_Cargo;				 					 
								spritegroup_Rilns_654_Cargo;}	

					switch (FEAT_TRAINS, SELF, random_choose_Rilns_654_PRIV, switch_alternative_var_random_bits(3,3)) {
							0: spritegroup_Rilns_654_DB;
							1: spritegroup_Rilns_654_PRIV1;
							2: spritegroup_Rilns_654_PRIV2;
							3: spritegroup_Rilns_654_PRIV3;
							4: spritegroup_Rilns_654_PRIV3;
							5: spritegroup_Rilns_654_PRIV4;
							6: spritegroup_Rilns_654_PRIV4;
							7: spritegroup_Rilns_654_PRIV2;
								spritegroup_Rilns_654_PRIV3;}
								
						switch(FEAT_TRAINS, SELF, switch_length_Rilns_654, position_in_vehid_chain % 3) {
							0: 4;
							1: 4;
							2: 4;}																						

						switch(FEAT_TRAINS,PARENT,switch_running_cost_Rilns_654, 1){
							return 500;}	
							
						switch(FEAT_TRAINS, SELF, switch_Rilns_654_graphics_current, position_in_articulated_veh % 3) {
							0:	   spriteset_empty;
							1:     return switch_Rilns_654_current_year;
							2:	   spriteset_empty;}

						switch (FEAT_TRAINS, SELF, switch_articulated_Rilns_654_current, extra_callback_info1) {
							1 .. 2: return ITEM_RILNS_654_CURRENT;
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}	

