									{ template_purchase(0, 0)}
				
		alternative_sprites (spriteset_BR_445_purchase_NahSH, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\BR_445/BR_445_front_NahSH_1x_32bpp.png", "gfx\BR_445/BR_445_front_NahSH_1x_mask.png")
									{ template_purchase(0, 0)}
									
									
//Switches

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_445_front_Regio, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_445_front_Regio;
							1: spritegroup_BR_445_front_Regio_loading;}										

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_445_middle1_Regio, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_445_middle1_Regio;
							1: spritegroup_BR_445_middle1_Regio_loading;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_445_middle2_Regio, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_445_middle2_Regio;
							1: spritegroup_BR_445_middle1_Regio_loading;}							

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_445_back_Regio, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_445_back_Regio;
							1: spritegroup_BR_445_back_Regio_loading;}							

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_445_front_NahSH, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
