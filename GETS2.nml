							1964 .. 1973 : spriteset_UICX_HSW_purchase_blaurot;
							1974 .. 2050 : spriteset_UICX_HSW_purchase_ozeanblau;
								spriteset_UICX_HSW_purchase_ozeanblau;}	
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_UICX_HSW_blau, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_UICX_HSW_blau;
							1: spritegroup_UICX_loading_1;}											

						switch(FEAT_TRAINS, SELF, switch_spritestack_UICX_HSW_gruen, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
