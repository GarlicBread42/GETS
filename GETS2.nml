//Switches																																	

						switch (FEAT_TRAINS,SELF,switch_purchase_N_Wagen,current_year) {
							  00 .. 1974 : spriteset_N_Wagen_purchase_schwarz;
							1975 .. 1987 : spriteset_N_Wagen_purchase_ozeanblau;
							1988 .. 1995 : spriteset_N_Wagen_purchase_Mint;
							1996 .. 2050 : spriteset_N_Wagen_purchase_verkehrsrot;
									spriteset_N_Wagen_purchase_verkehrsrot;}

						switch(FEAT_TRAINS, SELF, switch_loadstack_N_Wagen_schwarz_B, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_N_Wagen_schwarz_B;
							1: spritegroup_N_Wagen_loading;}									
									
						switch(FEAT_TRAINS, SELF, switch_loadstack_N_Wagen_schwarz_AB, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
