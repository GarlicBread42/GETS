							1: switch_loadstack_MZ_FERN_A1;
							   switch_loadstack_MZ_FERN_B;}
							   
						switch (FEAT_TRAINS, SELF, random_choose_MZ_BWX, switch_alternative_var_random_bits(1, 1)) {
							1: switch_loadstack_MZ_BWX_A3;
							   switch_loadstack_MZ_BWX_B;}
							   
						switch (FEAT_TRAINS, SELF, random_choose_MZ_LAX, switch_alternative_var_random_bits(1, 1)) {
							1: switch_loadstack_MZ_LAX_A3;
							   switch_loadstack_MZ_LAX_B;}	
							   
						switch (FEAT_TRAINS, SELF, random_choose_MZ_MNX, switch_alternative_var_random_bits(1, 1)) {
							1: switch_loadstack_MZ_MNX_AB;
							   switch_loadstack_MZ_MNX_B;}	

						switch (FEAT_TRAINS,SELF,switch_build_year_MZ_COACH,build_year) {
							   0 .. 1985 : random_choose_MZ_TEE;
							1986 .. 1995 : random_choose_MZ_ICOLD;
							1996 .. 1999 : random_choose_MZ_FERN;
							1999 .. 2100 : random_choose_MZ_ICNEW;
								random_choose_MZ_ICNEW;}
						
						switch (FEAT_TRAINS,SELF,switch_current_year_MZ_COACH,current_year) {
							   0 .. 1985 : random_choose_MZ_TEE;
							1986 .. 1995 : random_choose_MZ_ICOLD;
							1996 .. 1999 : random_choose_MZ_FERN;
							1999 .. 2100 : random_choose_MZ_ICNEW;
								random_choose_MZ_ICNEW;}	   								
					
						switch(FEAT_TRAINS, SELF, switch_length_MZ_COACH, position_in_articulated_veh % 3) {
							0: 4;
							1: 7;
							2: 4;}	

						switch (FEAT_TRAINS, PARENT, switch_running_cost_MZ_COACH,  switch_check_Restaurant_0()) {
							1: return 0;
							0: return 2650;}	
							
						switch (FEAT_TRAINS, PARENT, switch_cargo_aging_MZ_COACH,  switch_check_Restaurant_0()) {
							1: return 233;
							0: return 185;}								
							
						switch(FEAT_TRAINS, SELF, switch_MZ_COACH_graphics_build, position_in_articulated_veh  % 3) {
							0:     spriteset_empty;
							1:     return switch_build_year_MZ_COACH;
							2:     spriteset_empty;}

						switch (FEAT_TRAINS, SELF, switch_articulated_MZ_COACH_build, extra_callback_info1) {
							1 .. 2: return ITEM_MZ_COACH_BUILD;												
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}
																						
