					{template_purchase(0, 0)}	
		alternative_sprites (spriteset_RS_Stuttgart_purchase2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\RS_Stuttgart/RS_Stuttgart_DB_1x_32bpp.png", "gfx\RS_Stuttgart/RS_Stuttgart_DB_1x_mask.png")
					{template_purchase(0, 0)}					

//Switches

	switch (FEAT_TRAINS,SELF, switch_RS_Stuttgart_purchase,current_year){
		1800 .. 1945: spriteset_RS_Stuttgart_purchase1;
		1946 .. 2050: spriteset_RS_Stuttgart_purchase2;
			spriteset_RS_Stuttgart_purchase2;}		
																		
	switch (FEAT_TRAINS,SELF, switch_RS_Stuttgart_current_year,current_year){
		1800 .. 1945: spriteset_RS_Stuttgart_DRG;
		1946 .. 2050: spriteset_RS_Stuttgart_DB;
			spriteset_RS_Stuttgart_DB;}				

	switch(FEAT_TRAINS, SELF, switch_loadstack_RS_Stuttgart_Barren, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: return switch_RS_Stuttgart_current_year;
		1: spritegroup_RS_Stuttgart_load_Barren;}

	switch(FEAT_TRAINS, SELF, switch_loadstack_RS_Stuttgart_Box, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: return switch_RS_Stuttgart_current_year;
		1: spritegroup_RS_Stuttgart_load_Box;}	
		
	switch(FEAT_TRAINS, SELF, switch_loadstack_RS_Stuttgart_ENSP, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: return switch_RS_Stuttgart_current_year;
		1: switch_RS_Stuttgart_load_ENSP_current_year;}	
		
	switch(FEAT_TRAINS, SELF, switch_loadstack_RS_Stuttgart_Farm, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: return switch_RS_Stuttgart_current_year;
		1: switch_RS_Stuttgart_load_Farm_current_year;}	
		
	switch(FEAT_TRAINS, SELF, switch_loadstack_RS_Stuttgart_Draht, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: return switch_RS_Stuttgart_current_year;
		1: spritegroup_RS_Stuttgart_load_Draht;}
		
	switch(FEAT_TRAINS, SELF, switch_loadstack_RS_Stuttgart_Pipe, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: return switch_RS_Stuttgart_current_year;
		1: spritegroup_RS_Stuttgart_load_Pipe;}
								
	switch(FEAT_TRAINS, SELF, switch_loadstack_RS_Stuttgart_Profile, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: return switch_RS_Stuttgart_current_year;
		1: spritegroup_RS_Stuttgart_load_Profile;}							
		
	switch(FEAT_TRAINS, SELF, switch_loadstack_RS_Stuttgart_Timber, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: return switch_RS_Stuttgart_current_year;
		1: spritegroup_RS_Stuttgart_load_Timber;}						
		
	switch(FEAT_TRAINS, SELF, switch_loadstack_RS_Stuttgart_Wood, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: return switch_RS_Stuttgart_current_year;
		1: spritegroup_RS_Stuttgart_load_Wood;}							

	switch(FEAT_TRAINS, SELF, switch_RS_Stuttgart_CC_Piece, hasbit(cargo_classes, CC_PIECE_GOODS)) {
			0: switch_loadstack_RS_Stuttgart_Box;
				switch_loadstack_RS_Stuttgart_Box;}		

	switch (FEAT_TRAINS, SELF, switch_RS_Stuttgart_cargo_type, cargo_type_in_veh) {

//FIRS-Cargos					
			STAL: return switch_loadstack_RS_Stuttgart_Barren;
			ALUM: return switch_loadstack_RS_Stuttgart_Barren;
			STCB: return switch_loadstack_RS_Stuttgart_Barren;
			STST: return switch_loadstack_RS_Stuttgart_Barren;
			STSH: return switch_loadstack_RS_Stuttgart_Barren;
			
			POWR: return switch_loadstack_RS_Stuttgart_Box;
			VENG: return switch_loadstack_RS_Stuttgart_Box;
			VPTS: return switch_loadstack_RS_Stuttgart_Box;
			GOOD: return switch_loadstack_RS_Stuttgart_Box;
			GLAS: return switch_loadstack_RS_Stuttgart_Box;
			
			ENSP: return switch_loadstack_RS_Stuttgart_ENSP;
			FMSP: return switch_loadstack_RS_Stuttgart_Farm;
			
			STWR: return switch_loadstack_RS_Stuttgart_Draht;
			
			STEL: return switch_loadstack_RS_Stuttgart_Profile;
			STSE: return switch_loadstack_RS_Stuttgart_Profile;
			
			PIPE: return switch_loadstack_RS_Stuttgart_Pipe;
			
			BDMT: return switch_loadstack_RS_Stuttgart_Timber;
			WDPR: return switch_loadstack_RS_Stuttgart_Timber;
			
			WOOD: return switch_loadstack_RS_Stuttgart_Wood;
			
//Other Cargoes
			MNSP: return switch_loadstack_RS_Stuttgart_Box;
			MPTS: return switch_loadstack_RS_Stuttgart_Box;
			PAPR: return switch_loadstack_RS_Stuttgart_Box;							
			
				switch_RS_Stuttgart_CC_Piece;}																																																																				

	switch(FEAT_TRAINS,PARENT,switch_running_cost_RS_Stuttgart, 1){
		return 160;}	
						
item (FEAT_TRAINS , ITEM_RS_STUTTGART, 8865)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_RS_STUTTGART);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1937,01,01);
						model_life: 					60;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes: 		bitmask(CC_PIECE_GOODS );
						non_refittable_cargo_classes: 	bitmask(CC_EXPRESS,	CC_ARMOURED, CC_BULK, CC_LIQUID, CC_REFRIGERATED, CC_COVERED, CC_POWDERIZED);
						cargo_allow_refit:              [STAL, ALUM, STCB, STST, STSH, POWR, VENG, VPTS, GOOD, GLAS, ENSP, FMSP, STWR, STEL, STSE, PIPE, BDMT, WDPR, WOOD, MNSP, MPTS, PAPR,];
						cargo_disallow_refit: 			[LVST, FOOD, WATR, BEER, BOOM, FISH, IRON, EOIL, FERT, FICR, FRVG, FRUT, VEHI, ACID, NH3_, CHLO, O2__, RFPR, CBLK, CMNT,  ];
						misc_flags: 					bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_SPRITE_STACK);
						loading_speed:					10;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							100 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						13 ton;
						dual_headed: 					0;
						default_cargo_type:				WOOD;
						cargo_capacity:					20;
						ai_engine_rank: 				0;
						length: 						8;
												
			}
			
	//Vehicels Graphics
			graphics
			{
			default							: switch_RS_Stuttgart_cargo_type;
			additional_text					: string(STR_DESC_GOODS);
			purchase						: switch_RS_Stuttgart_purchase;
			cost_factor						: 73;
			running_cost_factor				: switch_running_cost_RS_Stuttgart;
			colour_mapping					: switch_generic_recolour;
			 }
		}			
