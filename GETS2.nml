						switch(FEAT_TRAINS, SELF, switch_loadstack_4iPR23_BC_DB, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_4iPR23_DB_BC;
							1: spritegroup_4iPR23_CD_loading;}
							
