							2:     spriteset_empty;}		

						switch (FEAT_TRAINS, SELF, switch_articulated_BR_515_build, extra_callback_info1) {
							1 .. 2 : return ITEM_BR_515_BUILD; 
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}
																						
item (FEAT_TRAINS , ITEM_BR_515_BUILD, 3916)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_BR_515_BUILD);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
