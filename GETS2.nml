							0: spriteset_ET_87_back_DRG2;
							1: spritegroup_ET_87_back_loading;}		
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_ET_87_front_DB, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
