							0: spriteset_CI_1906_C_DB;
							1: spritegroup_CI_1906_C_loading;}								
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_CI_1906_CD_DB, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_CI_1906_CD_DB;
							1: spritegroup_CI_1906_BC_loading;}								
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_CI_1906_D_DB, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_CI_1906_D_DB;
							1: spritegroup_CI_1906_D_loading;}																																																

					switch (FEAT_TRAINS, SELF, random_choose_CI_1906_KPEV, switch_alternative_var_random_bits(1, 3)) {
							1: switch_spritestack_CI_1906_BC_KPEV;
							2: switch_spritestack_CI_1906_C_KPEV;
							3: switch_spritestack_CI_1906_C_KPEV;
							4: switch_spritestack_CI_1906_CD_KPEV;
							5: switch_spritestack_CI_1906_CD_KPEV;
							6: switch_spritestack_CI_1906_C_KPEV;
							7: switch_spritestack_CI_1906_D_KPEV;																										
								switch_spritestack_CI_1906_D_KPEV;}

					switch (FEAT_TRAINS, SELF, random_choose_CI_1906_DRG, switch_alternative_var_random_bits(1, 2)) {
							1: switch_spritestack_CI_1906_BC_DRG;
							2: switch_spritestack_CI_1906_C_DRG;	
							3: switch_spritestack_CI_1906_CD_DRG;								
								switch_spritestack_CI_1906_D_DRG;}

					switch (FEAT_TRAINS, SELF, random_choose_CI_1906_DB, switch_alternative_var_random_bits(1, 2)) {
							1: switch_spritestack_CI_1906_BC_DB;
							2: switch_spritestack_CI_1906_C_DB;	
							3: switch_spritestack_CI_1906_CD_DB;								
								switch_spritestack_CI_1906_D_DB;}
																
					switch(FEAT_TRAINS,PARENT,switch_running_cost_CI_1906, 1){
						return 1050;}								
								
					switch (FEAT_TRAINS,SELF,switch_current_year_CI_1906,current_year) {
							   0 .. 1919 : random_choose_CI_1906_KPEV;
							1920 .. 1945 : random_choose_CI_1906_DRG;
							1946 .. 2050 : random_choose_CI_1906_DB;
								random_choose_CI_1906_DB;}
						
					switch (FEAT_TRAINS,SELF,switch_build_year_CI_1906,build_year) {
							   0 .. 1919 : random_choose_CI_1906_KPEV;
							1920 .. 1945 : random_choose_CI_1906_DRG;
							1946 .. 2050 : random_choose_CI_1906_DB;
								random_choose_CI_1906_DB;}		
								
