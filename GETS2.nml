							 1946 .. 2050: switch_spritestack_E_70_2_purchase_DB_green;							 					 					 
								switch_spritestack_E_70_2_purchase_DB_green;}	
								
						switch (FEAT_TRAINS, SELF, switch_animation_E_70_2, motion_counter % 4) {
