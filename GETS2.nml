//Switches									
							
							
						switch (FEAT_TRAINS, SELF, switch_animation_BR_50, motion_counter % 4) {
							0: spriteset_BR_50_anim1;
							1: spriteset_BR_50_anim2;
							2: spriteset_BR_50_anim3;
							3: spriteset_BR_50_anim4;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_50_purchase1, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_50_purchase1;
							1: spriteset_BR_50_purchase_anim;}								
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_50_purchase2, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_50_purchase2;
							1: spriteset_BR_50_purchase_anim;}	
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_50_purchase3, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_50_purchase3;
							1: spriteset_BR_50_purchase_anim;}							

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_50_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_50_DRG;
							1: return switch_animation_BR_50;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_50_DB_Wagner, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_50_DB_Wagner;
							1: return switch_animation_BR_50;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_50_DB_Witte, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_50_DB_Witte;
							1: return switch_animation_BR_50;}
							
						switch (FEAT_TRAINS,SELF, switch_BR_50_purchase,current_year){
							    0 .. 1945: switch_spritestack_BR_50_purchase1;
							 1946 .. 1987: switch_spritestack_BR_50_purchase2;						 					 
								switch_spritestack_BR_50_purchase2;}

					switch (FEAT_TRAINS, SELF, random_choose_BR_50, switch_alternative_var_random_bits(1, 1)) {
							1: switch_spritestack_BR_50_DB_Wagner;
								switch_spritestack_BR_50_DB_Witte;}
								
					switch (FEAT_TRAINS, SELF, random_choose_BR_50_Tender, switch_alternative_var_random_bits(1, 1)) {
							1: spriteset_Tender_22T26_DB;
								spriteset_Tender_22T26_KAB;}
								
						switch (FEAT_TRAINS,SELF, switch_BR_50_build_year,build_year){
							    0 .. 1945: switch_spritestack_BR_50_DRG;
							 1946 .. 1958: random_choose_BR_50;
							 1959 .. 2100: switch_spritestack_BR_50_DB_Witte;						 					 
								switch_spritestack_BR_50_DB_Witte;}
		
						switch (FEAT_TRAINS,SELF, switch_BR_50_current_year,current_year){
							    0 .. 1945: switch_spritestack_BR_50_DRG;
							 1946 .. 1958: random_choose_BR_50;
							 1959 .. 2100: switch_spritestack_BR_50_DB_Witte;						 					 
								switch_spritestack_BR_50_DB_Witte;}
								
						switch (FEAT_TRAINS,SELF, switch_BR_50_Tender_build_year,build_year){
							 1920 .. 1945: spriteset_Tender_22T26_DRG;
							 1946 .. 1958: spriteset_Tender_22T26_DB;
							 1959 .. 2100: random_choose_BR_50_Tender;						 					 
								random_choose_BR_50_Tender;}
		
						switch (FEAT_TRAINS,SELF, switch_BR_50_Tender_current_year,current_year){
							    0 .. 1945: spriteset_Tender_22T26_DRG;
							 1946 .. 1958: spriteset_Tender_22T26_DB;
							 1959 .. 2100: random_choose_BR_50_Tender;						 					 
								random_choose_BR_50_Tender;}

						switch(FEAT_TRAINS, SELF, switch_length_BR_50, position_in_vehid_chain % 3) {
							0: 4;
							1: 6;
							2: 6;}
						
						switch(FEAT_TRAINS, SELF, switch_FX_BR_50, position_in_vehid_chain % 3) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_STEAM, -2, DISABLE_WAGON_POWER);
								return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}
						
						switch (FEAT_TRAINS, PARENT, switch_running_cost_BR_50, 1) {
							return 1750;}
							
						switch(FEAT_TRAINS, SELF, switch_BR_50_graphics_build, position_in_vehid_chain % 3) {
							0:	   spriteset_empty;
							1:     return switch_BR_50_build_year;
							2:     return switch_BR_50_Tender_build_year;}	
							
						switch (FEAT_TRAINS, SELF, switch_articulated_BR_50_build, extra_callback_info1) {
							1: return ITEM_BR_50; 
							2: return ITEM_BR_50; 															
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS; }														

