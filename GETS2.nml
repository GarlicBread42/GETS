			cargo_capacity	                :return 0 ;
			purchase						:switch_BR_143_purchase;
			cost_factor						:100;
			running_cost_factor				:switch_running_cost_BR_143;
			visual_effect_and_powered		:switch_FX_BR_143;	
			}
	}	


