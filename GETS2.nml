							1:     return switch_loadstack_DOSTO_2GEN_DVT_VVO;
							2:     spriteset_empty;}													

						switch (FEAT_TRAINS, SELF, switch_articulated_DOSTO_2GEN_DVT_VVO, extra_callback_info1) {
