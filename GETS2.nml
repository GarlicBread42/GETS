							0: spriteset_UICX_HSW_ozeanblau;
							1: spritegroup_UICX_loading_1;}																						

						switch (FEAT_TRAINS, SELF, random_choose_UICX_HSW_full, switch_alternative_var_random_bits(1, 1)) {
							1: switch_spritestack_UICX_HSW_blau;
							   switch_spritestack_UICX_HSW_gruen;}	
							   
						switch (FEAT_TRAINS, SELF, random_choose_UICX_HSW_half, switch_alternative_var_random_bits(1, 1)) {
