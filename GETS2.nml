		spriteset (spriteset_Cont20_center2_Era2_Dry_Var6, "gfx\Cont/Cont20_center2_Era2_Dry_Var6_1x_8bpp.png")
					{template_98trains_1x(0, 0)}	
				
		alternative_sprites (spriteset_Cont20_center2_Era2_Dry_Var6, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\Cont/Cont20_center2_Era2_Dry_Var6_1x_32bpp.png", "gfx\Cont/Cont20_center2_Era2_Dry_Var6_1x_mask.png")
					{template_98trains_1x(0, 0)}	
				
		alternative_sprites (spriteset_Cont20_center2_Era2_Dry_Var6, ZOOM_LEVEL_IN_2X, BIT_DEPTH_32BPP, "gfx\Cont/Cont20_center2_Era2_Dry_Var6_2x_32bpp.png", "gfx\Cont/Cont20_center2_Era2_Dry_Var6_2x_mask.png")
					{template_98trains_2x(0, 0)}					
			
		alternative_sprites (spriteset_Cont20_center2_Era2_Dry_Var6, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP, "gfx\Cont/Cont20_center2_Era2_Dry_Var6_4x_32bpp.png", "gfx\Cont/Cont20_center2_Era2_Dry_Var6_4x_mask.png")
					{template_98trains_4x(0, 0)}
					
spritegroup spritegroup_Cont20_center2_Era2_Dry_Var6
		{loaded: 	[spriteset_empty, spriteset_empty, spriteset_Cont20_center2_Era2_Dry_Var6];
			loading: 	[spriteset_empty, spriteset_empty, spriteset_Cont20_center2_Era2_Dry_Var6];}					

					random_switch(FEAT_TRAINS, SELF, random_Cont20_center1_Era1_Dry_loadstage, bitmask(TRIGGER_VEHICLE_UNLOAD_ALL, TRIGGER_VEHICLE_NEW_LOAD,)) {
							independent: random_Cont40_center_Era1_Dry_loadstage;
							independent: random_Cont40_center_Era2_Dry_loadstage;
							2: spritegroup_Cont20_center1_Era1_Dry_Var1;
							2: spritegroup_Cont20_center1_Era1_Dry_Var2;
							1: spritegroup_Cont20_center1_Era1_Dry_Var3;
							3: spritegroup_Cont20_center1_Era1_Dry_Var4;
							1: spritegroup_Cont20_center1_Era1_Dry_Var5;
							1: spritegroup_Cont20_center1_Era1_Dry_Var6;}
					
					random_switch(FEAT_TRAINS, SELF, random_Cont20_center1_Era2_Dry_loadstage, bitmask(TRIGGER_VEHICLE_UNLOAD_ALL, TRIGGER_VEHICLE_NEW_LOAD,)) {
							independent: random_Cont40_center_Era1_Dry_loadstage;
							independent: random_Cont40_center_Era2_Dry_loadstage;
							1: spritegroup_Cont20_center1_Era2_Dry_Var1;
							2: spritegroup_Cont20_center1_Era2_Dry_Var2;
							1: spritegroup_Cont20_center1_Era2_Dry_Var3;
							2: spritegroup_Cont20_center1_Era2_Dry_Var4;
							1: spritegroup_Cont20_center1_Era2_Dry_Var5;
							2: spritegroup_Cont20_center1_Era2_Dry_Var6;}	
							
					random_switch(FEAT_TRAINS, SELF, random_Cont20_center2_Era1_Dry_loadstage, bitmask(TRIGGER_VEHICLE_UNLOAD_ALL, TRIGGER_VEHICLE_NEW_LOAD,)) {
							independent: random_Cont40_center_Era1_Dry_loadstage;
							independent: random_Cont40_center_Era2_Dry_loadstage;
							2: spritegroup_Cont20_center2_Era1_Dry_Var1;
							1: spritegroup_Cont20_center2_Era1_Dry_Var2;
							3: spritegroup_Cont20_center2_Era1_Dry_Var3;
							2: spritegroup_Cont20_center2_Era1_Dry_Var4;
							1: spritegroup_Cont20_center2_Era1_Dry_Var5;
							3: spritegroup_Cont20_center2_Era1_Dry_Var6;}
					
					random_switch(FEAT_TRAINS, SELF, random_Cont20_center2_Era2_Dry_loadstage, bitmask(TRIGGER_VEHICLE_UNLOAD_ALL, TRIGGER_VEHICLE_NEW_LOAD,)) {
							independent: random_Cont40_center_Era1_Dry_loadstage;
							independent: random_Cont40_center_Era2_Dry_loadstage;
							1: spritegroup_Cont20_center2_Era2_Dry_Var1;
							2: spritegroup_Cont20_center2_Era2_Dry_Var2;
							1: spritegroup_Cont20_center2_Era2_Dry_Var3;
							3: spritegroup_Cont20_center2_Era2_Dry_Var4;
							1: spritegroup_Cont20_center2_Era2_Dry_Var5;
							2: spritegroup_Cont20_center2_Era2_Dry_Var6;}									
														
					switch (FEAT_TRAINS,SELF,switch_Cont20_center1_Dry_loadstage_current_year,current_year) {
							  00 .. 1993 : random_Cont20_center1_Era1_Dry_loadstage;
							1994 .. 2050 : random_Cont20_center1_Era2_Dry_loadstage;
							random_Cont20_center1_Era2_Dry_loadstage;}
							
					switch (FEAT_TRAINS,SELF,switch_Cont20_center2_Dry_loadstage_current_year,current_year) {
							  00 .. 1993 : random_Cont20_center2_Era1_Dry_loadstage;
							1994 .. 2050 : random_Cont20_center2_Era2_Dry_loadstage;
							random_Cont20_center2_Era2_Dry_loadstage;}
