		alternative_sprites (spriteset_IC2_DVT_LOCO, ZOOM_LEVEL_IN_2X, BIT_DEPTH_32BPP, "gfx\IC2\IC2_DVT_LOCO_2x_32bpp.png", "gfx\IC2\IC2_DVT_LOCO_2x_mask.png")
					{template_158trains_2x(0,0)}				
