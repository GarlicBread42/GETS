	alternative_sprites (spriteset_BR_460_front_ODEG_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BR_460/BR_460_front_ODEG_1x_32bpp.png", "gfx/BR_460/BR_460_front_ODEG_1x_mask.png")
									{template_purchase(0, 0)}									
									
//Switches
	
							
						switch(FEAT_TRAINS, SELF, switch_loadstack_BR_460_front_ODEG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_460_front_ODEG;
							1: spritegroup_BR_460_front_ODEG_loading;
							2: spriteset_BR_460_front_lights_front;}								

						switch(FEAT_TRAINS, SELF, switch_loadstack_BR_460_front_ODEG_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_460_front_ODEG_REV;
							1: spritegroup_BR_460_front_ODEG_loading_REV;
							2: spriteset_BR_460_front_lights_back_REV;}																

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_460_middle_ODEG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_460_middle_ODEG;
							1: spritegroup_BR_460_middle_ODEG_loading;}	

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_460_middle_ODEG_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_460_middle_ODEG_REV;
							1: spritegroup_BR_460_middle_ODEG_loading_REV;}

						switch(FEAT_TRAINS, SELF, switch_loadstack_BR_460_back_ODEG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_460_back_ODEG;
							1: spritegroup_BR_460_back_ODEG_loading;
							2: spriteset_BR_460_back_lights_back;}								

						switch(FEAT_TRAINS, SELF, switch_loadstack_BR_460_back_ODEG_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_460_back_ODEG_REV;
							1: spritegroup_BR_460_back_ODEG_loading_REV;
							2: spriteset_BR_460_back_lights_front_REV;}

						switch(FEAT_TRAINS, SELF, switch_length_BR_460_3, position_in_vehid_chain % 9) {
							0: 4;
							1: 6;
							2: 4;
							3: 4;
							4: 7;
							5: 4;
							6: 4;
							7: 6;
							8: 4;}	
							
						switch(FEAT_TRAINS, SELF, switch_FX_BR_460_3_NONREV, position_in_vehid_chain % 9) {
								0: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE,0, DISABLE_WAGON_POWER);
								1: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
								2: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC,-2, DISABLE_WAGON_POWER);	
					       3 .. 8: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}							

						switch(FEAT_TRAINS, SELF, switch_FX_BR_460_3_REV, position_in_vehid_chain % 9) {
						   0 .. 5: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE,0, DISABLE_WAGON_POWER);
								6: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC,-2, DISABLE_WAGON_POWER);
								7: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);	
							    8: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}
							
						switch (FEAT_TRAINS, PARENT, switch_FX_BR_460_3, vehicle_is_reversed) {
							0: switch_FX_BR_460_3_NONREV;
								switch_FX_BR_460_3_REV;}
								
						switch(FEAT_TRAINS,PARENT,switch_running_cost_BR_460_3, 1){
							return 2650;}
							
						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_460_front_ODEG, vehicle_is_reversed) {
							0: switch_loadstack_BR_460_front_ODEG;
								switch_loadstack_BR_460_back_ODEG_REV;}																

						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_460_middle_ODEG, vehicle_is_reversed) {
							0: switch_spritestack_BR_460_middle_ODEG;
								switch_spritestack_BR_460_middle_ODEG_REV;}
								
						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_460_back_ODEG, vehicle_is_reversed) {
							0: switch_loadstack_BR_460_back_ODEG;
								switch_loadstack_BR_460_front_ODEG_REV;}								

						switch(FEAT_TRAINS, SELF, switch_graphics_BR_460_3_ODEG, position_in_vehid_chain % 9) {
							0:	   spriteset_empty;
							1:     return switch_reverse_BR_460_front_ODEG;
							2:     spriteset_empty;
							3:	   spriteset_empty;
							4:	   return switch_reverse_BR_460_middle_ODEG;
							5:	   spriteset_empty;
							6:	   spriteset_empty;
							7:	   return switch_reverse_BR_460_back_ODEG;
							8:	   spriteset_empty;}
						   
						switch (FEAT_TRAINS, SELF, switch_articulated_BR_460_3_ODEG, extra_callback_info1) {
							1 .. 8: return ITEM_BR_460_3_ODEG; 
							return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}


item (FEAT_TRAINS , ITEM_BR_460_3_ODEG, 4600)
