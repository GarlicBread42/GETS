							1987 .. 2050: spriteset_BR_103_2_purchase2;					 					 
								spriteset_BR_103_2_purchase2;}

						 switch (FEAT_TRAINS,SELF, switch_BR_103_2_current_year,current_year){
							1960 .. 1986: spriteset_BR_103_2_TEE;
							1987 .. 2050: spriteset_BR_103_2_orientrot;					 					 
