							1: switch_loadstack_UICX_A_Regio;
							   switch_loadstack_UICX_B_Regio;}											

						switch (FEAT_TRAINS, SELF, random_choose_UICX_FLIX, switch_alternative_var_random_bits(1, 1)) {
							1: switch_loadstack_UICX_B_FLIX1;
							   switch_loadstack_UICX_B_FLIX2;}																		

						switch (FEAT_TRAINS,SELF,switch_build_year_UICX,build_year) {
							  00 .. 1974 : random_choose_UICX_era1;
							1975 .. 1987 : random_choose_UICX_oceanblau;
							1988 .. 1995 : random_choose_UICX_interregio;
							1996 .. 2050 : random_choose_UICX_intercity;
								random_choose_UICX_intercity;}
						
						switch (FEAT_TRAINS,SELF,switch_current_year_UICX,current_year) {
							  00 .. 1974 : random_choose_UICX_era1;
							1975 .. 1987 : random_choose_UICX_oceanblau;
							1988 .. 1995 : random_choose_UICX_interregio;
							1996 .. 2050 : random_choose_UICX_intercity;
								random_choose_UICX_intercity;}			
													
						switch(FEAT_TRAINS, SELF, switch_length_UICX, position_in_articulated_veh % 3) {
							0: 4;
							1: 7;
							2: 4;}

						switch(FEAT_TRAINS, SELF, switch_speed_UICX, current_year) {
							00 .. 1963 : 140 ;
							1964 .. 1987 : 160 ;
							1988 .. 2050 : 200 ;
								200;}
						
						switch (FEAT_TRAINS, PARENT, switch_running_cost_UICX,  switch_check_Restaurant_0()) {
							1: return 0;
							0: return 2250;}	
							
						switch (FEAT_TRAINS, PARENT, switch_cargo_aging_UICX,  switch_check_Restaurant_0()) {
							1: return 233;
							0: return 185;}								
								
						switch(FEAT_TRAINS, SELF, switch_UICX_graphics_build, position_in_articulated_veh  % 3) {
							0:     spriteset_empty;
							1:     return switch_build_year_UICX;
							2:     spriteset_empty;}	
								
						switch (FEAT_TRAINS, SELF, switch_articulated_UICX_build, extra_callback_info1) {
							1 .. 2: return ITEM_UICX_BUILD;
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}
																					
