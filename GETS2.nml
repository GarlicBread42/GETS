					{template_purchase(0, 0)}	
		alternative_sprites (spriteset_Eaos_106_purchase_Graffiti, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\Eaos_106/Eaos_106_Graffiti1_1x_32bpp.png", "gfx\Eaos_106/Eaos_106_Graffiti1_1x_mask.png")
					{template_purchase(0, 0)}	
					


//Switches

	switch (FEAT_TRAINS,SELF, switch_Eaos_106_purchase,current_year){
		1800 .. 1997: spriteset_Eaos_106_purchase_brown;
		1998 .. 2050: spriteset_Eaos_106_purchase_DB;
			spriteset_Eaos_106_purchase_DB;}

	switch (FEAT_TRAINS, SELF, random_choose_Eaos_106_old, switch_alternative_var_random_bits(1, 1)) {
			1: spriteset_Eaos_106_brown1;
				spriteset_Eaos_106_brown2;}
				
	switch (FEAT_TRAINS, SELF, random_choose_Eaos_106_new, switch_alternative_var_random_bits(1, 3)) {
			1: spriteset_Eaos_106_brown1;
			2: spriteset_Eaos_106_DB1;
			3: spriteset_Eaos_106_brown2;
			4: spriteset_Eaos_106_DB2;																					
			5: spriteset_Eaos_106_Graffiti1;
			6: spriteset_Eaos_106_DB3;
			7: spriteset_Eaos_106_DB2;	
				spriteset_Eaos_106_brown1;}	
				
	switch (FEAT_TRAINS, SELF, random_choose_Eaos_106_DB, switch_alternative_var_random_bits(1, 2)) {
			1: spriteset_Eaos_106_DB1;
			2: spriteset_Eaos_106_DB2;
			3: spriteset_Eaos_106_DB3;														
				spriteset_Eaos_106_DB1;}								

	switch (FEAT_TRAINS, SELF, random_choose_Eaos_106_Graffiti, switch_alternative_var_random_bits(1, 1)) {
			1: spriteset_Eaos_106_Graffiti1;
				spriteset_Eaos_106_Graffiti1;}
				

	switch (FEAT_TRAINS,SELF, switch_Eaos_106_current_year,current_year){
			0 .. 1997: random_choose_Eaos_106_old;
		1998 .. 2050: random_choose_Eaos_106_new;
			random_choose_Eaos_106_new;}	

//Stacking + Loading Current Year
						
	switch(FEAT_TRAINS, SELF, switch_loadstack_Eaos_106_Barren, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: return switch_Eaos_106_current_year;
		1: spritegroup_Eaos_106_load_Barren;}																	

	switch(FEAT_TRAINS, SELF, switch_loadstack_Eaos_106_Box, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: return switch_Eaos_106_current_year;
		1: spritegroup_Eaos_106_load_Box;}

	switch(FEAT_TRAINS, SELF, switch_loadstack_Eaos_106_Bulk, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: return switch_Eaos_106_current_year;
		1: spritegroup_Eaos_106_load_Bulk;}

	switch(FEAT_TRAINS, SELF, switch_loadstack_Eaos_106_Bulk_covered, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: return switch_Eaos_106_current_year;
		1: spritegroup_Eaos_106_load_Bulk_covered;}
		
	switch(FEAT_TRAINS, SELF, switch_loadstack_Eaos_106_COPR, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: return switch_Eaos_106_current_year;
		1: spritegroup_Eaos_106_load_COPR;}						
		
	switch(FEAT_TRAINS, SELF, switch_loadstack_Eaos_106_Rohr, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: return switch_Eaos_106_current_year;
		1: spritegroup_Eaos_106_load_Rohr;}						
		
	switch(FEAT_TRAINS, SELF, switch_loadstack_Eaos_106_Timber, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: return switch_Eaos_106_current_year;
		1: spritegroup_Eaos_106_load_Timber;}
		
	switch(FEAT_TRAINS, SELF, switch_loadstack_Eaos_106_Wood, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: return switch_Eaos_106_current_year;
		1: spritegroup_Eaos_106_load_Wood;}					

	switch(FEAT_TRAINS, SELF, switch_Eaos_106_CC_Piece, hasbit(cargo_classes, CC_PIECE_GOODS)) {
			0: switch_loadstack_Eaos_106_Box;
				switch_loadstack_Eaos_106_Box;}		

	switch(FEAT_TRAINS, SELF, switch_Eaos_106_CC_Bulk, hasbit(cargo_classes, CC_BULK)) {
		0: switch_Eaos_106_CC_Piece;
			switch_loadstack_Eaos_106_Bulk;}

	switch(FEAT_TRAINS, SELF, switch_Eaos_106_CC_Bulk_Covered, hasbit(cargo_classes, CC_COVERED)) {
		0: switch_Eaos_106_CC_Bulk;
			switch_loadstack_Eaos_106_Bulk_covered;}

	switch (FEAT_TRAINS, SELF, switch_Eaos_106_cargo_type, cargo_type_in_veh) {
			STEL: return switch_loadstack_Eaos_106_Barren;
			METL: return switch_loadstack_Eaos_106_Rohr;
			ZINC: return switch_loadstack_Eaos_106_Rohr;
			COPR: return switch_loadstack_Eaos_106_COPR;
			STST: return switch_loadstack_Eaos_106_Barren;
			STSH: return switch_loadstack_Eaos_106_Barren;
			STSE: return switch_loadstack_Eaos_106_Barren;
			STAL: return switch_loadstack_Eaos_106_Barren;
			STCB: return switch_loadstack_Eaos_106_Rohr;
			STWR: return switch_loadstack_Eaos_106_Rohr; 
			CSTI: return switch_loadstack_Eaos_106_Rohr;
			PIPE: return switch_loadstack_Eaos_106_Rohr;

			ENSP: return switch_loadstack_Eaos_106_Box;
			FMSP: return switch_loadstack_Eaos_106_Box;
			MNSP: return switch_loadstack_Eaos_106_Box;
			POWR: return switch_loadstack_Eaos_106_Box;
			VPTS: return switch_loadstack_Eaos_106_Box;
			MPTS: return switch_loadstack_Eaos_106_Box;
			GOOD: return switch_loadstack_Eaos_106_Box;
			PAPR: return switch_loadstack_Eaos_106_Box;
			TYRE: return switch_loadstack_Eaos_106_Box;
			WOOL: return switch_loadstack_Eaos_106_Box;
			TEXT: return switch_loadstack_Eaos_106_Box;	
			SEED: return switch_loadstack_Eaos_106_Box;	
			FERT: return switch_loadstack_Eaos_106_Box;

			FRVG: return switch_loadstack_Eaos_106_Bulk_covered;
			TATO: return switch_loadstack_Eaos_106_Bulk_covered;
			FRUT: return switch_loadstack_Eaos_106_Bulk_covered;
			CERE: return switch_loadstack_Eaos_106_Bulk_covered;
			FICR: return switch_loadstack_Eaos_106_Bulk_covered;
			OLSD: return switch_loadstack_Eaos_106_Bulk_covered;
			QLME: return switch_loadstack_Eaos_106_Bulk;
			MNO2: return switch_loadstack_Eaos_106_Bulk;

			BDMT: return switch_loadstack_Eaos_106_Timber;
			WDPR: return switch_loadstack_Eaos_106_Timber;
			WOOD: return switch_loadstack_Eaos_106_Wood;
			GLAS: return switch_loadstack_Eaos_106_Box;
			BRCK: return switch_loadstack_Eaos_106_Box;
				switch_Eaos_106_CC_Bulk_Covered;}					

//Stacking + Loading Old Liveries
						
	switch(FEAT_TRAINS, SELF, switch_loadstack_Eaos_106_old_Barren, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: return random_choose_Eaos_106_old;
		1: spritegroup_Eaos_106_load_Barren;}																	

	switch(FEAT_TRAINS, SELF, switch_loadstack_Eaos_106_old_Box, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: return random_choose_Eaos_106_old;
		1: spritegroup_Eaos_106_load_Box;}

	switch(FEAT_TRAINS, SELF, switch_loadstack_Eaos_106_old_Bulk, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: return random_choose_Eaos_106_old;
		1: spritegroup_Eaos_106_load_Bulk;}

	switch(FEAT_TRAINS, SELF, switch_loadstack_Eaos_106_old_Bulk_covered, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: return random_choose_Eaos_106_old;
		1: spritegroup_Eaos_106_load_Bulk_covered;}
		
	switch(FEAT_TRAINS, SELF, switch_loadstack_Eaos_106_old_COPR, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: return random_choose_Eaos_106_old;
		1: spritegroup_Eaos_106_load_COPR;}						
		
	switch(FEAT_TRAINS, SELF, switch_loadstack_Eaos_106_old_Rohr, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: return random_choose_Eaos_106_old;
		1: spritegroup_Eaos_106_load_Rohr;}						
		
	switch(FEAT_TRAINS, SELF, switch_loadstack_Eaos_106_old_Timber, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: return random_choose_Eaos_106_old;
		1: spritegroup_Eaos_106_load_Timber;}
		
	switch(FEAT_TRAINS, SELF, switch_loadstack_Eaos_106_old_Wood, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: return random_choose_Eaos_106_old;
		1: spritegroup_Eaos_106_load_Wood;}

	switch(FEAT_TRAINS, SELF, switch_Eaos_106_old_CC_Piece, hasbit(cargo_classes, CC_PIECE_GOODS)) {
			0: switch_loadstack_Eaos_106_old_Box;
				switch_loadstack_Eaos_106_old_Box;}		

