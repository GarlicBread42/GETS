							0: spriteset_BR_89_70_purchase_DB;
							1: spriteset_BR_89_70_purchase_anim;}							
	
						switch (FEAT_TRAINS,SELF, switch_BR_89_70_purchase,current_year){
							   0 .. 1919: switch_spritestack_BR_89_70_purchase_KPEV;
							1920 .. 1945: switch_spritestack_BR_89_70_purchase_DRG;
							1946 .. 2050: switch_spritestack_BR_89_70_purchase_DB;															 					 
								switch_spritestack_BR_89_70_purchase_DB;}																					
							
						switch (FEAT_TRAINS, SELF, switch_animation_BR_89_70, motion_counter % 4) {
								0: spriteset_BR_89_70_anim1;
								1: spriteset_BR_89_70_anim2;
								2: spriteset_BR_89_70_anim3;
								3: spriteset_BR_89_70_anim4;}

						switch (FEAT_TRAINS, SELF, switch_animation_BR_89_70_REV, motion_counter % 4) {
								0: spriteset_BR_89_70_anim1_REV;
								1: spriteset_BR_89_70_anim2_REV;
								2: spriteset_BR_89_70_anim3_REV;
								3: spriteset_BR_89_70_anim4_REV;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_89_70_KPEV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_89_70_KPEV;
							1: return switch_animation_BR_89_70;}									

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_89_70_KPEV_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_89_70_KPEV_REV;
							1: return switch_animation_BR_89_70_REV;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_89_70_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_89_70_DRG;
							1: return switch_animation_BR_89_70;}									

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_89_70_DRG_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_89_70_DRG_REV;
							1: return switch_animation_BR_89_70_REV;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_89_70_DB, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_89_70_DB;
							1: return switch_animation_BR_89_70;}									

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_89_70_DB_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_89_70_DB_REV;
							1: return switch_animation_BR_89_70_REV;}
							
						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_89_70_KPEV, vehicle_is_reversed) {
							0: switch_spritestack_BR_89_70_KPEV;
								switch_spritestack_BR_89_70_KPEV_REV;}

						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_89_70_DRG, vehicle_is_reversed) {
							0: switch_spritestack_BR_89_70_DRG;
								switch_spritestack_BR_89_70_DRG_REV;}

						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_89_70_DB, vehicle_is_reversed) {
							0: switch_spritestack_BR_89_70_DB;
								switch_spritestack_BR_89_70_DB_REV;}							

						switch (FEAT_TRAINS,SELF, switch_BR_89_70_build_year,build_year){
							  00 .. 1919: switch_reverse_BR_89_70_KPEV;
							1920 .. 1945: switch_reverse_BR_89_70_DRG;
							1946 .. 1990: switch_reverse_BR_89_70_DB;						 					 
								switch_reverse_BR_89_70_DB;}
							
						switch (FEAT_TRAINS,SELF, switch_BR_89_70_current_year,current_year){
							  00 .. 1919: switch_reverse_BR_89_70_KPEV;
							1920 .. 1945: switch_reverse_BR_89_70_DRG;
							1946 .. 1990: switch_reverse_BR_89_70_DB;						 					 
								switch_reverse_BR_89_70_DB;}
								
						switch(FEAT_TRAINS, PARENT, switch_FX_BR_89_70, vehicle_is_reversed) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_STEAM, -2, DISABLE_WAGON_POWER);
								return visual_effect_and_powered(VISUAL_EFFECT_STEAM, 2, DISABLE_WAGON_POWER);}																
								
						switch(FEAT_TRAINS,PARENT,switch_running_cost_BR_89_70, 1){
						return 225;}
						
