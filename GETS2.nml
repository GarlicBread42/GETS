spriteset (spriteset_PR99_PW_purchase3, "gfx/KPEV_PR99_PW/PR99_PW_DB_1x_8bpp.png")
						{template_purchase(0, 0)}
				
		alternative_sprites (spriteset_PR99_PW_purchase3, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/KPEV_PR99_PW/PR99_PW_DB_1x_32bpp.png", "gfx/KPEV_PR99_PW/PR99_PW_DB_1x_mask.png")
						{template_purchase(0, 0)}	
						
//Switches					

					switch (FEAT_TRAINS,SELF,switch_purchase_PR99_PW,current_year) {
						   0 .. 1919 : spriteset_PR99_PW_purchase1;
						1920 .. 1945 : spriteset_PR99_PW_purchase2;
						1946 .. 2050 : spriteset_PR99_PW_purchase3;
							spriteset_PR99_PW_purchase3;}
						
					switch (FEAT_TRAINS,SELF,switch_build_year_PR99_PW,build_year) {
						   0 .. 1919 : spritegroup_PR99_PW_KPEV;
						1920 .. 1945 : spritegroup_PR99_PW_DRG;
						1946 .. 2050 : spritegroup_PR99_PW_DB;
							spritegroup_PR99_PW_DB;}

					switch (FEAT_TRAINS,SELF,switch_current_year_PR99_PW,current_year) {
						   0 .. 1919 : spritegroup_PR99_PW_KPEV;
						1920 .. 1945 : spritegroup_PR99_PW_DRG;
						1946 .. 2050 : spritegroup_PR99_PW_DB;
							spritegroup_PR99_PW_DB;}					

					switch(FEAT_TRAINS,PARENT,switch_running_cost_PR99_PW, 1){
						return 870;}																																


