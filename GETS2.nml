								spritegroup_V23_Altona_DB_MBH;}	
								
					switch (FEAT_TRAINS,SELF,switch_graphics_V23_Altona,current_year) {
							1800 .. 1945 : random_choose_V23_Altona_DRG;
							1946 .. 2050 : random_choose_V23_Altona_DB;
							random_choose_V23_Altona_DRG;}															

					switch(FEAT_TRAINS,PARENT,switch_running_cost_V23_Altona, 1){
							return 95;}	
							
					switch (FEAT_TRAINS, PARENT, switch_speed_V23_Altona,  switch_check_PWG_0()) {
						1: return 80;
						0: return 65;}							

