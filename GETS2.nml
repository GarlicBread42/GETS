//Spritesets Purchase

spriteset(spriteset_BR_614_purchase1, "gfx\BR_614/BR_614_front_popfarben_1x_8bpp.png")
									{ template_purchase(0, 0)}
				
		alternative_sprites (spriteset_BR_614_purchase1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\BR_614/BR_614_front_popfarben_1x_32bpp.png", "gfx\BR_614/BR_614_front_popfarben_1x_mask.png")
