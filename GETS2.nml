						switch (FEAT_TRAINS, SELF, switch_purchase_BR_515, current_year){
							1900 .. 1974 : spriteset_BR_515_altrot_purchase;
							1975 .. 1992 : spriteset_BR_515_ozeanblau_purchase;
							1993 .. 2100 : spriteset_BR_515_Nokia_purchase;													
							spriteset_BR_515_Nokia_purchase;}	
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_515_altrot, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_515_altrot;
							1: spritegroup_BR_515_loading;}	
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_515_ozeanblau, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
