//Spritesets purchase


spriteset (spriteset_Tehs_50_neutral_purchase, "gfx\Tehs_50/Tehs_50_NEUT1_1x_8bpp.png")
					{template_purchase(0, 0)}	
				
		alternative_sprites (spriteset_Tehs_50_neutral_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\Tehs_50/Tehs_50_NEUT1_1x_32bpp.png", "gfx\Tehs_50/Tehs_50_NEUT1_1x_mask.png")
					{template_purchase(0, 0)}

spriteset (spriteset_Tehs_50_Transthermos_purchase, "gfx\Tehs_50/Tehs_50_Transthermos1_1x_8bpp.png")
					{template_purchase(0, 0)}	
				
		alternative_sprites (spriteset_Tehs_50_Transthermos_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\Tehs_50/Tehs_50_Transthermos1_1x_32bpp.png", "gfx\Tehs_50/Tehs_50_Transthermos1_1x_mask.png")
					{template_purchase(0, 0)}
					

//Switches

						switch(FEAT_TRAINS, SELF, switch_loadstack_Tehs_50_NEUT1, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_Tehs_50_neutral1;
							1: spritegroup_Tehs_50_loading;}

						switch(FEAT_TRAINS, SELF, switch_loadstack_Tehs_50_NEUT2, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_Tehs_50_neutral2;
							1: spritegroup_Tehs_50_loading;}

						switch(FEAT_TRAINS, SELF, switch_loadstack_Tehs_50_Transthermos1, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_Tehs_50_Transthermos1;
							1: spritegroup_Tehs_50_loading;}

						switch(FEAT_TRAINS, SELF, switch_loadstack_Tehs_50_Transthermos2, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_Tehs_50_Transthermos2;
							1: spritegroup_Tehs_50_loading;}

						switch (FEAT_TRAINS, SELF, random_choose_Tehs_50_ALL, switch_alternative_var_random_bits(1, 2)) {
							0: switch_loadstack_Tehs_50_NEUT1;
							1: switch_loadstack_Tehs_50_NEUT2;
							2: switch_loadstack_Tehs_50_Transthermos1;
								switch_loadstack_Tehs_50_Transthermos2;}												

					switch (FEAT_TRAINS, SELF, random_choose_Tehs_50_NEUT, switch_alternative_var_random_bits(1, 1)) {
							1: switch_loadstack_Tehs_50_NEUT1;
								switch_loadstack_Tehs_50_NEUT2;}

					switch (FEAT_TRAINS, SELF, random_choose_Tehs_50_Transthermos, switch_alternative_var_random_bits(1, 1)) {
							1: switch_loadstack_Tehs_50_Transthermos1;
								switch_loadstack_Tehs_50_Transthermos2;}

					switch(FEAT_TRAINS,PARENT,switch_running_cost_Tehs_50, 1){
						return 150;}

