	alternative_sprites (spriteset_BR_57_4_purchase_anim, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BR_57_4/BR_57_4_anim1_1x_32bpp.png", "gfx/BR_57_4/BR_57_4_anim1_1x_mask.png")
									{ template_purchase(0, 0)}
									
																		
//Switches	

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_57_4_purchase1, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_57_4_purchase1;
							1: spriteset_BR_57_4_purchase_anim;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_57_4_purchase2, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_57_4_purchase2;
							1: spriteset_BR_57_4_purchase_anim;}

						switch (FEAT_TRAINS,SELF, switch_BR_57_4_purchase,current_year){
							   0 .. 1919: switch_spritestack_BR_57_4_purchase1;
							1920 .. 2050: switch_spritestack_BR_57_4_purchase2;	
							switch_spritestack_BR_57_4_purchase2;}								
							
						switch (FEAT_TRAINS, SELF, switch_animation_BR_57_4, motion_counter % 4) {
							0: spriteset_BR_57_4_anim1;
							1: spriteset_BR_57_4_anim2;
							2: spriteset_BR_57_4_anim3;
							3: spriteset_BR_57_4_anim4;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_57_4_KWSE, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_57_4_KWSE;
							1: return switch_animation_BR_57_4;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_57_4_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_57_4_DRG;
							1: return switch_animation_BR_57_4;}	
							
						switch (FEAT_TRAINS,SELF, switch_BR_57_4_current_year,current_year){
							    0 .. 1919: switch_spritestack_BR_57_4_KWSE;
							 1920 .. 1945: switch_spritestack_BR_57_4_DRG;						 					 
							 switch_spritestack_BR_57_4_DRG;}														
									
						switch (FEAT_TRAINS,SELF, switch_BR_57_4_build_year,build_year){
							    0 .. 1919: switch_spritestack_BR_57_4_KWSE;
							 1920 .. 1945: switch_spritestack_BR_57_4_DRG;						 					 
							 switch_spritestack_BR_57_4_DRG;}	
							 
						switch (FEAT_TRAINS,SELF, switch_BR_57_4_Tender_current_year,current_year){
							   0 .. 1919: spriteset_Tender_3achs_Wue;
							1920 .. 1945: spriteset_Tender_3achs_Wue_DRG;			 					 
							spriteset_Tender_3achs_Wue_DRG;}
								
						switch (FEAT_TRAINS,SELF, switch_BR_57_4_Tender_build_year,build_year){
							   0 .. 1919: spriteset_Tender_3achs_Wue;
							1920 .. 1945: spriteset_Tender_3achs_Wue_DRG;			 					 
							spriteset_Tender_3achs_Wue_DRG;}			 						 

						switch(FEAT_TRAINS, SELF, switch_length_BR_57_4, position_in_vehid_chain % 2) {
							0: 7;
							1: 4;}

						switch(FEAT_TRAINS, SELF, switch_FX_BR_57_4, position_in_vehid_chain % 3) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_STEAM, -2, DISABLE_WAGON_POWER);
							return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}

						
						switch (FEAT_TRAINS, PARENT, switch_running_cost_BR_57_4, 1) {
							return 725;}
							
						switch(FEAT_TRAINS, SELF, switch_BR_57_4_graphics_build, position_in_vehid_chain % 2) {
							0:	   return switch_BR_57_4_build_year;
							1:     return switch_BR_57_4_Tender_build_year;}		
							
						switch (FEAT_TRAINS, SELF, switch_articulated_BR_57_4_build, extra_callback_info1) {
							1: return ITEM_BR_57_4; 
							return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}							
							
