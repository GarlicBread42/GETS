							0: spriteset_E_77_DRG1;
							1: return switch_animation_E_77;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_E_77_DRG2, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_E_77_DRG2;
							1: return switch_animation_E_77;}							
						
							
						switch (FEAT_TRAINS,SELF, switch_E_77_build_year,build_year){
