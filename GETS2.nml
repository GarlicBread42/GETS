						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_39_DRG_gruen_purchase, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_39_DRG_gruen_purchase;
							1: spriteset_BR_39_purchase_anim;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_39_DRG_purchase, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_39_DRG_purchase;
							1: spriteset_BR_39_purchase_anim;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_39_DB_Wagner_purchase, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_39_DB_Wagner_purchase;
							1: spriteset_BR_39_purchase_anim;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_39_DB_Wagner_Silber_purchase, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_39_DB_Wagner_Silber_purchase;
							1: spriteset_BR_39_purchase_anim;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_39_DB_Witte_purchase, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_39_DB_Witte_purchase;
							1: spriteset_BR_39_purchase_anim;}														
							
						switch (FEAT_TRAINS,SELF, switch_BR_39_purchase,current_year){
							  00 .. 1921: switch_spritestack_BR_39_DRG_gruen_purchase;
							1922 .. 1945: switch_spritestack_BR_39_DRG_purchase;
							1946 .. 2050: switch_spritestack_BR_39_DB_Witte_purchase;							
										switch_spritestack_BR_39_DB_Witte_purchase;}							

						switch (FEAT_TRAINS, SELF, switch_animation_BR_39, motion_counter % 4) {
							0: spriteset_BR_39_anim1;
							1: spriteset_BR_39_anim2;
							2: spriteset_BR_39_anim3;
							3: spriteset_BR_39_anim4;}																												

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_39_DRG_gruen, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_39_DRG_gruen;
							1: return switch_animation_BR_39;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_39_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_39_DRG;
							1: return switch_animation_BR_39;}	
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_39_DB_Wagner, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_39_DB_Wagner;
							1: return switch_animation_BR_39;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_39_DB_Wagner_Silber, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_39_DB_Wagner_Silber;
							1: return switch_animation_BR_39;}								
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_39_DB_Witte, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_39_DB_Witte;
							1: return switch_animation_BR_39;}																					

						switch (FEAT_TRAINS, SELF, random_choose_BR_39_DB, switch_alternative_var_random_bits(1, 2)) {
							0: switch_spritestack_BR_39_DB_Wagner;
							1: switch_spritestack_BR_39_DB_Witte;
							2: switch_spritestack_BR_39_DB_Wagner_Silber;							
								switch_spritestack_BR_39_DB_Witte;}	

						switch (FEAT_TRAINS,SELF, switch_BR_39_build_year,build_year){
							  00 .. 1921: switch_spritestack_BR_39_DRG_gruen;
							1922 .. 1945: switch_spritestack_BR_39_DRG;
							1946 .. 2050: random_choose_BR_39_DB; 
									random_choose_BR_39_DB;}

						switch (FEAT_TRAINS,SELF, switch_BR_39_current_year,current_year){
							  00 .. 1921: switch_spritestack_BR_39_DRG_gruen;
							1922 .. 1945: switch_spritestack_BR_39_DRG;
							1946 .. 2050: random_choose_BR_39_DB; 
									random_choose_BR_39_DB;}

						switch (FEAT_TRAINS,SELF, switch_BR_39_tender_build_year,build_year){
							  00 .. 1921: spriteset_Tender_22T315_DRG_gruen;
							1922 .. 1945: spriteset_Tender_22T315_DRG;
							1946 .. 2050: spriteset_Tender_22T315_DB; 
									spriteset_Tender_22T315_DB;}

						switch (FEAT_TRAINS,SELF, switch_BR_39_tender_current_year,current_year){
							  00 .. 1921: spriteset_Tender_22T315_DRG_gruen;
							1922 .. 1945: spriteset_Tender_22T315_DRG;
							1946 .. 2050: spriteset_Tender_22T315_DB; 
									spriteset_Tender_22T315_DB;}

						switch(FEAT_TRAINS, SELF, switch_BR_39_graphics_buildyear, position_in_articulated_veh % 3) {
							0:	   spriteset_empty;
							1:     return switch_BR_39_build_year;
