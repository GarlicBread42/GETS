									{template_purchase(0, 0)}																			
	
	
//Switches	
						 switch (FEAT_TRAINS,SELF, switch_E_40_purchase,current_year){
							1950 .. 1974: spriteset_E_40_purchase1;
							1975 .. 1987: spriteset_E_40_purchase2;
							1988 .. 1999: spriteset_E_40_purchase3;
							2009 .. 2050: spriteset_E_40_purchase4;					 					 
								spriteset_E_40_purchase4;}
						 	
						 switch (FEAT_TRAINS,SELF, switch_E_40_current_year,current_year){
							1950 .. 1974: spriteset_E_40_gruen;
							1975 .. 1987: spriteset_E_40_ozeanblau;
							1988 .. 1999: spriteset_E_40_orientrot;
							2009 .. 2050: spriteset_E_40_cargo;					 					 
								spriteset_E_40_cargo;}
	
						switch (FEAT_TRAINS,SELF,switch_E_40_build_year,build_year){
							1950 .. 1974: spriteset_E_40_gruen;
							1975 .. 1987: spriteset_E_40_ozeanblau;
							1988 .. 1999: spriteset_E_40_orientrot;
							2009 .. 2050: spriteset_E_40_cargo;					 					 
								spriteset_E_40_cargo;}	

						switch (FEAT_TRAINS, SELF, switch_speed_E_40, current_year){
							   0 .. 1968: 100;
							1969 .. 2050: 110;
								110;}
							
						switch(FEAT_TRAINS, SELF, switch_length_E_40, position_in_vehid_chain % 2) {
							0: 4;
							1: 6;}
						
						switch(FEAT_TRAINS, SELF, switch_FX_E_40, position_in_vehid_chain % 2) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
							return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);} 
													
						switch(FEAT_TRAINS,PARENT,switch_running_cost_E_40, 1){
							return 2850;}

						switch(FEAT_TRAINS, SELF, switch_E_40_graphics_build, position_in_vehid_chain % 2) {
							0:	   spriteset_empty;
							1:     return switch_E_40_build_year;}
							
						switch (FEAT_TRAINS, SELF, switch_articulated_E_40_build, extra_callback_info1) {
							1: return ITEM_E_40_BUILD; 
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}													
						
