							2: spriteset_BR_01_anim3;
							3: spriteset_BR_01_anim4;}																												

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_01_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_01_DRG;
							1: return switch_animation_BR_01;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_01_DB_ABK, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_01_DB_ABK;
