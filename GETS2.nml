					{ template_purchase(0, 0)}		
				
		alternative_sprites (spriteset_Kessel_1902_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\Kessel_1902/Kessel_1902_OIL_MBH1_1x_32bpp.png", "gfx\Kessel_1902/Kessel_1902_OIL_MBH1_1x_mask.png")
					{ template_purchase(0, 0)}
					
spriteset (spriteset_Kessel_1902_purchase2, "gfx\Kessel_1902/Kessel_1902_CHEM_MBH1_1x_8bpp.png")
					{template_purchase(0, 0)}	
				
		alternative_sprites (spriteset_Kessel_1902_purchase2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\Kessel_1902/Kessel_1902_CHEM_MBH1_1x_32bpp.png", "gfx\Kessel_1902/Kessel_1902_CHEM_MBH1_1x_mask.png")
					{template_purchase(0, 0)}							
					
//Switches

					switch (FEAT_TRAINS, SELF, random_choose_Kessel_1902_CHEM, switch_alternative_var_random_bits(1, 3)) {
							1: spriteset_Kessel_1902_CHEM_MBH1;
							2: spriteset_Kessel_1902_CHEM_MBH2;
							3: spriteset_Kessel_1902_CHEM_MBH3;
							4: spriteset_Kessel_1902_CHEM_MBH4;
							5: spriteset_Kessel_1902_CHEM_OBH1;																												
							6: spriteset_Kessel_1902_CHEM_OBH2;
							7: spriteset_Kessel_1902_CHEM_OBH3;														
								spriteset_Kessel_1902_CHEM_OBH4;}	
								
					switch (FEAT_TRAINS, SELF, random_choose_Kessel_1902_OIL, switch_alternative_var_random_bits(1, 3)) {
							1: spriteset_Kessel_1902_OIL_MBH1;
							2: spriteset_Kessel_1902_OIL_MBH2;
							3: spriteset_Kessel_1902_OIL_MBH3;
							4: spriteset_Kessel_1902_OIL_MBH4;
							5: spriteset_Kessel_1902_OIL_OBH1;																												
							6: spriteset_Kessel_1902_OIL_OBH2;
							7: spriteset_Kessel_1902_OIL_OBH3;														
								spriteset_Kessel_1902_OIL_OBH4;}												

					switch (FEAT_TRAINS, SELF, switch_Kessel_1902_sprite_choose, cargo_type_in_veh) {
						OIL_: random_choose_Kessel_1902_OIL;
						RUBR: random_choose_Kessel_1902_OIL; 
						WATR: random_choose_Kessel_1902_CHEM;
						BEER: random_choose_Kessel_1902_CHEM;
						DYES: random_choose_Kessel_1902_CHEM; 
						PETR: random_choose_Kessel_1902_OIL;
						RFPR: random_choose_Kessel_1902_OIL;
						SULP: random_choose_Kessel_1902_CHEM;
						ACID: random_choose_Kessel_1902_CHEM;
						CHLO: random_choose_Kessel_1902_CHEM;
						COAT: random_choose_Kessel_1902_CHEM;
						FUEL: random_choose_Kessel_1902_CHEM;
						LYE_: random_choose_Kessel_1902_CHEM;
						MOLS: random_choose_Kessel_1902_CHEM;
						NH3_: random_choose_Kessel_1902_CHEM;
						OILI: random_choose_Kessel_1902_OIL;
						OILD: random_choose_Kessel_1902_OIL;
						O2__: random_choose_Kessel_1902_CHEM;
						SOAP: random_choose_Kessel_1902_CHEM;
						PLST: random_choose_Kessel_1902_OIL;}

					switch (FEAT_TRAINS, PARENT, switch_speed_Kessel_1902,  switch_check_PWG_0()) {
						1: return 65;
						0: return 50;}

					switch(FEAT_TRAINS,PARENT,switch_running_cost_Kessel_1902, 1){
						return 61;}	
						
