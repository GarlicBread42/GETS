						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_465_middle_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_465_middle_REV;
							1: spritegroup_BR_465_middle_loading_REV;
							2: return random_choose_BR_465_middle_ADV_REV;}	
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_465_back, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_465_back;
							1: spritegroup_ET_65_back_loading;
							2: return random_choose_BR_465_back_ADV;}	
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_465_back_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_465_back_REV;
							1: spritegroup_ET_65_back_loading_REV;
							2: return random_choose_BR_465_back_ADV_REV;}																						

						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_465_front, vehicle_is_reversed) {
							0: switch_spritestack_BR_465_front;
								switch_spritestack_BR_465_back_REV;}
								
						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_465_back, vehicle_is_reversed) {
							0: switch_spritestack_BR_465_back;
								switch_spritestack_BR_465_front_REV;}
								
						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_465_middle, vehicle_is_reversed) {
