									{ template_purchase(0, 0)}									

spriteset(spriteset_BR_64_anim_purchase, "gfx/BR_64/BR_64_anim1_1x_8bpp.png")
									{ template_purchase(0, 0)}
				
	alternative_sprites (spriteset_BR_64_anim_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BR_64/BR_64_anim1_1x_32bpp.png", "gfx/BR_64/BR_64_anim1_1x_mask.png")
									{ template_purchase(0, 0)}									

//Switches	

						switch (FEAT_TRAINS, SELF, switch_animation_BR_64, motion_counter % 4) {
								0: spriteset_BR_64_anim1;
								1: spriteset_BR_64_anim2;
								2: spriteset_BR_64_anim3;
								3: spriteset_BR_64_anim4;}

						switch (FEAT_TRAINS, SELF, switch_animation_BR_64_REV, motion_counter % 4) {
								0: spriteset_BR_64_anim1_REV;
								1: spriteset_BR_64_anim2_REV;
								2: spriteset_BR_64_anim3_REV;
								3: spriteset_BR_64_anim4_REV;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_64_purchase1, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_64_purchase1;
							1: spriteset_BR_64_anim_purchase;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_64_purchase2, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_64_purchase2;
							1: spriteset_BR_64_anim_purchase;}													
						
						switch (FEAT_TRAINS,SELF, switch_BR_64_purchase,current_year){
							1900 .. 1945: switch_spritestack_BR_64_purchase1;
							1946 .. 2050: switch_spritestack_BR_64_purchase2;															 					 
								switch_spritestack_BR_64_purchase2;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_64_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_64_DRG;
							1: return switch_animation_BR_64;}									

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_64_DRG_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_64_DRG_REV;
							1: return switch_animation_BR_64_REV;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_64_DB, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_64_DB;
							1: return switch_animation_BR_64;}									

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_64_DB_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_64_DB_REV;
							1: return switch_animation_BR_64_REV;}

						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_64_DRG, vehicle_is_reversed) {
							0: switch_spritestack_BR_64_DRG;
								switch_spritestack_BR_64_DRG_REV;}

						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_64_DB, vehicle_is_reversed) {
							0: switch_spritestack_BR_64_DB;
								switch_spritestack_BR_64_DB_REV;}
									
						switch (FEAT_TRAINS,SELF, switch_BR_64_current_year,current_year){
							 1927 .. 1945: switch_reverse_BR_64_DRG;	
							 1946 .. 1987: switch_reverse_BR_64_DB;					 					 
							 switch_reverse_BR_64_DB;}
		
						switch (FEAT_TRAINS,SELF, switch_BR_64_build_year,build_year){
							 1927 .. 1945: switch_reverse_BR_64_DRG;	
							 1946 .. 1987: switch_reverse_BR_64_DB;					 					 
							 switch_reverse_BR_64_DB;}

						switch(FEAT_TRAINS, PARENT, switch_FX_BR_64, vehicle_is_reversed) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_STEAM, -3, DISABLE_WAGON_POWER);
								return visual_effect_and_powered(VISUAL_EFFECT_STEAM, 2, DISABLE_WAGON_POWER);}							
															
						switch(FEAT_TRAINS,PARENT,switch_running_cost_BR_64, 1){
						return 1225;}
						
