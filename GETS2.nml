//Switches

					switch (FEAT_TRAINS,SELF, switch_SSla_Koeln_purchase,current_year){
						    0 .. 1945: spriteset_SSla_Koeln_purchase_DRG;
						 1946 .. 2050: spriteset_SSla_Koeln_purchase_DB;						 
							spriteset_SSla_Koeln_purchase_DB;}			

					switch(FEAT_TRAINS, SELF, switch_loadstack_SSla_Koeln_MBH_Barren, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_SSla_Koeln_MBH_DRG;
						1: spritegroup_SSla_Koeln_MBH_load_Barren;}
						
					switch(FEAT_TRAINS, SELF, switch_loadstack_SSla_Koeln_MBH_Box, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_SSla_Koeln_MBH_DRG;
						1: spritegroup_SSla_Koeln_MBH_load_Box;}	
						
					switch(FEAT_TRAINS, SELF, switch_loadstack_SSla_Koeln_MBH_Draht, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_SSla_Koeln_MBH_DRG;
						1: spritegroup_SSla_Koeln_MBH_load_Draht;}	
						
					switch(FEAT_TRAINS, SELF, switch_loadstack_SSla_Koeln_MBH_ENSP, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_SSla_Koeln_MBH_DRG;
						1: switch_SSla_Koeln_MBH_load_ENSP_current_year;}

					switch(FEAT_TRAINS, SELF, switch_loadstack_SSla_Koeln_MBH_Farm, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_SSla_Koeln_MBH_DRG;
						1: switch_SSla_Koeln_MBH_load_Farm_current_year;}

					switch(FEAT_TRAINS, SELF, switch_loadstack_SSla_Koeln_MBH_Pipe, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_SSla_Koeln_MBH_DRG;
						1: spritegroup_SSla_Koeln_MBH_load_Pipe;}

					switch(FEAT_TRAINS, SELF, switch_loadstack_SSla_Koeln_MBH_Profile, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_SSla_Koeln_MBH_DRG;
						1: spritegroup_SSla_Koeln_MBH_load_Profile;}

					switch(FEAT_TRAINS, SELF, switch_loadstack_SSla_Koeln_MBH_Timber, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_SSla_Koeln_MBH_DRG;
						1: spritegroup_SSla_Koeln_MBH_load_Timber;}
						
					switch(FEAT_TRAINS, SELF, switch_loadstack_SSla_Koeln_MBH_Wood, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_SSla_Koeln_MBH_DRG;
						1: spritegroup_SSla_Koeln_MBH_load_Wood;}	
						
					switch(FEAT_TRAINS, SELF, switch_SSla_Koeln_MBH_cargo_classes, cargo_classes) {
							bitmask(CC_PIECE_GOODS) : return switch_loadstack_SSla_Koeln_MBH_Box;
								return switch_loadstack_SSla_Koeln_MBH_Box;}	
														
					switch (FEAT_TRAINS, SELF, switch_SSla_Koeln_MBH_cargo_type, cargo_type_in_veh) {

//FIRS-Cargos					
							STAL: return switch_loadstack_SSla_Koeln_MBH_Barren;
							ALUM: return switch_loadstack_SSla_Koeln_MBH_Barren;
							STCB: return switch_loadstack_SSla_Koeln_MBH_Barren;
							STST: return switch_loadstack_SSla_Koeln_MBH_Barren;
							STSH: return switch_loadstack_SSla_Koeln_MBH_Barren;
							
							POWR: return switch_loadstack_SSla_Koeln_MBH_Box;
							VENG: return switch_loadstack_SSla_Koeln_MBH_Box;
							VPTS: return switch_loadstack_SSla_Koeln_MBH_Box;
							GOOD: return switch_loadstack_SSla_Koeln_MBH_Box;
							GLAS: return switch_loadstack_SSla_Koeln_MBH_Box;
							
							ENSP: return switch_loadstack_SSla_Koeln_MBH_ENSP;
							FMSP: return switch_loadstack_SSla_Koeln_MBH_Farm;
							
							STWR: return switch_loadstack_SSla_Koeln_MBH_Draht;
							
							STEL: return switch_loadstack_SSla_Koeln_MBH_Profile;
							STSE: return switch_loadstack_SSla_Koeln_MBH_Profile;
							
							PIPE: return switch_loadstack_SSla_Koeln_MBH_Pipe;
							
							BDMT: return switch_loadstack_SSla_Koeln_MBH_Timber;
							WDPR: return switch_loadstack_SSla_Koeln_MBH_Timber;
							
							WOOD: return switch_loadstack_SSla_Koeln_MBH_Wood;
							
//Other Cargoes
							MNSP: return switch_loadstack_SSla_Koeln_MBH_Box;
							MPTS: return switch_loadstack_SSla_Koeln_MBH_Box;
							PAPR: return switch_loadstack_SSla_Koeln_MBH_Box;							
							
								switch_SSla_Koeln_MBH_cargo_classes;}																	

					switch(FEAT_TRAINS, SELF, switch_loadstack_SSla_Koeln_OBH_Barren, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_SSla_Koeln_OBH_DB;
						1: spritegroup_SSla_Koeln_OBH_load_Barren;}
						
					switch(FEAT_TRAINS, SELF, switch_loadstack_SSla_Koeln_OBH_Box, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_SSla_Koeln_OBH_DB;
						1: spritegroup_SSla_Koeln_OBH_load_Box;}	
						
					switch(FEAT_TRAINS, SELF, switch_loadstack_SSla_Koeln_OBH_Draht, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_SSla_Koeln_OBH_DB;
						1: spritegroup_SSla_Koeln_OBH_load_Draht;}	
						
					switch(FEAT_TRAINS, SELF, switch_loadstack_SSla_Koeln_OBH_ENSP, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_SSla_Koeln_OBH_DB;
						1: switch_SSla_Koeln_OBH_load_ENSP_current_year;}

					switch(FEAT_TRAINS, SELF, switch_loadstack_SSla_Koeln_OBH_Farm, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_SSla_Koeln_OBH_DB;
						1: switch_SSla_Koeln_OBH_load_Farm_current_year;}

					switch(FEAT_TRAINS, SELF, switch_loadstack_SSla_Koeln_OBH_Pipe, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_SSla_Koeln_OBH_DB;
						1: spritegroup_SSla_Koeln_OBH_load_Pipe;}

					switch(FEAT_TRAINS, SELF, switch_loadstack_SSla_Koeln_OBH_Profile, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_SSla_Koeln_OBH_DB;
						1: spritegroup_SSla_Koeln_OBH_load_Profile;}

					switch(FEAT_TRAINS, SELF, switch_loadstack_SSla_Koeln_OBH_Timber, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_SSla_Koeln_OBH_DB;
						1: spritegroup_SSla_Koeln_OBH_load_Timber;}
						
					switch(FEAT_TRAINS, SELF, switch_loadstack_SSla_Koeln_OBH_Wood, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_SSla_Koeln_OBH_DB;
						1: spritegroup_SSla_Koeln_OBH_load_Wood;}

					switch(FEAT_TRAINS, SELF, switch_SSla_Koeln_OBH_cargo_classes, cargo_classes) {
							bitmask(CC_PIECE_GOODS) : return switch_loadstack_SSla_Koeln_OBH_Box;
								return switch_loadstack_SSla_Koeln_OBH_Box;}	
														
					switch (FEAT_TRAINS, SELF, switch_SSla_Koeln_OBH_cargo_type, cargo_type_in_veh) {

//FIRS-Cargos					
							STAL: return switch_loadstack_SSla_Koeln_OBH_Barren;
							ALUM: return switch_loadstack_SSla_Koeln_OBH_Barren;
							STCB: return switch_loadstack_SSla_Koeln_OBH_Barren;
							STST: return switch_loadstack_SSla_Koeln_OBH_Barren;
							STSH: return switch_loadstack_SSla_Koeln_OBH_Barren;
							
							POWR: return switch_loadstack_SSla_Koeln_OBH_Box;
							VENG: return switch_loadstack_SSla_Koeln_OBH_Box;
							VPTS: return switch_loadstack_SSla_Koeln_OBH_Box;
							GOOD: return switch_loadstack_SSla_Koeln_OBH_Box;
							GLAS: return switch_loadstack_SSla_Koeln_OBH_Box;
							
							ENSP: return switch_loadstack_SSla_Koeln_OBH_ENSP;
							FMSP: return switch_loadstack_SSla_Koeln_OBH_Farm;
							
							STWR: return switch_loadstack_SSla_Koeln_OBH_Draht;
							
							STEL: return switch_loadstack_SSla_Koeln_OBH_Profile;
							STSE: return switch_loadstack_SSla_Koeln_OBH_Profile;
							
							PIPE: return switch_loadstack_SSla_Koeln_OBH_Pipe;
							
							BDMT: return switch_loadstack_SSla_Koeln_OBH_Timber;
							WDPR: return switch_loadstack_SSla_Koeln_OBH_Timber;
							
							WOOD: return switch_loadstack_SSla_Koeln_OBH_Wood;
							
//Other Cargoes
							MNSP: return switch_loadstack_SSla_Koeln_OBH_Box;
							MPTS: return switch_loadstack_SSla_Koeln_OBH_Box;
							PAPR: return switch_loadstack_SSla_Koeln_OBH_Box;							
							
								switch_SSla_Koeln_OBH_cargo_classes;}		

					switch (FEAT_TRAINS,SELF, switch_SSla_Koeln_current_year,current_year){
						    0 .. 1945: switch_SSla_Koeln_MBH_cargo_type;
						 1946 .. 2050: switch_SSla_Koeln_OBH_cargo_type;						 
							switch_SSla_Koeln_OBH_cargo_type;}	

						switch(FEAT_TRAINS, SELF, switch_SSla_Koeln_graphics, position_in_articulated_veh % 3) {
							0:	   spriteset_empty;
							1:     return switch_SSla_Koeln_current_year;
							2:	   spriteset_empty;}

						switch(FEAT_TRAINS, SELF, switch_length_SSla_Koeln, position_in_vehid_chain % 3) {
							0: 4;
							1: 4;
							2: 4;}			
								
						switch (FEAT_TRAINS, PARENT, switch_speed_SSla_Koeln,  switch_check_PWG_0()) {
							1: return 80;
							0: return 65;}																					

						switch (FEAT_TRAINS, SELF, switch_articulated_SSla_Koeln, extra_callback_info1) {
							1 .. 2: return ITEM_SSLA_KOELN;
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}																																																																												

						switch(FEAT_TRAINS,PARENT,switch_running_cost_SSla_Koeln, 1){
							return 275;}	

item (FEAT_TRAINS , ITEM_SSLA_KOELN, 8928)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_SSLA_KOELN);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1934,01,01);
						model_life: 					50;
						vehicle_life: 					50;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes: 		bitmask(CC_PIECE_GOODS );
						cargo_allow_refit:              [STAL, ALUM, STCB, STST, STSH, POWR, VENG, VPTS, GOOD, GLAS, ENSP, FMSP, STWR, STEL, STSE, PIPE, BDMT, WDPR, WOOD, MNSP, MPTS, PAPR,];
						cargo_disallow_refit: 			[LVST, FOOD, WATR, BEER, BOOM, FISH, IRON, EOIL, FERT, FICR, FRVG, FRUT, VEHI];
						misc_flags: 					bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_SPRITE_STACK);
						loading_speed:					5;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							80 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						21 ton;
						dual_headed: 					0;
						default_cargo_type:				WOOD;
						cargo_capacity:					14;
						ai_engine_rank: 				0;
						length: 						8;
												
			}
			
	//Vehicels Graphics
			graphics
			{
			default							: switch_SSla_Koeln_graphics;
			additional_text					: string(STR_DESC_CABOOSE_80);
			articulated_part			  	: switch_articulated_SSla_Koeln;
			length							: switch_length_SSla_Koeln;
			purchase						: switch_SSla_Koeln_purchase;
			speed							: switch_speed_SSla_Koeln;
			cost_factor						: 125;
			running_cost_factor				: switch_running_cost_SSla_Koeln;
			colour_mapping					: switch_generic_recolour;
			 }
		}	
