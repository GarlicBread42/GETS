					{template_purchase(0, 0)}	
				
		alternative_sprites (spriteset_GL11_Purchase_3, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\GL11/GL11_DB_MBH_1x_32bpp.png", "gfx\GL11/GL11_DB_MBH_1x_mask.png")
					{template_purchase(0, 0)}	
					
//Switches
					 switch (FEAT_TRAINS,SELF, switch_GL11_purchase,current_year){
							1880 .. 1919: spriteset_GL11_Purchase_1;
							1920 .. 1946: spriteset_GL11_Purchase_2;		
							1947 .. 2000: spriteset_GL11_Purchase_3;										 					 
							spriteset_GL11_Purchase_3;}

					switch (FEAT_TRAINS, SELF, random_choose_GL11_KPEV, switch_alternative_var_random_bits(1, 1)) {
							1: spritegroup_GL11_KPEV_MBH;
								spritegroup_GL11_KPEV_OBH;}	
								
					switch (FEAT_TRAINS, SELF, random_choose_GL11_DRG, switch_alternative_var_random_bits(1, 1)) {
							1: spritegroup_GL11_DRG_MBH;
								spritegroup_GL11_DRG_OBH;}	
								
					switch (FEAT_TRAINS, SELF, random_choose_GL11_DB, switch_alternative_var_random_bits(1, 1)) {
							1: spritegroup_GL11_DB_MBH;
								spritegroup_GL11_DB_OBH;}
								
					switch (FEAT_TRAINS,SELF,switch_graphics_GL11,current_year) {
						1880 .. 1919 : random_choose_GL11_KPEV;
						1920 .. 1946 : random_choose_GL11_DRG;
						1947 .. 2000 : random_choose_GL11_DB;						
						random_choose_GL11_DB;}

					switch (FEAT_TRAINS, PARENT, switch_speed_GL11,  switch_check_PWG_0()) {
						1: return 65;
						0: return 50;}
						
					switch(FEAT_TRAINS,PARENT,switch_running_cost_GL11, 1){
						return 75;}							

item (FEAT_TRAINS , ITEM_GL11, 8260)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_GL11);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1914,01,01);
						model_life: 					59;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes:		bitmask(CC_PIECE_GOODS);
						cargo_allow_refit:              [MAIL,GOOD,VALU,PAPR,DIAM,BDMT,BEER,BOOM,BRCK,CERA,CERE,DYES,ENSP,FERT,FICR,FMSP,GLAS,JAVA,PLAS,TYRE,WDPR,WOOL,ZINC,ALUM,BAKE,CIGR,COAT,COBL,FURN,METL,MNSP,MPTS,NUTS,PCL_,PIPE,SEED,SESP,SOAP,STAL,STCB,STSE,STSH,STST,STWR,TATO,VENG,VPTS,BATT,BUBL,FZDR,TOYS,];
						loading_speed:					6;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							50 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						13 ton;
						dual_headed: 					0;
						default_cargo_type:				GOOD;
						cargo_capacity:					36;
						ai_engine_rank: 				0;
						length: 						8;
												
			}
			
	//Vehicels Graphics
			graphics
			{
			default							: switch_graphics_GL11;
			additional_text					: string(STR_DESC_CABOOSE_65);
			purchase						: switch_GL11_purchase;
			speed							: switch_speed_GL11;
			cost_factor						: 35;
			running_cost_factor				: switch_running_cost_GL11;				
			
			 }
		}
