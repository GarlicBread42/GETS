									{ template_purchase(0, 0)}
				
		alternative_sprites (spriteset_BR_614_purchase4, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\BR_614/BR_614_front_rot_1x_32bpp.png", "gfx\BR_614/BR_614_front_rot_1x_mask.png")
									{ template_purchase(0, 0)}	
									
//Switches allgemein

						switch (FEAT_TRAINS,SELF,switch_purchase_BR_614,current_year) {
						1940 .. 1974 : spriteset_BR_614_purchase1;
						1975 .. 1986 : spriteset_BR_614_purchase2;
						1987 .. 1995 : spriteset_BR_614_purchase3;
						1996 .. 2050 : spriteset_BR_614_purchase4;
						spriteset_BR_614_purchase4;}
						
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_614_front_popfarben, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_614_front_popfarben;
							1: spritegroup_BR_614_front_loading;}													
						
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_614_front_ozeanblau, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_614_front_ozeanblau;
							1: spritegroup_BR_614_front_loading;}									
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_614_front_mint, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_614_front_mint;
							1: spritegroup_BR_614_front_loading;}									
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_614_front_rot, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_614_front_rot;
							1: spritegroup_BR_614_front_loading;}																										

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_614_middle_popfarben, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_614_middle_popfarben;
							1: spritegroup_BR_614_middle_loading;}												
						
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_614_middle_ozeanblau, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_614_middle_ozeanblau;
							1: spritegroup_BR_614_middle_loading;}								
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_614_middle_mint, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_614_middle_mint;
							1: spritegroup_BR_614_middle_loading;}								
							
