//Switches

						switch (FEAT_TRAINS,SELF,switch_purchase_Gruppe_28,current_year) {
							   0 .. 1945 : spriteset_Gruppe_28_purchase1;
							1945 .. 1990 : spriteset_Gruppe_28_purchase2;
								spriteset_Gruppe_28_purchase2;}	
						
						switch(FEAT_TRAINS, SELF, switch_spritestack_Gruppe_28_DRG_AB, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_Gruppe_28_DRG_AB;
							1: spritegroup_Gruppe_28_loading_2doors_DRG;}	
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_Gruppe_28_DRG_C1, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
