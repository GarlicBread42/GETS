						tractive_effort_coefficient: 	0.21;
						length: 						8;
												
			}

		//Vehicels Graphics
			graphics
			{
			default							: switch_BR_515_graphics_build;
			additional_text					: string(STR_CONCAT_2, 
											  string(STR_TRACTION_BEMU), 
											  string(STR_DESC_PASS),);
