						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_01_DB_NBK_Silber, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_01_DB_NBK_Silber;
							1: return switch_animation_BR_01;}																					

						switch (FEAT_TRAINS, SELF, random_choose_BR_01_DB_ABK, switch_alternative_var_random_bits(1, 2)) {
							0: switch_spritestack_BR_01_DB_ABK;
							1: switch_spritestack_BR_01_DB_ABK_Silber;
							2: switch_spritestack_BR_01_DB_ABK;							
								switch_spritestack_BR_01_DB_ABK;}	

						switch (FEAT_TRAINS, SELF, random_choose_BR_01_DB_NBK, switch_alternative_var_random_bits(1, 2)) {
							0: switch_spritestack_BR_01_DB_NBK;
							1: switch_spritestack_BR_01_DB_NBK_Silber;
							2: switch_spritestack_BR_01_DB_NBK;	
