		alternative_sprites (spriteset_X_Wagen_DVT_sbahn_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\X_Wagen_DVT/X_Wagen_DVT_sbahn_1x_32bpp.png", "gfx\X_Wagen_DVT/X_Wagen_DVT_sbahn_1x_mask.png")
									{ template_purchase(0, 0)}    

spriteset(spriteset_X_Wagen_DVT_verkehrsrot_purchase, "gfx\X_Wagen_DVT/X_Wagen_DVT_verkehrsrot_1x_8bpp.png")
									{ template_purchase(0, 0)}
		alternative_sprites (spriteset_X_Wagen_DVT_verkehrsrot_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\X_Wagen_DVT/X_Wagen_DVT_verkehrsrot_1x_32bpp.png", "gfx\X_Wagen_DVT/X_Wagen_DVT_verkehrsrot_1x_mask.png")
									{ template_purchase(0, 0)}  

