# 1 "src/PASSENGER/WR6ue.pnml" 1
//########################################
//###WR6ü 1907 Preussischer Speisewagen###
//########################################

//Spritesets

//Spriteset KPEV

spriteset (spriteset_WR6ue_Teak, "gfx/WR6ue/WR6ue_Teak_1x_8bpp.png")
					{ template_138trains_1x(0, 0)}	
				
		alternative_sprites (spriteset_WR6ue_Teak, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/WR6ue/WR6ue_Teak_1x_32bpp.png", "gfx/WR6ue/WR6ue_Teak_1x_mask.png")
					{template_138trains_1x(0,0)}
				
		alternative_sprites (spriteset_WR6ue_Teak, ZOOM_LEVEL_IN_2X, BIT_DEPTH_32BPP, "gfx/WR6ue/WR6ue_Teak_2x_32bpp.png", "gfx/WR6ue/WR6ue_Teak_2x_mask.png")
					{template_138trains_2x(0,0)}				
			
		alternative_sprites (spriteset_WR6ue_Teak, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP, "gfx/WR6ue/WR6ue_Teak_4x_32bpp.png", "gfx/WR6ue/WR6ue_Teak_4x_mask.png")
					{template_138trains_4x(0,0)}
					
//Spriteset loading				
				
spriteset (spriteset_WR6ue_Teak_loading, "gfx/WR6ue/WR6ue_Teak_loading_1x_8bpp.png")
					{ template_138trains_1x(0, 0)}	
				
		alternative_sprites (spriteset_WR6ue_Teak_loading, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/WR6ue/WR6ue_Teak_loading_1x_32bpp.png", "gfx/WR6ue/WR6ue_Teak_loading_1x_mask.png")
					{template_138trains_1x(0,0)}
				
		alternative_sprites (spriteset_WR6ue_Teak_loading, ZOOM_LEVEL_IN_2X, BIT_DEPTH_32BPP, "gfx/WR6ue/WR6ue_Teak_loading_2x_32bpp.png", "gfx/WR6ue/WR6ue_Teak_loading_2x_mask.png")
					{template_138trains_2x(0,0)}				
			
		alternative_sprites (spriteset_WR6ue_Teak_loading, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP, "gfx/WR6ue/WR6ue_Teak_loading_4x_32bpp.png", "gfx/WR6ue/WR6ue_Teak_loading_4x_mask.png")
					{template_138trains_4x(0,0)}	
						
spritegroup spritegroup_WR6ue_Teak_loading
		{loaded: 	[spriteset_empty];
			loading: 	[spriteset_WR6ue_Teak_loading];}					

//Spriteset DRG

spriteset (spriteset_WR6ue_DRG, "gfx/WR6ue/WR6ue_DRG_1x_8bpp.png")
					{ template_138trains_1x(0, 0)}	
				
		alternative_sprites (spriteset_WR6ue_DRG, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/WR6ue/WR6ue_DRG_1x_32bpp.png", "gfx/WR6ue/WR6ue_DRG_1x_mask.png")
					{template_138trains_1x(0,0)}
				
		alternative_sprites (spriteset_WR6ue_DRG, ZOOM_LEVEL_IN_2X, BIT_DEPTH_32BPP, "gfx/WR6ue/WR6ue_DRG_2x_32bpp.png", "gfx/WR6ue/WR6ue_DRG_2x_mask.png")
					{template_138trains_2x(0,0)}				
			
		alternative_sprites (spriteset_WR6ue_DRG, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP, "gfx/WR6ue/WR6ue_DRG_4x_32bpp.png", "gfx/WR6ue/WR6ue_DRG_4x_mask.png")
					{template_138trains_4x(0,0)}

//Spriteset loading				
				
spriteset (spriteset_WR6ue_DRG_loading, "gfx/WR6ue/WR6ue_DRG_loading_1x_8bpp.png")
					{ template_138trains_1x(0, 0)}	
				
		alternative_sprites (spriteset_WR6ue_DRG_loading, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/WR6ue/WR6ue_DRG_loading_1x_32bpp.png", "gfx/WR6ue/WR6ue_DRG_loading_1x_mask.png")
					{template_138trains_1x(0,0)}
				
		alternative_sprites (spriteset_WR6ue_DRG_loading, ZOOM_LEVEL_IN_2X, BIT_DEPTH_32BPP, "gfx/WR6ue/WR6ue_DRG_loading_2x_32bpp.png", "gfx/WR6ue/WR6ue_DRG_loading_2x_mask.png")
					{template_138trains_2x(0,0)}				
			
		alternative_sprites (spriteset_WR6ue_DRG_loading, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP, "gfx/WR6ue/WR6ue_DRG_loading_4x_32bpp.png", "gfx/WR6ue/WR6ue_DRG_loading_4x_mask.png")
					{template_138trains_4x(0,0)}	
						
spritegroup spritegroup_WR6ue_DRG_loading
		{loaded: 	[spriteset_empty];
			loading: 	[spriteset_WR6ue_DRG_loading];}
								
//Spritesets purchase

spriteset (spriteset_WR6ue_purchase_Teak, "gfx/WR6ue/WR6ue_Teak_1x_8bpp.png")
					{ template_purchase(0, 0)}	
				
		alternative_sprites (spriteset_WR6ue_purchase_Teak, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/WR6ue/WR6ue_Teak_1x_32bpp.png", "gfx/WR6ue/WR6ue_Teak_1x_mask.png")
					{template_purchase(0,0)}					

spriteset (spriteset_WR6ue_purchase_DRG, "gfx/WR6ue/WR6ue_DRG_1x_8bpp.png")
					{ template_purchase(0, 0)}	
				
		alternative_sprites (spriteset_WR6ue_purchase_DRG, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/WR6ue/WR6ue_DRG_1x_32bpp.png", "gfx/WR6ue/WR6ue_DRG_1x_mask.png")
					{template_purchase(0,0)}
					
//Switches


						switch (FEAT_TRAINS,SELF,switch_purchase_WR6ue,current_year) {
							0 .. 1919 : spriteset_WR6ue_purchase_Teak;
							1920 .. 2050 : spriteset_WR6ue_purchase_DRG;
								spriteset_WR6ue_purchase_DRG;}	
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_WR6ue_KPEV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_WR6ue_Teak;
							1: spritegroup_WR6ue_Teak_loading;}											

						switch(FEAT_TRAINS, SELF, switch_spritestack_WR6ue_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_WR6ue_DRG;
							1: spritegroup_WR6ue_DRG_loading;}
																			
						switch(FEAT_TRAINS, SELF, switch_length_WR6ue, position_in_vehid_chain % 3) {
							0: 4;
							1: 5;
							2: 4;}
						
						switch(FEAT_TRAINS,PARENT,switch_running_cost_WR6ue, 1){
							return 7500;}	
							
						switch (FEAT_TRAINS,SELF,switch_build_year_WR6ue,build_year) {
							   0 .. 1919 : switch_spritestack_WR6ue_KPEV;
							1920 .. 2050 : switch_spritestack_WR6ue_DRG;
								switch_spritestack_WR6ue_DRG;}		

						switch(FEAT_TRAINS, SELF, switch_WR6ue_graphics_build, position_in_vehid_chain  % 3) {
							0:     spriteset_empty;
							1:     return switch_build_year_WR6ue;
							2:     spriteset_empty;}	

						switch (FEAT_TRAINS, SELF, switch_articulated_WR6ue_build, extra_callback_info1) {
							1 ..2: return ITEM_WR6UE_BUILD;
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}														

