							   switch_loadstack_Wue_29_DRG_C_front;}
							   
						switch (FEAT_TRAINS, SELF, random_choose_Wue_29_DRG_back, switch_alternative_var_random_bits(1, 1)) {
							1: switch_loadstack_Wue_29_DRG_B_back;
							   switch_loadstack_Wue_29_DRG_C_back;}	
							   
						switch (FEAT_TRAINS, SELF, random_choose_Wue_29_DB_front, switch_alternative_var_random_bits(1, 1)) {
							1: switch_loadstack_Wue_29_DB_B_front;
							   switch_loadstack_Wue_29_DB_C_front;}
							   
						switch (FEAT_TRAINS, SELF, random_choose_Wue_29_DB_back, switch_alternative_var_random_bits(1, 1)) {
							1: switch_loadstack_Wue_29_DB_B_back;
							   switch_loadstack_Wue_29_DB_C_back;}							   																																										
							
						switch (FEAT_TRAINS, SELF, random_choose_Wue_29_Red_front, switch_alternative_var_random_bits(1, 1)) {
							1: switch_loadstack_Wue_29_Red_B_front;
							   switch_loadstack_Wue_29_Red_C_front;}
							   
						switch (FEAT_TRAINS, SELF, random_choose_Wue_29_Red_back, switch_alternative_var_random_bits(1, 1)) {
							1: switch_loadstack_Wue_29_Red_B_back;
							   switch_loadstack_Wue_29_Red_C_back;}

						switch (FEAT_TRAINS, SELF, switch_build_year_Wue_29_front, build_year){
							1900 .. 1945 : random_choose_Wue_29_DRG_front;
							1946 .. 2050 : random_choose_Wue_29_DB_front;
								random_choose_Wue_29_DB_front;}	
								
						switch (FEAT_TRAINS, SELF, switch_build_year_Wue_29_back, build_year){
							1900 .. 1945 : random_choose_Wue_29_DRG_back;
							1946 .. 2050 : random_choose_Wue_29_DB_back;
								random_choose_Wue_29_DB_back;}
								
						switch (FEAT_TRAINS, SELF, switch_current_year_Wue_29_front, current_year){
							1900 .. 1945 : random_choose_Wue_29_DRG_front;
							1946 .. 2050 : random_choose_Wue_29_DB_front;
								random_choose_Wue_29_DB_front;}	
								
						switch (FEAT_TRAINS, SELF, switch_current_year_Wue_29_back, current_year){
							1900 .. 1945 : random_choose_Wue_29_DRG_back;
							1946 .. 2050 : random_choose_Wue_29_DB_back;
								random_choose_Wue_29_DB_back;}
								
						switch(FEAT_TRAINS, SELF, switch_length_Wue_29, position_in_articulated_veh % 8) {
							0: 8;
							1: 8;}	

						switch(FEAT_TRAINS,PARENT,switch_running_cost_Wue_29, 1){
							return 2200;}																																																					   

						switch(FEAT_TRAINS, SELF, switch_Wue_29_graphics_build, position_in_articulated_veh  % 8) {
							0:     switch_build_year_Wue_29_front;
							1:     switch_build_year_Wue_29_back;}	

						switch (FEAT_TRAINS, SELF, switch_articulated_Wue_29_build, extra_callback_info1) {
							1: return ITEM_WUE_29_BUILD;														
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}
																				
