//Switches

						switch (FEAT_TRAINS,SELF, switch_BR_110_3_purchase,current_year){
							   0 .. 1974: spriteset_BR_110_3_purchase_blau;
							1975 .. 1987: spriteset_BR_110_3_purchase_ozeanblau;	
							1988 .. 1999: spriteset_BR_110_3_purchase_orientrot;
							2000 .. 2045: spriteset_BR_110_3_purchase_verkehrsrot;														 					 
								spriteset_BR_110_3_purchase_verkehrsrot;}
								
						switch (FEAT_TRAINS,SELF, switch_BR_110_3_build_year,build_year){
							   0 .. 1974: spriteset_BR_110_3_blau;
							1975 .. 1987: spriteset_BR_110_3_ozeanblau;	
							1988 .. 1999: spriteset_BR_110_3_orientrot;
							2000 .. 2045: spriteset_BR_110_3_verkehrsrot;														 					 
								spriteset_BR_110_3_verkehrsrot;}	
								
						switch (FEAT_TRAINS,SELF, switch_BR_110_3_current_year,current_year){
							   0 .. 1974: spriteset_BR_110_3_blau;
							1975 .. 1987: spriteset_BR_110_3_ozeanblau;	
							1988 .. 1999: spriteset_BR_110_3_orientrot;
							2000 .. 2045: spriteset_BR_110_3_verkehrsrot;														 					 
								spriteset_BR_110_3_verkehrsrot;}															

						switch(FEAT_TRAINS, SELF, switch_length_BR_110_3, position_in_vehid_chain % 2) {
							0: 4;
							1: 6;}
						
						switch(FEAT_TRAINS, SELF, switch_FX_BR_110_3, position_in_vehid_chain % 3) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
							return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}

						switch(FEAT_TRAINS,PARENT,switch_running_cost_BR_110_3, 1){
							return 4275;}						

						switch(FEAT_TRAINS, SELF, switch_BR_110_3_graphics_build, position_in_vehid_chain % 2) {
							0:	   spriteset_empty;
							1:     return switch_BR_110_3_build_year;}

						switch (FEAT_TRAINS, SELF, switch_articulated_BR_110_3_build, extra_callback_info1) {
							1: return ITEM_BR_110_3_BUILD; 
							return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}
							
item (FEAT_TRAINS , ITEM_BR_110_3_BUILD, 1099)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_BR_110_3_BUILD);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);						
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1963,01,01);
						model_life: 					58;
						vehicle_life: 					40;
						retire_early: 					-10;							
						reliability_decay: 				20;
						cargo_allow_refit: 				[PASS] ;
						cargo_capacity: 				1 ;
						cost_factor: 					108;
						running_cost_base:   			RUNNING_COST_STEAM;							
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							160 km/h;
						refit_cost: 					0;
						track_type: 					AC15;
						power:  						4920 hp;
						weight: 						83 ton;
						ai_engine_rank: 				0;
						engine_class: 					ENGINE_CLASS_ELECTRIC;
						visual_effect_and_powered: 		visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
						dual_headed: 					0;
						tractive_effort_coefficient: 	0.325;
						length: 						8;
			}

		//Vehicels Graphics
			graphics
			{
			default:						switch_BR_110_3_graphics_build;
			additional_text					: string(STR_CONCAT_2, 
											  string(STR_TRACTION_ELECTRIC), 
											  string(STR_DESC_EXPRESS),);
			length:							switch_length_BR_110_3;
			articulated_part:				switch_articulated_BR_110_3_build;
			purchase_cargo_capacity		    : 0 ;
			cargo_capacity	                : return 0 ;
			purchase						: switch_BR_110_3_purchase;
			cost_factor						: 191;
			running_cost_factor				: switch_running_cost_BR_110_3;
			visual_effect_and_powered		:switch_FX_BR_110_3;
			}
	}							

						switch(FEAT_TRAINS, SELF, switch_BR_110_3_graphics_current, position_in_vehid_chain % 2) {
							0:	   spriteset_empty;
							1:     return switch_BR_110_3_current_year;}
							
						switch (FEAT_TRAINS, SELF, switch_articulated_BR_110_3_current, extra_callback_info1) {
							1: return ITEM_BR_110_3_CURRENT; 
							return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}
							
