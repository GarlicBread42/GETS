		alternative_sprites (spriteset_DTW_Kittel_purchase_anim, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\DTW_Kittel/DTW_Kittel_anim1_1x_32bpp.png", "gfx\DTW_Kittel/DTW_Kittel_anim1_1x_mask.png")
