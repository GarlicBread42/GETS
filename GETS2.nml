						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_460_purchase, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_460_front_base_purchase;
							1: spriteset_BR_460_front_MRB_2008_purchase;}	


//Headlight and backlight sprites are taken from BR 460 ODEG

						switch (FEAT_TRAINS, SELF, switch_spritechoose_BR_460_front_headlights, position_in_consist) {
							1: spriteset_BR_460_front_lights_front;
								spriteset_empty;}	
															
						switch (FEAT_TRAINS, SELF, switch_spritechoose_BR_460_back_taillights, position_in_consist_from_end) {
							1: spriteset_BR_460_back_lights_back;
								spriteset_empty;}

						switch (FEAT_TRAINS, SELF, switch_spritechoose_BR_460_back_headlights_REV, position_in_consist) {
