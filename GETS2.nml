//Switches

						switch (FEAT_TRAINS,SELF,switch_purchase_uicx_bdms,current_year) {
							  00 .. 1973 : spriteset_UICX_BDMS_purchase1;
							1974 .. 1987 : spriteset_UICX_BDMS_purchase2;
							1988 .. 1998 : spriteset_UICX_BDMS_purchase3;
							1999 .. 2050 : spriteset_UICX_BDMS_purchase4;
								spriteset_UICX_BDMS_purchase4;}
						
						switch(FEAT_TRAINS, SELF, switch_loadstack_UICX_BDMS_gruen, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_UICX_BDMS_gruen;
							1: spritegroup_UICX_loading_1;
							2: spritegroup_UICX_BDMS_loading_gruen;}	
							
						switch(FEAT_TRAINS, SELF, switch_loadstack_UICX_BDMS_oceanblau, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_UICX_BDMS_oceanblau;
							1: spritegroup_UICX_loading_1;
							2: spritegroup_UICX_BDMS_loading_oceanblau;}	
							
						switch(FEAT_TRAINS, SELF, switch_loadstack_UICX_BDMS_popfarben, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_UICX_BDMS_popfarben;
							1: spritegroup_UICX_loading_1;
							2: spritegroup_UICX_BDMS_loading_popfarben;}
							
						switch(FEAT_TRAINS, SELF, switch_loadstack_UICX_BDMS_icalt, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_UICX_BDMS_icalt;
							1: spritegroup_UICX_loading_2;
							2: spritegroup_UICX_BDMS_loading_icalt;}	
							
						switch(FEAT_TRAINS, SELF, switch_loadstack_UICX_BDMS_Regio, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_UICX_BDMS_Regio;
							1: spritegroup_UICX_loading_2;
							2: spritegroup_UICX_BDMS_loading_Regio;}																															

						switch (FEAT_TRAINS,SELF,switch_build_year_uicx_bdms,build_year) {
							  00 .. 1973 : switch_loadstack_UICX_BDMS_gruen;
							1974 .. 1987 : switch_loadstack_UICX_BDMS_oceanblau;
							1988 .. 1998 : switch_loadstack_UICX_BDMS_icalt;
							1999 .. 2050 : switch_loadstack_UICX_BDMS_Regio;
								switch_loadstack_UICX_BDMS_Regio;}
						
						switch (FEAT_TRAINS,SELF,switch_current_year_uicx_bdms,current_year) {
							  00 .. 1973 : switch_loadstack_UICX_BDMS_gruen;
							1974 .. 1987 : switch_loadstack_UICX_BDMS_oceanblau;
							1988 .. 1998 : switch_loadstack_UICX_BDMS_icalt;
							1999 .. 2050 : switch_loadstack_UICX_BDMS_Regio;
								switch_loadstack_UICX_BDMS_Regio;}								   	


						switch(FEAT_TRAINS, SELF, switch_length_uicx_bdms, position_in_articulated_veh % 3) {
							0: 4;
							1: 7;
							2: 4;}

						switch(FEAT_TRAINS, SELF, switch_speed_uicx_bdms, current_year) {
							1950 .. 1969 : 140 ;
							1970 .. 1987 : 160 ;
							200;}


item (FEAT_TRAINS , ITEM_UICX_BDMS_MAIL, 3952)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_UICX_BDMS_BUILD);
						climates_available: 			NO_CLIMATE;
						introduction_date: 				date(1952,01,01);
						model_life: 					55;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						cargo_allow_refit:				[MAIL, GOOD, VALU];
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);							
						loading_speed:					8;
						cost_factor:                    0;
						running_cost_base:              RUNNING_COST_STEAM;
						running_cost_factor: 			0;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							140 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						38 ton;
						dual_headed: 					0;
						default_cargo_type:				MAIL;
						cargo_capacity:					46;
						ai_engine_rank: 				0;
						length: 						4;
	}		

	//Vehicels Graphics
			graphics
			{
			default							: spriteset_empty;		
			 }
		}		


						switch (FEAT_TRAINS, SELF, switch_articulated_uicx_bdms_build, extra_callback_info1) {
							1: return ITEM_UICX_BDMS_BUILD;
							2: return ITEM_UICX_BDMS_MAIL;
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;} 
	
						switch(FEAT_TRAINS, SELF, switch_uicx_bdms_graphics_build, position_in_articulated_veh  % 3) {
							0:     spriteset_empty;
							1:     return switch_build_year_uicx_bdms;
							2:     spriteset_empty;}	
	
