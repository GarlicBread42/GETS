			cost_factor						: 163;
			running_cost_factor				: switch_running_cost_ET_30;
			
			}
	}	


					switch(FEAT_TRAINS, SELF, switch_ET_30_graphics_ozeanblau, position_in_vehid_chain % 9) {
							0:	   spriteset_empty;
							1:     return switch_spritestack_ET_30_front_ozeanblau;
							2:     spriteset_empty;
							3:	   spriteset_empty;
							4:     return switch_spritestack_ET_30_middle_ozeanblau;
							5:     spriteset_empty;							
							6:	   spriteset_empty;
							7:	   return switch_spritestack_ET_30_back_ozeanblau;
							8:	   spriteset_empty;}	

					switch (FEAT_TRAINS, SELF, switch_articulated_ET_30_ozeanblau, extra_callback_info1) {
						1 .. 8: return ITEM_ET_30_OZEANBLAU; 
						return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}							

item (FEAT_TRAINS , ITEM_ET_30_OZEANBLAU, 4304)
