							1900 .. 1945 : spriteset_Abteil_21_purchase1;
							1946 .. 2050 : spriteset_Abteil_21_purchase2;
							spriteset_Abteil_21_purchase2;}																																				

						switch(FEAT_TRAINS, SELF, switch_loadstack_Abteil_21_B_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_Abteil_21_B_DRG;
							1: spritegroup_Abteil_21_B_load;}

						switch(FEAT_TRAINS, SELF, switch_loadstack_Abteil_21_B_DB, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_Abteil_21_B_DB;
