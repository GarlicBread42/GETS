							0: spriteset_DOSTO_2GEN_B_VERKEHRSROT;
							1: spritegroup_DOSTO_2GEN_VERKEHRSROT;}	

						switch(FEAT_TRAINS, SELF, switch_spritestack_DOSTO_2GEN_AB_VERKEHRSROT, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_DOSTO_2GEN_AB_VERKEHRSROT;
							1: spritegroup_DOSTO_2GEN_VERKEHRSROT;}	
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_DOSTO_2GEN_B_METRONOM, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_DOSTO_2GEN_B_METRONOM;
							1: spritegroup_DOSTO_2GEN_METRONOM;}								
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_DOSTO_2GEN_VVO, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_DOSTO_2GEN_B_VVO;
							1: spritegroup_DOSTO_2GEN_VERKEHRSROT;}									
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_DOSTO_2GEN_HKX, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_DOSTO_2GEN_B_HKX;
							1: spritegroup_DOSTO_2GEN_HKX;}																										
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_DOSTO_2GEN_ALEX, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_DOSTO_2GEN_B_ALEX;
							1: spritegroup_DOSTO_2GEN_ALEX;}	
														
						switch (FEAT_TRAINS, SELF, random_choose_DOSTO_2GEN_Verkehrsrot, switch_alternative_var_random_bits(1, 1)) {
							1: switch_spritestack_DOSTO_2GEN_B_VERKEHRSROT;
							  switch_spritestack_DOSTO_2GEN_AB_VERKEHRSROT;}								
					
						switch(FEAT_TRAINS, SELF, switch_length_DOSTO_2GEN, position_in_articulated_veh % 3) {
							0: 4;
							1: 7;
							2: 4;}
							
						switch(FEAT_TRAINS,PARENT,switch_running_cost_Dosto_2GEN, 1){
							return 3750;}							

						switch(FEAT_TRAINS, SELF, switch_DOSTO_2GEN_graphics_verkehrsrot, position_in_articulated_veh  % 3) {
							0:     spriteset_empty;
							1:     return random_choose_DOSTO_2GEN_Verkehrsrot;
							2:     spriteset_empty;}	
							
						switch (FEAT_TRAINS, SELF, switch_articulated_DOSTO_2GEN_verkehrsrot, extra_callback_info1) {
							1 .. 2: return ITEM_DOSTO_2GEN_VERKEHRSROT;
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}

item (FEAT_TRAINS , ITEM_DOSTO_2GEN_VERKEHRSROT, 7410)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_DOSTO_2GEN_VERKEHRSROT);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(2000,01,01);
						model_life: 					VEHICLE_NEVER_EXPIRES;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);
						refittable_cargo_classes:		bitmask(CC_PASSENGERS);
						cargo_allow_refit:				[PASS, TOUR];
						loading_speed:					15;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							160 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						60 ton;
						dual_headed: 					0;
						default_cargo_type:				PASS;
						cargo_capacity:					50;
						ai_engine_rank: 				0;
						length: 						8;
												
			}
			
	//Vehicels Graphics
			graphics
			{
			default:						switch_DOSTO_2GEN_graphics_verkehrsrot;
			additional_text:				string(STR_DESC_PASS);
			length:							switch_length_DOSTO_2GEN;
			articulated_part:				switch_articulated_DOSTO_2GEN_verkehrsrot;
			purchase:						spriteset_DOSTO_2GEN_purchase_VERKEHRSROT;
			cost_factor:					765;
			running_cost_factor:			switch_running_cost_Dosto_2GEN;								
			 }
		}						

						switch(FEAT_TRAINS, SELF, switch_DOSTO_2GEN_graphics_metronom, position_in_articulated_veh  % 3) {
							0:     spriteset_empty;
							1:     return switch_spritestack_DOSTO_2GEN_B_METRONOM;
							2:     spriteset_empty;}	
							
						switch (FEAT_TRAINS, SELF, switch_articulated_DOSTO_2GEN_metronom, extra_callback_info1) {
							1 .. 2: return ITEM_DOSTO_2GEN_METRONOM;
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}

