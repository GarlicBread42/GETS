					{template_purchase(0, 0)}					

//Switches

					switch (FEAT_TRAINS,PARENT,switch_H02_Regensburg_check_BAYKWSE, switch_check_BAY_0()) {
							0: spriteset_H02_Regensburg_KPEV; 
								spriteset_H02_Regensburg_KBAY;}

					switch(FEAT_TRAINS, SELF, switch_loadstack_H02_Regensburg_Wood, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: switch_H02_Regensburg_check_BAYKWSE;
						1: spritegroup_H02_Regensburg_load_Wood;}

					switch(FEAT_TRAINS, SELF, switch_loadstack_H02_Regensburg_Timber, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: switch_H02_Regensburg_check_BAYKWSE;
						1: spritegroup_H02_Regensburg_load_Timber;}
						
					switch (FEAT_TRAINS, SELF, switch_H02_Regensburg_cargo_type, cargo_type_in_veh) {		
							BDMT: return switch_loadstack_H02_Regensburg_Timber;
							WDPR: return switch_loadstack_H02_Regensburg_Timber;						
							WOOD: return switch_loadstack_H02_Regensburg_Wood;							
								switch_loadstack_H02_Regensburg_Wood;}																									
												
					switch(FEAT_TRAINS, SELF, switch_length_H02_Regensburg, position_in_vehid_chain % 3) {
						0: 4;
						1: 3;
						2: 4;}
						
					switch(FEAT_TRAINS,PARENT,switch_running_cost_H02_Regensburg, 1){
						return 130;}	
																																																																											
					switch(FEAT_TRAINS, SELF, switch_H02_Regensburg_graphics_current, position_in_vehid_chain % 3) {
						0:	   spriteset_empty;
						1:     return switch_H02_Regensburg_cargo_type;
						2:	   spriteset_empty;}	
						
					switch (FEAT_TRAINS, SELF, switch_articulated_H02_Regensburg_current, extra_callback_info1) {
						1 .. 2: return ITEM_H02_REGENSBURG_CURRENT;
						return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}				

