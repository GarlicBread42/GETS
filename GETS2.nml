	switch(FEAT_TRAINS, SELF, switch_FX_BR_403, position_in_vehid_chain % 24) {
			0 .. 4: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE,0, DISABLE_WAGON_POWER);
			5: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC,0, DISABLE_WAGON_POWER);
