//Switches

					 switch (FEAT_TRAINS,SELF, switch_VH_Altona_purchase,current_year){
							1800 .. 1919: spriteset_VH_Altona_purchase_1;
							1920 .. 1955: spriteset_VH_Altona_purchase_2;				 					 
							spriteset_VH_Altona_purchase_2;}					

					switch (FEAT_TRAINS, SELF, random_choose_VH_Altona_KPEV, switch_alternative_var_random_bits(1, 1)) {
							1: spritegroup_VH_Altona_KPEV_OBH;
								spritegroup_VH_Altona_KPEV_MBH;}
								
					switch (FEAT_TRAINS, SELF, random_choose_VH_Altona_DRG, switch_alternative_var_random_bits(1, 1)) {
							1: spritegroup_VH_Altona_DRG_OBH;
								spritegroup_VH_Altona_DRG_MBH;}	
								
					switch (FEAT_TRAINS,SELF,switch_graphics_VH_Altona,current_year) {
							1880 .. 1919 : random_choose_VH_Altona_KPEV;
							1920 .. 1955 : random_choose_VH_Altona_DRG;
							random_choose_VH_Altona_DRG;}															

					switch(FEAT_TRAINS,PARENT,switch_running_cost_VH_Altona, 1){
							return 43;}	

item (FEAT_TRAINS , ITEM_VH_ALTONA, 8500)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_VH_ALTONA);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1885,01,01);
						model_life: 					65;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						cargo_allow_refit:              [LVST];
						loading_speed:					6;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							50 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						11 ton;
						dual_headed: 					0;
						default_cargo_type:				LVST;
						cargo_capacity:					10;
						ai_engine_rank: 				0;
						length: 						5;
												
			}
			
	//Vehicels Graphics
			graphics
			{
			default							: switch_graphics_VH_Altona;
			additional_text					: string(STR_DESC_GOODS);
			purchase						: switch_VH_Altona_purchase;
			cost_factor						: 23;
			running_cost_factor				: switch_running_cost_VH_Altona;				
			
			 }
		}
