									{ template_purchase(0, 0)}
																		
//Switches

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_55_25_purchase1, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_55_25_purchase1;
							1: spriteset_BR_55_25_purchase_anim;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_55_25_purchase2, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_55_25_purchase2;
							1: spriteset_BR_55_25_purchase_anim;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_55_25_purchase3, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_55_25_purchase3;
							1: spriteset_BR_55_25_purchase_anim;}														

						switch (FEAT_TRAINS,SELF, switch_BR_55_25_purchase,current_year){
							  00 .. 1919: switch_spritestack_BR_55_25_purchase1;
							1920 .. 1945: switch_spritestack_BR_55_25_purchase2;
							1946 .. 1990: switch_spritestack_BR_55_25_purchase3;	
							switch_spritestack_BR_55_25_purchase3;}

						switch (FEAT_TRAINS, SELF, switch_animation_BR_55_25, motion_counter % 4) {
							0: spriteset_BR_55_25_anim1;
							1: spriteset_BR_55_25_anim2;
							2: spriteset_BR_55_25_anim3;
							3: spriteset_BR_55_25_anim4;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_55_25_KPEV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_55_25_KPEV;
							1: return switch_animation_BR_55_25;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_55_25_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_55_25_DRG;
							1: return switch_animation_BR_55_25;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_55_25_DB, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_55_25_DB;
							1: return switch_animation_BR_55_25;}														
							
						switch (FEAT_TRAINS,SELF, switch_BR_55_25_current_year,current_year){
							   00 .. 1919: switch_spritestack_BR_55_25_KPEV;
							 1920 .. 1945: switch_spritestack_BR_55_25_DRG;
							 1946 .. 1990: switch_spritestack_BR_55_25_DB; 						 					 
							 switch_spritestack_BR_55_25_DB;}
							 
						switch (FEAT_TRAINS,SELF, switch_BR_55_25_build_year,build_year){
							   00 .. 1919: switch_spritestack_BR_55_25_KPEV;
							 1920 .. 1945: switch_spritestack_BR_55_25_DRG;
							 1946 .. 1990: switch_spritestack_BR_55_25_DB; 						 					 
							 switch_spritestack_BR_55_25_DB;}	
							 
						switch (FEAT_TRAINS,SELF, switch_BR_55_25_Tender_current_year,current_year){
							   00 .. 1919: spriteset_Tender_3T16_5_KPEV;
							 1920 .. 1945: spriteset_Tender_3T16_5_DRG;
							 1946 .. 1990: spriteset_Tender_3T16_5_DB; 						 					 
							 spriteset_Tender_3T16_5_DB;}
							 
						switch (FEAT_TRAINS,SELF, switch_BR_55_25_Tender_build_year,build_year){
							   00 .. 1919: spriteset_Tender_3T16_5_KPEV;
							 1920 .. 1945: spriteset_Tender_3T16_5_DRG;
							 1946 .. 1990: spriteset_Tender_3T16_5_DB; 						 					 
							 spriteset_Tender_3T16_5_DB;}

						switch(FEAT_TRAINS, SELF, switch_length_BR_55_25, position_in_vehid_chain % 2) {
							0: 7;
							1: 4;}
							
						switch(FEAT_TRAINS, SELF, switch_FX_BR_55_25, position_in_vehid_chain % 2) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_STEAM, -2, DISABLE_WAGON_POWER);
