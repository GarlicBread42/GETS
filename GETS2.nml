							0: spriteset_BR_610_back_regio;
							1: spritegroup_BR_610_back_loading_regio;}														

						switch(FEAT_TRAINS,SELF, switch_BR_610_front_mint_curv, curv_info){
							vehicle_curv_info (2,1): spriteset_BR_610_front_tiltleft_mint;	
							vehicle_curv_info (2,0): spriteset_BR_610_front_tiltleft_mint;													
							vehicle_curv_info (1,0): spriteset_BR_610_front_tiltleft_mint;
							vehicle_curv_info (0,1): spriteset_BR_610_front_tiltleft_mint;
							vehicle_curv_info (0,2): spriteset_BR_610_front_tiltleft_mint;		
							vehicle_curv_info (1,2): spriteset_BR_610_front_tiltleft_mint;												
							vehicle_curv_info (-1,0): spriteset_BR_610_front_tiltright_mint;
							vehicle_curv_info (-2,0): spriteset_BR_610_front_tiltright_mint;
							vehicle_curv_info (-2,1): spriteset_BR_610_front_tiltright_mint;														
							vehicle_curv_info (0,-1): spriteset_BR_610_front_tiltright_mint;	
							vehicle_curv_info (0,-2): spriteset_BR_610_front_tiltright_mint;		
							vehicle_curv_info (1,-2): spriteset_BR_610_front_tiltright_mint;																		
