							1920 .. 1932 : switch_spritestack_ET_87_back_DRG2;
							1933 .. 1945 : switch_spritestack_ET_87_back_DRG1;							
							1946 .. 2000 : switch_spritestack_ET_87_back_DB;							
							switch_spritestack_ET_87_back_DB;}	

						switch(FEAT_TRAINS, SELF, switch_BR_ET_87_graphics_build, position_in_vehid_chain % 5) {
							0:	   spriteset_empty;
							1:     return switch_ET_87_front_build_year;
							2:     switch_ET_87_middle_build_year;
							3:	   spriteset_empty;
							4:     return switch_ET_87_back_build_year;}	
														
						switch (FEAT_TRAINS, SELF, switch_articulated_ET_87_build, extra_callback_info1) {
							1 .. 4: return ITEM_ET_87_BUILD; 
							return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}													

item (FEAT_TRAINS , ITEM_ET_87_BUILD, 4870)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_ET_87_BUILD);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1914,01,01);
						model_life: 					45;
						vehicle_life: 					40;
						retire_early: 					-10;							
						reliability_decay: 				20;
						misc_flags						: bitmask(TRAIN_FLAG_SPRITE_STACK);	
						cargo_allow_refit:              [PASS, TOUR];
						cargo_capacity:                 23 ;
						loading_speed:					5;
						cost_factor: 					108;
						running_cost_base:				RUNNING_COST_STEAM;						
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							70 km/h;
						refit_cost: 					0;
						track_type: 					AC15;	
						power:  						680 hp;
						weight: 						99 ton;
						ai_engine_rank: 				0;
						engine_class: 					ENGINE_CLASS_DIESEL;
						visual_effect_and_powered: 		visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
						dual_headed: 					0;
						tractive_effort_coefficient: 	0.08;
						length: 						8;
												
			}

		//Vehicels Graphics
			graphics
			{
			default							: switch_BR_ET_87_graphics_build;
			additional_text					: string(STR_CONCAT_2, 
											  string(STR_TRACTION_ELECTRIC), 
											  string(STR_DESC_PASS),);
			length							: switch_ET_87_length;	
			articulated_part				: switch_articulated_ET_87_build;
			visual_effect_and_powered		: switch_FX_ET_87;
			purchase						: switch_purchase_ET_87;
			cost_factor						: 42;
			running_cost_factor				: switch_running_cost_ET_87;		
			}
	}

	
						switch (FEAT_TRAINS,SELF,switch_ET_87_front_current_year,current_year){
