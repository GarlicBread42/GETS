//Switches

						switch (FEAT_TRAINS, SELF, switch_purchase_4iPR23, current_year){
							1900 .. 1945 : spriteset_4iPR23_purchase1;
							1946 .. 2050 : spriteset_4iPR23_purchase2;
							spriteset_4iPR23_purchase2;}																																				

						switch(FEAT_TRAINS, SELF, switch_loadstack_4iPR23_BC_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_4iPR23_DRG_BC;
							1: spritegroup_4iPR23_CD_loading;}
							
						switch(FEAT_TRAINS, SELF, switch_loadstack_4iPR23_C_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_4iPR23_DRG_C;
							1: spritegroup_4iPR23_C_loading;}							
							
						switch(FEAT_TRAINS, SELF, switch_loadstack_4iPR23_CD_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_4iPR23_DRG_CD;
