									{ template_purchase(0, 0)}

//Switches

						switch (FEAT_TRAINS,SELF, switch_V_100_purchase,current_year){
							   0 .. 1974: spriteset_v_100_purchase1;
							1975 .. 1987: spriteset_v_100_purchase2;	
							1988 .. 1999: spriteset_v_100_purchase3;
							2000 .. 2045: spriteset_v_100_purchase4;														 					 
								spriteset_v_100_purchase4;}

		
						switch (FEAT_TRAINS,SELF, switch_V_100_current_year,current_year){
							   0 .. 1974: spriteset_v_100_altrot;
							1975 .. 1987: spriteset_v_100_ozeanblau;
							1988 .. 1999: spriteset_v_100_orientrot;		
							2000 .. 2050: spriteset_v_100_verkehrsrot;								 					 
								spriteset_v_100_altrot;}
		
						switch (FEAT_TRAINS,SELF, switch_V_100_build_year,build_year){
						       0 .. 1974: spriteset_v_100_altrot;
							1975 .. 1987: spriteset_v_100_ozeanblau;
							1988 .. 1999: spriteset_v_100_orientrot;
							2000 .. 2050: spriteset_v_100_verkehrsrot;	
								spriteset_v_100_altrot;}
						
						switch(FEAT_TRAINS,PARENT,switch_running_cost_V_100, 1){
							return 975;}							

