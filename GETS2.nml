									{ template_98trains_1x(0, 0)}
				
		alternative_sprites (spriteset_BR_425_middle_loaddummy, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\BR_425/BR_425_middle_loaddummy_1x_32bpp.png", "gfx\BR_425/BR_425_middle1_1x_mask.png")
