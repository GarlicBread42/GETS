					switch (FEAT_TRAINS, SELF, random_choose_BR_145_private, switch_alternative_var_random_bits(3,3)) {
							0: spriteset_BR_145_RBH;
							1: spriteset_BR_145_MRCE;
							2: spriteset_BR_145_HGK;
							3: spriteset_BR_145_Arcelor;
							4: spriteset_BR_145_Alpha;
							5: spriteset_BR_145_HGK;
							6: spriteset_BR_145_RBH;
							7: spriteset_BR_145_MRCE;}				

						 switch (FEAT_TRAINS,SELF, switch_BR_145_current_year,current_year){
							1900 .. 1995: spriteset_BR_145_verkehrsrot;
							1996 .. 1999: spriteset_BR_145_cargo;
							2000 .. 2009: spriteset_BR_145_Railion;					 					 
								spriteset_BR_145_verkehrsrot;}
	
						 switch (FEAT_TRAINS,SELF, switch_BR_145_build_year,build_year){
							1900 .. 1995: spriteset_BR_145_verkehrsrot;
							1996 .. 1999: spriteset_BR_145_cargo;
							2000 .. 2009: spriteset_BR_145_Railion;					 					 
								spriteset_BR_145_verkehrsrot;}							

						switch(FEAT_TRAINS, SELF, switch_cargo_dependant_BR_145_current, most_common_cargo_type){
							PASS: spriteset_BR_145_verkehrsrot;
							MAIL: spriteset_BR_145_verkehrsrot;
								switch_BR_145_current_year;}
						
						switch(FEAT_TRAINS, SELF, switch_cargo_dependant_BR_145_build, most_common_cargo_type){
							PASS: spriteset_BR_145_verkehrsrot;
							MAIL: spriteset_BR_145_verkehrsrot;
								switch_BR_145_build_year;}																					
					
						switch(FEAT_TRAINS, SELF, switch_length_BR_145, position_in_vehid_chain % 3) {
							0: 4;
							1: 4;
							2: 4;}
						
						switch(FEAT_TRAINS, SELF, switch_FX_BR_145, position_in_vehid_chain % 3) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
								return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}						

						switch(FEAT_TRAINS,PARENT,switch_running_cost_BR_145, 1){
						return 2150;}

						switch(FEAT_TRAINS, SELF, switch_BR_145_graphics_build, position_in_vehid_chain % 3) {
							0:	   spriteset_empty;
							1:     return switch_cargo_dependant_BR_145_build;
							2:	   spriteset_empty;}

						switch (FEAT_TRAINS, SELF, switch_articulated_BR_145_build, extra_callback_info1) {
							1 .. 2: return ITEM_BR_145_BUILD; 				
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}
						
item (FEAT_TRAINS , ITEM_BR_145_BUILD, 1450)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_BR_145_BUILD);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);							
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1997,01,01);
						model_life: 					40;
						vehicle_life: 					40;
						retire_early: 					-10;							
						reliability_decay: 				20;
						cargo_allow_refit: 				[PASS] ;
						cargo_capacity: 				1 ;
						cost_factor: 					108;
						running_cost_base: 				RUNNING_COST_STEAM;						
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							140 km/h;
						refit_cost: 					0;
						track_type: 					AC15;
						power:  						5712 hp;
						weight: 						80 ton;
						ai_engine_rank: 				0;
						engine_class: 					ENGINE_CLASS_ELECTRIC;
						visual_effect_and_powered: 		visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
						dual_headed: 					0;
						tractive_effort_coefficient: 	0.375;
						length: 						8;												
			}

		//Vehicels Graphics
			graphics
			{
			default							: switch_BR_145_graphics_build;
			additional_text					: string(STR_CONCAT_2, 
											  string(STR_TRACTION_ELECTRIC), 
											  string(STR_DESC_UNIVERSAL),);
			length							: switch_length_BR_145;
			articulated_part				: switch_articulated_BR_145_build;
			purchase_cargo_capacity		    : 0 ;
			cargo_capacity	                : return 0 ;
			purchase						: spriteset_BR_145_purchase;
			cost_factor						: 131;
			running_cost_factor				: switch_running_cost_BR_145;
			visual_effect_and_powered		: switch_FX_BR_145;
			}
	}	

						switch(FEAT_TRAINS, SELF, switch_BR_145_graphics_current, position_in_vehid_chain % 3) {
							0:	   spriteset_empty;
							1:     return switch_cargo_dependant_BR_145_current;
							2:	   spriteset_empty;}

						switch (FEAT_TRAINS, SELF, switch_articulated_BR_145_current, extra_callback_info1) {
							1 .. 2: return ITEM_BR_145_CURRENT; 				
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}
																
