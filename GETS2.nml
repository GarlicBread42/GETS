						switch (FEAT_TRAINS, PARENT, switch_speed_BT_10,  switch_check_PWG_0()) {
							1: return 100;
							0: return 80;}	
							
						switch(FEAT_TRAINS,PARENT,switch_running_cost_BT_10, 1){
							return 130;}	
							
item (FEAT_TRAINS , ITEM_BT_10, 9840)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_BT_10);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1950,01,01);
						model_life: 					30;
						vehicle_life: 					30;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes: 		bitmask(CC_PIECE_GOODS, CC_BULK, CC_LIQUID );
						cargo_allow_refit:              [ACID, BEER, NH3_, BEAN, BDMT, CBLK, CASS, CMNT, RFPR, CHLO, SOAP, COAL, CTAR, JAVA, COKE, CORE, EOIL, POWR, ENSP, BOOM, FMSP, FECR, FERT, GLAS, GOOD, IORE, LIME, MAIL, MNO2, MILK, NITR, NUTS, OIL_, O2__, COAT, PAPR, PEAT, PETR, PHOS, PLAS, POTA, PORE, QLME, RUBR, SALT, SAND, SASH, LYE_, GRVL, SULP, TYRE, WOOL, ZINC,];
						cargo_disallow_refit: 			[STAL, ALUM, STCB, CSTI, KAOL, CLAY, COPR, DIAM, FISH, FOOD, FRUT, GRAI, LVST, WOOD, MAIZ, IRON, PIPE, SCMT, SLAG, STST, STEL, STSE, STSH, STWR, WDPR, VBOD, VENG, VEHI,];
						misc_flags: 					bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_SPRITE_STACK);
						loading_speed:					5;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							80 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						8 ton;
						dual_headed: 					0;
						default_cargo_type:				GOOD;
						cargo_capacity:					20;
						ai_engine_rank: 				0;
						length: 						6;
												
			}
			
	//Vehicels Graphics
			graphics
			{
			default							: switch_BT_10_cargo_type;
			additional_text					: string(STR_DESC_CABOOSE_100);
			purchase						: spriteset_BT_10_purchase;
			speed							: switch_speed_BT_10;
			cost_factor						: 58;
			running_cost_factor				: switch_running_cost_BT_10;
			colour_mapping					: switch_bulk_recolour;
			 }
		}																																								
