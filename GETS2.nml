//Switches					
						random_switch (FEAT_TRAINS, SELF, random_choose_G10_NEUT,) {				
						    1: spritegroup_G10_NEUT1_MBH;						   
							1: spritegroup_G10_NEUT1_OBH;	
							1: spritegroup_G10_NEUT2_MBH;	
							1: spritegroup_G10_NEUT2_OBH;	
							1: spritegroup_G10_NEUT3_MBH;	
							1: spritegroup_G10_NEUT3_OBH;						   						   						   						   						   																				   						   
							1: spritegroup_G10_NEUT1_OBH;}								
												
						random_switch (FEAT_TRAINS, SELF, random_choose_G10_BAY) {
							1: spritegroup_G10_bay_MBH;
							1: spritegroup_G10_bay_OBH;}	

						random_switch (FEAT_TRAINS, SELF, random_choose_G10,) {				
							1: spritegroup_G10_ADV1_MBH;
							1: spritegroup_G10_ADV1_OBH;
							1: spritegroup_G10_ADV2_OBH;
							1: spritegroup_G10_ADV3_OBH;
							1: spritegroup_G10_ADV4_MBH;
							1: spritegroup_G10_ADV4_OBH;
							1: spritegroup_G10_ADV5_MBH;
							1: spritegroup_G10_ADV5_OBH;
							1: spritegroup_G10_ADV6_MBH;
							1: spritegroup_G10_ADV6_OBH;
						    3: spritegroup_G10_NEUT1_MBH;						   
							3: spritegroup_G10_NEUT1_OBH;	
							3: spritegroup_G10_NEUT2_MBH;	
							3: spritegroup_G10_NEUT2_OBH;	
							3: spritegroup_G10_NEUT3_MBH;	
							3: spritegroup_G10_NEUT3_OBH;						   						   						   						   						   																				   						   
							3: spritegroup_G10_NEUT1_OBH;}	
							
						random_switch (FEAT_TRAINS, SELF, random_choose_G10_ADV,) {				
							1: spritegroup_G10_ADV1_MBH;
							1: spritegroup_G10_ADV1_OBH;
							1: spritegroup_G10_ADV2_OBH;
							1: spritegroup_G10_ADV3_OBH;
							1: spritegroup_G10_ADV4_MBH;
							1: spritegroup_G10_ADV4_OBH;
							1: spritegroup_G10_ADV5_MBH;
							1: spritegroup_G10_ADV5_OBH;
							1: spritegroup_G10_ADV6_MBH;
							1: spritegroup_G10_ADV6_OBH;}												
					
					switch (FEAT_TRAINS,PARENT,switch_G10_check_BAYKWSE, switch_check_BAY_0()) {
							0: random_choose_G10; 
								random_choose_G10_BAY;}
								
					switch (FEAT_TRAINS,SELF,switch_graphics_G10,current_year) {
						1880 .. 1919 : switch_G10_check_BAYKWSE;
						1920 .. 2000 : random_choose_G10;
						random_choose_G10;}
																																											 
					switch (FEAT_TRAINS, PARENT, switch_speed_G10,  switch_check_PWG_0()) {
						1: return 65;
						0: return 50;}
						
					switch(FEAT_TRAINS,PARENT,switch_running_cost_G10, 1){
						return 60;}
						
item (FEAT_TRAINS , ITEM_G10, 8255)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_G10);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);						
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1914,01,01);
						model_life: 					71;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes:		bitmask(CC_PIECE_GOODS);
						cargo_allow_refit:              [MAIL,GOOD,VALU,PAPR,DIAM,BDMT,BEER,BOOM,BRCK,CERA,CERE,DYES,ENSP,FERT,FICR,FMSP,GLAS,JAVA,PLAS,TYRE,WDPR,WOOL,ZINC,ALUM,BAKE,CIGR,COAT,COBL,FURN,METL,MNSP,MPTS,NUTS,PCL_,PIPE,SEED,SESP,SOAP,STAL,STCB,STSE,STSH,STST,STWR,TATO,VENG,VPTS,BATT,BUBL,FZDR,TOYS,];
						loading_speed:					6;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							50 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						11 ton;
						dual_headed: 					0;
						default_cargo_type:				GOOD;
						cargo_capacity:					30;
						ai_engine_rank: 				0;
						length: 						6;
												
			}
			
	//Vehicels Graphics
			graphics
			{
			default							: switch_graphics_G10;
			additional_text					: string(STR_DESC_CABOOSE_65);
			purchase						: spriteset_G10_purchase_NEUT;
			speed							: switch_speed_G10;
			cost_factor						: 29;
			running_cost_factor				: switch_running_cost_G10;				
			
			 }
		}


