					{template_purchase(0, 0)}	
				
		alternative_sprites (spriteset_Oot_Oldenburg_purchase1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\Oot_Oldenburg/Oot_Oldenburg_DRG_1x_32bpp.png", "gfx\Oot_Oldenburg/Oot_Oldenburg_DRG_1x_mask.png")
					{template_purchase(0, 0)}
					
spriteset (spriteset_Oot_Oldenburg_purchase2, "gfx\Oot_Oldenburg/Oot_Oldenburg_DB_1x_8bpp.png")
					{template_purchase(0, 0)}	
				
		alternative_sprites (spriteset_Oot_Oldenburg_purchase2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\Oot_Oldenburg/Oot_Oldenburg_DB_1x_32bpp.png", "gfx\Oot_Oldenburg/Oot_Oldenburg_DB_1x_mask.png")
					{template_purchase(0, 0)}
					
					
//Switches

					 switch (FEAT_TRAINS,SELF, switch_Oot_Oldenburg_purchase,current_year){
							1900 .. 1945: spriteset_Oot_Oldenburg_purchase1;
							1946 .. 2050: spriteset_Oot_Oldenburg_purchase2;				 					 
							spriteset_Oot_Oldenburg_purchase2;}
							
					 switch (FEAT_TRAINS,SELF, switch_Oot_Oldenburg_current_year,current_year){
							1900 .. 1945: spriteset_Oot_Oldenburg_DRG;
							1946 .. 2050: spriteset_Oot_Oldenburg_DB;				 					 
							spriteset_Oot_Oldenburg_DB;}							

					switch(FEAT_TRAINS, SELF, switch_Oot_Oldenburg_loadstack, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: return switch_Oot_Oldenburg_current_year;
						1: spritegroup_Oot_Oldenburg_load;}

					switch(FEAT_TRAINS,PARENT,switch_running_cost_Oot_Oldenburg, 1){
						return 250;}
						
item (FEAT_TRAINS , ITEM_OOT_OLDENBURG, 8753)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_OOT_OLDENBURG);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1927,01,01);
						model_life: 					45;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes: 		bitmask(CC_BULK);
						non_refittable_cargo_classes: 	bitmask(CC_LIQUID, CC_REFRIGERATED, CC_HAZARDOUS, CC_OVERSIZED, CC_COVERED);
						cargo_allow_refit:              [COAL, IORE, CORE, COKE, AORE, CLAY, FECR, GRVL, KAOL, LIME, PHOS, PORE, POTA, SAND, SULP, URAN, CASS, MNO2, NICK, NITR, NKOR, QLME, RCYC, SALT, SASH, SLAG, TOFF,];
						cargo_disallow_refit: 			[BDMT, CMNT, FERT, FICR, GRAI, RCYC, SCMT, SCRP, SALT, PEAT, BEAN, SUGR, SGBT, SGCN, TWOD, WDPR,];
						misc_flags: 					bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_SPRITE_STACK);
						loading_speed:					10;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							50 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						21 ton;
						dual_headed: 					0;
						default_cargo_type:				COAL;
						cargo_capacity:					54;
						ai_engine_rank: 				0;
						length: 						7;
												
			}
			
	//Vehicels Graphics
			graphics
			{
			default							: switch_Oot_Oldenburg_loadstack;
			additional_text					: string(STR_DESC_GOODS);
			purchase						: switch_Oot_Oldenburg_purchase;
			cost_factor						: 99;
			running_cost_factor				: switch_running_cost_Oot_Oldenburg;				
			colour_mapping					: switch_bulk_recolour;
			 }
		}
