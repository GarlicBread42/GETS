		alternative_sprites (spriteset_BR_445_purchase_Regio, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\BR_445/BR_445_front_Regio_1x_32bpp.png", "gfx\BR_445/BR_445_front_Regio_1x_mask.png")
