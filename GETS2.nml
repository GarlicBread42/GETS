		alternative_sprites (spriteset_Wue_Ci_purchase1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\Wue_4Ci_1903\Wue_CCi_1903_1x_32bpp.png", "gfx\Wue_4Ci_1903\Wue_CCi_1903_1x_mask.png")
