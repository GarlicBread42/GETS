//Switches	

						switch (FEAT_TRAINS, SELF, switch_spritechoose_BR_271_front_headlight, position_in_consist) {
							1: spriteset_BR_271_front_Headlights;
								spriteset_empty;}

						switch (FEAT_TRAINS, SELF, switch_spritechoose_BR_271_front_taillight_REV, position_in_consist_from_end) {
							1: spriteset_BR_271_front_Taillights_REV;
								spriteset_empty;}
								
						switch (FEAT_TRAINS, SELF, switch_spritechoose_BR_271_back_taillight, position_in_consist_from_end) {
							1: spriteset_BR_271_front_Taillights;
								spriteset_empty;}								

						switch (FEAT_TRAINS, SELF, switch_spritechoose_BR_271_back_headlight_REV, position_in_consist) {
							1: spriteset_BR_271_front_Headlights_REV;
								spriteset_empty;}
																								
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_271_HGK, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_271_HGK;
							1: switch_spritechoose_BR_271_front_headlight;
							2: switch_spritechoose_BR_271_back_taillight;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_271_HGK_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_271_HGK_REV;
							1: switch_spritechoose_BR_271_back_headlight_REV;
							2: switch_spritechoose_BR_271_front_taillight_REV;}
								
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_271_KSW, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_271_KSW;
							1: switch_spritechoose_BR_271_front_headlight;
							2: switch_spritechoose_BR_271_back_taillight;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_271_KSW_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_271_KSW_REV;
							1: switch_spritechoose_BR_271_back_headlight_REV;
							2: switch_spritechoose_BR_271_front_taillight_REV;}		
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_271_Chemion, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_271_Chemion;
							1: switch_spritechoose_BR_271_front_headlight;
							2: switch_spritechoose_BR_271_back_taillight;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_271_Chemion_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_271_Chemion_REV;
							1: switch_spritechoose_BR_271_back_headlight_REV;
							2: switch_spritechoose_BR_271_front_taillight_REV;}			
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_271_RO, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_271_RO;
							1: switch_spritechoose_BR_271_front_headlight;
							2: switch_spritechoose_BR_271_back_taillight;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_271_RO_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_271_RO_REV;
							1: switch_spritechoose_BR_271_back_headlight_REV;
							2: switch_spritechoose_BR_271_front_taillight_REV;}																

						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_271_HGK, vehicle_is_reversed) {
							0: switch_spritestack_BR_271_HGK;
								switch_spritestack_BR_271_HGK_REV;}
								
						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_271_KSW, vehicle_is_reversed) {
							0: switch_spritestack_BR_271_KSW;
								switch_spritestack_BR_271_KSW_REV;}																																																					

						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_271_Chemion, vehicle_is_reversed) {
							0: switch_spritestack_BR_271_Chemion;
								switch_spritestack_BR_271_Chemion_REV;}

						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_271_RO, vehicle_is_reversed) {
							0: switch_spritestack_BR_271_RO;
								switch_spritestack_BR_271_RO_REV;}
																																				
						switch(FEAT_TRAINS, SELF, switch_FX_BR_271_REV, position_in_vehid_chain % 2) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
							1: return visual_effect_and_powered(VISUAL_EFFECT_DIESEL, -2, DISABLE_WAGON_POWER);}
						
						switch(FEAT_TRAINS, SELF, switch_FX_BR_271_REV2, position_in_vehid_chain % 2) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 2, DISABLE_WAGON_POWER);
							1: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}		
										
						switch (FEAT_TRAINS, PARENT, switch_FX_BR_271, vehicle_is_reversed) {
							0: switch_FX_BR_271_REV;
								switch_FX_BR_271_REV2;}	

						switch(FEAT_TRAINS, SELF, switch_length_BR_271, position_in_vehid_chain % 2) {
							0: 4;
							1: 6;}
																											
						switch(FEAT_TRAINS,PARENT,switch_running_cost_BR_271, 1){
							return 1300;}

						switch(FEAT_TRAINS, SELF, switch_BR_271_graphics_HGK, position_in_vehid_chain % 2) {
							0:	   spriteset_empty;
							1:     return switch_reverse_BR_271_HGK;}	
							
						switch (FEAT_TRAINS, SELF, switch_articulated_BR_271_HGK, extra_callback_info1) {
							1: return ITEM_BR_271_HGK; 
							return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}							

