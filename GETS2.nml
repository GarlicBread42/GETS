								0: spriteset_E_49_anim1;
								1: spriteset_E_49_anim2;
								2: spriteset_E_49_anim3;
								3: spriteset_E_49_anim4;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_E_49_purchase, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_E_49_purchase;
							1: spriteset_E_49_anim_purchase;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_E_49, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_E_49;
							1: return switch_animation_E_49;}									

						switch(FEAT_TRAINS, SELF, switch_length_E_49, position_in_vehid_chain % 2) {
							0: 4;
							1: 6;}
						
						switch(FEAT_TRAINS, SELF, switch_FX_E_49, position_in_vehid_chain % 2) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
							1: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, -2, DISABLE_WAGON_POWER);}					

						switch(FEAT_TRAINS,PARENT,switch_running_cost_E_49, 1){
							return 1600;}
							
						switch(FEAT_TRAINS, SELF, switch_E_49_graphics, position_in_vehid_chain % 2) {
							0:	   spriteset_empty;
							1:     switch_spritestack_E_49;}	

						switch (FEAT_TRAINS, SELF, switch_articulated_E_49, extra_callback_info1) {
							1: return ITEM_E_49;
						return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}												
						
