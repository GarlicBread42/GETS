spriteset (spriteset_DOSTO_2GEN_DVT_purchase_verkehrsrot, "gfx\DOSTO_2GEN\Dosto_DBpza_DVT_REV_verkehrsrot_1x_8bpp.png")
					{template_purchase(0, 0)}	
				
		alternative_sprites (spriteset_DOSTO_2GEN_DVT_purchase_verkehrsrot, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\DOSTO_2GEN\Dosto_DBpza_DVT_REV_verkehrsrot_1x_32bpp.png", "gfx\DOSTO_2GEN\Dosto_DBpza_DVT_REV_verkehrsrot_1x_mask.png")
