# 1 "GETS2.pnml"
disable_item(FEAT_TRAINS);
# 1 "src/HEADER.pnml" 1
/*
GRF block defines everything - grf-ID is unique
// An inline comment is preceded by two slashes
// If you need multiple lines, each line gets two slashes in front
*/

grf {
			grfid: "SA\08\08" ;
			name: string(STR_GRF_NAME) ;
			desc: string(STR_GRF_DESC) ;
			version: 19;
			min_compatible_version: 36;

	param 0{
		running_cost{
			type		: int ;
			name		: string(STR_PARAM_RUNNING_COST) ;
			desc		: string(STR_PARAM_RUNNING_COST_DESC) ;
			min_value	: 0 ;
			max_value	: 5 ;
			def_value	: 3 ;
			names		: {
				 0	: string(STR_PARAM_VERYVERYCHEAP);
				 1	: string(STR_PARAM_VERYCHEAP);
				 2	: string(STR_PARAM_CHEAP);
				 3	: string(STR_PARAM_DEFAULT);
				 4	: string(STR_PARAM_HIGH);
				 5	: string(STR_PARAM_VERYHIGH);};
				 }
				 }

	param 1{
		purchase_cost{
			type		: int ;
			name		: string(STR_PARAM_PURCHASE_COST) ;
			desc		: string(STR_PARAM_PURCHASE_COST_DESC) ;
			min_value	: 0 ;
			max_value	: 4 ;
			def_value	: 2 ;
			names		: {
				 0	: string(STR_PARAM_VERYCHEAP);
				 1	: string(STR_PARAM_CHEAP);
				 2	: string(STR_PARAM_DEFAULT);
				 3	: string(STR_PARAM_HIGH);
				 4	: string(STR_PARAM_VERYHIGH);};
				 }
				 }
				 }		

train_width_32_px  = 1 ;
traininfo_y_offset = 2 ;
	

basecost {
 	PR_BUILD_VEHICLE_TRAIN: (param[1]-4);
 	PR_BUILD_VEHICLE_WAGON: (param[1]-1);
 	PR_RUNNING_TRAIN_STEAM: (param[0]-6);//original: -4 - zuletzt -5
 	PR_RUNNING_TRAIN_DIESEL:(param[0]-8);//original: -6 - zuletzt -7
}

//Disabling standard trains
disable_item(FEAT_TRAINS, 0, 115);
# 1 "GETS2.pnml" 2
# 1 "src/CARGO_TABLE.pnml" 1
cargotable {
//Default cargos
   PASS, MAIL, COAL, FOOD, GOLD, GOOD, GRAI, IORE, LVST, OIL_, PAPR, STEL, VALU, WHEA, WOOD,

//Tropical cargos
   CORE, DIAM, FRUT, MAIZ, RUBR, WATR, 

//ECS
   AORE, BDMT, BRCK, CERA, CERE, CMNT, DYES, FERT, FICR, FISH, GLAS, LIME, OLSD, PETR, PLAS, POTA, RFPR, SAND, SULP, TOUR, VEHI, WDPR, WOOL, 
   
//FIRS
   ACID, ALUM, BEAN, BEER, BOOM, CLAY, CHLO, CASS, CBLK, COAT, CTAR, CSTI, COKE, ENSP, EOIL, FECR, FMSP, FRVG, GRVL, IRON, KAOL, LYE_, METL, MNO2, MILK, MNSP, NICK, NITR, NUTS, O2__, NH3_, PEAT, PHOS, PIPE, PORE, QLME, RCYC, SALT, SASH, SCMT, SGBT, SGCN, SLAG, SOAP, STAL, STCB, STSE, STSH, STST, STWR, TYRE, VBOD, VENG, VPTS, JAVA, COPR, SUGR, ZINC,
   
   SCRP, //Old scrap metal
   
//OTIS
	BAKE, CHSE, ELTR, FUEL, FURN, MEAT, MPTS, OTI1, OTI2, OYST, PCL_, SEED, SESP, TATO, TEXT, TWOD,

//2TT

CIGR, COBL, MOLS, NKOR, NUKF, NUKW, OILI, OILD, TBCO, WSTE,

//Toyland

BATT, BUBL, COLA, CTCD, FZDR, PLST, SWET, TOFF, TOYS,

//SPECIAL

URAN, POWR,	
  

}
