		alternative_sprites (spriteset_BR_321_purchase3, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BR_321/BR_321_DB_altrot2_1x_32bpp.png", "gfx/BR_321/BR_321_DB_altrot2_1x_mask.png")
									{ template_purchase(0, 0)}	
									
spriteset(spriteset_BR_321_purchase4, "gfx/BR_321/BR_321_DB_verkehrsrot_1x_8bpp.png")
									{ template_purchase(0, 0)}
				
		alternative_sprites (spriteset_BR_321_purchase4, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BR_321/BR_321_DB_verkehrsrot_1x_32bpp.png", "gfx/BR_321/BR_321_DB_verkehrsrot_1x_mask.png")
									{ template_purchase(0, 0)}	
									
