						0: spriteset_Btms_55;
						1: spritegroup_Btms_55_load_Piece;}												

					switch(FEAT_TRAINS, SELF, switch_Btms_55_cargo_classes, cargo_classes) {
							bitmask(CC_PIECE_GOODS) : return switch_loadstack_Btms_55_Piece;
							bitmask(CC_BULK) : return switch_loadstack_Btms_55_Bulk;
