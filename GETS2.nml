							3: switch_loadstack_N_Wagen_verkehrsrot_B;
							   switch_loadstack_N_Wagen_verkehrsrot_AB;}
							   
						switch (FEAT_TRAINS, SELF, random_choose_N_Wagen_Karlsruhe, switch_alternative_var_random_bits(1, 2)) {
							1: switch_loadstack_N_Wagen_Karlsruhe_B;
							2: switch_loadstack_N_Wagen_Karlsruhe_B;
							3: switch_loadstack_N_Wagen_Karlsruhe_B;
							   switch_loadstack_N_Wagen_Karlsruhe_AB;}
							   
						switch (FEAT_TRAINS, SELF, random_choose_N_Wagen_Flughafen, switch_alternative_var_random_bits(1, 2)) {
							1: switch_loadstack_N_Wagen_Flughafen_B;
							2: switch_loadstack_N_Wagen_Flughafen_B;
							3: switch_loadstack_N_Wagen_Flughafen_B;
							   switch_loadstack_N_Wagen_Flughafen_AB;}
							   
						switch (FEAT_TRAINS, SELF, random_choose_N_Wagen_Citybahn, switch_alternative_var_random_bits(1, 3)) {
							1: switch_loadstack_N_Wagen_Citybahn_Cafe;
							2: switch_loadstack_N_Wagen_Citybahn_B;
							3: switch_loadstack_N_Wagen_Citybahn_B;
							4: switch_loadstack_N_Wagen_Citybahn_AB;
							5: switch_loadstack_N_Wagen_Citybahn_AB;
							   switch_loadstack_N_Wagen_Citybahn_B;}							   							   							   

						switch (FEAT_TRAINS, SELF, random_choose_N_Wagen_NatX, switch_alternative_var_random_bits(1, 2)) {
							1: switch_loadstack_N_Wagen_NatX_B;
							2: switch_loadstack_N_Wagen_NatX_B;
							3: switch_loadstack_N_Wagen_NatX_B;
							   switch_loadstack_N_Wagen_NatX_AB;}
							   
						switch (FEAT_TRAINS, SELF, random_choose_N_Wagen_GFF, switch_alternative_var_random_bits(1, 2)) {
							1: switch_loadstack_N_Wagen_GFF_B;
							2: switch_loadstack_N_Wagen_GFF_B;
							3: switch_loadstack_N_Wagen_GFF_B;
							   switch_loadstack_N_Wagen_GFF_AB;}
							   
						switch (FEAT_TRAINS, SELF, random_choose_N_Wagen_Bwegt, switch_alternative_var_random_bits(1, 2)) {
							1: switch_loadstack_N_Wagen_Bwegt_B;
							2: switch_loadstack_N_Wagen_Bwegt_B;
							3: switch_loadstack_N_Wagen_Bwegt_B;
							   switch_loadstack_N_Wagen_Bwegt_AB;}							   							   

						switch(FEAT_TRAINS, SELF, switch_length_N_Wagen, position_in_articulated_veh % 3) {
							0: 4;
							1: 7;
							2: 4;}
							
						switch(FEAT_TRAINS, SELF, switch_speed_N_Wagen, current_year){
							   0 .. 1967: 120;
							1968 .. 2050: 140;
								140;}				

						switch(FEAT_TRAINS,PARENT,switch_running_cost_N_Wagen, 1){
							return 2350;}
							
						switch (FEAT_TRAINS,SELF,switch_build_year_N_Wagen,build_year) {
							  00 .. 1974 : random_choose_N_Wagen_schwarz;
							1975 .. 1987 : random_choose_N_Wagen_ozeanblau;
							1988 .. 1995 : random_choose_N_Wagen_Mint;
							1996 .. 2050 : random_choose_N_Wagen_verkehrsrot;
								random_choose_N_Wagen_verkehrsrot;}							

						switch(FEAT_TRAINS, SELF, switch_N_Wagen_graphics_build, position_in_articulated_veh  % 3) {
							0:     spriteset_empty;
							1:     return switch_build_year_N_Wagen;
							2:     spriteset_empty;}	
								
						switch (FEAT_TRAINS, SELF, switch_articulated_N_Wagen_build, extra_callback_info1) {
							1 .. 2: return ITEM_N_WAGEN_BUILD;
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}

