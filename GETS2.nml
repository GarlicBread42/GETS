	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_BR_01_DB_ABK_SILBER);
						variant_group: 					0010;
						extra_flags:					bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW);
						climates_available:				ALL_CLIMATES;
						introduction_date: 				date(1945,01,01);
						model_life: 					28;
						vehicle_life: 					28;
						reliability_decay: 				20;
						cargo_allow_refit:				[PASS] ;
						misc_flags:						bitmask(TRAIN_FLAG_SPRITE_STACK);	
						cargo_capacity:       			1 ;
						cost_factor: 					108;
						running_cost_base:				RUNNING_COST_STEAM;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							130 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;
						power:  						2240 hp;
						weight: 						171 ton;
						ai_engine_rank: 				0;
						engine_class: 					ENGINE_CLASS_STEAM;
						visual_effect_and_powered: 		visual_effect_and_powered(VISUAL_EFFECT_STEAM, -2, DISABLE_WAGON_POWER);
						dual_headed: 					0;
						tractive_effort_coefficient: 	0.309;
						length: 						8;
												
			}

		//Vehicels Graphics
			graphics
			{
			default						   	: switch_BR_01_graphics_DB_ABK_Silber;
						additional_text:				string(STR_CONCAT_2, 
														string(STR_TRACTION_STEAM), 
														string(STR_DESC_BR_01),);
			length						   	: switch_length_BR_01;
			articulated_part			   	: switch_articulated_BR_01_DB_ABK_Silber;
			purchase_cargo_capacity        	: 0 ;
			cargo_capacity                  : return 0 ;
			purchase						: switch_spritestack_BR_01_purchase4;
			cost_factor					    : 69;
			running_cost_factor				: switch_running_cost_BR_01;
			visual_effect_and_powered		: switch_FX_BR_01;
			power							: switch_power_BR_01;	
			
			}
	}			


						switch(FEAT_TRAINS, SELF, switch_BR_01_graphics_DB_NBK, position_in_articulated_veh % 3) {
							0:	   spriteset_empty;
							1:     return switch_spritestack_BR_01_DB_NBK;
							2:     return spriteset_Tender_22T32_DB;}
							
						switch (FEAT_TRAINS, SELF, switch_articulated_BR_01_DB_NBK, extra_callback_info1) {
							1: return ITEM_BR_01_DB_NBK;
							2: return ITEM_BR_01_DB_NBK;							
							return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}	

