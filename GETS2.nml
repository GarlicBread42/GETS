						1920 .. 2050: switch_loadstack_Om_Ludwigshafen_1909_DRG;			 					 
							switch_loadstack_Om_Ludwigshafen_1909_DRG;}

					switch (FEAT_TRAINS, PARENT, switch_speed_Om_Ludwigshafen_1909,  switch_check_PWG_0()) {
						1: return 65;
						0: return 50;}
													
					switch(FEAT_TRAINS,PARENT,switch_running_cost_Om_Ludwigshafen_1909, 1){
						return 79;}

item (FEAT_TRAINS , ITEM_O_LUDWIGSHAFEN_1909, 8653)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_O_LUDWIGSHAFEN_1909);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1909,01,01);
						model_life: 					40;
