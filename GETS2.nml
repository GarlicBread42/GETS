							1:     return switch_BR_01_build_year;
							2:     return switch_BR_01_tender_build_year;}																																											

						switch(FEAT_TRAINS, SELF, switch_length_BR_01, position_in_vehid_chain % 3) {
							0: 4;
							1: 6;
							2: 5;}

						switch(FEAT_TRAINS, SELF, switch_FX_BR_01, position_in_vehid_chain % 3) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_STEAM, -2, DISABLE_WAGON_POWER);
							return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}	

						switch (FEAT_TRAINS, SELF, switch_articulated_BR_01, extra_callback_info1) {
							1: return ITEM_BR_01;
							2: return ITEM_BR_01;							
							return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}

						switch (FEAT_TRAINS, PARENT, switch_running_cost_BR_01, 1) {
							return 4075;}

						switch (FEAT_TRAINS, PARENT, switch_power_BR_01, current_year) {
							1900 .. 1957: 2240;
							1958 .. 1990: 2330;}							
							

item (FEAT_TRAINS , ITEM_BR_01, 0010)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_BR_01);
						climates_available: 			ALL_CLIMATES;
						introduction_date:  			date(1925,01,01);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						model_life: 					48;
						vehicle_life: 					35;
						reliability_decay: 				20;
						cargo_allow_refit				: [PASS] ;
						misc_flags						: bitmask(TRAIN_FLAG_SPRITE_STACK);	
						cargo_capacity                 : 1 ;
						cost_factor: 108;
						running_cost_base				: RUNNING_COST_STEAM;
						running_cost_factor: 90;
						
			//Train specific properties
						sprite_id: SPRITE_ID_NEW_TRAIN;
						speed: 130 km/h;
						refit_cost: 0;
						track_type: RAIL;
						power:  2240 hp;
						weight: 171 ton;
						ai_engine_rank: 0;
						engine_class: ENGINE_CLASS_STEAM;
						visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_STEAM, -2, DISABLE_WAGON_POWER);
						dual_headed: 0;
						tractive_effort_coefficient: 0.309;
						length: 8;
												
			}

		//Vehicels Graphics
			graphics
			{
			default						   	: switch_BR_01_graphics_buildyear;
						additional_text:				string(STR_CONCAT_2, 
														string(STR_TRACTION_STEAM), 
														string(STR_DESC_BR_01),);
			length						   	: switch_length_BR_01;
			articulated_part			   	: switch_articulated_BR_01;
			purchase_cargo_capacity        	: 0 ;
			cargo_capacity                  : return 0 ;
			purchase						: switch_BR_01_purchase;
			cost_factor					    : 69;
			running_cost_factor				: switch_running_cost_BR_01;
			visual_effect_and_powered		: switch_FX_BR_01;
			power							: switch_power_BR_01;	
			
			}
	}
	
	
						switch(FEAT_TRAINS, SELF, switch_BR_01_graphics_currentyear, position_in_articulated_veh % 3) {
							0:	   spriteset_empty;
							1:     return switch_BR_01_current_year;
							2:     return switch_BR_01_tender_current_year;}		

						switch (FEAT_TRAINS, SELF, switch_articulated_BR_01_current, extra_callback_info1) {
							1: return ITEM_BR_01_CURRENT;
							2: return ITEM_BR_01_CURRENT;							
							return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}

