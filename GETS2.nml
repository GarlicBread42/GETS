									{ template_purchase(0, 0)}


//Switches

						switch(FEAT_TRAINS, SELF, switch_spritestack_VT_11_5_front_TEE, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_VT_11_5_front_TEE;
							1: spritegroup_VT_11_5_front_loading;}	
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_VT_11_5_front_IC, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
