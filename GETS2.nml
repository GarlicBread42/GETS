								switch_spritestack_BR_58_2_DB;}	
						
				switch (FEAT_TRAINS,SELF, switch_BR_58_2_current_year,current_year){
						   0 .. 1917: switch_spritestack_BR_58_2_KPEV1;
						1918 .. 1919: switch_spritestack_BR_58_2_KPEV2;
						1920 .. 1945: switch_spritestack_BR_58_2_DRG;	
						1946 .. 2000: switch_spritestack_BR_58_2_DB;
						switch_spritestack_BR_58_2_DB;}						
							 
