					{template_purchase(0,0)}

																				
//Switches

						switch (FEAT_TRAINS,SELF,switch_purchase_WRmz_135,current_year) {
							   0 .. 1977 : spriteset_WRmz_135_TEE_purchase;
							1978 .. 1985 : spriteset_WRmz_135_IC79_purchase;
							1986 .. 1995 : spriteset_WRmz_135_icalt_purchase;
							1996 .. 1999 : spriteset_WRmz_135_Fern_purchase;
							2000 .. 2050 : spriteset_WRmz_135_ICneu_purchase;
								spriteset_WRmz_135_ICneu_purchase;}	
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_WRmz_135_TEE, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_WRmz_135_TEE;
							1: spritegroup_Arm_217_loading;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_WRmz_135_TEE_late, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_WRmz_135_TEE_late;
							1: spritegroup_Arm_217_loading;}							

						switch(FEAT_TRAINS, SELF, switch_spritestack_WRmz_135_IC79, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_WRmz_135_IC79;
							1: spritegroup_Arm_217_loading;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_WRmz_135_Quickpick1, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_WRmz_135_Quickpick1;
							1: spritegroup_Arm_217_loading;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_WRmz_135_Quickpick2, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_WRmz_135_Quickpick2;
							1: spritegroup_Arm_217_loading;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_WRmz_135_icalt, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_WRmz_135_icalt;
							1: spritegroup_Arm_217_loading;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_WRmz_135_McTrain, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_WRmz_135_McTrain;
							1: spritegroup_Arm_217_loading;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_WRmz_135_Fern, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_WRmz_135_Fern;
							1: spritegroup_Arm_217_loading;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_WRmz_135_Regio, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_WRmz_135_Regio;
							1: spritegroup_Arm_217_loading;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_WRmz_135_ICneu, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_WRmz_135_ICneu;
							1: spritegroup_Arm_217_loading;}
							   																			
						switch(FEAT_TRAINS, SELF, switch_length_WRmz_135, position_in_vehid_chain % 3) {
							0: 4;
							1: 7;
							2: 4;}
						
						switch(FEAT_TRAINS,PARENT,switch_running_cost_WRmz_135, 1){
							return 7800;}	
							
						switch (FEAT_TRAINS, SELF, random_choose_WRmz_135_TEE, switch_alternative_var_random_bits(1, 1)) {
							1: switch_spritestack_WRmz_135_TEE;
							   switch_spritestack_WRmz_135_TEE_late;}
							   
						switch (FEAT_TRAINS, SELF, random_choose_WRmz_135_Quickpick, switch_alternative_var_random_bits(1, 1)) {
							1: switch_spritestack_WRmz_135_Quickpick1;
							   switch_spritestack_WRmz_135_Quickpick2;}							   

						switch (FEAT_TRAINS, SELF, random_choose_WRmz_135_icalt, switch_alternative_var_random_bits(1, 2)) {
							1: switch_spritestack_WRmz_135_icalt;
							2: switch_spritestack_WRmz_135_McTrain;
							3: switch_spritestack_WRmz_135_icalt;
							   switch_spritestack_WRmz_135_icalt;}
													
							
						switch (FEAT_TRAINS,SELF,switch_build_year_WRmz_135,build_year) {
							   0 .. 1977 : random_choose_WRmz_135_TEE;
							1978 .. 1985 : switch_spritestack_WRmz_135_IC79;
							1986 .. 1992 : switch_spritestack_WRmz_135_icalt;
							1993 .. 1995 : random_choose_WRmz_135_icalt;
							1996 .. 1999 : switch_spritestack_WRmz_135_Fern;
							2000 .. 2050 : switch_spritestack_WRmz_135_ICneu;
								switch_spritestack_WRmz_135_ICneu;}													   								

						switch(FEAT_TRAINS, SELF, switch_WRmz_135_graphics_build, position_in_vehid_chain  % 3) {
							0:     spriteset_empty;
							1:     return switch_build_year_WRmz_135;
							2:     spriteset_empty;}	

						switch (FEAT_TRAINS, SELF, switch_articulated_WRmz_135_build, extra_callback_info1) {
							1 ..2: return ITEM_WRMZ_135_BUILD;
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}														

item (FEAT_TRAINS , ITEM_WRMZ_135_BUILD, 5583)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_WRMZ_135_BUILD);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1969,01,01);
						model_life: 					VEHICLE_NEVER_EXPIRES;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);
						refittable_cargo_classes:		bitmask(CC_PASSENGERS);
						cargo_allow_refit:				[PASS, TOUR];
						loading_speed:					7;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						cargo_age_period:				232;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							200 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						50 ton;
						dual_headed: 					0;
						default_cargo_type:				PASS;
						cargo_capacity:					14;
						ai_engine_rank: 				0;
						length: 						8;												
			}
			
	//Vehicels Graphics
			graphics
			{
			default							: switch_WRmz_135_graphics_build;
			additional_text					: string(STR_DESC_RESTAURANT);
			length							: switch_length_WRmz_135;
			articulated_part				: switch_articulated_WRmz_135_build;
			purchase						: switch_purchase_WRmz_135;
			cost_factor						: 860;
			running_cost_factor				: switch_running_cost_WRmz_135;				
			 }
		}


						switch (FEAT_TRAINS,SELF,switch_current_year_WRmz_135,current_year) {
							   0 .. 1977 : random_choose_WRmz_135_TEE;
							1978 .. 1985 : switch_spritestack_WRmz_135_IC79;
							1986 .. 1992 : switch_spritestack_WRmz_135_icalt;
							1993 .. 1995 : random_choose_WRmz_135_icalt;
							1996 .. 1999 : switch_spritestack_WRmz_135_Fern;
							2000 .. 2050 : switch_spritestack_WRmz_135_ICneu;
								switch_spritestack_WRmz_135_ICneu;}															   								

						switch(FEAT_TRAINS, SELF, switch_WRmz_135_graphics_current, position_in_vehid_chain  % 3) {
							0:     spriteset_empty;
							1:     return switch_current_year_WRmz_135;
							2:     spriteset_empty;}	

						switch (FEAT_TRAINS, SELF, switch_articulated_WRmz_135_current, extra_callback_info1) {
							1 ..2: return ITEM_WRMZ_135_CURRENT;
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}														

