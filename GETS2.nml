//Spriteset DRG


spriteset (spriteset_Pwi28_DRG, "gfx\Pwi28\Pwi28_DRG_1x_8bpp.png")
					{template_88trains_1x(0, 0)}	
				
		alternative_sprites (spriteset_Pwi28_DRG, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\Pwi28\Pwi28_DRG_1x_32bpp.png", "gfx\Pwi28\Pwi28_DRG_1x_mask.png")
