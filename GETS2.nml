						switch (FEAT_TRAINS, SELF, switch_animation_BR_44, motion_counter % 4) {
							0: spriteset_BR_44_Anim1;
							1: spriteset_BR_44_Anim2;
							2: spriteset_BR_44_Anim3;
							3: spriteset_BR_44_Anim4;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_44_purchase1, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_44_purchase1;
							1: spriteset_BR_44_purchase_anim;}								
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_44_purchase2, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_44_purchase2;
							1: spriteset_BR_44_purchase_anim;}	

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_44_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_44_DRG;
							1: return switch_animation_BR_44;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_44_DB, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_44_DB;
							1: return switch_animation_BR_44;}

						switch (FEAT_TRAINS,SELF, switch_BR_44_purchase,current_year){
							 1920 .. 1945: switch_spritestack_BR_44_purchase1;
							 1945 .. 1987: switch_spritestack_BR_44_purchase2;						 					 
								switch_spritestack_BR_44_purchase2;}
													
						switch (FEAT_TRAINS,SELF, switch_BR_44_current_year,current_year){
							 1920 .. 1945: switch_spritestack_BR_44_DRG;
							 1945 .. 1987: switch_spritestack_BR_44_DB;						 					 
								switch_spritestack_BR_44_DB;}
		
						switch (FEAT_TRAINS,SELF, switch_BR_44_build_year,build_year){
							 1920 .. 1945: switch_spritestack_BR_44_DRG;
							 1945 .. 1987: switch_spritestack_BR_44_DB;						 					 
								switch_spritestack_BR_44_DB;}

						switch(FEAT_TRAINS, SELF, switch_length_BR_44, position_in_vehid_chain % 3) {
							0: 4;
							1: 6;
							2: 5;}
						
						switch(FEAT_TRAINS, SELF, switch_FX_BR_44, position_in_vehid_chain % 3) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_STEAM, -2, DISABLE_WAGON_POWER);
							return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}
						
						switch (FEAT_TRAINS, PARENT, switch_running_cost_BR_44, 1) {
							return 2175;}

						switch(FEAT_TRAINS, SELF, switch_BR_44_graphics_build, position_in_vehid_chain % 3) {
							0:	   spriteset_empty;
							1:     return switch_BR_44_build_year;
							2:     return switch_Tender_22T32_build_year;}	

						switch (FEAT_TRAINS, SELF, switch_articulated_BR_44_build, extra_callback_info1) {
							1: return ITEM_BR_44; 
							2: return ITEM_BR_44; 															
							return CB_RESULT_NO_MORE_ARTICULATED_PARTS; }
													
