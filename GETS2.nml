//Switches

						switch(FEAT_TRAINS, SELF, switch_spritestack_DTW_Kittel_purchase_KWSE, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_DTW_Kittel_purchase_KWSE;
							1: spriteset_DTW_Kittel_purchase_anim;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_DTW_Kittel_purchase_DRG_gruen, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_DTW_Kittel_purchase_DRG_gruen;
							1: spriteset_DTW_Kittel_purchase_anim;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_DTW_Kittel_purchase_DRG_rotweiss, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_DTW_Kittel_purchase_DRG_rotweiss;
							1: spriteset_DTW_Kittel_purchase_anim;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_DTW_Kittel_purchase_DB, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_DTW_Kittel_purchase_DB;
							1: spriteset_DTW_Kittel_purchase_anim;}																					
							
						switch (FEAT_TRAINS,SELF,switch_purchase_DTW_Kittel,current_year) {
							   0 .. 1919 : switch_spritestack_DTW_Kittel_purchase_KWSE;
							1920 .. 1931 : switch_spritestack_DTW_Kittel_purchase_DRG_gruen;
							1932 .. 1945 : switch_spritestack_DTW_Kittel_purchase_DRG_rotweiss;
							1946 .. 2050 : switch_spritestack_DTW_Kittel_purchase_DB;
							switch_spritestack_DTW_Kittel_purchase_DB;}
							
						switch (FEAT_TRAINS, SELF, switch_animation_DTW_Kittel, motion_counter % 4) {
								0: spriteset_DTW_Kittel_anim1;
								1: spriteset_DTW_Kittel_anim2;
								2: spriteset_DTW_Kittel_anim3;
								3: spriteset_DTW_Kittel_anim4;}	
								
						switch (FEAT_TRAINS, SELF, switch_animation_DTW_Kittel_REV, motion_counter % 4) {
								0: spriteset_DTW_Kittel_anim1_REV;
								1: spriteset_DTW_Kittel_anim2_REV;
								2: spriteset_DTW_Kittel_anim3_REV;
								3: spriteset_DTW_Kittel_anim4_REV;}														

						switch(FEAT_TRAINS, SELF, switch_spritestack_DTW_Kittel_KWSE, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_DTW_Kittel_KWSE;
							1: switch_animation_DTW_Kittel;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_DTW_Kittel_KWSE_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_DTW_Kittel_KWSE_REV;
							1: switch_animation_DTW_Kittel_REV;}							

						switch(FEAT_TRAINS, SELF, switch_spritestack_DTW_Kittel_DRG_gruen, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_DTW_Kittel_DRG_gruen;
							1: switch_animation_DTW_Kittel;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_DTW_Kittel_DRG_gruen_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_DTW_Kittel_DRG_gruen_REV;
							1: switch_animation_DTW_Kittel_REV;}	

						switch(FEAT_TRAINS, SELF, switch_spritestack_DTW_Kittel_DRG_rotweiss, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_DTW_Kittel_DRG_rotweiss;
							1: switch_animation_DTW_Kittel;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_DTW_Kittel_DRG_rotweiss_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_DTW_Kittel_DRG_rotweiss_REV;
							1: switch_animation_DTW_Kittel_REV;}	

						switch(FEAT_TRAINS, SELF, switch_spritestack_DTW_Kittel_DB, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_DTW_Kittel_DB;
							1: switch_animation_DTW_Kittel;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_DTW_Kittel_DB_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_DTW_Kittel_DB_REV;
							1: switch_animation_DTW_Kittel_REV;}	

						switch (FEAT_TRAINS, PARENT, switch_reverse_DTW_Kittel_KWSE, vehicle_is_reversed) {
							0: switch_spritestack_DTW_Kittel_KWSE;
								switch_spritestack_DTW_Kittel_KWSE_REV;}
								
						switch (FEAT_TRAINS, PARENT, switch_reverse_DTW_Kittel_DRG_gruen, vehicle_is_reversed) {
							0: switch_spritestack_DTW_Kittel_DRG_gruen;
								switch_spritestack_DTW_Kittel_DRG_gruen_REV;}
								
						switch (FEAT_TRAINS, PARENT, switch_reverse_DTW_Kittel_DRG_rotweiss, vehicle_is_reversed) {
							0: switch_spritestack_DTW_Kittel_DRG_rotweiss;
								switch_spritestack_DTW_Kittel_DRG_rotweiss_REV;}
								
						switch (FEAT_TRAINS, PARENT, switch_reverse_DTW_Kittel_DB, vehicle_is_reversed) {
							0: switch_spritestack_DTW_Kittel_DB;
								switch_spritestack_DTW_Kittel_DB_REV;}																								
								
						switch (FEAT_TRAINS,SELF,switch_DTW_Kittel_current_year,current_year) {
							   0 .. 1919 : switch_reverse_DTW_Kittel_KWSE;
							1920 .. 1931 : switch_reverse_DTW_Kittel_DRG_gruen;
							1932 .. 1945 : switch_reverse_DTW_Kittel_DRG_rotweiss;
							1946 .. 2050 : switch_reverse_DTW_Kittel_DB;
							switch_reverse_DTW_Kittel_DB;}

						switch (FEAT_TRAINS,SELF,switch_DTW_Kittel_build_year,build_year) {
							   0 .. 1919 : switch_reverse_DTW_Kittel_KWSE;
							1920 .. 1931 : switch_reverse_DTW_Kittel_DRG_gruen;
							1932 .. 1945 : switch_reverse_DTW_Kittel_DRG_rotweiss;
							1946 .. 2050 : switch_reverse_DTW_Kittel_DB;
							switch_reverse_DTW_Kittel_DB;}
													
						switch(FEAT_TRAINS, PARENT, switch_FX_DTW_Kittel, vehicle_is_reversed) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_STEAM, -3, DISABLE_WAGON_POWER);
								return visual_effect_and_powered(VISUAL_EFFECT_STEAM, 2, DISABLE_WAGON_POWER);}														

						switch(FEAT_TRAINS,PARENT,switch_running_cost_DTW_Kittel, 1){
							return 500;}																													 																											

														
