							0: spriteset_Gruppe_30_DRG_BC;
							1: spritegroup_Gruppe_28_loading_3doors_DRG;}	
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_Gruppe_28_DRG_C2, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_Gruppe_30_DRG_C;
