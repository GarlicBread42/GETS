					{template_88trains_1x(0, 0)}	
				
		alternative_sprites (spriteset_Pwi28_DB, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\Pwi28\Pwi28_DB_1x_32bpp.png", "gfx\Pwi28\Pwi28_DB_1x_mask.png")
					{template_88trains_1x(0, 0)}
				
		alternative_sprites (spriteset_Pwi28_DB, ZOOM_LEVEL_IN_2X, BIT_DEPTH_32BPP, "gfx\Pwi28\Pwi28_DB_2x_32bpp.png", "gfx\Pwi28\Pwi28_DB_2x_mask.png")
					{template_88trains_2x(0,0)}				
			
		alternative_sprites (spriteset_Pwi28_DB, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP, "gfx\Pwi28\Pwi28_DB_4x_32bpp.png", "gfx\Pwi28\Pwi28_DB_4x_mask.png")
					{template_88trains_4x(0,0)}	
			
				
spriteset (spriteset_Pwi28_DB_loading, "gfx\Pwi28\Pwi28_DB_loading_1x_8bpp.png")
					{template_128trains_1x(0, 0)}	
				
		alternative_sprites (spriteset_Pwi28_DB_loading, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\Pwi28\Pwi28_DB_loading_1x_32bpp.png", "gfx\Pwi28\Pwi28_DB_loading_1x_mask.png")
					{template_88trains_1x(0,0)}
				
		alternative_sprites (spriteset_Pwi28_DB_loading, ZOOM_LEVEL_IN_2X, BIT_DEPTH_32BPP, "gfx\Pwi28\Pwi28_DB_loading_2x_32bpp.png", "gfx\Pwi28\Pwi28_DB_loading_2x_mask.png")
					{template_88trains_2x(0,0)}				
			
		alternative_sprites (spriteset_Pwi28_DB_loading, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP, "gfx\Pwi28\Pwi28_DB_loading_4x_32bpp.png", "gfx\Pwi28\Pwi28_DB_loading_4x_mask.png")
					{template_88trains_4x(0,0)}	
					
spritegroup spritegroup_Pwi28_DB
		{
			loaded: 	[spriteset_Pwi28_DB];
			loading: 	[spriteset_Pwi28_DB_loading];}				

//Spriteset Purchase


spriteset (spriteset_Pwi28_purchase1, "gfx\Pwi28\Pwi28_DRG_1x_8bpp.png")
					{template_purchase(0, 0)}	
				
		alternative_sprites (spriteset_Pwi28_purchase1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\Pwi28\Pwi28_DRG_1x_32bpp.png", "gfx\Pwi28\Pwi28_DRG_1x_mask.png")
					{template_purchase(0, 0)}	
					
spriteset (spriteset_Pwi28_purchase2, "gfx\Pwi28\Pwi28_DB_1x_8bpp.png")
					{template_purchase(0, 0)}		
				
		alternative_sprites (spriteset_Pwi28_purchase2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\Pwi28\Pwi28_DB_1x_32bpp.png", "gfx\Pwi28\Pwi28_DB_1x_mask.png")
					{template_purchase(0, 0)}	
					
					
//Switches

						switch (FEAT_TRAINS, SELF, switch_purchase_Pwi28, current_year){
							   0 .. 1945 : spriteset_Pwi28_purchase1;
							1946 .. 2050 : spriteset_Pwi28_purchase2;
							spriteset_Pwi28_purchase2;}	

						switch (FEAT_TRAINS, SELF, switch_build_year_Pwi28, build_year){
							   0 .. 1945 : spritegroup_Pwi28_DRG;
							1946 .. 2050 : spritegroup_Pwi28_DB;
							spritegroup_Pwi28_DB;}
							
						switch (FEAT_TRAINS, SELF, switch_current_year_Pwi28, current_year){
							   0 .. 1945 : spritegroup_Pwi28_DRG;
							1946 .. 2050 : spritegroup_Pwi28_DB;
							spritegroup_Pwi28_DB;}							
							
						switch(FEAT_TRAINS,PARENT,switch_running_cost_Pwi28, 1){
							return 1200;}
						
						
