			additional_text					: string(STR_DESC_EXPRESS);
			length							: switch_length_Karwendel_29;
			articulated_part				: switch_articulated_Karwendel_29_DRG_blau;
			purchase						: spriteset_Karwendel_29_purchase1;
			cost_factor						: 450;
			running_cost_factor				: switch_running_cost_Karwendel_29;
			purchase_running_cost_factor	: 2225;	
			cargo_age_period				: switch_cargo_aging_Karwendel_29;			
			 }
		}	


					switch(FEAT_TRAINS, SELF, switch_Karwendel_29_graphics_DRG_beige, position_in_vehid_chain  % 3) {
							0:     spriteset_empty;
							1:     return random_choose_Karwendel_29_DRG_beige;
							2:     spriteset_empty;}	

					switch (FEAT_TRAINS, SELF, switch_articulated_Karwendel_29_DRG_beige, extra_callback_info1) {
						1 .. 2: return ITEM_KARWENDEL_29_DRG_BEIGE;												
						return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}							
													
