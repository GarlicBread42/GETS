			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							75 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						11 ton;
						dual_headed: 					0;
						default_cargo_type:				COAL;
						cargo_capacity:					25;
						ai_engine_rank: 				0;
						length: 						6;
												
			}
			
	//Vehicels Graphics
			graphics
			{
			default							: switch_Ommu_Duisburg_cargo_type;
			additional_text					: string(STR_DESC_GOODS);
			purchase						: spriteset_Ommu_Duisburg_purchase;
			cost_factor						: 84;
