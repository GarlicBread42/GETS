								0: 7;
								1: 5;}																																																																							

						switch(FEAT_TRAINS, SELF, switch_FX_BR_13_10, position_in_vehid_chain % 2) {
								0: return visual_effect_and_powered(VISUAL_EFFECT_STEAM, -2, DISABLE_WAGON_POWER);
								return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}										
						
						switch (FEAT_TRAINS, PARENT, switch_running_cost_BR_13_10, 1) {
								return 1450;}
								
						switch(FEAT_TRAINS, SELF, switch_BR_13_10_graphics_build, position_in_vehid_chain % 2) {
								0:     return switch_BR_13_10_build_year;
								1:     return switch_BR_13_10_Tender_build_year;}									

						switch (FEAT_TRAINS, SELF, switch_articulated_BR_13_10_build, extra_callback_info1) {
								1: return ITEM_BR_13_10; 
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}
								
