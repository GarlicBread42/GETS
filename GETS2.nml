									{ template_purchase(0, 0)}									
									
//Switches

					switch (FEAT_TRAINS,SELF, switch_CI_1906_purchase,current_year){
						    0 .. 1919: spriteset_CI_1906_KPEV_purchase;
						 1920 .. 1945: spriteset_CI_1906_DRG_purchase;
						 1946 .. 2050: spriteset_CI_1906_DB_purchase;					 
							spriteset_CI_1906_DB_purchase;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_CI_1906_BC_KPEV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_CI_1906_BC_KPEV;
							1: spritegroup_CI_1906_BC_loading;}		
							
