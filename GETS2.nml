							1900 .. 1945: switch_spritestack_BR_01_DRG;
							1946 .. 1957: random_choose_BR_01_DB_ABK;
							1958 .. 1990: random_choose_BR_01_DB_NBK; 
									random_choose_BR_01_DB_NBK;}

						switch (FEAT_TRAINS,SELF, switch_BR_01_tender_build_year,build_year){
							1900 .. 1945: spriteset_Tender_22T32_DRG;
							1946 .. 1957: spriteset_Tender_22T32_DB;
							1958 .. 1990: spriteset_Tender_22T32_DB; 
									spriteset_Tender_22T32_DB;}

