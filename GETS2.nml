									{ template_purchase(0, 0)}
				
	alternative_sprites (spriteset_BR_53_80_purchase_anim, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BR_53_80/BR_53_80_anim1_1x_32bpp.png", "gfx/BR_53_80/BR_53_80_anim1_1x_mask.png")
									{ template_purchase(0, 0)}
									
//Switches
						switch (FEAT_TRAINS, SELF, switch_animation_BR_53_80, motion_counter % 4) {
							0: spriteset_BR_53_80_anim1;
							1: spriteset_BR_53_80_anim2;
							2: spriteset_BR_53_80_anim3;
							3: spriteset_BR_53_80_anim4;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_53_80_purchase1, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_53_80_purchase1;
							1: spriteset_BR_53_80_purchase_anim;}	
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_53_80_purchase2, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_53_80_purchase2;
							1: spriteset_BR_53_80_purchase_anim;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_53_80_purchase3, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_53_80_purchase3;
							1: spriteset_BR_53_80_purchase_anim;}														

						switch (FEAT_TRAINS,SELF, switch_BR_53_80_purchase,current_year){
							1800 .. 1919: switch_spritestack_BR_53_80_purchase1;
							1920 .. 2000: switch_spritestack_BR_53_80_purchase2;
							switch_spritestack_BR_53_80_purchase2;}							

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_53_80_BAY_green, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_53_80_BAY_green;
							1: return switch_animation_BR_53_80;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_53_80_BAY_gray, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_53_80_BAY_gray;
							1: return switch_animation_BR_53_80;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_53_80_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_53_80_DRG;
							1: return switch_animation_BR_53_80;}																													

						switch (FEAT_TRAINS, SELF, random_choose_BR_53_80, switch_alternative_var_random_bits(1, 1)) {
							1: return switch_spritestack_BR_53_80_BAY_green;
								return switch_spritestack_BR_53_80_BAY_gray;}	
								
						switch (FEAT_TRAINS, SELF, random_choose_BR_53_80_tender, switch_alternative_var_random_bits(1, 1)) {
							1: spriteset_Tender_BAY_3T10_green;
								spriteset_Tender_BAY_3T10_gray;}	

						switch (FEAT_TRAINS,SELF, switch_BR_53_80_current_year,current_year){
							 1800 .. 1919: random_choose_BR_53_80;
							 1920 .. 2000: switch_spritestack_BR_53_80_DRG;					 					 
							 switch_spritestack_BR_53_80_DRG;}							

						switch (FEAT_TRAINS,SELF, switch_BR_53_80_build_year,build_year){
							 1800 .. 1919: random_choose_BR_53_80;
							 1920 .. 2000: switch_spritestack_BR_53_80_DRG;					 					 
							 switch_spritestack_BR_53_80_DRG;}															

						switch (FEAT_TRAINS,SELF, switch_BR_53_80_tender_current_year,current_year){
							 1800 .. 1919: random_choose_BR_53_80_tender;
							 1920 .. 2000: spriteset_Tender_BAY_3T10_DRG;					 					 
							 spriteset_Tender_BAY_3T10_DRG;}	
							 
						switch (FEAT_TRAINS,SELF, switch_BR_53_80_tender_build_year,build_year){
							 1800 .. 1919: random_choose_BR_53_80_tender;
							 1920 .. 2000: spriteset_Tender_BAY_3T10_DRG;					 					 
							 spriteset_Tender_BAY_3T10_DRG;}												

						switch(FEAT_TRAINS, SELF, switch_length_BR_53_80, position_in_vehid_chain % 2) {
							0: 5;
							1: 4;}
							
						switch(FEAT_TRAINS, SELF, switch_FX_BR_53_80, position_in_vehid_chain % 2) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_STEAM, -2, DISABLE_WAGON_POWER);
							return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}

						
						switch (FEAT_TRAINS, PARENT, switch_running_cost_BR_53_80, 1) {
							return 375;}
							
						switch(FEAT_TRAINS, SELF, switch_BR_53_80_graphics_build, position_in_vehid_chain % 2) {
							0:	   switch_BR_53_80_build_year;
							1:     switch_BR_53_80_tender_build_year;}
							
						switch (FEAT_TRAINS, SELF, switch_articulated_BR_53_80_build, extra_callback_info1) {
							1: return ITEM_BR_53_80; 
							return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}	
							
														
