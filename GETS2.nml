			default						   : switch_BR_38_10_graphics_DB2;
			additional_text				   : string(STR_CONCAT_2, 
											string(STR_TRACTION_STEAM), 
											string(STR_DESC_UNIVERSAL),);
			length						   : switch_length_BR_38_10;
			articulated_part			   : switch_articulated_BR_38_10_DB2;
			purchase_cargo_capacity        : 0 ;
			cargo_capacity                 : return 0 ;
			purchase					   : switch_spritestack_BR_38_10_purchase3;
			cost_factor					   :30;
			running_cost_factor				:switch_running_cost_BR_38_10;
			visual_effect_and_powered		:switch_FX_BR_38_10;
			
			}
	}

						switch(FEAT_TRAINS, SELF, switch_BR_38_10_graphics_DB3, position_in_vehid_chain % 2) {
							0:	   return switch_spritestack_BR_38_10_DB_Witte_Closecab;
							1:     return spriteset_Wannentender_DB;}															

						switch (FEAT_TRAINS, SELF, switch_articulated_BR_38_10_DB3, extra_callback_info1) {
							1: return ITEM_BR_38_10_DB3;
							return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}
						
