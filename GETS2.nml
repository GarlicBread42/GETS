							1900 .. 1958: spriteset_E_41_purchase1;
							1959 .. 1974: spriteset_E_41_purchase2;
							1975 .. 1987: spriteset_E_41_purchase3;
							1988 .. 1999: spriteset_E_41_purchase4;
							2009 .. 2050: spriteset_E_41_purchase5;					 					 
								spriteset_E_41_purchase5;}
	
						 switch (FEAT_TRAINS,SELF, switch_E_41_current_year,current_year){
							1950 .. 1958: spriteset_E_41_blau;
							1959 .. 1974: spriteset_E_41_gruen;
							1975 .. 1987: spriteset_E_41_ozeanblau;
							1988 .. 1999: spriteset_E_41_orientrot;
							2009 .. 2050: spriteset_E_41_verkehrsrot;					 					 
								spriteset_E_41_gruen;}
	
						switch (FEAT_TRAINS,SELF,switch_E_41_build_year,build_year){
							1950 .. 1958: spriteset_E_41_blau;
							1959 .. 1974: spriteset_E_41_gruen;
							1975 .. 1987: spriteset_E_41_ozeanblau;
							1988 .. 1999: spriteset_E_41_orientrot;
							2009 .. 2050: spriteset_E_41_verkehrsrot;					 					 
								spriteset_E_41_gruen;}						

						switch(FEAT_TRAINS, SELF, switch_length_E_41, position_in_vehid_chain % 3) {
							0: 3;
							1: 3;
							2: 3;}
						
						switch(FEAT_TRAINS, SELF, switch_FX_E_41, position_in_vehid_chain % 3) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
							return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}
						
						switch(FEAT_TRAINS,PARENT,switch_running_cost_E_41, 1){
							return 2175;}						
	
						switch(FEAT_TRAINS, SELF, switch_E_41_graphics_build, position_in_vehid_chain % 3) {
							0:	spriteset_empty;
							1:  return switch_E_41_build_year;
							2:	spriteset_empty;}
							
						switch (FEAT_TRAINS, SELF, switch_articulated_E_41_build, extra_callback_info1) {
							1 .. 2: return ITEM_E_41_BUILD; 
							return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}													
						
item (FEAT_TRAINS , ITEM_E_41_BUILD, 1410)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_E_41_BUILD);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);						
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1956,01,01);
						model_life: 					51;
						vehicle_life: 					40;
						retire_early: 					-10;							
						reliability_decay: 				20;
						cargo_allow_refit: 				[PASS] ;
						cargo_capacity: 				1 ;
						cost_factor: 					108;
						running_cost_base:   			RUNNING_COST_STEAM;								
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							120 km/h;
						refit_cost: 					0;
						track_type: 					AC15;
						power:  						3140 hp;
						weight: 						66 ton;
						ai_engine_rank: 				0;
						engine_class: 					ENGINE_CLASS_ELECTRIC;
						visual_effect_and_powered: 		visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
						dual_headed: 					0;
						tractive_effort_coefficient: 	0.310;
						length: 						8;												
			}

		//Vehicels Graphics
			graphics
			{
			default:						switch_E_41_graphics_build;
			additional_text					: string(STR_CONCAT_2, 
											  string(STR_TRACTION_ELECTRIC), 
											  string(STR_DESC_PASS),);
			length:							switch_length_E_41;
			articulated_part:				switch_articulated_E_41_build;
			purchase_cargo_capacity		    : 0 ;
			cargo_capacity	                : return 0 ;
			purchase						: switch_E_41_purchase;
			cost_factor						: 98;
			running_cost_factor				: switch_running_cost_E_41;
			visual_effect_and_powered		:switch_FX_E_41;
						
			
			}
	}	

						switch(FEAT_TRAINS, SELF, switch_E_41_graphics_current, position_in_vehid_chain % 3) {
							0:	spriteset_empty;
							1:  return switch_E_41_current_year;
							2:	spriteset_empty;}
							
						switch (FEAT_TRAINS, SELF, switch_articulated_E_41_current, extra_callback_info1) {
							1 .. 2: return ITEM_E_41_CURRENT; 
							return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}													
						
