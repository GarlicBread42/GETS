spriteset (spriteset_PW4ue_purchase_KPEV, "gfx/PW4ue/PW4ue_GW_KPEV_1x_8bpp.png")
					{template_purchase(0, 0)}	
				
		alternative_sprites (spriteset_PW4ue_purchase_KPEV, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/PW4ue/PW4ue_GW_KPEV_1x_32bpp.png", "gfx/PW4ue/PW4ue_GW_KPEV_1x_mask.png")
					{template_purchase(0,0)}	
					
spriteset (spriteset_PW4ue_purchase_DRG, "gfx/PW4ue/PW4ue_GW_DRG_1x_8bpp.png")
					{template_purchase(0, 0)}	
				
		alternative_sprites (spriteset_PW4ue_purchase_DRG, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/PW4ue/PW4ue_GW_DRG_1x_32bpp.png", "gfx/PW4ue/PW4ue_GW_DRG_1x_mask.png")
					{template_purchase(0,0)}									

