		0: return switch_Om_Koenigsberg_OBH_current_year;
		1: spritegroup_Oc_Muenster_OBH_load_COPR;}
		
	switch(FEAT_TRAINS, SELF, switch_loadstack_Om_Koenigsberg_OBH_Fass, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: return switch_Om_Koenigsberg_OBH_current_year;
		1: spritegroup_Oc_Muenster_OBH_load_Fass;}

	switch(FEAT_TRAINS, SELF, switch_loadstack_Om_Koenigsberg_OBH_Rohr, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: return switch_Om_Koenigsberg_OBH_current_year;
		1: spritegroup_Oc_Muenster_OBH_load_Rohr;}
								
	switch(FEAT_TRAINS, SELF, switch_loadstack_Om_Koenigsberg_OBH_Timber, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: return switch_Om_Koenigsberg_OBH_current_year;
		1: spritegroup_Oc_Muenster_OBH_load_Timber;}
		
	switch(FEAT_TRAINS, SELF, switch_loadstack_Om_Koenigsberg_OBH_Wood, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: return switch_Om_Koenigsberg_OBH_current_year;
		1: spritegroup_Oc_Muenster_OBH_load_Wood;}							

	switch (FEAT_TRAINS, SELF, random_choose_Om_Koenigsberg_Barren, switch_alternative_var_random_bits(1, 1)) {
			1: switch_loadstack_Om_Koenigsberg_OBH_Barren;
				switch_loadstack_Om_Koenigsberg_MBH_Barren;}	
				
	switch (FEAT_TRAINS, SELF, random_choose_Om_Koenigsberg_Box, switch_alternative_var_random_bits(1, 1)) {
			1: switch_loadstack_Om_Koenigsberg_OBH_Box;
				switch_loadstack_Om_Koenigsberg_MBH_Box;}	
				
	switch (FEAT_TRAINS, SELF, random_choose_Om_Koenigsberg_Bulk, switch_alternative_var_random_bits(1, 1)) {
			1: switch_loadstack_Om_Koenigsberg_OBH_Bulk;
				switch_loadstack_Om_Koenigsberg_MBH_Bulk;}
																	
	switch (FEAT_TRAINS, SELF, random_choose_Om_Koenigsberg_Bulk_covered, switch_alternative_var_random_bits(1, 1)) {
			1: switch_loadstack_Om_Koenigsberg_OBH_Bulk_covered;
				switch_loadstack_Om_Koenigsberg_MBH_Bulk_covered;}
				
	switch (FEAT_TRAINS, SELF, random_choose_Om_Koenigsberg_COPR, switch_alternative_var_random_bits(1, 1)) {
			1: switch_loadstack_Om_Koenigsberg_OBH_COPR;
				switch_loadstack_Om_Koenigsberg_MBH_COPR;}								
				
	switch (FEAT_TRAINS, SELF, random_choose_Om_Koenigsberg_Fass, switch_alternative_var_random_bits(1, 1)) {
			1: switch_loadstack_Om_Koenigsberg_OBH_Fass;
				switch_loadstack_Om_Koenigsberg_MBH_Fass;}

	switch (FEAT_TRAINS, SELF, random_choose_Om_Koenigsberg_Rohr, switch_alternative_var_random_bits(1, 1)) {
			1: switch_loadstack_Om_Koenigsberg_OBH_Rohr;
				switch_loadstack_Om_Koenigsberg_MBH_Rohr;}
												
	switch (FEAT_TRAINS, SELF, random_choose_Om_Koenigsberg_Timber, switch_alternative_var_random_bits(1, 1)) {
			1: switch_loadstack_Om_Koenigsberg_OBH_Timber;
				switch_loadstack_Om_Koenigsberg_MBH_Timber;}
				
	switch (FEAT_TRAINS, SELF, random_choose_Om_Koenigsberg_Wood, switch_alternative_var_random_bits(1, 1)) {
			1: switch_loadstack_Om_Koenigsberg_OBH_Wood;
				switch_loadstack_Om_Koenigsberg_MBH_Wood;}	
								
	switch(FEAT_TRAINS, SELF, switch_Om_Koenigsberg_current_CC_Liquid, hasbit(cargo_classes, CC_LIQUID)) {
			0: random_choose_Om_Koenigsberg_Box;
				random_choose_Om_Koenigsberg_Fass;}	

	switch(FEAT_TRAINS, SELF, switch_Om_Koenigsberg_current_CC_Piece, hasbit(cargo_classes, CC_PIECE_GOODS)) {
			0: switch_Om_Koenigsberg_current_CC_Liquid;
				random_choose_Om_Koenigsberg_Box;}		

	switch(FEAT_TRAINS, SELF, switch_Om_Koenigsberg_current_CC_Bulk, hasbit(cargo_classes, CC_BULK)) {
		0: switch_Om_Koenigsberg_current_CC_Piece;
			random_choose_Om_Koenigsberg_Bulk;}

	switch(FEAT_TRAINS, SELF, switch_Om_Koenigsberg_current_CC_Bulk_Covered, hasbit(cargo_classes, CC_COVERED & CC_BULK)) {
		0: switch_Om_Koenigsberg_current_CC_Bulk;
			random_choose_Om_Koenigsberg_Bulk_covered;}			

	switch (FEAT_TRAINS, SELF, switch_Om_Koenigsberg_cargo_type, cargo_type_in_veh) {
			STEL: return random_choose_Om_Koenigsberg_Barren;
			METL: return random_choose_Om_Koenigsberg_Rohr;
			ZINC: return random_choose_Om_Koenigsberg_Rohr;
			COPR: return random_choose_Om_Koenigsberg_COPR;
			STST: return random_choose_Om_Koenigsberg_Barren;
			STSH: return random_choose_Om_Koenigsberg_Barren;
			STSE: return random_choose_Om_Koenigsberg_Barren;
			STAL: return random_choose_Om_Koenigsberg_Barren;
			STCB: return random_choose_Om_Koenigsberg_Rohr;
			STWR: return random_choose_Om_Koenigsberg_Rohr; 
			CSTI: return random_choose_Om_Koenigsberg_Rohr;
			PIPE: return random_choose_Om_Koenigsberg_Rohr;

			ENSP: return random_choose_Om_Koenigsberg_Box;
			FMSP: return random_choose_Om_Koenigsberg_Box;
			MNSP: return random_choose_Om_Koenigsberg_Box;
			POWR: return random_choose_Om_Koenigsberg_Box;
			VPTS: return random_choose_Om_Koenigsberg_Box;
			MPTS: return random_choose_Om_Koenigsberg_Box;
			GOOD: return random_choose_Om_Koenigsberg_Box;
			PAPR: return random_choose_Om_Koenigsberg_Box;
			TYRE: return random_choose_Om_Koenigsberg_Box;
			WOOL: return random_choose_Om_Koenigsberg_Box;
			TEXT: return random_choose_Om_Koenigsberg_Box;	
			SEED: return random_choose_Om_Koenigsberg_Box;	
			FERT: return random_choose_Om_Koenigsberg_Box;

			FRVG: return random_choose_Om_Koenigsberg_Bulk_covered;
			TATO: return random_choose_Om_Koenigsberg_Bulk_covered;
			FRUT: return random_choose_Om_Koenigsberg_Bulk_covered;
			CERE: return random_choose_Om_Koenigsberg_Bulk_covered;
			FICR: return random_choose_Om_Koenigsberg_Bulk_covered;
			OLSD: return random_choose_Om_Koenigsberg_Bulk_covered;
			QLME: return random_choose_Om_Koenigsberg_Bulk;
			MNO2: return random_choose_Om_Koenigsberg_Bulk;

			BDMT: return random_choose_Om_Koenigsberg_Timber;
			WDPR: return random_choose_Om_Koenigsberg_Timber;
			WOOD: return random_choose_Om_Koenigsberg_Wood;
			GLAS: return random_choose_Om_Koenigsberg_Box;
			BRCK: return random_choose_Om_Koenigsberg_Box;
				switch_Om_Koenigsberg_current_CC_Bulk_Covered;}		

	switch (FEAT_TRAINS, PARENT, switch_speed_Om_Koenigsberg,  switch_check_PWG_0()) {
		1: return 80;
		0: return 65;}								

	switch(FEAT_TRAINS,PARENT,switch_running_cost_Om_Koenigsberg, 1){
		return 105;}

item (FEAT_TRAINS , ITEM_OM_KOENIGSBERG, 8605)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_OM_KOENIGSBERG);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1927,01,01);
						model_life: 					52;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes: 		bitmask(CC_BULK, CC_COVERED, CC_PIECE_GOODS, CC_LIQUID);
						non_refittable_cargo_classes: 	bitmask(CC_REFRIGERATED, CC_HAZARDOUS, CC_OVERSIZED);
						cargo_allow_refit:              [WOOD, BDMT, WDPR, TWOD, FRUT ];
						cargo_disallow_refit: 			[LVST, FOOD, WATR, BEER, BOOM, FISH, IRON];
						misc_flags: 					bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_SPRITE_STACK);
						loading_speed:					10;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							65 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						11 ton;
						dual_headed: 					0;
						default_cargo_type:				COAL;
						cargo_capacity:					20;
						ai_engine_rank: 				0;
						length: 						6;
												
			}
			
	//Vehicels Graphics
			graphics
			{
			default							: switch_Om_Koenigsberg_cargo_type;
			additional_text					: string(STR_DESC_CABOOSE_80);
			purchase						: switch_Om_Koenigsberg_purchase;
			speed							: switch_speed_Om_Koenigsberg;
			cost_factor						: 46;
			running_cost_factor				: switch_running_cost_Om_Koenigsberg;
			colour_mapping					: switch_bulk_recolour;
			 }
		}
