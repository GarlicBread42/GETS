					{template_purchase(0, 0)}
					
					
//Switches										

					 switch (FEAT_TRAINS,SELF, switch_Hbillns303_purchase,current_year){
							   0 .. 1995: spriteset_Hbillns303_purchase1;
							1996 .. 2008: spriteset_Hbillns303_purchase2;
							2009 .. 2050: spriteset_Hbillns303_purchase3;											 					 
							spriteset_Hbillns303_purchase3;}

					switch (FEAT_TRAINS, SELF, random_choose_Hbillns303_EP4, switch_alternative_var_random_bits(1, 2)) {			
							1: spritegroup_Hbillns303_Var1;
							2: spritegroup_Hbillns303_Var2;
							3: spritegroup_Hbillns303_Var3;							
								spritegroup_Hbillns303_Var1;}
								
					switch (FEAT_TRAINS, SELF, random_choose_Hbillns303_EP5, switch_alternative_var_random_bits(1, 2)) {			
							1: spritegroup_Hbillns303_Var4;
							2: spritegroup_Hbillns303_Var5;
							3: spritegroup_Hbillns303_Var6;							
								spritegroup_Hbillns303_Var4;}								
								
					switch (FEAT_TRAINS, SELF, random_choose_Hbillns303_EP6, switch_alternative_var_random_bits(1, 3)) {			
							1: spritegroup_Hbillns303_Var4;
							2: spritegroup_Hbillns303_cargo;
							3: spritegroup_Hbillns303_Var5;
							4: spritegroup_Hbillns303_cargo;
							5: spritegroup_Hbillns303_Var6;
							6: spritegroup_Hbillns303_cargo;
							7: spritegroup_Hbillns303_cargo;							
								spritegroup_Hbillns303_cargo;}

					 switch (FEAT_TRAINS,SELF, switch_Hbillns303_current_year,current_year){
							   0 .. 1995: random_choose_Hbillns303_EP4;
							1996 .. 2008: random_choose_Hbillns303_EP5;
							2009 .. 2050: random_choose_Hbillns303_EP6;											 					 
							random_choose_Hbillns303_EP6;}
							
