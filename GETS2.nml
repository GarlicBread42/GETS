			cargo_capacity               	: return 0 ;
			purchase					  	: switch_BR_55_0_purchase;
			cost_factor					    : 17;
			running_cost_factor				: switch_running_cost_BR_55_0;
			visual_effect_and_powered		: switch_FX_BR_55_0;
			
			}
	}	


