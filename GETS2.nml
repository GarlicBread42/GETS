//#######################################
//###BP 35 Preussischer Briefpostwagen###
//#######################################

//Spritesets


//Spriteset KPEV

spriteset (spriteset_BP_35_KPEV, "gfx/BP_35/BP_35_KPEV_1x_8bpp.png")
					{ template_128trains_1x(0, 0)}	
		alternative_sprites (spriteset_BP_35_KPEV, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BP_35/BP_35_KPEV_1x_32bpp.png", "gfx/BP_35/BP_35_KPEV_1x_mask.png")
					{template_128trains_1x(0,0)}
		alternative_sprites (spriteset_BP_35_KPEV, ZOOM_LEVEL_IN_2X, BIT_DEPTH_32BPP, "gfx/BP_35/BP_35_KPEV_2x_32bpp.png", "gfx/BP_35/BP_35_KPEV_2x_mask.png")
					{template_128trains_2x(0,0)}				
		alternative_sprites (spriteset_BP_35_KPEV, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP, "gfx/BP_35/BP_35_KPEV_4x_32bpp.png", "gfx/BP_35/BP_35_KPEV_4x_mask.png")
					{template_128trains_4x(0,0)}			
		
//Spriteset DRG

spriteset (spriteset_BP_35_DRG, "gfx/BP_35/BP_35_DRG_1x_8bpp.png")
					{ template_128trains_1x(0, 0)}	
		alternative_sprites (spriteset_BP_35_DRG, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BP_35/BP_35_DRG_1x_32bpp.png", "gfx/BP_35/BP_35_DRG_1x_mask.png")
					{template_128trains_1x(0,0)}
		alternative_sprites (spriteset_BP_35_DRG, ZOOM_LEVEL_IN_2X, BIT_DEPTH_32BPP, "gfx/BP_35/BP_35_DRG_2x_32bpp.png", "gfx/BP_35/BP_35_DRG_2x_mask.png")
					{template_128trains_2x(0,0)}				
		alternative_sprites (spriteset_BP_35_DRG, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP, "gfx/BP_35/BP_35_DRG_4x_32bpp.png", "gfx/BP_35/BP_35_DRG_4x_mask.png")
					{template_128trains_4x(0,0)}			
		
//Spriteset DB

spriteset (spriteset_BP_35_DB, "gfx/BP_35/BP_35_DB_1x_8bpp.png")
					{ template_128trains_1x(0, 0)}	
		alternative_sprites (spriteset_BP_35_DB, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BP_35/BP_35_DB_1x_32bpp.png", "gfx/BP_35/BP_35_DB_1x_mask.png")
					{template_128trains_1x(0,0)}
		alternative_sprites (spriteset_BP_35_DB, ZOOM_LEVEL_IN_2X, BIT_DEPTH_32BPP, "gfx/BP_35/BP_35_DB_2x_32bpp.png", "gfx/BP_35/BP_35_DB_2x_mask.png")
					{template_128trains_2x(0,0)}				
		alternative_sprites (spriteset_BP_35_DB, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP, "gfx/BP_35/BP_35_DB_4x_32bpp.png", "gfx/BP_35/BP_35_DB_4x_mask.png")
					{template_128trains_4x(0,0)}	
		
//Spriteset loading				
				
spriteset (spriteset_BP_35_LOADING, "gfx/BP_35/BP_35_loading_1x_8bpp.png")
					{ template_128trains_1x(0, 0)}	
		alternative_sprites (spriteset_BP_35_LOADING, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BP_35/BP_35_loading_1x_32bpp.png", "gfx/BP_35/BP_35_loading_1x_mask.png")
					{template_128trains_1x(0,0)}
