					switch(FEAT_TRAINS, SELF, switch_Fad163_loadstack, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: return switch_Fad163_current_year;
						1: spritegroup_Fad163_load;}

					switch(FEAT_TRAINS,PARENT,switch_running_cost_Fad163, 1){
						return 240;}
						
item (FEAT_TRAINS , ITEM_FAD163, 8758)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_OOT_SAARBRUECKEN);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1941,01,01);
						model_life: 					33;
						vehicle_life: 					30;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes: 		bitmask(CC_BULK);
						non_refittable_cargo_classes: 	bitmask(CC_LIQUID, CC_REFRIGERATED, CC_HAZARDOUS, CC_OVERSIZED, CC_COVERED);
						cargo_allow_refit:              [COAL, IORE, CORE, COKE, AORE, CLAY, FECR, GRVL, KAOL, LIME, PHOS, PORE, POTA, SAND, SULP, URAN, CASS, MNO2, NICK, NITR, NKOR, QLME, RCYC, SALT, SASH, SLAG, TOFF,];
						cargo_disallow_refit: 			[BDMT, CMNT, FERT, FICR, GRAI, RCYC, SCMT, SCRP, SALT, PEAT, BEAN, SUGR, SGBT, SGCN, TWOD, WDPR,];
						misc_flags: 					bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_SPRITE_STACK);
						loading_speed:					10;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							55 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						22 ton;
						dual_headed: 					0;
						default_cargo_type:				IORE;
						cargo_capacity:					56;
						ai_engine_rank: 				0;
						length: 						7;
												
			}
			
	//Vehicels Graphics
			graphics
			{
			default							: switch_Fad163_loadstack;
			additional_text					: string(STR_DESC_GOODS);
			purchase						: switch_Fad163_purchase;
			cost_factor						: 111;
			running_cost_factor				: switch_running_cost_Fad163;				
			colour_mapping					: switch_bulk_recolour;
			 }
		}
