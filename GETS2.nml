									{ template_148trains_4x(0, 0)}
									
//Spriteset loading

spriteset(spriteset_VT_137_025_loading, "gfx\VT_137_025/VT_137_025_loading_1x_8bpp.png")
									{ template_148trains_1x(0, 0)}
				
		alternative_sprites (spriteset_VT_137_025_loading, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\VT_137_025/VT_137_025_loading_1x_32bpp.png", "gfx\VT_137_025/VT_137_025_loading_1x_mask.png")
									{ template_148trains_1x(0, 0)}
				
