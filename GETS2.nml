//Switches
						switch (FEAT_TRAINS, SELF, switch_animation_BR_71_0, motion_counter % 4) {
								0: spriteset_BR_71_0_anim1;
								1: spriteset_BR_71_0_anim2;
								2: spriteset_BR_71_0_anim3;
								3: spriteset_BR_71_0_anim4;}

						switch (FEAT_TRAINS, SELF, switch_animation_BR_71_0_REV, motion_counter % 4) {
								0: spriteset_BR_71_0_anim1_REV;
								1: spriteset_BR_71_0_anim2_REV;
								2: spriteset_BR_71_0_anim3_REV;
								3: spriteset_BR_71_0_anim4_REV;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_71_0_purchase1, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_71_0_purchase1;
							1: spriteset_BR_71_0_anim_purchase;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_71_0_purchase2, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_71_0_purchase2;
							1: spriteset_BR_71_0_anim_purchase;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_71_0_purchase_SBER1, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_71_0_purchase_SBER1;
							1: spriteset_BR_71_0_anim_purchase;}																									
						
						switch (FEAT_TRAINS,SELF, switch_BR_71_0_purchase,current_year){
							1800 .. 1919: switch_spritestack_BR_71_0_purchase1;
							1920 .. 1945: switch_spritestack_BR_71_0_purchase2;														 					 
								switch_spritestack_BR_71_0_purchase2;}						

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_71_0_KPEV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_71_0_KPEV;
							1: return switch_animation_BR_71_0;}									

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_71_0_KPEV_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_71_0_KPEV_REV;
							1: return switch_animation_BR_71_0_REV;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_71_0_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_71_0_DRG;
							1: return switch_animation_BR_71_0;}									

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_71_0_DRG_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_71_0_DRG_REV;
							1: return switch_animation_BR_71_0_REV;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_71_0_SBER1, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_71_0_SBER1;
							1: return switch_animation_BR_71_0;}									

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_71_0_SBER1_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_71_0_SBER1_REV;
							1: return switch_animation_BR_71_0_REV;}

						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_71_0_KPEV, vehicle_is_reversed) {
							0: switch_spritestack_BR_71_0_KPEV;
								switch_spritestack_BR_71_0_KPEV_REV;}

						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_71_0_DRG, vehicle_is_reversed) {
							0: switch_spritestack_BR_71_0_DRG;
								switch_spritestack_BR_71_0_DRG_REV;}

						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_71_0_SBER1, vehicle_is_reversed) {
							0: switch_spritestack_BR_71_0_SBER1;
								switch_spritestack_BR_71_0_SBER1_REV;}																																														

						switch (FEAT_TRAINS,PARENT,switch_enginecheck_BR_71_0_SBER1,(count_veh_id(8816))) {
							0: switch_reverse_BR_71_0_KPEV; 
								switch_reverse_BR_71_0_SBER1;}															

						switch (FEAT_TRAINS,SELF, switch_BR_71_0_build_year,build_year){
							1800 .. 1919: switch_enginecheck_BR_71_0_SBER1;
							1920 .. 1945: switch_reverse_BR_71_0_DRG;					 					 
								switch_reverse_BR_71_0_DRG;}
							
						switch (FEAT_TRAINS,SELF, switch_BR_71_0_current_year,current_year){
							1800 .. 1919: switch_enginecheck_BR_71_0_SBER1;
							1920 .. 1945: switch_reverse_BR_71_0_DRG;					 					 
								switch_reverse_BR_71_0_DRG;}						
							
					switch(FEAT_TRAINS, PARENT, switch_FX_BR_71_0, vehicle_is_reversed) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_STEAM, -3, DISABLE_WAGON_POWER);
								return visual_effect_and_powered(VISUAL_EFFECT_STEAM, 2, DISABLE_WAGON_POWER);}							
						
					switch (FEAT_TRAINS, PARENT, switch_running_cost_BR_71_0, 1) {
							return 750;}
							
