									{ template_purchase(0, 0)}
	alternative_sprites (spriteset_BR_55_0_purchase_anim, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BR_55_0/BR_55_0_anim1_1x_32bpp.png", "gfx/BR_55_0/BR_55_0_anim1_1x_mask.png")
									{ template_purchase(0, 0)}
																		
//Switches

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_55_0_KPEV_purchase, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_55_0_KPEV_purchase;
							1: spriteset_BR_55_0_purchase_anim;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_55_0_KPEV_Brotan_purchase, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_55_0_KPEV_Brotan_purchase;
							1: spriteset_BR_55_0_purchase_anim;}
														
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_55_0_DRG_purchase, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_55_0_DRG_purchase;
							1: spriteset_BR_55_0_purchase_anim;}
							
