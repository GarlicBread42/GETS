	alternative_sprites (spriteset_BR_17_0_purchase_anim, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BR_17_0/BR_17_0_anim1_1x_32bpp.png", "gfx/BR_17_0/BR_17_0_anim1_1x_mask.png")
									{ template_purchase(0, 0)}


										
//Switches								
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_17_0_purchase1, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_17_0_purchase1;
							1: spriteset_BR_17_0_purchase_anim;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_17_0_purchase2, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_17_0_purchase2;
							1: spriteset_BR_17_0_purchase_anim;}
							
						switch (FEAT_TRAINS, SELF, switch_purchase_BR_17_0, current_year){
								1800 .. 1919: switch_spritestack_BR_17_0_purchase1;
								1920 .. 2050: switch_spritestack_BR_17_0_purchase2;
								switch_spritestack_BR_17_0_purchase2;}																	

						switch (FEAT_TRAINS, SELF, switch_animation_BR_17_0, motion_counter % 4) {
							0: spriteset_BR_17_0_anim1;
							1: spriteset_BR_17_0_anim2;
							2: spriteset_BR_17_0_anim3;
							3: spriteset_BR_17_0_anim4;}	

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_17_0_KPEV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_17_0_KPEV;
							1: return switch_animation_BR_17_0;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_17_0_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_17_0_DRG;
							1: return switch_animation_BR_17_0;}
								
						switch (FEAT_TRAINS,SELF, switch_BR_17_0_build_year,build_year){
								  00 .. 1919: switch_spritestack_BR_17_0_KPEV;
								1920 .. 1950: switch_spritestack_BR_17_0_DRG;				 					 
								switch_spritestack_BR_17_0_DRG;}

						switch (FEAT_TRAINS,SELF, switch_BR_17_0_current_year,current_year){
								  00 .. 1919: switch_spritestack_BR_17_0_KPEV;
								1920 .. 1950: switch_spritestack_BR_17_0_DRG;				 					 
								switch_spritestack_BR_17_0_DRG;}							 						 
		
						switch (FEAT_TRAINS,SELF, switch_BR_17_0_Tender_build_year,build_year){
								  00 .. 1919: spriteset_Tender_22T215_KPEV_Redline;
								1920 .. 1950: spriteset_Tender_22T215_DRG;
								spriteset_Tender_22T215_DRG;}
								
						switch (FEAT_TRAINS,SELF, switch_BR_17_0_Tender_current_year,current_year){
								  00 .. 1919: spriteset_Tender_22T215_KPEV_Redline;
								1920 .. 1950: spriteset_Tender_22T215_DRG;
								spriteset_Tender_22T215_DRG;}

						switch(FEAT_TRAINS, SELF, switch_length_BR_17_0, position_in_vehid_chain % 2) {
								0: 8;
								1: 5;}																																																																							

						switch(FEAT_TRAINS, SELF, switch_FX_BR_17_0, position_in_vehid_chain % 2) {
								0: return visual_effect_and_powered(VISUAL_EFFECT_STEAM, -2, DISABLE_WAGON_POWER);
								return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}										
						
						switch (FEAT_TRAINS, PARENT, switch_running_cost_BR_17_0, 1) {
								return 1850;}
								
						switch(FEAT_TRAINS, SELF, switch_BR_17_0_graphics_build, position_in_vehid_chain % 2) {
								0:     return switch_BR_17_0_build_year;
								1:     return switch_BR_17_0_Tender_build_year;}									

						switch (FEAT_TRAINS, SELF, switch_articulated_BR_17_0_build, extra_callback_info1) {
								1: return ITEM_BR_17_0; 
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}
								
item (FEAT_TRAINS , ITEM_BR_17_0, 0170)
