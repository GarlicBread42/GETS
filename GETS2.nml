//Switches

						switch (FEAT_TRAINS, SELF, switch_animation_V_60, motion_counter % 4) {
								0: spriteset_V_60_anim1;
								1: spriteset_V_60_anim2;
								2: spriteset_V_60_anim3;
								3: spriteset_V_60_anim4;}
								
						switch (FEAT_TRAINS, SELF, switch_animation_V_60_REV, motion_counter % 4) {
								0: spriteset_V_60_anim1_REV;
								1: spriteset_V_60_anim2_REV;
								2: spriteset_V_60_anim3_REV;
								3: spriteset_V_60_anim4_REV;}								
								
						switch(FEAT_TRAINS, SELF, switch_spritestack_V_60_purchase1, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_V_60_purchase1;
							1: spriteset_V_60_anim_purchase;}								
																										
						switch(FEAT_TRAINS, SELF, switch_spritestack_V_60_purchase2, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_V_60_purchase2;
							1: spriteset_V_60_anim_purchase;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_V_60_purchase3, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_V_60_purchase3;
							1: spriteset_V_60_anim_purchase;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_V_60_purchase4, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_V_60_purchase4;
							1: spriteset_V_60_anim_purchase;}
							
						switch (FEAT_TRAINS,SELF, switch_V_60_purchase,current_year){
							   0 .. 1974: switch_spritestack_V_60_purchase1;
							1975 .. 1987: switch_spritestack_V_60_purchase2;	
							1988 .. 1999: switch_spritestack_V_60_purchase3;
							2000 .. 2045: switch_spritestack_V_60_purchase4;														 					 
								switch_spritestack_V_60_purchase4;}							
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_V_60_altrot, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_V_60_altrot;
							1: return switch_animation_V_60;}							
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_V_60_ozeanblau, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_V_60_ozeanblau;
							1: return switch_animation_V_60;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_V_60_orientrot, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_V_60_orientrot;
							1: return switch_animation_V_60;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_V_60_verkehrsrot, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_V_60_verkehrsrot;
							1: return switch_animation_V_60;}																					
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_V_60_altrot_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_V_60_altrot_REV;
							1: return switch_animation_V_60_REV;}							
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_V_60_ozeanblau_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_V_60_ozeanblau_REV;
							1: return switch_animation_V_60_REV;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_V_60_orientrot_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_V_60_orientrot_REV;
							1: return switch_animation_V_60_REV;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_V_60_verkehrsrot_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_V_60_verkehrsrot_REV;
							1: return switch_animation_V_60_REV;}							
							
						switch (FEAT_TRAINS, PARENT, switch_reverse_V_60_altrot, vehicle_is_reversed) {
							0: switch_spritestack_V_60_altrot;
								switch_spritestack_V_60_altrot_REV;}							
							
						switch (FEAT_TRAINS, PARENT, switch_reverse_V_60_ozeanblau, vehicle_is_reversed) {
							0: switch_spritestack_V_60_ozeanblau;
								switch_spritestack_V_60_ozeanblau_REV;}							
							
						switch (FEAT_TRAINS, PARENT, switch_reverse_V_60_orientrot, vehicle_is_reversed) {
							0: switch_spritestack_V_60_orientrot;
								switch_spritestack_V_60_orientrot_REV;}							
							
						switch (FEAT_TRAINS, PARENT, switch_reverse_V_60_verkehrsrot, vehicle_is_reversed) {
							0: switch_spritestack_V_60_verkehrsrot;
								switch_spritestack_V_60_verkehrsrot_REV;}	
								
						switch (FEAT_TRAINS,SELF, switch_V_60_build_year,build_year){
							   0 .. 1974: switch_reverse_V_60_altrot;
							1975 .. 1987: switch_reverse_V_60_ozeanblau;
							1988 .. 1999: switch_reverse_V_60_orientrot;
							1988 .. 2050: switch_reverse_V_60_verkehrsrot;	
							switch_reverse_V_60_altrot;}

						switch (FEAT_TRAINS,SELF, switch_V_60_current_year,current_year){
							   0 .. 1974: switch_reverse_V_60_altrot;
							1975 .. 1987: switch_reverse_V_60_ozeanblau;
							1988 .. 1999: switch_reverse_V_60_orientrot;
							1988 .. 2050: switch_reverse_V_60_verkehrsrot;	
							switch_reverse_V_60_altrot;}

						switch(FEAT_TRAINS,PARENT,switch_running_cost_V_60, 1){
							return 350;}														
							
