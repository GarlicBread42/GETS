						 1900 .. 1931: switch_spritestack_EB_41_Twotone;
						 1932 .. 1935: switch_spritestack_EB_41_Grau;
						 1936 .. 2050: switch_spritestack_EB_41_Rot;
							switch_spritestack_EB_41_Rot;}
						 
					switch (FEAT_TRAINS,SELF, switch_EB_41_build_year,build_year){
						 1900 .. 1931: switch_spritestack_EB_41_Twotone;
						 1932 .. 1935: switch_spritestack_EB_41_Grau;
						 1936 .. 2050: switch_spritestack_EB_41_Rot;
							switch_spritestack_EB_41_Rot;}						

					switch(FEAT_TRAINS, SELF, switch_coupling_EB_41, vehicle_type_id) {
							4410: return CB_RESULT_ATTACH_ALLOW;
							4411: return CB_RESULT_ATTACH_ALLOW;
							4412: return CB_RESULT_ATTACH_ALLOW;
							4413: return CB_RESULT_ATTACH_ALLOW;
							4414: return CB_RESULT_ATTACH_ALLOW;
							4311: return CB_RESULT_ATTACH_ALLOW;
							3410: return CB_RESULT_ATTACH_ALLOW;
							3411: return CB_RESULT_ATTACH_ALLOW;
							3412: return CB_RESULT_ATTACH_ALLOW;
							3413: return CB_RESULT_ATTACH_ALLOW;
							3414: return CB_RESULT_ATTACH_ALLOW;							
							return string (STR_COUPLING_SAME_TRAILER);}	
							
					switch(FEAT_TRAINS, SELF, switch_length_EB_41, position_in_vehid_chain % 3) {
							0: 4;
							1: 6;
							2: 4;}	

					switch(FEAT_TRAINS,PARENT,switch_running_cost_EB_41, 1){
							return 1075;}
							
					switch(FEAT_TRAINS, SELF, switch_EB_41_graphics_build, position_in_vehid_chain % 3) {
							0:	   spriteset_empty;
							1:     return switch_EB_41_build_year;
							2:     spriteset_empty;}
								
					switch (FEAT_TRAINS, SELF, switch_articulated_EB_41_build, extra_callback_info1) {
						1 .. 2: return ITEM_EB_41_BUILD; 
						return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}	
												
