spriteset(spriteset_BR_90_0_purchase1, "gfx/BR_90_0/BR_90_0_KPEV_1x_8bpp.png")
									{ template_purchase(0, 0)}
	alternative_sprites (spriteset_BR_90_0_purchase1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BR_90_0/BR_90_0_KPEV_1x_32bpp.png", "gfx/BR_90_0/BR_90_0_KPEV_1x_mask.png")
