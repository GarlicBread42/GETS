	switch(FEAT_TRAINS, SELF, switch_loadstack_Om_Ludwigshafen_OBH_Wood, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: return switch_Om_Ludwigshafen_OBH_current_year;
		1: spritegroup_Oc_Muenster_OBH_load_Wood;}							

	switch (FEAT_TRAINS, SELF, random_choose_Om_Ludwigshafen_Barren, switch_alternative_var_random_bits(1, 1)) {
			1: switch_loadstack_Om_Ludwigshafen_OBH_Barren;
				switch_loadstack_Om_Ludwigshafen_MBH_Barren;}	
				
	switch (FEAT_TRAINS, SELF, random_choose_Om_Ludwigshafen_Box, switch_alternative_var_random_bits(1, 1)) {
			1: switch_loadstack_Om_Ludwigshafen_OBH_Box;
				switch_loadstack_Om_Ludwigshafen_MBH_Box;}	
				
	switch (FEAT_TRAINS, SELF, random_choose_Om_Ludwigshafen_Bulk, switch_alternative_var_random_bits(1, 1)) {
			1: switch_loadstack_Om_Ludwigshafen_OBH_Bulk;
				switch_loadstack_Om_Ludwigshafen_MBH_Bulk;}
																	
	switch (FEAT_TRAINS, SELF, random_choose_Om_Ludwigshafen_Bulk_covered, switch_alternative_var_random_bits(1, 1)) {
