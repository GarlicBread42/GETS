							13: switch_spritestack_ICN_middle_H_blue;
							14: spriteset_ICN_back_blue;}
							
						switch (FEAT_TRAINS, SELF, switch_articulated_ICN_half_blue, extra_callback_info1) {
							1 .. 14: return ITEM_ICN_HALF_BLUE; 
							return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}							

item (FEAT_TRAINS , ITEM_ICN_HALF_BLUE, 5400)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_ICN_HALF_BLUE);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1994,01,01);
						model_life: 					30;
						vehicle_life: 					30;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes:		bitmask(CC_PASSENGERS);
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);						
						cargo_allow_refit:				[PASS, TOUR];
						loading_speed:					8;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							140 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						240 ton;
						dual_headed: 					0;
						default_cargo_type:				PASS;
						cargo_capacity:					15;
						ai_engine_rank: 				0;
						length: 						8;												
			}
			
	//Vehicels Graphics
			graphics{
			default							: switch_ICN_half_blue_graphics;
			additional_text					: string(STR_DESC_SLEEP);
			length							: switch_ICN_Length_half;
			articulated_part				: switch_articulated_ICN_half_blue;
			purchase						: spriteset_ICN_purchase_blue;
			cost_factor						: 750;
			running_cost_factor				: switch_running_cost_ICN_half;
			}
		}

//Switches for Short Set

						switch(FEAT_TRAINS, SELF, switch_ICN_Length_short, position_in_vehid_chain % 11) {
							0 .. 10: 7;}	
							
						switch(FEAT_TRAINS,PARENT,switch_running_cost_ICN_short, 1){
							return 3600;}																																										

						switch(FEAT_TRAINS, SELF, switch_ICN_short_blue_graphics, position_in_vehid_chain % 11) {
							0: spriteset_ICN_front_blue;
							1: switch_spritestack_ICN_middle_A_blue;
							2: switch_spritestack_ICN_middle_B_blue;
							3: spriteset_ICN_middle_C_blue;
							4: switch_spritestack_ICN_middle_D_blue;
							5: spriteset_ICN_middle_C_blue;
							6: spriteset_ICN_middle_E_blue;
							7: switch_spritestack_ICN_middle_F_blue;
							8: switch_spritestack_ICN_middle_G_blue;
							9: switch_spritestack_ICN_middle_H_blue;
							10: spriteset_ICN_back_blue;}
							
						switch (FEAT_TRAINS, SELF, switch_articulated_ICN_short_blue, extra_callback_info1) {
							1 .. 10: return ITEM_ICN_SHORT_BLUE; 
							return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}							

