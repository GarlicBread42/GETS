							6: spriteset_Zans_95_GATX1;
							7: spriteset_Zans_95_GATX1;													
								spriteset_Zans_95_VTG1;}									

					switch (FEAT_TRAINS, SELF, random_choose_Zans_95_GATX, switch_alternative_var_random_bits(1, 1)) {
							1: spriteset_Zans_95_GATX1;
								spriteset_Zans_95_GATX2;}

					switch (FEAT_TRAINS, SELF, random_choose_Zans_95_VTG, switch_alternative_var_random_bits(1, 1)) {
							1: spriteset_Zans_95_VTG1;
								spriteset_Zans_95_VTG2;}								

																
					switch (FEAT_TRAINS, SELF, switch_Zans_95_sprite_choose, cargo_type_in_veh) {
							OIL_: random_choose_Zans_95_OIL;
							RUBR: random_choose_Zans_95_OIL; 
							WATR: random_choose_Zans_95_CHEM;
							BEER: random_choose_Zans_95_CHEM;
							DYES: random_choose_Zans_95_CHEM; 
							PETR: random_choose_Zans_95_OIL;
							RFPR: random_choose_Zans_95_OIL;
							SULP: random_choose_Zans_95_CHEM;
							ACID: random_choose_Zans_95_CHEM;
							CHLO: random_choose_Zans_95_CHEM;
							COAT: random_choose_Zans_95_CHEM;
							FUEL: random_choose_Zans_95_CHEM;
							LYE_: random_choose_Zans_95_CHEM;
							MOLS: random_choose_Zans_95_CHEM;
							NH3_: random_choose_Zans_95_CHEM;
							OILI: random_choose_Zans_95_OIL;
							OILD: random_choose_Zans_95_OIL;
							O2__: random_choose_Zans_95_CHEM;
							SOAP: random_choose_Zans_95_CHEM;
							PLST: random_choose_Zans_95_OIL;
								random_choose_Zans_95_CHEM;}								

						switch(FEAT_TRAINS, SELF, switch_length_Zans_95, position_in_vehid_chain % 2) {
							0: 4;
							1: 6;}								

					switch(FEAT_TRAINS,PARENT,switch_running_cost_Zans_95, 1){
						return 700;}								

						switch(FEAT_TRAINS, SELF, switch_Zans_95_AUTO_graphics, position_in_articulated_veh % 2) {
							0:	   spriteset_empty;
							1:     return switch_Zans_95_sprite_choose;}
						 		 
					switch (FEAT_TRAINS, SELF, switch_articulated_Zans_95_AUTO, extra_callback_info1) {
						1: return ITEM_ZANS_95_AUTO;
						return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}
													
item (FEAT_TRAINS , ITEM_ZANS_95_AUTO, 9373)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_ZANS_95_AUTO);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1998,01,01);
						model_life: 					VEHICLE_NEVER_EXPIRES;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes:		bitmask(CC_LIQUID);
						cargo_allow_refit:              [OIL_, RUBR, WATR, BEER, DYES, PETR, RFPR, SULP, ACID, CHLO, COAT, FUEL, LYE_, MOLS, NH3_, OILI, OILD, O2__, SOAP, PLST,];
						loading_speed:					5;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							120 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						24 ton;
						dual_headed: 					0;
						default_cargo_type:				OIL_;
						cargo_capacity:					47;
						ai_engine_rank: 				0;
						length: 						8;
												
			}
			
	//Vehicels Graphics
			graphics
			{
			default							: switch_Zans_95_AUTO_graphics;
			additional_text					: string(STR_DESC_GOODS);
			articulated_part			  	: switch_articulated_Zans_95_AUTO;
			length							: switch_length_Zans_95;			
			purchase						: spriteset_Zans_95_purchase_VTG;
			cost_factor						: 340;
			running_cost_factor				: switch_running_cost_Zans_95;				
			
			 }
		}	

						switch(FEAT_TRAINS, SELF, switch_Zans_95_CHEM_graphics, position_in_articulated_veh % 2) {
							0:	   spriteset_empty;
							1:     return random_choose_Zans_95_CHEM;}
						 		 
					switch (FEAT_TRAINS, SELF, switch_articulated_Zans_95_CHEM, extra_callback_info1) {
						1: return ITEM_ZANS_95_CHEM;
						return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}
													
