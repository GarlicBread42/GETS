//Switches

					switch (FEAT_TRAINS,SELF, switch_Shimmns_708_purchase,current_year){
						1800 .. 1978: spriteset_Shimmns_708_purchase_silber;
						1979 .. 1995: spriteset_Shimmns_708_purchase_braun;
						1996 .. 2050: spriteset_Shimmns_708_purchase_DBCargo;
							spriteset_Shimmns_708_purchase_DBCargo;}							

					switch (FEAT_TRAINS, SELF, random_choose_Shimmns_708_Era1, switch_alternative_var_random_bits(1, 2)) {
							1: spritegroup_Shimmns_708_braun;
							2: spritegroup_Shimmns_708_silber;
							3: spritegroup_Shimmns_708_braun;														
								spritegroup_Shimmns_708_braun;}
								
					switch (FEAT_TRAINS, SELF, random_choose_Shimmns_708_Era2, switch_alternative_var_random_bits(1, 2)) {
							1: spritegroup_Shimmns_708_braun;
							2: spritegroup_Shimmns_708_DBCargo;
							3: spritegroup_Shimmns_708_DBCargo;														
								spritegroup_Shimmns_708_DBCargo;}								
								
					switch (FEAT_TRAINS, SELF, random_choose_Shimmns_708_Era3, switch_alternative_var_random_bits(1, 2)) {
							1: spritegroup_Shimmns_708_Transwaggon;
							2: spritegroup_Shimmns_708_DBCargo;
							3: spritegroup_Shimmns_708_Transwaggon;														
								spritegroup_Shimmns_708_DBCargo;}
								
					switch (FEAT_TRAINS,SELF, switch_Shimmns_708_current_year,current_year){
						   0 .. 1978: spritegroup_Shimmns_708_silber;
						1979 .. 1995: random_choose_Shimmns_708_Era1;
						1996 .. 2001: random_choose_Shimmns_708_Era2;
						2002 .. 2050: random_choose_Shimmns_708_Era3;
							random_choose_Shimmns_708_Era3;}									
																				
					switch(FEAT_TRAINS,PARENT,switch_running_cost_Shimmns_708, 1){
						return 475;}
													
item (FEAT_TRAINS , ITEM_SHIMMNS_708_CURRENT, 9030)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_SHIMMNS_708_CURRENT);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1978,01,01);
						model_life: 					VEHICLE_NEVER_EXPIRES;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes: 		bitmask(CC_COVERED, CC_PIECE_GOODS);
						non_refittable_cargo_classes: 	bitmask(CC_LIQUID, CC_BULK);
						cargo_allow_refit:              [STAL, ALUM, STCB, STST, STSH, STWR, COPR,];
						cargo_disallow_refit: 			[LVST, FOOD, WATR, BEER, BOOM, FISH, IRON, ENSP, FMSP, FRUT, PAPR, MPTS, POWR, VPTS, WOOD, WOOL, PIPE, VEHI, VBOD, VENG, MNSP, ZINC, CSTI, GLAS, STSE, TYRE];
						misc_flags: 					bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_SPRITE_STACK);
						loading_speed:					6;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							100 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						23 ton;
						dual_headed: 					0;
						default_cargo_type:				STAL;
						cargo_capacity:					67;
						ai_engine_rank: 				0;
						length: 						8;
												
			}
			
	//Vehicels Graphics
			graphics
			{
			default							: switch_Shimmns_708_current_year;
			additional_text					: string(STR_DESC_GOODS);
			purchase						: switch_Shimmns_708_purchase;
			cost_factor						: 150;
			running_cost_factor				: switch_running_cost_Shimmns_708;	
			colour_mapping					: switch_generic_recolour;
			 }
		}


