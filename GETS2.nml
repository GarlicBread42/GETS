	switch (FEAT_TRAINS,SELF, switch_Om_Ludwigshafen_purchase,current_year){
		1800 .. 1919: spriteset_Om_Ludwigshafen_purchase1;
		1920 .. 1945: spriteset_Om_Ludwigshafen_purchase2;						
		1946 .. 2050: spriteset_Om_Ludwigshafen_purchase3;
			spriteset_Om_Ludwigshafen_purchase3;}															

	switch (FEAT_TRAINS,SELF, switch_Om_Ludwigshafen_MBH_current_year,current_year){
		1800 .. 1919: spriteset_Om_Ludwigshafen_KPEV_MBH;
		1920 .. 2045: spriteset_Om_Ludwigshafen_DRG_MBH;
		1946 .. 2050: spriteset_Om_Ludwigshafen_DB_MBH;
			spriteset_Om_Ludwigshafen_DB_MBH;}						
		
	switch (FEAT_TRAINS,SELF, switch_Om_Ludwigshafen_OBH_current_year,current_year){
		1800 .. 1919: spriteset_Om_Ludwigshafen_KPEV_OBH;
		1920 .. 1945: spriteset_Om_Ludwigshafen_DRG_OBH;					
		1946 .. 2050: spriteset_Om_Ludwigshafen_DB_OBH;
			spriteset_Om_Ludwigshafen_DB_OBH;}

