							0: spriteset_WRmh_132_TEE;
							1: spritegroup_WRmh_132_loading;}																					

							   																			
						switch(FEAT_TRAINS, SELF, switch_length_WRmh_132, position_in_vehid_chain % 3) {
							0: 4;
							1: 7;
							2: 4;}
						
						switch(FEAT_TRAINS,PARENT,switch_running_cost_WRmh_132, 1){
							return 7800;}	
							
						switch(FEAT_TRAINS, SELF, switch_speed_WRmh_132, current_year) {
							  00 .. 1977 : 160 ;
							1978 .. 2050 : 200 ;
								200;}							
							
						switch (FEAT_TRAINS,SELF,switch_build_year_WRmh_132,build_year) {
							   0 .. 1965 : switch_spritestack_WRmh_132_DSG;
							1966 .. 1973 : switch_spritestack_WRmh_132_DB_rot;
