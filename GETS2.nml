switch (FEAT_TRAINS, SELF, switch_articulated_Eaos_106_DB, extra_callback_info1) {
	1 .. 2: return ITEM_EAOS_106_DB;
	return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}
													
item (FEAT_TRAINS , ITEM_EAOS_106_DB, 8625)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_EAOS_106_DB);
						variant_group:					8623;
						extra_flags:					bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW);	
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1998,01,01);
						model_life: 					VEHICLE_NEVER_EXPIRES;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes: 		bitmask(CC_BULK, CC_COVERED, CC_PIECE_GOODS,);
						non_refittable_cargo_classes: 	bitmask(CC_LIQUID, CC_REFRIGERATED, CC_HAZARDOUS, CC_OVERSIZED);
						cargo_allow_refit:              [WOOD, BDMT, WDPR, TWOD, FRUT ];
						cargo_disallow_refit: 			[LVST, FOOD, WATR, BEER, BOOM, FISH, IRON];
						misc_flags: 					bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_SPRITE_STACK);
						loading_speed:					10;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							100 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						20 ton;
						dual_headed: 					0;
						default_cargo_type:				COAL;
						cargo_capacity:					25;
						ai_engine_rank: 				0;
						length: 						8;
												
			}
			
	//Vehicels Graphics
			graphics
			{
			default							: switch_Eaos_106_DB_graphics;
			additional_text					: string(STR_DESC_GOODS);
			purchase						: spriteset_Eaos_106_purchase_DB;
			cost_factor						: 170;
			running_cost_factor				: switch_running_cost_Eaos_106;
			articulated_part			  	: switch_articulated_Eaos_106_DB;
			length							: switch_length_Eaos_106;			
			colour_mapping					: switch_bulk_recolour;
			 }
		}

//Only DB Railion liveries

	switch(FEAT_TRAINS, SELF, switch_Eaos_106_Graffiti_graphics, position_in_articulated_veh % 3) {
		0:	   spriteset_empty;
		1:     return switch_Eaos_106_Graffiti_cargo_type;
		2:	   spriteset_empty;}
				
	switch (FEAT_TRAINS, SELF, switch_articulated_Eaos_106_Graffiti, extra_callback_info1) {
		1 .. 2: return ITEM_EAOS_106_GRAFFITI;
		return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}
													
item (FEAT_TRAINS , ITEM_EAOS_106_GRAFFITI, 8628)
