						switch (FEAT_TRAINS,SELF,switch_purchase_UICX_D,current_year) {
							  00 .. 1974 : spriteset_UICX_D_purchase_gruen;
							1975 .. 1987 : spriteset_UICX_D_purchase_ozeanblau;
							1988 .. 1995 : spriteset_UICX_D_purchase_grau;
							1996 .. 2050 : spriteset_UICX_D_purchase_Regio;
									spriteset_UICX_D_purchase_Regio;}

						switch(FEAT_TRAINS, SELF, switch_loadstack_UICX_D_gruen, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_UICX_D_gruen;
							1: spritegroup_UICX_D_loading;}

						switch(FEAT_TRAINS, SELF, switch_loadstack_UICX_D_popfarben1, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_UICX_D_popfarben1;
							1: spritegroup_UICX_D_loading;}
							
						switch(FEAT_TRAINS, SELF, switch_loadstack_UICX_D_popfarben2, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_UICX_D_popfarben2;
							1: spritegroup_UICX_D_loading;}
							
						switch(FEAT_TRAINS, SELF, switch_loadstack_UICX_D_ozeanblau, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_UICX_D_ozeanblau;
							1: spritegroup_UICX_D_loading;}
							
						switch(FEAT_TRAINS, SELF, switch_loadstack_UICX_D_grau, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_UICX_D_grau;
							1: spritegroup_UICX_D_loading;}

						switch(FEAT_TRAINS, SELF, switch_loadstack_UICX_D_Regio, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_UICX_D_Regio;
							1: spritegroup_UICX_D_loading;}

						switch (FEAT_TRAINS, SELF, random_choose_UICX_D_popfarben, switch_alternative_var_random_bits(1, 1)) {
							1: switch_loadstack_UICX_D_popfarben1;
								switch_loadstack_UICX_D_popfarben2;}
													
						switch(FEAT_TRAINS, SELF, switch_length_UICX_D, position_in_articulated_veh % 3) {
							0: 4;
							1: 7;
							2: 4;}

						switch(FEAT_TRAINS, SELF, switch_speed_UICX_D, current_year) {
							  00 .. 1963 : 140 ;
							1964 .. 1987 : 160 ;
							1988 .. 2050 : 200 ;
								200;}
						
						switch(FEAT_TRAINS,PARENT,switch_running_cost_UICX_D, 1){
							return 2250;}

						switch (FEAT_TRAINS,SELF,switch_build_year_UICX_D,build_year) {
							  00 .. 1974 : switch_loadstack_UICX_D_gruen;
							1975 .. 1987 : switch_loadstack_UICX_D_ozeanblau;
							1988 .. 1995 : switch_loadstack_UICX_D_grau;
							1996 .. 2050 : switch_loadstack_UICX_D_Regio;
								switch_loadstack_UICX_D_Regio;}
								
						switch(FEAT_TRAINS, SELF, switch_UICX_D_graphics_build, position_in_articulated_veh  % 3) {
							0:     spriteset_empty;
							1:     return switch_build_year_UICX_D;
							2:     spriteset_empty;}	
								
						switch (FEAT_TRAINS, SELF, switch_articulated_UICX_D_build, extra_callback_info1) {
							1 .. 2: return ITEM_UICX_D_BUILD;
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}								
	
