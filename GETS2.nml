							0: spriteset_BR_650_WB;
							1: spritegroup_BR_650_WB_loading;}	
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_650_EB, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_650_EB;
							1: spritegroup_BR_650_EB_loading;}		
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_650_STB, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_650_STB;
							1: spritegroup_BR_650_EB_loading;}																																																				

						switch(FEAT_TRAINS, SELF, switch_BR_650_length, position_in_vehid_chain % 3) {
							0: 4;
							1: 7;
							2: 4;}							

						switch(FEAT_TRAINS, SELF, switch_FX_BR_650, position_in_vehid_chain % 3) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_DIESEL, -2, DISABLE_WAGON_POWER);
							return visual_effect_and_powered(VISUAL_EFFECT_DIESEL, -7, DISABLE_WAGON_POWER);}

						switch(FEAT_TRAINS,PARENT,switch_running_cost_BR_650, 1){
							return 475;}						
							
						switch(FEAT_TRAINS, SELF, switch_BR_650_graphics_DB, position_in_vehid_chain % 3) {
							0:	   spriteset_empty;
							1:     return switch_spritestack_BR_650_DB;
							2:     spriteset_empty;}

						switch (FEAT_TRAINS, SELF, switch_articulated_BR_650_DB, extra_callback_info1) {
							1 .. 2: return ITEM_BR_650_DB; 				
							return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}
								
item (FEAT_TRAINS , ITEM_BR_650_DB, 6500)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_BR_650_DB);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1996,01,01);
						model_life: 					40;
						vehicle_life: 					40;
