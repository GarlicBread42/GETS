		alternative_sprites (spriteset_BR_484_lights_front, ZOOM_LEVEL_IN_2X, BIT_DEPTH_32BPP, "gfx\BR_483/BR_483_lights_front_2x_32bpp.png", "gfx\BR_483/BR_483_lights_front_2x_mask.png")
									{ template_118trains_2x(0, 0)}
				
