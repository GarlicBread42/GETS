					switch (FEAT_TRAINS, PARENT, switch_speed_Kessel_Krupp,  switch_check_PWG_0()) {
						1: return 65;
						0: return 50;}

					switch(FEAT_TRAINS,PARENT,switch_running_cost_Kessel_Krupp, 1){
						return 165;}	
						
