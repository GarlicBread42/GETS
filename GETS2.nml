							return visual_effect_and_powered(VISUAL_EFFECT_DIESEL, -7, DISABLE_WAGON_POWER);}

						switch(FEAT_TRAINS,PARENT,switch_running_cost_VT_757, 1){
							return 475;}
							
						switch(FEAT_TRAINS, SELF, switch_speed_VT_757, current_year){
							   0 .. 1939: 70;
							1940 .. 2050: 85;
								85;}
							
						switch(FEAT_TRAINS, SELF, switch_hp_VT_757, current_year){
