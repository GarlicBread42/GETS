						 switch (FEAT_TRAINS,SELF, switch_111_purchase,current_year){
							1970 .. 1987: spriteset_111_purchase1;
							1988 .. 1999: spriteset_111_purchase2;
							2000 .. 2050: spriteset_111_purchase3;					 					 
								spriteset_111_purchase3;}
						 	
						 switch (FEAT_TRAINS,SELF, switch_111_current_year,current_year){
							1970 .. 1987: spriteset_111_ozeanblau;
							1988 .. 1999: spriteset_111_orientrot;
							2000 .. 2050: spriteset_111_verkehrsrot;					 					 
								spriteset_111_ozeanblau;}
	
						switch (FEAT_TRAINS,SELF,switch_111_build_year,build_year){
							1970 .. 1987: spriteset_111_ozeanblau;
							1988 .. 1999: spriteset_111_orientrot;
							2000 .. 2050: spriteset_111_verkehrsrot;					 					 
								spriteset_111_ozeanblau;}
					
						switch(FEAT_TRAINS, SELF, switch_length_111, position_in_vehid_chain % 2) {
						0: 4;
						1: 6;}
						
						switch(FEAT_TRAINS, SELF, switch_FX_111, position_in_vehid_chain % 3) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
							return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}

						switch(FEAT_TRAINS,PARENT,switch_running_cost_111, 1){
							return 3650;}						
							
						switch(FEAT_TRAINS, SELF, switch_111_graphics_build, position_in_vehid_chain % 2) {
							0:	   spriteset_empty;
							1:     return switch_111_build_year;}
							
						switch (FEAT_TRAINS, SELF, switch_articulated_111_build, extra_callback_info1) {
							1: return ITEM_BR_111_BUILD; 
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}
													
item (FEAT_TRAINS , ITEM_BR_111_BUILD, 1110)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_BR_111_BUILD);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1974,01,01);
						model_life: 					56;
						vehicle_life: 					40;
						retire_early: 					-10;							
						reliability_decay: 				20;
						cargo_allow_refit: 				[PASS] ;
						cargo_capacity: 				1 ;
						cost_factor: 					108;
						running_cost_base: 				RUNNING_COST_STEAM;						
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							160 km/h;
						refit_cost: 					0;
						track_type: 					AC15;
						power:  						4924 hp;
						weight: 						83 ton;
						ai_engine_rank: 				0;
						engine_class: 					ENGINE_CLASS_ELECTRIC;
