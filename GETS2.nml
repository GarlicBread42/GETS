//Switches

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_89_70_purchase_KPEV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_89_70_purchase_KPEV;
							1: spriteset_BR_89_70_purchase_anim;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_89_70_purchase_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
