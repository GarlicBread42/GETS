		alternative_sprites (spriteset_Pwi28_DRG_loading, ZOOM_LEVEL_IN_2X, BIT_DEPTH_32BPP, "gfx\Pwi28\Pwi28_DRG_loading_2x_32bpp.png", "gfx\Pwi28\Pwi28_DRG_loading_2x_mask.png")
					{template_88trains_2x(0,0)}				
			
		alternative_sprites (spriteset_Pwi28_DRG_loading, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP, "gfx\Pwi28\Pwi28_DRG_loading_4x_32bpp.png", "gfx\Pwi28\Pwi28_DRG_loading_4x_mask.png")
					{template_88trains_4x(0,0)}	
					
spritegroup spritegroup_Pwi28_DRG
		{
			loaded: 	[spriteset_Pwi28_DRG];
			loading: 	[spriteset_Pwi28_DRG_loading];}	
			
			
//Spriteset DB


