//Spritesets purchase

spriteset (spriteset_Eaos_106_purchase_brown, "gfx\Eaos_106/Eaos_106_brown1_1x_8bpp.png")
					{template_purchase(0, 0)}	
		alternative_sprites (spriteset_Eaos_106_purchase_brown, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\Eaos_106/Eaos_106_brown1_1x_32bpp.png", "gfx\Eaos_106/Eaos_106_brown1_1x_mask.png")
