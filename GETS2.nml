						switch (FEAT_TRAINS,SELF, switch_BR_218_purchase,current_year){
							    0 .. 1974: spriteset_BR218_purchase_altrot;
							 1975 .. 1987: spriteset_BR218_purchase_ozeanblau;
							 1988 .. 2008: spriteset_BR218_purchase_orientrot;
							 2009 .. 2050: spriteset_BR218_purchase_verkehrsrot;					 					 
								spriteset_BR218_purchase_altrot;}
							 
						switch (FEAT_TRAINS,SELF, switch_BR_218_current_year,current_year){
							    0 .. 1974: spriteset_BR218_altrot;
							 1975 .. 1987: spriteset_BR218_ozeanblau;
							 1988 .. 2008: spriteset_BR218_orientrot;
							 2009 .. 2050: spriteset_BR218_verkehrsrot;					 					 
								spriteset_BR218_altrot;}
		
						switch (FEAT_TRAINS,SELF, switch_BR_218_build_year,build_year){
							    0 .. 1974: spriteset_BR218_altrot;
							 1975 .. 1987: spriteset_BR218_ozeanblau;
							 1988 .. 2008: spriteset_BR218_orientrot;
							 2009 .. 2050: spriteset_BR218_verkehrsrot;					 					 
								spriteset_BR218_altrot;}								

						switch(FEAT_TRAINS, SELF, switch_length_BR218, position_in_vehid_chain % 2) {
							0: 4;
							1: 6;}
						
						switch(FEAT_TRAINS, SELF, switch_FX_BR_218, position_in_vehid_chain % 3) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 2, DISABLE_WAGON_POWER);
								return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}
						
						switch(FEAT_TRAINS,PARENT,switch_running_cost_218, 1){
							return 3075;}

						switch(FEAT_TRAINS, SELF, switch_BR218_graphics_build, position_in_vehid_chain % 2) {
							0:	   spriteset_empty;
							1:     return switch_BR_218_build_year;}

						switch (FEAT_TRAINS, SELF, switch_articulated_BR218_build, extra_callback_info1) {
							1: return ITEM_BR_218_BUILD; 
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}
								
