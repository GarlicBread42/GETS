						switch(FEAT_TRAINS, SELF, switch_uicx_bdms_graphics_Regio, position_in_articulated_veh  % 3) {
							0:     spriteset_empty;
							1:     return switch_loadstack_UICX_BDMS_Regio;
							2:     spriteset_empty;}	
	
