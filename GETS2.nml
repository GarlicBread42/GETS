//Switches

						switch (FEAT_TRAINS,SELF,switch_purchase_BC6S,current_year) {
							  00 .. 1945 : spriteset_BC6S_purchase_LBE;
							1946 .. 2050 : spriteset_BC6S_purchase_DB;
								spriteset_BC6S_purchase_DB;}	
								
						switch(FEAT_TRAINS, SELF, switch_loadstack_BC6S_LBE_front, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BC6S_LBE_front;
							1: spritegroup_BC6S_front_loading;}	
							
						switch(FEAT_TRAINS, SELF, switch_loadstack_BC6S_LBE_back, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BC6S_LBE_back;
							1: spritegroup_BC6S_back_loading;}	
							
						switch(FEAT_TRAINS, SELF, switch_loadstack_BC6S_DB_front, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BC6S_DB_front;
							1: spritegroup_BC6S_front_loading;}	
							
						switch(FEAT_TRAINS, SELF, switch_loadstack_BC6S_DB_back, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BC6S_DB_back;
							1: spritegroup_BC6S_back_loading;}		
							
							   
							   						   																																
						switch(FEAT_TRAINS, SELF, switch_length_BC6S, position_in_articulated_veh % 6) {
							0: 4;
							1: 6;
							2: 4;
							3: 4;
							4: 6;
							5: 4;							}

						switch(FEAT_TRAINS,PARENT,switch_running_cost_BC6S, 1){
							return 7200;}
							
						switch (FEAT_TRAINS,SELF,switch_build_year_BC6S_front,build_year) {
							  00 .. 1945 : switch_loadstack_BC6S_LBE_front;
							1946 .. 2050 : switch_loadstack_BC6S_DB_front;
								switch_loadstack_BC6S_DB_front;}
								
						switch (FEAT_TRAINS,SELF,switch_build_year_BC6S_back,build_year) {
							  00 .. 1945 : switch_loadstack_BC6S_LBE_back;
							1946 .. 2050 : switch_loadstack_BC6S_DB_back;
								switch_loadstack_BC6S_DB_back;}																

						switch(FEAT_TRAINS, SELF, switch_BC6S_graphics_build, position_in_articulated_veh  % 6) {
							0:     spriteset_empty;
							1:     return switch_build_year_BC6S_front;
							2:     spriteset_empty;	
							3:     spriteset_empty;
							4:     return switch_build_year_BC6S_back;
							5:     spriteset_empty;}							
								
						switch (FEAT_TRAINS, SELF, switch_articulated_BC6S_build, extra_callback_info1) {
							1 .. 5: return ITEM_BC6S_BUILD;
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}


item (FEAT_TRAINS , ITEM_BC6S_BUILD, 7332)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_BC6S_BUILD);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
