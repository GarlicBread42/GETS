//Switches
						switch (FEAT_TRAINS, SELF, switch_animation_BR_92_1, motion_counter % 4) {
								0: spriteset_BR_92_1_anim1;
								1: spriteset_BR_92_1_anim2;
								2: spriteset_BR_92_1_anim3;
								3: spriteset_BR_92_1_anim4;}

						switch (FEAT_TRAINS, SELF, switch_animation_BR_92_1_REV, motion_counter % 4) {
								0: spriteset_BR_92_1_anim1_REV;
								1: spriteset_BR_92_1_anim2_REV;
								2: spriteset_BR_92_1_anim3_REV;
								3: spriteset_BR_92_1_anim4_REV;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_92_1_purchase1, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_92_1_purchase1;
							1: spriteset_BR_92_1_anim_purchase;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_92_1_purchase2, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_92_1_purchase2;
							1: spriteset_BR_92_1_anim_purchase;}								
	
							switch (FEAT_TRAINS,SELF, switch_BR_92_1_purchase,current_year){
							   0 .. 1919: switch_spritestack_BR_92_1_purchase1;
							1920 .. 2045: switch_spritestack_BR_92_1_purchase2;															 					 
								switch_spritestack_BR_92_1_purchase2;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_92_1_KWSE, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_92_1_KWSE;
							1: return switch_animation_BR_92_1;}									

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_92_1_KWSE_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_92_1_KWSE_REV;
							1: return switch_animation_BR_92_1_REV;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_92_1_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_92_1_DRG;
							1: return switch_animation_BR_92_1;}									

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_92_1_DRG_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_92_1_DRG_REV;
							1: return switch_animation_BR_92_1_REV;}


						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_92_1_KWSE, vehicle_is_reversed) {
							0: switch_spritestack_BR_92_1_KWSE;
								switch_spritestack_BR_92_1_KWSE_REV;}

						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_92_1_DRG, vehicle_is_reversed) {
							0: switch_spritestack_BR_92_1_DRG;
								switch_spritestack_BR_92_1_DRG_REV;}									

						switch (FEAT_TRAINS,SELF, switch_BR_92_1_current_year,current_year){
							    0 .. 1919: switch_reverse_BR_92_1_KWSE;
							 1920 .. 1960: switch_reverse_BR_92_1_DRG;					 					 
							 switch_reverse_BR_92_1_DRG;}		
							 
						switch (FEAT_TRAINS,SELF, switch_BR_92_1_build_year,build_year){
							    0 .. 1919: switch_reverse_BR_92_1_KWSE;
							 1920 .. 1960: switch_reverse_BR_92_1_DRG;					 					 
							 switch_reverse_BR_92_1_DRG;}							 																																									

						switch(FEAT_TRAINS, PARENT, switch_FX_BR_92_1, vehicle_is_reversed) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_STEAM, -3, DISABLE_WAGON_POWER);
								return visual_effect_and_powered(VISUAL_EFFECT_STEAM, 2, DISABLE_WAGON_POWER);}
								
						switch(FEAT_TRAINS,PARENT,switch_running_cost_BR_92_1, 1){
						return 450;}

item (FEAT_TRAINS , ITEM_BR_92_1, 0920)
		{
			//property Block
					property 
