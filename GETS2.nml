						switch(FEAT_TRAINS, SELF, switch_spritestack_E_70_2_DB_blue, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_E_70_2_DB_blue;
							1: return switch_animation_E_70_2;}								

						switch (FEAT_TRAINS,SELF, switch_E_70_2_build_year,build_year){
							    0 .. 1926: switch_spritestack_E_70_2_DRG_brown;	
