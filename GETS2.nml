item (FEAT_TRAINS , ITEM_BR_ES6_KPEV, 1006)
		{
	//property Block
			property 
			{
			//common properties
						name: string(STR_NAME_BR_ES6_KPEV);
						climates_available: ALL_CLIMATES;
						introduction_date: date(1914,01,01);
						model_life: 9;
						vehicle_life: 9;
						retire_early: -10;							
						reliability_decay: 20;
						cargo_allow_refit              : [PASS] ;
						cargo_capacity                 : 1 ;
						cost_factor: 0;
						running_cost_base:   RUNNING_COST_STEAM;						
						running_cost_factor: 90;

						
			//Train specific properties
						sprite_id: SPRITE_ID_NEW_TRAIN;
						speed: 100 km/h;
						refit_cost: 0;
						track_type: AC15;
						power:  1203 hp;
						weight: 81 ton;
						ai_engine_rank: 0;
						engine_class: ENGINE_CLASS_ELECTRIC;
						visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
						dual_headed: 0;
						tractive_effort_coefficient: 0.1;
						length: 8;
												
			}

		//Vehicels Graphics
			graphics
			{
			default							: switch_animation_BR_ES6_KPEV;
			additional_text					: string(STR_CONCAT_2, 
											  string(STR_TRACTION_ELECTRIC), 
											  string(STR_DESC_EXPRESS),);
			purchase_cargo_capacity		    : 0 ;
			cargo_capacity	                : return 0 ;
			purchase						: spriteset_BR_ES6_KPEV_purchase;
			cost_factor						: 37;
			running_cost_factor				: switch_running_cost_BR_ES6_KPEV;
			}
	}
