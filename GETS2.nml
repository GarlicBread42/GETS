						   0 .. 1919: spriteset_Tender_3T16_5_KPEV;
						1920 .. 1945: spriteset_Tender_3T16_5_DRG;
						1946 .. 1990: spriteset_Tender_3T16_5_DB; 						 					 
						spriteset_Tender_3T16_5_DB;}

				switch (FEAT_TRAINS,SELF, switch_BR_58_2_Tender_current_year,current_year){
						   0 .. 1919: spriteset_Tender_3T16_5_KPEV;
						1920 .. 1945: spriteset_Tender_3T16_5_DRG;
						1946 .. 1990: spriteset_Tender_3T16_5_DB; 						 					 
						spriteset_Tender_3T16_5_DB;}

					switch(FEAT_TRAINS, SELF, switch_length_BR_58_2, position_in_vehid_chain % 2) {
						0: 8;
						1: 4;}
							
					switch(FEAT_TRAINS, SELF, switch_FX_BR_58_2, position_in_vehid_chain % 2) {
						0: return visual_effect_and_powered(VISUAL_EFFECT_STEAM, -2, DISABLE_WAGON_POWER);
						return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}
						
					switch (FEAT_TRAINS, PARENT, switch_running_cost_BR_58_2, 1) {
							return 1450;}																											 						 
							
					switch(FEAT_TRAINS, SELF, switch_BR_58_2_graphics_build, position_in_vehid_chain % 2) {
						0:	   return switch_BR_58_2_build_year;
						1:     return switch_BR_58_2_Tender_build_year;}	
																			
					switch (FEAT_TRAINS, SELF, switch_articulated_BR_58_2_build, extra_callback_info1) {
						1: return ITEM_BR_58_2; 
						return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}
						
item (FEAT_TRAINS , ITEM_BR_58_2, 0580)
