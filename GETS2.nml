		alternative_sprites (spriteset_E_1200_RBH, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/E_1200/E_1200_RBH_1x_32bpp.png", "gfx/E_1200/E_1200_RBH_1x_mask.png")
