							   switch_spritestack_UICX_HSW_gruenrot;}
							   																			
						switch(FEAT_TRAINS, SELF, switch_length_UICX_HSW, position_in_vehid_chain % 3) {
							0: 4;
							1: 7;
							2: 4;}
						
						switch(FEAT_TRAINS,PARENT,switch_running_cost_UICX_HSW, 1){
							return 7800;}							   							
							
						switch (FEAT_TRAINS,SELF,switch_build_year_UICX_HSW,build_year) {
