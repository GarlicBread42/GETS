						switch(FEAT_TRAINS, SELF, switch_coupling_VT_085, vehicle_type_id) {
							6080: return CB_RESULT_ATTACH_ALLOW;
							6081: return CB_RESULT_ATTACH_ALLOW;
							6125: return CB_RESULT_ATTACH_ALLOW;
							6126: return CB_RESULT_ATTACH_ALLOW;
							return string (STR_COUPLING_VT_085);}

						switch(FEAT_TRAINS, SELF, switch_spritestack_VT_085_front, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
