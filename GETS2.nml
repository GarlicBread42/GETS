						switch(FEAT_TRAINS, SELF, switch_FX_BR_445_6, position_in_vehid_chain % 18) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE,0, DISABLE_WAGON_POWER);
							1: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
							2: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC,-2, DISABLE_WAGON_POWER);	
					  3 .. 14: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
						   15: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC,-1, DISABLE_WAGON_POWER);
						   16: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
						   17: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}	
							
						switch(FEAT_TRAINS,PARENT,switch_running_cost_BR_445_6, 1){
							return 7400;}

						switch(FEAT_TRAINS, SELF, switch_BR_445_6_Regio_graphics, position_in_vehid_chain % 18) {
							0:	   spriteset_empty;
							1:     return switch_spritestack_BR_445_front_Regio;
							2:     spriteset_empty;
							3:	   spriteset_empty;
							4:	   return switch_spritestack_BR_445_middle1_Regio;
							5:	   spriteset_empty;
							6:	   spriteset_empty;
							7:	   return random_choose_BR_445_4_Regio_middle1;
							8:	   spriteset_empty;							
							9:	   spriteset_empty;
						   10:	   return random_choose_BR_445_4_Regio_middle2;
						   11:	   spriteset_empty;
						   12:	   spriteset_empty;
						   13:	   return switch_spritestack_BR_445_middle1_Regio;
						   14:	   spriteset_empty;
						   15:	   spriteset_empty;
						   16:	   return switch_spritestack_BR_445_back_Regio;
						   17:	   spriteset_empty;}

						switch (FEAT_TRAINS, SELF, switch_articulated_BR_445_6_Regio, extra_callback_info1) {
							1 .. 17: return ITEM_BR_445_6_REGIO; 
							return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}

item (FEAT_TRAINS , ITEM_BR_445_6_REGIO, 4459)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_BR_445_6_REGIO);
						variant_group:					4451;
						extra_flags:					bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);						
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(2014,01,01);
						model_life: 					VEHICLE_NEVER_EXPIRES;
						vehicle_life: 					40;
						retire_early: 					-10;							
						reliability_decay: 				20;
						cargo_allow_refit:              [PASS, TOUR];
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);
						cargo_capacity:                 40 ;
						loading_speed:					15;
						cost_factor: 					108;
						running_cost_base:				RUNNING_COST_STEAM;						
						running_cost_factor: 			90;

						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							160 km/h;
						refit_cost: 					0;
						track_type: 					AC15;	
						power:  						6250 hp;
						weight: 						332 ton;
						ai_engine_rank: 				0;
						engine_class: 					ENGINE_CLASS_ELECTRIC;
						visual_effect_and_powered: 		visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
						dual_headed: 					0;
						tractive_effort_coefficient: 	0.109;
						length: 						8;
			}

		//Vehicels Graphics
			graphics
			{
			default							: switch_BR_445_6_Regio_graphics;
			additional_text					: string(STR_CONCAT_2, 
											  string(STR_TRACTION_EMU), 
											  string(STR_DESC_PASS),);
			length							: switch_length_BR_445_6;
			articulated_part				: switch_articulated_BR_445_6_Regio;
			visual_effect_and_powered		: switch_FX_BR_445_6;
			purchase						: spriteset_BR_445_purchase_Regio;
			cost_factor						: 554;
			running_cost_factor				: switch_running_cost_BR_445_6;			
			}
	}
