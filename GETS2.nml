//Switches

						switch (FEAT_TRAINS,SELF, switch_purchase_Karlsruher,current_year){
							   0 .. 1974: spriteset_Karlsruher_purchase_schwarz;
							1975 .. 1987: spriteset_Karlsruher_purchase_ozeanblau;
							1988 .. 1995: spriteset_Karlsruher_purchase_mint;
							1996 .. 2050: spriteset_Karlsruher_purchase_verkehrsrot;
								spriteset_Karlsruher_purchase_verkehrsrot;}	
								
						switch(FEAT_TRAINS, SELF, switch_spritestack_Karlsruher_schwarz, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_Karlsruher_schwarz;
							1: spritegroup_Hasenkasten_loading;}																	

						switch(FEAT_TRAINS, SELF, switch_spritestack_Karlsruher_Binde, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_Karlsruher_Binde;
							1: spritegroup_Hasenkasten_loading;}	

						switch(FEAT_TRAINS, SELF, switch_spritestack_Karlsruher_ozeanblau, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_Karlsruher_ozeanblau;
							1: spritegroup_Hasenkasten_loading;}	
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_Karlsruher_mint, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_Karlsruher_mint;
							1: spritegroup_Hasenkasten_loading;}	
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_Karlsruher_verkehrsrot, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_Karlsruher_verkehrsrot;
							1: spritegroup_Hasenkasten_loading;}	
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_Karlsruher_Karlsruhe, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_Karlsruher_Karlsruhe;
							1: spritegroup_Hasenkasten_loading;}	
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_Karlsruher_Citybahn, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_Karlsruher_Citybahn;
							1: spritegroup_Hasenkasten_loading;}	
													
						switch(FEAT_TRAINS, SELF, switch_spritestack_Karlsruher_NatX, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_Karlsruher_NatX;
							1: spritegroup_Hasenkasten_loading;}
								
						switch(FEAT_TRAINS, SELF, switch_length_Karlsruher, position_in_vehid_chain % 3) {
							0: 4;
							1: 7;
							2: 4;}

						switch(FEAT_TRAINS,PARENT,switch_running_cost_Karlsruher, 1){
							return 2350;}

						switch (FEAT_TRAINS, SELF, switch_build_year_Karlsruher, build_year){
							   0 .. 1974: switch_spritestack_Karlsruher_schwarz;
							1975 .. 1987: switch_spritestack_Karlsruher_ozeanblau;
							1988 .. 1995: switch_spritestack_Karlsruher_mint;
							1996 .. 2050: switch_spritestack_Karlsruher_verkehrsrot;
								switch_spritestack_Karlsruher_verkehrsrot;}

						switch(FEAT_TRAINS, SELF, switch_graphics_Karlsruher_build, position_in_vehid_chain  % 3) {
								0:     spriteset_empty;
								1:     return switch_build_year_Karlsruher;
								2:     spriteset_empty;}

						switch (FEAT_TRAINS, SELF, switch_articulated_Karlsruher_build, extra_callback_info1) {
							1 .. 2: return ITEM_KARLSRUHER_BUILD;
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}

item (FEAT_TRAINS , ITEM_KARLSRUHER_BUILD, 7915)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_KARLSRUHER_BUILD);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1972,01,01);
						model_life: 					40;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);
						cargo_allow_refit:              [PASS, TOUR, MAIL, GOOD, VALU];
						cargo_capacity:                 32 ;
						cost_factor: 					108;
						running_cost_factor: 			90;
						running_cost_base:              RUNNING_COST_DIESEL;	
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							140 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;	
						weight: 						28 ton;
						ai_engine_rank: 				0;
						dual_headed: 					0;
						length: 						8;
											
			}

		//Vehicels Graphics
			graphics
			{
			default						: switch_graphics_Karlsruher_build;
			additional_text				: string(STR_DESC_KARL);
			length						: switch_length_Karlsruher;
			articulated_part			: switch_articulated_Karlsruher_build;
			purchase					: switch_purchase_Karlsruher;
			cost_factor					: 23;
			running_cost_factor			: switch_running_cost_Karlsruher;							
			}
	}

						switch (FEAT_TRAINS, SELF, switch_current_year_Karlsruher, current_year){
							   0 .. 1974: switch_spritestack_Karlsruher_schwarz;
							1975 .. 1987: switch_spritestack_Karlsruher_ozeanblau;
							1988 .. 1995: switch_spritestack_Karlsruher_mint;
							1996 .. 2050: switch_spritestack_Karlsruher_verkehrsrot;
								switch_spritestack_Karlsruher_verkehrsrot;}

						switch(FEAT_TRAINS, SELF, switch_graphics_Karlsruher_current, position_in_vehid_chain  % 3) {
								0:     spriteset_empty;
								1:     return switch_current_year_Karlsruher;
								2:     spriteset_empty;}

						switch (FEAT_TRAINS, SELF, switch_articulated_Karlsruher_current, extra_callback_info1) {
							1 .. 2: return ITEM_KARLSRUHER_CURRENT;
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}

