						switch(FEAT_TRAINS, SELF, switch_spritestack_E_91_3_purchase1, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_E_91_3_purchase1;
							1: spriteset_E_91_3_purchase_anim;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_E_91_3_purchase2, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_E_91_3_purchase2;
							1: spriteset_E_91_3_purchase_anim;}	

						 switch (FEAT_TRAINS,SELF, switch_E_91_3_purchase,current_year){
							1900 .. 1919: switch_spritestack_E_91_3_purchase1;
							1920 .. 1999: switch_spritestack_E_91_3_purchase2;				 					 
										switch_spritestack_E_91_3_purchase2;}

						switch (FEAT_TRAINS, SELF, switch_animation_E_91_3, motion_counter % 4) {
							0: spriteset_E_91_3_anim1;
							1: spriteset_E_91_3_anim2;
							2: spriteset_E_91_3_anim3;
							3: spriteset_E_91_3_anim4;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_E_91_3_KPEV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_E_91_3_KPEV;
							1: return switch_animation_E_91_3;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_E_91_3_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_E_91_3_DRG;
							1: return switch_animation_E_91_3;}							
						
							
						switch (FEAT_TRAINS,SELF, switch_E_91_3_build_year,build_year){
							1900 .. 1919: switch_spritestack_E_91_3_KPEV;
							1920 .. 1999: switch_spritestack_E_91_3_DRG;
								switch_spritestack_E_91_3_DRG;}
							
						switch (FEAT_TRAINS,SELF, switch_E_91_3_current_year,current_year){
							1900 .. 1919: switch_spritestack_E_91_3_KPEV;
							1920 .. 1999: switch_spritestack_E_91_3_DRG;
								switch_spritestack_E_91_3_DRG;}
								
						switch(FEAT_TRAINS, SELF, switch_length_E_91_3, position_in_vehid_chain % 3) {
							0: 4;
							1: 3;
							2: 4;}
						
						switch(FEAT_TRAINS, SELF, switch_FX_E_91_3, position_in_vehid_chain % 3) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
							return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}	

						switch(FEAT_TRAINS,PARENT,switch_running_cost_E_91_3, 1){
							return 575;}

						switch(FEAT_TRAINS, SELF, switch_E_91_3_graphics_build, position_in_vehid_chain % 3) {
							0:	   spriteset_empty;
							1:     return switch_E_91_3_build_year;
							2:	   spriteset_empty;}	

						switch (FEAT_TRAINS, SELF, switch_articulated_E_91_3_build, extra_callback_info1) {
							1 .. 2: return ITEM_E_91_3_BUILD;
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}

item (FEAT_TRAINS , ITEM_E_91_3_BUILD, 1910)
		{
