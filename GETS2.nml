							0: spriteset_Abteil_21_D_DRG;
							1: spritegroup_Abteil_21_D_load;}

						switch(FEAT_TRAINS, SELF, switch_loadstack_Abteil_21_D_DB, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
