		alternative_sprites (spriteset_PR05_purchase_RSV1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\KPEV_PR05\PR05_C_BH_RSV1_1x_32bpp.png", "gfx\KPEV_PR05\PR05_C_BH_RSV1_1x_mask.png")
					{template_purchase(0,0)}

spriteset (spriteset_PR05_purchase_RSV2, "gfx\KPEV_PR05\PR05_C_BH_RSV2_loading_1x_8bpp.png")
					{template_purchase(0, 0)}	
				
		alternative_sprites (spriteset_PR05_purchase_RSV2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\KPEV_PR05\PR05_C_BH_RSV2_1x_32bpp.png", "gfx\KPEV_PR05\PR05_C_BH_RSV2_1x_mask.png")
					{template_purchase(0,0)}
								
//Switches

						switch (FEAT_TRAINS,SELF,switch_purchase_KPEV_PR05,current_year) {
							   0 .. 1919 : spriteset_PR05_purchase1;
							1920 .. 1945 : spriteset_PR05_purchase2;
							1946 .. 1980 : spriteset_PR05_purchase3;
								spriteset_PR05_purchase3;}
							
						random_switch (FEAT_TRAINS, SELF, random_choose_PR05_KPEV,) {
							2: spritegroup_PR05_AB_BH_KPEV;
							3: spritegroup_PR05_ABC_BH_KPEV;
							4: spritegroup_PR05_C_BH_KPEV;}
							
						random_switch (FEAT_TRAINS, SELF, random_choose_PR05_DRG,) {
							1: spritegroup_PR05_BC_BH_DRG;
							1: spritegroup_PR05_C_BH_DRG; 
							1: spritegroup_PR05_C2_BH_DRG;
							1: spritegroup_PR05_BC_OBH_DRG;
							1: spritegroup_PR05_C_OBH_DRG; 
							1: spritegroup_PR05_C2_OBH_DRG;}
							
						random_switch (FEAT_TRAINS, SELF, random_choose_PR05_RSV1,) {
							1: spritegroup_PR05_BC_BH_RSV1;
							1: spritegroup_PR05_C_BH_RSV1; 
							1: spritegroup_PR05_C2_BH_RSV1;
							1: spritegroup_PR05_BC_OBH_RSV1;
							1: spritegroup_PR05_C_OBH_RSV1; 
							1: spritegroup_PR05_C2_OBH_RSV1;}
							
						random_switch (FEAT_TRAINS, SELF, random_choose_PR05_RSV2,) {
							1: spritegroup_PR05_BC_BH_RSV2;
							1: spritegroup_PR05_C_BH_RSV2; 
							1: spritegroup_PR05_C2_BH_RSV2;
							1: spritegroup_PR05_BC_OBH_RSV2;
							1: spritegroup_PR05_C_OBH_RSV2; 
							1: spritegroup_PR05_C2_OBH_RSV2;}
							
						random_switch (FEAT_TRAINS, SELF, random_choose_PR05_DB,) {
							1: spritegroup_PR05_BC_BH_DB;
							1: spritegroup_PR05_C_BH_DB; 
							1: spritegroup_PR05_C2_BH_DB;
							2: spritegroup_PR05_BC_OBH_DB;
							2: spritegroup_PR05_C_OBH_DB; 
							2: spritegroup_PR05_C2_OBH_DB;}
	
						switch (FEAT_TRAINS,PARENT,switch_enginecheck_RSV2,((count_veh_id(0386)) + (count_veh_id(0784)))) {
							0: random_choose_PR05_DRG; 
								random_choose_PR05_RSV2;}							
							
						switch (FEAT_TRAINS,PARENT,switch_enginecheck_RSV1,((count_veh_id(0386)) + (count_veh_id(00784)))) {
							0: random_choose_PR05_DRG; 
								random_choose_PR05_RSV1;}																																		

						switch (FEAT_TRAINS,SELF,switch_build_year_KPEV_PR05,build_year) {
							   0 .. 1919 : random_choose_PR05_KPEV;
							1920 .. 1931 : random_choose_PR05_DRG;
							1932 .. 1935 : switch_enginecheck_RSV2;
							1936 .. 1945 : switch_enginecheck_RSV1;
							1946 .. 1980 : random_choose_PR05_DB;
								random_choose_PR05_DRG;}

						switch (FEAT_TRAINS,SELF,switch_current_year_KPEV_PR05,current_year) {
							   0 .. 1919 : random_choose_PR05_KPEV;
							1920 .. 1931 : random_choose_PR05_DRG;
							1932 .. 1935 : switch_enginecheck_RSV2;
							1936 .. 1945 : switch_enginecheck_RSV1;
							1946 .. 1980 : random_choose_PR05_DB;
								random_choose_PR05_DRG;}
											
						switch(FEAT_TRAINS, SELF, switch_length_KPEV_PR05, position_in_vehid_chain % 3) {
							0: 4;
							1: 4;
							2: 4;}
						
						switch(FEAT_TRAINS,PARENT,switch_running_cost_KPEV_PR05, 1){
							return 1600;}
							
						switch(FEAT_TRAINS, SELF, switch_KPEV_PR05_graphics_build, position_in_vehid_chain  % 3) {
