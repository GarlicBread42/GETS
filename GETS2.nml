//Spriteset Purchase

spriteset (spriteset_4ue_PR05_purchase1, "gfx/KPEV_4ue_PR05/C4ue_PR05_KPEV_1x_8bpp.png")
					{template_purchase(0, 0)}	
				
		alternative_sprites (spriteset_4ue_PR05_purchase1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/KPEV_4ue_PR05/C4ue_PR05_KPEV_1x_32bpp.png", "gfx/KPEV_4ue_PR05/C4ue_PR05_KPEV_1x_mask.png")
					{template_purchase(0, 0)}

spriteset (spriteset_4ue_PR05_purchase2, "gfx/KPEV_4ue_PR05/C4ue_PR05_DRG_1x_8bpp.png")
					{template_purchase(0, 0)}
				
		alternative_sprites (spriteset_4ue_PR05_purchase2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/KPEV_4ue_PR05/C4ue_PR05_DRG_1x_32bpp.png", "gfx/KPEV_4ue_PR05/C4ue_PR05_DRG_1x_mask.png")
					{template_purchase(0, 0)}					
					
spriteset (spriteset_4ue_PR05_purchase3, "gfx/KPEV_4ue_PR05/B4ue_PR05_DB_1x_8bpp.png")
					{template_purchase(0, 0)}	
				
		alternative_sprites (spriteset_4ue_PR05_purchase3, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/KPEV_4ue_PR05/B4ue_PR05_DB_1x_32bpp.png", "gfx/KPEV_4ue_PR05/B4ue_PR05_DB_1x_mask.png")
					{template_purchase(0, 0)}					
					
//Switches					

					switch (FEAT_TRAINS,SELF,switch_purchase_4ue_PR05,current_year) {
						   0 .. 1919 : spriteset_4ue_PR05_purchase1;
						1920 .. 1945 : spriteset_4ue_PR05_purchase2;
						1946 .. 2050 : spriteset_4ue_PR05_purchase3;
							spriteset_4ue_PR05_purchase3;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_4ue_PR05_AB_KPEV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_4ue_PR05_AB_KPEV;
							1: spritegroup_4ue_PR05_AB_KPEV_loading;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_4ue_PR05_ABC_KPEV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_4ue_PR05_ABC_KPEV;
							1: spritegroup_4ue_PR05_ABC_KPEV_loading;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_4ue_PR05_C_KPEV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_4ue_PR05_C_KPEV;
							1: spritegroup_4ue_PR05_C_KPEV_loading;}														

						switch(FEAT_TRAINS, SELF, switch_spritestack_4ue_PR05_AB_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_4ue_PR05_AB_DRG;
							1: spritegroup_4ue_PR05_DRG_loading;}		

						switch(FEAT_TRAINS, SELF, switch_spritestack_4ue_PR05_ABC_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_4ue_PR05_ABC_DRG;
							1: spritegroup_4ue_PR05_DRG_loading;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_4ue_PR05_C_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_4ue_PR05_C_DRG;
							1: spritegroup_4ue_PR05_DRG_loading;}		
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_4ue_PR05_A_DB, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_4ue_PR05_A_DB;
							1: spritegroup_4ue_PR05_DB_loading;}	
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_4ue_PR05_AB_DB, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_4ue_PR05_AB_DB;
							1: spritegroup_4ue_PR05_DB_loading;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_4ue_PR05_B_DB, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_4ue_PR05_B_DB;
							1: spritegroup_4ue_PR05_DB_loading;}																																														
							
						switch (FEAT_TRAINS, SELF, random_choose_4ue_PR05_KPEV, switch_alternative_var_random_bits(2, 2)) {
							1: switch_spritestack_4ue_PR05_AB_KPEV;
							2: switch_spritestack_4ue_PR05_ABC_KPEV;
							3: switch_spritestack_4ue_PR05_C_KPEV;
								switch_spritestack_4ue_PR05_C_KPEV;}	
								
						switch (FEAT_TRAINS, SELF, random_choose_4ue_PR05_DRG, switch_alternative_var_random_bits(2, 2)) {
							1: switch_spritestack_4ue_PR05_AB_DRG;
							2: switch_spritestack_4ue_PR05_ABC_DRG;
							3: switch_spritestack_4ue_PR05_C_DRG;
								switch_spritestack_4ue_PR05_C_DRG;}	
								
						switch (FEAT_TRAINS, SELF, random_choose_4ue_PR05_DB, switch_alternative_var_random_bits(2, 2)) {
							1: switch_spritestack_4ue_PR05_AB_DB;
							2: switch_spritestack_4ue_PR05_B_DB;
							3: switch_spritestack_4ue_PR05_A_DB;
								switch_spritestack_4ue_PR05_B_DB;}	
								
						switch (FEAT_TRAINS,SELF,switch_build_year_4ue_PR05,build_year) {
							   0 .. 1919 : random_choose_4ue_PR05_KPEV;
							1920 .. 1945 : random_choose_4ue_PR05_DRG;
							1946 .. 2050 : random_choose_4ue_PR05_DB;
								random_choose_4ue_PR05_DB;}

						switch (FEAT_TRAINS,SELF,switch_current_year_4ue_PR05,current_year) {
							   0 .. 1919 : random_choose_4ue_PR05_KPEV;
							1920 .. 1945 : random_choose_4ue_PR05_DRG;
							1946 .. 1980 : random_choose_4ue_PR05_DB;
								random_choose_4ue_PR05_DB;}						
																			
						switch(FEAT_TRAINS, SELF, switch_length_4ue_PR05, position_in_vehid_chain % 3) {
							0: 4;
							1: 4;
							2: 4;}
								
						switch (FEAT_TRAINS, PARENT, switch_running_cost_4ue_PR05,  switch_check_Restaurant_0()) {
							1: return 0;
							0: return 1700;}	
							
						switch (FEAT_TRAINS, PARENT, switch_cargo_aging_4ue_PR05,  switch_check_Restaurant_0()) {
							1: return 233;
							0: return 185;}																																													

						switch(FEAT_TRAINS, SELF, switch_4ue_PR05_graphics_build, position_in_vehid_chain  % 3) {
