//Spritesets purchase

spriteset (spriteset_K15_Elberfeld_KPEV_purchase, "gfx\K15_Elberfeld/K15_Elberfeld_MBH_KPEV_1x_8bpp.png")
					{template_purchase(0, 0)}	
		alternative_sprites (spriteset_K15_Elberfeld_KPEV_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\K15_Elberfeld/K15_Elberfeld_MBH_KPEV_1x_32bpp.png", "gfx\K15_Elberfeld/K15_Elberfeld_MBH_KPEV_1x_mask.png")
					{template_purchase(0, 0)}

spriteset (spriteset_K15_Elberfeld_DRG_purchase, "gfx\K15_Elberfeld/K15_Elberfeld_MBH_DRG_1x_8bpp.png")
					{template_purchase(0, 0)}	
