							7: spriteset_Zans_95_Ermewa;													
								spriteset_Zans_95_Wascosa;}	
								

					switch (FEAT_TRAINS, SELF, random_choose_Zans_95_OIL, switch_alternative_var_random_bits(1, 3)) {
							1: spriteset_Zans_95_DHL;
