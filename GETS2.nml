						PLST: random_choose_Kessel_1928_OIL;}

					switch (FEAT_TRAINS, PARENT, switch_speed_Kessel_1928,  switch_check_PWG_0()) {
						1: return 80;
						0: return 65;}

					switch(FEAT_TRAINS,PARENT,switch_running_cost_Kessel_1928, 1){
						return 75;}	

						
