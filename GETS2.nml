spriteset (spriteset_IC2_DVT_purchase, "gfx\IC2\IC2_DVT_1x_8bpp.png")
					{template_purchase(0, 0)}	
		alternative_sprites (spriteset_IC2_DVT_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\IC2\IC2_DVT_1x_32bpp.png", "gfx\IC2\IC2_DVT_1x_mask.png")
					{template_purchase(0,0)}
															
//Switches


						switch(FEAT_TRAINS, SELF, switch_spritestack_IC2_A, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_IC2_A;
							1: spritegroup_IC2_A_loading;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_IC2_B, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_IC2_B;
							1: spritegroup_IC2_B_loading;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_IC2_DVT, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_IC2_DVT;
							1: spritegroup_IC2_DVT_loading;}							
																					   
						switch (FEAT_TRAINS, SELF, random_choose_IC2, switch_alternative_var_random_bits(1, 1)) {
							1: switch_spritestack_IC2_A;
							  switch_spritestack_IC2_B;}

						switch(FEAT_TRAINS, SELF, switch_autoconsist_IC2, position_in_vehid_chain) {
							 1: return switch_spritestack_IC2_A;
							 4: return switch_spritestack_IC2_B;
							 7: return switch_spritestack_IC2_B;
							10: switch_spritestack_IC2_B;
								default: switch_spritestack_IC2_B;}
								
						switch(FEAT_TRAINS, SELF, switch_DVT_IC2, position_in_consist_from_end) {
							1: return switch_spritestack_IC2_DVT;
								default: return switch_autoconsist_IC2;}									

						switch (FEAT_TRAINS,PARENT,switch_IC2_check_1462_1464,(count_veh_id(1462))+(count_veh_id(1464))) {
							0: random_choose_IC2; 
								switch_DVT_IC2;}									
					
						switch(FEAT_TRAINS, SELF, switch_length_IC2, position_in_articulated_veh % 3) {
							0: 4;
							1: 7;
							2: 4;}

						switch(FEAT_TRAINS,PARENT,switch_running_cost_IC2, 1){
							return 3000;}	
													
						switch(FEAT_TRAINS, SELF, switch_IC2_graphics, position_in_articulated_veh  % 3) {
							0:     spriteset_empty;
							1:     return switch_IC2_check_1462_1464;
							2:     spriteset_empty;}
							
						switch (FEAT_TRAINS, SELF, switch_articulated_IC2, extra_callback_info1) {
							1 .. 2: return ITEM_IC2;	
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}

