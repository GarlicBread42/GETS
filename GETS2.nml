					{template_158trains_4x(0,0)}

spritegroup spritegroup_ARkimbz_loading
		{loaded: 	[spriteset_empty];
			loading: 	[spriteset_ARkimbz_loading];}	
			
			
//Spritesets purchase

spriteset (spriteset_ARkimbz_Interregio_purchase, "gfx/ARkimbz/ARkimbz_Interregio_1x_8bpp.png")
					{ template_purchase(0, 0)}	
		alternative_sprites (spriteset_ARkimbz_Interregio_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/ARkimbz/ARkimbz_Interregio_1x_32bpp.png", "gfx/ARkimbz/ARkimbz_Interregio_1x_mask.png")
					{template_purchase(0,0)}

spriteset (spriteset_ARkimbz_IC_purchase, "gfx/ARkimbz/ARkimbz_IC_1x_8bpp.png")
					{ template_purchase(0, 0)}	
		alternative_sprites (spriteset_ARkimbz_IC_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/ARkimbz/ARkimbz_IC_1x_32bpp.png", "gfx/ARkimbz/ARkimbz_IC_1x_mask.png")
					{template_purchase(0,0)}

spriteset (spriteset_ARkimbz_BWE_purchase, "gfx/ARkimbz/ARkimbz_BWE_1x_8bpp.png")
					{ template_purchase(0, 0)}	
		alternative_sprites (spriteset_ARkimbz_BWE_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/ARkimbz/ARkimbz_BWE_1x_32bpp.png", "gfx/ARkimbz/ARkimbz_BWE_1x_mask.png")
					{template_purchase(0,0)}

spriteset (spriteset_ARkimbz_Flix_purchase, "gfx/ARkimbz/ARkimbz_Flix_1x_8bpp.png")
					{ template_purchase(0, 0)}	
		alternative_sprites (spriteset_ARkimbz_Flix_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/ARkimbz/ARkimbz_Flix_1x_32bpp.png", "gfx/ARkimbz/ARkimbz_Flix_1x_mask.png")
					{template_purchase(0,0)}
																				
//Switches

						switch (FEAT_TRAINS,SELF,switch_purchase_ARkimbz,current_year) {
							   0 .. 1999 : spriteset_ARkimbz_Interregio_purchase;
							2000 .. 2050 : spriteset_ARkimbz_IC_purchase;
								spriteset_ARkimbz_IC_purchase;}	
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_ARkimbz_Interregio, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_ARkimbz_Interregio;
							1: spritegroup_ARkimbz_loading;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_ARkimbz_IC, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_ARkimbz_IC;
							1: spritegroup_ARkimbz_loading;}							

						switch(FEAT_TRAINS, SELF, switch_spritestack_ARkimbz_BWE, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_ARkimbz_BWE;
							1: spritegroup_ARkimbz_loading;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_ARkimbz_Flix, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_ARkimbz_Flix;
							1: spritegroup_ARkimbz_loading;}
							   																			
						switch(FEAT_TRAINS, SELF, switch_length_ARkimbz, position_in_vehid_chain % 3) {
							0: 4;
							1: 7;
							2: 4;}
						
						switch(FEAT_TRAINS,PARENT,switch_running_cost_ARkimbz, 1){
							return 7800;}	
							
						switch (FEAT_TRAINS,SELF,switch_build_year_ARkimbz,build_year) {
							   0 .. 1999 : switch_spritestack_ARkimbz_Interregio;
							2000 .. 2050 : switch_spritestack_ARkimbz_IC;
								switch_spritestack_ARkimbz_IC;}													   								

						switch(FEAT_TRAINS, SELF, switch_ARkimbz_graphics_build, position_in_vehid_chain  % 3) {
							0:     spriteset_empty;
							1:     return switch_build_year_ARkimbz;
							2:     spriteset_empty;}	

						switch (FEAT_TRAINS, SELF, switch_articulated_ARkimbz_build, extra_callback_info1) {
							1 ..2: return ITEM_ARMKIMBZ_BUILD;
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}														

