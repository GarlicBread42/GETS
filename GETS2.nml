					{template_purchase(0, 0)}	
					
//Switches

						switch (FEAT_TRAINS,SELF,switch_purchase_Wue_Litera_E,current_year) {
							   0 .. 1919 : spriteset_Wue_Litera_E_purchase1;
							1920 .. 1945 : spriteset_Wue_Litera_E_purchase2;
							1946 .. 2050 : spriteset_Wue_Litera_E_purchase3;
								spriteset_Wue_Litera_E_purchase3;}
						
						
						switch(FEAT_TRAINS, SELF, switch_spritestack_Wue_Litera_E_BC_KWSE, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_Wue_Litera_E_BC_KWSE;
							1: spritegroup_Wue_Litera_E_loading;}																

						switch(FEAT_TRAINS, SELF, switch_spritestack_Wue_Litera_E_C_KWSE, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_Wue_Litera_E_C_KWSE;
							1: spritegroup_Wue_Litera_E_loading;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_Wue_Litera_E_D_KWSE, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_Wue_Litera_E_D_KWSE;
							1: spritegroup_Wue_Litera_E_loading;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_Wue_Litera_E_B_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_Wue_Litera_E_B_DRG;
							1: spritegroup_Wue_Litera_E_loading;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_Wue_Litera_E_C_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_Wue_Litera_E_C_DRG;
							1: spritegroup_Wue_Litera_E_loading;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_Wue_Litera_E_B1_DB, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_Wue_Litera_E_B1_DB;
							1: spritegroup_Wue_Litera_E_loading;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_Wue_Litera_E_B2_DB, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_Wue_Litera_E_B2_DB;
							1: spritegroup_Wue_Litera_E_loading;}

						switch (FEAT_TRAINS, SELF, random_choose_Litera_E_KWSE, switch_alternative_var_random_bits(1, 2)) {
							1: switch_spritestack_Wue_Litera_E_BC_KWSE;
							2: switch_spritestack_Wue_Litera_E_C_KWSE;
							3: switch_spritestack_Wue_Litera_E_D_KWSE;												
								 switch_spritestack_Wue_Litera_E_D_KWSE;}
							
						switch (FEAT_TRAINS, SELF, random_choose_Litera_E_DRG, switch_alternative_var_random_bits(1, 1)) {
							1: switch_spritestack_Wue_Litera_E_C_DRG;
								switch_spritestack_Wue_Litera_E_B_DRG;}

						switch (FEAT_TRAINS, SELF, random_choose_Litera_E_DB, switch_alternative_var_random_bits(1, 1)) {
							1: switch_spritestack_Wue_Litera_E_B1_DB;
								switch_spritestack_Wue_Litera_E_B2_DB;}

						switch (FEAT_TRAINS,SELF,switch_build_year_Wue_Litera_E,build_year) {
							0 .. 1919 : random_choose_Litera_E_KWSE;
							1920 .. 1945 : random_choose_Litera_E_DRG;
							1946 .. 2050 : random_choose_Litera_E_DB;
								random_choose_Litera_E_DB;}
						
						switch (FEAT_TRAINS,SELF,switch_current_year_Wue_Litera_E,current_year) {
							0 .. 1919 : random_choose_Litera_E_KWSE;
							1920 .. 1945 : random_choose_Litera_E_DRG;
							1946 .. 2050 : random_choose_Litera_E_DB;
								random_choose_Litera_E_DB;}

						switch(FEAT_TRAINS,PARENT,switch_running_cost_Wue_Litera_E, 1){
							return 600;}
						
