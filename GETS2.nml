						 switch (FEAT_TRAINS,SELF, switch_BR_321_purchase,current_year){
								1910 .. 1945: spriteset_BR_321_purchase1;
								1946 .. 1974: spriteset_BR_321_purchase2;	
								1975 .. 1996: spriteset_BR_321_purchase3;
								1997 .. 2050: spriteset_BR_321_purchase4;																		 					 
								spriteset_BR_321_purchase3;}

					switch (FEAT_TRAINS, SELF, random_choose_BR_321, switch_alternative_var_random_bits(1, 1)) {
							1: spriteset_BR_321_DB_altrot2;
								spriteset_BR_321_DB_altrot_closecab;}								
								
						switch (FEAT_TRAINS,SELF, switch_BR_321_current_year,current_year){
							 1910 .. 1945: spriteset_BR_321_DRG;
							 1946 .. 1974: spriteset_BR_321_DB_altrot;
							 1975 .. 1996: random_choose_BR_321;
							 1997 .. 2050: spriteset_BR_321_DB_verkehrsrot;					 					 
							 spriteset_BR_321_DB_verkehrsrot;}
		
						switch (FEAT_TRAINS,SELF, switch_BR_321_build_year,build_year){
							 1910 .. 1945: spriteset_BR_321_DRG;
							 1946 .. 1974: spriteset_BR_321_DB_altrot;
							 1975 .. 1996: random_choose_BR_321;
							 1997 .. 2050: spriteset_BR_321_DB_verkehrsrot;					 					 
							 spriteset_BR_321_DB_verkehrsrot;}
							
						switch(FEAT_TRAINS,PARENT,switch_running_cost_BR_321, 1){
							return 50;}
							
