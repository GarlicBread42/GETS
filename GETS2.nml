		alternative_sprites (spriteset_WRmz_135_TEE_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/WRmz_135/WRmz_135_TEE_1x_32bpp.png", "gfx/WRmz_135/WRmz_135_TEE_1x_mask.png")
