									{ template_purchase(0, 0)}
									
			alternative_sprites (spriteset_ET_25_purchase1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\ET_25/ET25_DRG_front_1x_32bpp.png", "gfx\ET_25/ET25_DRG_front_1x_mask.png")
									{ template_purchase(0, 0)}

spriteset(spriteset_ET_25_purchase2, "gfx\ET_25/ET25_DB_front_1x_8bpp.png")
									{ template_purchase(0, 0)}
				
		alternative_sprites (spriteset_ET_25_purchase2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\ET_25/ET25_DB_front_1x_32bpp.png", "gfx\ET_25/ET25_DB_front_1x_mask.png")
									{ template_purchase(0, 0)}
									
//Switches

						switch (FEAT_TRAINS,SELF, switch_ET_25_purchase,current_year){
							   0 .. 1945: spriteset_ET_25_purchase1;
							1946 .. 2050: spriteset_ET_25_purchase2;
								spriteset_ET_25_purchase2;}
						 
						switch(FEAT_TRAINS, SELF, switch_spritestack_ET_25_front_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_ET_25_front_DRG;
							1: spritegroup_ET_25_front_DRG_loading;}						 									

						switch(FEAT_TRAINS, SELF, switch_spritestack_ET_25_back_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_ET_25_back_DRG;
							1: spritegroup_ET_25_back_DRG_loading;}
														
						switch(FEAT_TRAINS, SELF, switch_spritestack_ET_25_front_DB, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_ET_25_front_DB;
							1: spritegroup_ET_25_front_DB_loading;}						 									

						switch(FEAT_TRAINS, SELF, switch_spritestack_ET_25_back_DB, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_ET_25_back_DB;
							1: spritegroup_ET_25_back_DB_loading;}

						switch(FEAT_TRAINS, SELF, switch_length_ET_25, position_in_vehid_chain % 6) {
							0: 4;
							1: 6;
							2: 4;
							3: 4;
							4: 6;
							5: 4;}
						
						switch(FEAT_TRAINS,PARENT,switch_running_cost_ET_25, 1){
							return 2800;}

						switch(FEAT_TRAINS,PARENT,switch_running_cost_ET_55, 1){
							return 2800;}
														
						switch(FEAT_TRAINS, SELF, switch_FX_ET_25, position_in_vehid_chain % 6) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE,0, DISABLE_WAGON_POWER);
							1: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
							2: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);	
							3: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC,-2, DISABLE_WAGON_POWER);
							4: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
							5: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}							

						switch (FEAT_TRAINS,SELF, switch_ET_25_front_build_year,build_year){
							   0 .. 1945: switch_spritestack_ET_25_front_DRG;
							1946 .. 2050: switch_spritestack_ET_25_front_DB;
								switch_spritestack_ET_25_front_DB;}	
								
						switch (FEAT_TRAINS,SELF, switch_ET_25_back_build_year,build_year){
							   0 .. 1945: switch_spritestack_ET_25_back_DRG;
							1946 .. 2050: switch_spritestack_ET_25_back_DB;
								switch_spritestack_ET_25_back_DB;}	

					switch(FEAT_TRAINS, SELF, switch_ET_25_graphics_build, position_in_vehid_chain % 6) {
							0:	   spriteset_empty;
							1:     return switch_ET_25_front_build_year;
							2:     spriteset_empty;
							3:	   spriteset_empty;
							4:	   return switch_ET_25_back_build_year;
							5:	   spriteset_empty;}	

					switch (FEAT_TRAINS, SELF, switch_articulated_ET_25_build, extra_callback_info1) {
						1 .. 5: return ITEM_ET_25_BUILD; 
						return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}

