							1: spritegroup_Gruppe_28_loading_2doors_DB;}																																										

						switch(FEAT_TRAINS, SELF, switch_spritestack_Gruppe_28_DB_B, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_Gruppe_30_DB_B;
							1: spritegroup_Gruppe_28_loading_2doors_DB;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_Gruppe_28_DB_BC, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_Gruppe_30_DB_BC;
							1: spritegroup_Gruppe_28_loading_3doors_DB;}	
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_Gruppe_28_DB_C2, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_Gruppe_30_DB_C;
							1: spritegroup_Gruppe_28_loading_4doors_DB;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_Gruppe_28_DB_F, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_Gruppe_28_DB_F_Keks;
							1: spritegroup_Gruppe_28_loading_2doors_DB_F;}							

						switch (FEAT_TRAINS, SELF, random_choose_Gruppe_28_DRG_all, switch_alternative_var_random_bits(1, 3)) {
							0: switch_spritestack_Gruppe_28_DRG_AB;
							1: switch_spritestack_Gruppe_28_DRG_C1;
							2: switch_spritestack_Gruppe_28_DRG_C2;
							3: switch_spritestack_Gruppe_28_DRG_B;
							4: switch_spritestack_Gruppe_28_DRG_BC;
							5: switch_spritestack_Gruppe_28_DRG_C2;
							6: switch_spritestack_Gruppe_28_DRG_BC;
							7: switch_spritestack_Gruppe_28_DRG_C2;
							   switch_spritestack_Gruppe_28_DRG_C2;}
							   
						switch (FEAT_TRAINS, SELF, random_choose_Gruppe_28_DB_all, switch_alternative_var_random_bits(1, 3)) {
							0: switch_spritestack_Gruppe_28_DB_AB;
							1: switch_spritestack_Gruppe_28_DB_C1;
							2: switch_spritestack_Gruppe_28_DB_C2;
							3: switch_spritestack_Gruppe_28_DB_B;
							4: switch_spritestack_Gruppe_28_DB_BC;
							5: switch_spritestack_Gruppe_28_DB_C2;
							6: switch_spritestack_Gruppe_28_DB_BC;
							7: switch_spritestack_Gruppe_28_DB_BC;
							   switch_spritestack_Gruppe_28_DB_C2;}							   							

						switch (FEAT_TRAINS, SELF, random_choose_Gruppe_28_DRG_28, switch_alternative_var_random_bits(1, 1)) {
							1: switch_spritestack_Gruppe_28_DRG_AB;
								switch_spritestack_Gruppe_28_DRG_C1;}
							
						switch (FEAT_TRAINS, SELF, random_choose_Gruppe_28_DB_28, switch_alternative_var_random_bits(1, 1)) {
							1: switch_spritestack_Gruppe_28_DB_AB;
								switch_spritestack_Gruppe_28_DB_C1;}	
							
						switch (FEAT_TRAINS, SELF, random_choose_Gruppe_28_DRG_30, switch_alternative_var_random_bits(1, 2)) {
							1: switch_spritestack_Gruppe_28_DRG_B;
							2: switch_spritestack_Gruppe_28_DRG_BC;
							3: switch_spritestack_Gruppe_28_DRG_C2;
								switch_spritestack_Gruppe_28_DRG_C2;}
							
						switch (FEAT_TRAINS, SELF, random_choose_Gruppe_28_DB_30, switch_alternative_var_random_bits(1, 2)) {
							1: switch_spritestack_Gruppe_28_DB_B;
							2: switch_spritestack_Gruppe_28_DB_BC;
							3: switch_spritestack_Gruppe_28_DB_C2;
								switch_spritestack_Gruppe_28_DB_C2;}	
							
						switch (FEAT_TRAINS,SELF,switch_build_year_Gruppe_28,build_year) {
							   0 .. 1945 : random_choose_Gruppe_28_DRG_all;
							1945 .. 1990 : random_choose_Gruppe_28_DB_all;
								random_choose_Gruppe_28_DB_all;}
								
						switch (FEAT_TRAINS,SELF,switch_current_year_Gruppe_28,current_year) {
							   0 .. 1945 : random_choose_Gruppe_28_DRG_all;
							1945 .. 1990 : random_choose_Gruppe_28_DB_all;
								random_choose_Gruppe_28_DB_all;}																						
					
						switch(FEAT_TRAINS, SELF, switch_length_Gruppe_28, position_in_vehid_chain % 3) {
							0: 4;
							1: 5;
							2: 4;}

						switch (FEAT_TRAINS, PARENT, switch_running_cost_Gruppe_28,  switch_check_Restaurant_0()) {
							1: return 0;
							0: return 2400;}	
							
						switch (FEAT_TRAINS, PARENT, switch_cargo_aging_Gruppe_28,  switch_check_Restaurant_0()) {
							1: return 233;
							0: return 185;}		


						switch(FEAT_TRAINS, SELF, switch_Gruppe_28_graphics_build, position_in_vehid_chain  % 3) {
							0:     spriteset_empty;
							1:     return switch_build_year_Gruppe_28;
							2:     spriteset_empty;}

						switch (FEAT_TRAINS, SELF, switch_articulated_Gruppe_28_build, extra_callback_info1) {
								1 .. 2: return ITEM_GRUPPE_28_BUILD;												
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}
																					
