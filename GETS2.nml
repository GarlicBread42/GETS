							   0 .. 1963: spriteset_BR_216_0_rotweiss;
							1964 .. 1974: spriteset_BR_216_altrot;
							1975 .. 1987: spriteset_BR_216_ozeanblau;
							1988 .. 1999: spriteset_BR_216_orientrot;
							2000 .. 2050: spriteset_BR_216_verkehrsrot;	
								spriteset_BR_216_verkehrsrot;}								

						switch (FEAT_TRAINS,SELF, switch_BR_216_current_year,current_year){
							   0 .. 1963: spriteset_BR_216_0_rotweiss;
							1964 .. 1974: spriteset_BR_216_altrot;
							1975 .. 1987: spriteset_BR_216_ozeanblau;
							1988 .. 1999: spriteset_BR_216_orientrot;
							2000 .. 2050: spriteset_BR_216_verkehrsrot;	
								spriteset_BR_216_verkehrsrot;}
									
						switch(FEAT_TRAINS, SELF, switch_length_BR_216, position_in_vehid_chain % 2) {
							0: 4;
							1: 6;}						

						switch(FEAT_TRAINS, SELF, switch_FX_BR_216, position_in_vehid_chain % 2) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_DIESEL, -1, DISABLE_WAGON_POWER);
							return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}

						switch(FEAT_TRAINS,PARENT,switch_running_cost_BR_216, 1){
							return 1975;}

						switch(FEAT_TRAINS, SELF, switch_BR_216_graphics_build, position_in_vehid_chain % 2) {
							0:	   spriteset_empty;
							1:     return switch_BR_216_build_year;}

					switch (FEAT_TRAINS, SELF, switch_articulated_BR_216_build, extra_callback_info1) {
						1: return ITEM_BR_216_BUILD; 
						return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}				

item (FEAT_TRAINS , ITEM_BR_216_BUILD, 2160)
		{
		property 
			{
			//common properties
						name: 							string(STR_NAME_BR_216_BUILD);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1960,01,01);
						model_life: 					44;
						vehicle_life: 					35;
						retire_early: 					-10;	
						reliability_decay: 				20;
						cargo_allow_refit: 				[PASS] ;
						cargo_capacity: 				1 ;
						cost_factor: 					108;
						running_cost_base: 				RUNNING_COST_STEAM;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							120 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;
						power:  						1900 hp;
						weight: 						76 ton;
						ai_engine_rank: 				0;
						engine_class: 					ENGINE_CLASS_DIESEL;
						visual_effect_and_powered: 		visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 2, DISABLE_WAGON_POWER);
						dual_headed: 					0;
						tractive_effort_coefficient: 	0.309;
						length: 						8;										
			}

		graphics
			{
			default							:switch_BR_216_graphics_build;
						additional_text				   : string(STR_CONCAT_2, 
													     string(STR_TRACTION_DIESEL), 
														 string(STR_DESC_PASS),);
			length							:switch_length_BR_216; 
			articulated_part				:switch_articulated_BR_216_build;
			purchase_cargo_capacity        	:0 ;
			cost_factor						:49;
			cargo_capacity                 	:return 0 ;
			purchase					   	:switch_BR_216_purchase;
			running_cost_factor				:switch_running_cost_BR_216;
			visual_effect_and_powered		:switch_FX_BR_216;
			
			}
	}
	
						switch(FEAT_TRAINS, SELF, switch_BR_216_graphics_current, position_in_vehid_chain % 2) {
							0:	   spriteset_empty;
							1:     return switch_BR_216_current_year;}
							
