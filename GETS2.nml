spriteset(spriteset_BR_89_78_anim_purchase, "gfx/BR_89_78/BR_89_78_anim1_1x_8bpp.png")
									{ template_purchase(0, 0)}
	alternative_sprites (spriteset_BR_89_78_anim_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BR_89_78/BR_89_78_anim1_1x_32bpp.png", "gfx/BR_89_78/BR_89_78_anim1_1x_mask.png")
									{ template_purchase(0, 0)}

//Switches
						switch (FEAT_TRAINS, SELF, switch_animation_BR_89_78, motion_counter % 4) {
								0: spriteset_BR_89_78_anim1;
								1: spriteset_BR_89_78_anim2;
								2: spriteset_BR_89_78_anim3;
								3: spriteset_BR_89_78_anim4;}

						switch (FEAT_TRAINS, SELF, switch_animation_BR_89_78_REV, motion_counter % 4) {
								0: spriteset_BR_89_78_anim1_REV;
								1: spriteset_BR_89_78_anim2_REV;
								2: spriteset_BR_89_78_anim3_REV;
								3: spriteset_BR_89_78_anim4_REV;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_89_78_KPEV_purchase, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_89_78_KPEV_purchase;
							1: spriteset_BR_89_78_anim_purchase;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_89_78_DRG_purchase, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_89_78_DRG_purchase;
							1: spriteset_BR_89_78_anim_purchase;}								
	
							switch (FEAT_TRAINS,SELF, switch_BR_89_78_purchase,current_year){
							   0 .. 1919: switch_spritestack_BR_89_78_KPEV_purchase;
							1920 .. 2045: switch_spritestack_BR_89_78_DRG_purchase;															 					 
								switch_spritestack_BR_89_78_DRG_purchase;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_89_78_KPEV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_89_78_KPEV;
							1: return switch_animation_BR_89_78;}									

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_89_78_KPEV_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_89_78_KPEV_REV;
							1: return switch_animation_BR_89_78_REV;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_89_78_KPEV_B, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_89_78_KPEV_B;
							1: return switch_animation_BR_89_78;}									

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_89_78_KPEV_B_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_89_78_KPEV_B_REV;
							1: return switch_animation_BR_89_78_REV;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_89_78_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_89_78_DRG;
							1: return switch_animation_BR_89_78;}									

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_89_78_DRG_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_89_78_DRG_REV;
							1: return switch_animation_BR_89_78_REV;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_89_78_DRG_B, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_89_78_DRG_B;
							1: return switch_animation_BR_89_78;}									

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_89_78_DRG_B_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_89_78_DRG_B_REV;
							1: return switch_animation_BR_89_78_REV;}

						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_89_78_KPEV, vehicle_is_reversed) {
							0: switch_spritestack_BR_89_78_KPEV;
								switch_spritestack_BR_89_78_KPEV_REV;}

						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_89_78_KPEV_B, vehicle_is_reversed) {
							0: switch_spritestack_BR_89_78_KPEV_B;
								switch_spritestack_BR_89_78_KPEV_B_REV;}

						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_89_78_DRG, vehicle_is_reversed) {
							0: switch_spritestack_BR_89_78_DRG;
								switch_spritestack_BR_89_78_DRG_REV;}																															

						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_89_78_DRG_B, vehicle_is_reversed) {
							0: switch_spritestack_BR_89_78_DRG_B;
								switch_spritestack_BR_89_78_DRG_B_REV;}										

					switch (FEAT_TRAINS, SELF, random_choose_BR_89_78_KPEV, switch_alternative_var_random_bits(1, 1)) {
							1: switch_reverse_BR_89_78_KPEV;
								switch_reverse_BR_89_78_KPEV_B;}								

					switch (FEAT_TRAINS, SELF, random_choose_BR_89_78_DRG, switch_alternative_var_random_bits(1, 1)) {
							1: switch_reverse_BR_89_78_DRG;
								switch_reverse_BR_89_78_DRG_B;}	
																
						switch (FEAT_TRAINS,SELF, switch_BR_89_78_current_year,current_year){
								   0 .. 1919: random_choose_BR_89_78_KPEV;
								1920 .. 2050: random_choose_BR_89_78_DRG;					 					 
								random_choose_BR_89_78_DRG;}		
							 
						switch (FEAT_TRAINS,SELF, switch_BR_89_78_build_year,build_year){
							    0 .. 1919: random_choose_BR_89_78_KPEV;
							 1920 .. 2050: random_choose_BR_89_78_DRG;					 					 
							 random_choose_BR_89_78_DRG;}								 																																												

						switch(FEAT_TRAINS, PARENT, switch_FX_BR_89_78, vehicle_is_reversed) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_STEAM, -3, DISABLE_WAGON_POWER);
								return visual_effect_and_powered(VISUAL_EFFECT_STEAM, 2, DISABLE_WAGON_POWER);}	
																
						switch(FEAT_TRAINS,PARENT,switch_running_cost_BR_89_78, 1){
						return 400;}
						
item (FEAT_TRAINS , ITEM_BR_89_78, 0887)
		{
			//property Block
					property 
					{
