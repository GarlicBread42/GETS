					{template_purchase(0, 0)}		
				
		alternative_sprites (spriteset_O_Nuernberg_purchase3, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\O_Nuernberg/O_Nuernberg_DB_MBH_1x_32bpp.png", "gfx\O_Nuernberg/O_Nuernberg_DB_MBH_1x_mask.png")
					{template_purchase(0, 0)}	


//Switches

					switch (FEAT_TRAINS,SELF, switch_O_Nuernberg_purchase,current_year){
						1800 .. 1919: spriteset_O_Nuernberg_purchase1;
						1920 .. 1945: spriteset_O_Nuernberg_purchase2;
						1946 .. 2050: spriteset_O_Nuernberg_purchase3;				 					 
							spriteset_O_Nuernberg_purchase3;}

					switch(FEAT_TRAINS, SELF, switch_loadstack_O_Nuernberg_KPEV_OBH, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_O_Nuernberg_KPEV_OBH;
						1: spritegroup_O_Nuernberg_OBH_load;}

					switch(FEAT_TRAINS, SELF, switch_loadstack_O_Nuernberg_KPEV_MBH, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_O_Nuernberg_KPEV_MBH;
						1: spritegroup_O_Nuernberg_MBH_load;}

					switch(FEAT_TRAINS, SELF, switch_loadstack_O_Nuernberg_DRG_OBH, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_O_Nuernberg_DRG_OBH;
						1: spritegroup_O_Nuernberg_OBH_load;}

					switch(FEAT_TRAINS, SELF, switch_loadstack_O_Nuernberg_DRG_MBH, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_O_Nuernberg_DRG_MBH;
						1: spritegroup_O_Nuernberg_MBH_load;}
						
					switch(FEAT_TRAINS, SELF, switch_loadstack_O_Nuernberg_DB_OBH, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_O_Nuernberg_DB_OBH;
						1: spritegroup_O_Nuernberg_OBH_load;}

					switch(FEAT_TRAINS, SELF, switch_loadstack_O_Nuernberg_DB_MBH, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_O_Nuernberg_DB_MBH;
						1: spritegroup_O_Nuernberg_MBH_load;}						

					switch (FEAT_TRAINS, SELF, random_choose_O_Nuernberg_KPEV, switch_alternative_var_random_bits(1, 1)) {
						1: switch_loadstack_O_Nuernberg_KPEV_OBH;
							switch_loadstack_O_Nuernberg_KPEV_MBH;}	

					switch (FEAT_TRAINS, SELF, random_choose_O_Nuernberg_DRG, switch_alternative_var_random_bits(1, 1)) {
						1: switch_loadstack_O_Nuernberg_DRG_OBH;
							switch_loadstack_O_Nuernberg_DRG_MBH;}
							
					switch (FEAT_TRAINS, SELF, random_choose_O_Nuernberg_DB, switch_alternative_var_random_bits(1, 1)) {
						1: switch_loadstack_O_Nuernberg_DB_OBH;
							switch_loadstack_O_Nuernberg_DB_MBH;}															

					switch (FEAT_TRAINS,SELF, switch_O_Nuernberg_current_year,current_year){
						1800 .. 1919: random_choose_O_Nuernberg_KPEV;
						1920 .. 1945: random_choose_O_Nuernberg_DRG;
						1946 .. 2050: random_choose_O_Nuernberg_DB;				 					 
							random_choose_O_Nuernberg_DB;}

					switch (FEAT_TRAINS, PARENT, switch_speed_O_Nuernberg,  switch_check_PWG_0()) {
						1: return 65;
						0: return 50;}
													
					switch(FEAT_TRAINS,PARENT,switch_running_cost_O_Nuernberg, 1){
						return 73;}

item (FEAT_TRAINS , ITEM_O_NUERNBERG, 8654)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_O_NUERNBERG);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1913,01,01);
						model_life: 					45;
						vehicle_life: 					45;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes: 		bitmask(CC_BULK);
						non_refittable_cargo_classes: 	bitmask(CC_COVERED, CC_LIQUID, CC_REFRIGERATED, CC_HAZARDOUS, CC_OVERSIZED);
						cargo_allow_refit:              [COAL, IORE, CORE, AORE, CLAY, FECR, GRVL, KAOL, LIME, PHOS, PORE, POTA, SAND, SULP, URAN, CASS, COKE, MNO2, NICK, NITR, NKOR, QLME, RCYC, SALT, SASH, SLAG, TOFF, RCYC, SCMT, SCRP, ];
						cargo_disallow_refit: 			[BDMT, CMNT, FERT, FICR, GRAI, SALT, SCRP, PEAT, BEAN, SUGR, SGBT, SGCN, TWOD, WDPR];
						misc_flags: 					bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_SPRITE_STACK);
						loading_speed:					10;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							50 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						9 ton;
