									{ template_purchase(0, 0)}
				
	alternative_sprites (spriteset_BR_E_01_purchase1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BR_E_01/BR_E_01_KPEV_1x_32bpp.png", "gfx/BR_E_01/BR_E_01_KPEV_1x_mask.png")
