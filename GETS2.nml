							1: spritegroup_WR4ue_39_loading;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_WR4ue_39_popfarben, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_WR4ue_39_popfarben;
							1: spritegroup_WR4ue_39_loading;}										
																			
						switch(FEAT_TRAINS, SELF, switch_length_WR4ue_39, position_in_vehid_chain % 3) {
							0: 4;
							1: 6;
							2: 4;}
						
						switch(FEAT_TRAINS,PARENT,switch_running_cost_WR4ue_39, 1){
							return 7200;}	
							
						switch (FEAT_TRAINS,SELF,switch_build_year_WR4ue_39,build_year) {
							   0 .. 1945 : switch_spritestack_WR4ue_39_DRG;
							1946 .. 1965 : switch_spritestack_WR4ue_39_DSG;
							1966 .. 1973 : switch_spritestack_WR4ue_39_rot;
							1974 .. 2050 : switch_spritestack_WR4ue_39_ozeanblau;
								switch_spritestack_WR4ue_39_ozeanblau;}		

						switch(FEAT_TRAINS, SELF, switch_WR4ue_39_graphics_build, position_in_vehid_chain  % 3) {
							0:     spriteset_empty;
							1:     return switch_build_year_WR4ue_39;
							2:     spriteset_empty;}	

						switch (FEAT_TRAINS, SELF, switch_articulated_WR4ue_39_build, extra_callback_info1) {
							1 ..2: return ITEM_WR4UE_39_BUILD;
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}														

item (FEAT_TRAINS , ITEM_WR4UE_39_BUILD, 5538)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_WR4UE_39_BUILD);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1939,01,01);
						model_life: 					45;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);
						refittable_cargo_classes:		bitmask(CC_PASSENGERS);
						cargo_allow_refit:				[PASS, TOUR];
						loading_speed:					9;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						cargo_age_period:				232;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							180 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						53 ton;
						dual_headed: 					0;
						default_cargo_type:				PASS;
						cargo_capacity:					15;
						ai_engine_rank: 				0;
						length: 						8;												
			}
			
	//Vehicels Graphics
			graphics
			{
			default							: switch_WR4ue_39_graphics_build;
			additional_text					: string(STR_DESC_RESTAURANT);
			length							: switch_length_WR4ue_39;
			articulated_part				: switch_articulated_WR4ue_39_build;
			purchase						: switch_purchase_WR4ue_39;
			cost_factor						: 720;
			running_cost_factor				: switch_running_cost_WR4ue_39;				
			 }
		}

						switch (FEAT_TRAINS,SELF,switch_current_year_WR4ue_39,current_year) {
							   0 .. 1945 : switch_spritestack_WR4ue_39_DRG;
							1946 .. 1965 : switch_spritestack_WR4ue_39_DSG;
							1966 .. 1973 : switch_spritestack_WR4ue_39_rot;
							1974 .. 2050 : switch_spritestack_WR4ue_39_ozeanblau;
								switch_spritestack_WR4ue_39_ozeanblau;}			

						switch(FEAT_TRAINS, SELF, switch_WR4ue_39_graphics_current, position_in_vehid_chain  % 3) {
							0:     spriteset_empty;
							1:     return switch_current_year_WR4ue_39;
							2:     spriteset_empty;}	

						switch (FEAT_TRAINS, SELF, switch_articulated_WR4ue_39_current, extra_callback_info1) {
							1 ..2: return ITEM_WR4UE_39_CURRENT;
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}														

