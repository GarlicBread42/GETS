item (FEAT_TRAINS , ITEM_GKH_BERLIN, 8410)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_GKH_BERLIN);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);						
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1911,01,01);
						model_life: 					55;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						cargo_allow_refit:              [FOOD, FRUT, BEER, FISH, MILK, CHSE, FRVG, MEAT, OYST, TATO, SWET, TOFF,];
						loading_speed:					6;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							85 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						16 ton;
						dual_headed: 					0;
						default_cargo_type:				FOOD;
						cargo_capacity:					10;
						ai_engine_rank: 				0;
						length: 						7;
												
			}
			
	//Vehicels Graphics
			graphics
			{
			default							: switch_GKH_Berlin_sprite_choose;
			additional_text					: string(STR_DESC_GOODS);
			purchase						: spriteset_GKH_Berlin_purchase;
			cost_factor						: 33;
			running_cost_factor				: switch_running_cost_GKH_BERLIN;				
			
			 }
		}	

