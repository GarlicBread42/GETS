							0: spriteset_BR_13_10_KPEV;
							1: return switch_animation_BR_13_10;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_13_10_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_13_10_DRG;
							1: return switch_animation_BR_13_10;}
								
						switch (FEAT_TRAINS,SELF, switch_BR_13_10_build_year,build_year){
								  00 .. 1919: switch_spritestack_BR_13_10_KPEV;
								1920 .. 1950: switch_spritestack_BR_13_10_DRG;				 					 
								switch_spritestack_BR_13_10_DRG;}

						switch (FEAT_TRAINS,SELF, switch_BR_13_10_current_year,current_year){
								  00 .. 1919: switch_spritestack_BR_13_10_KPEV;
								1920 .. 1950: switch_spritestack_BR_13_10_DRG;				 					 
								switch_spritestack_BR_13_10_DRG;}							 						 
		
						switch (FEAT_TRAINS,SELF, switch_BR_13_10_Tender_build_year,build_year){
								  00 .. 1919: spriteset_Tender_22T215_KPEV;
								1920 .. 1950: spriteset_Tender_22T215_DRG;
								spriteset_Tender_22T215_DRG;}
								
						switch (FEAT_TRAINS,SELF, switch_BR_13_10_Tender_current_year,current_year){
