			loading: 	[spriteset_Oot_Oldenburg_load_0, spriteset_Oot_Oldenburg_load_0, spriteset_Oot_Oldenburg_load_0, spriteset_Oot_Oldenburg_load_75, spriteset_Oot_Oldenburg_load_100];		
