						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_455_back_COM1, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_455_back;
							1: spriteset_BR_455_back_COM1;
							2: spritegroup_BR_455_back_loading;}																	

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_455_back_COM2, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_455_back;
							1: spriteset_BR_455_back_COM2;
							2: spritegroup_BR_455_back_loading;}		
							
						switch(FEAT_TRAINS, SELF, switch_length_BR_455, position_in_vehid_chain % 9) {
							0: 4;
							1: 6;
							2: 4;
							3: 4;
							4: 6;
							5: 4;
							6: 4;
							7: 6;
							8: 4;}																					
						
						switch(FEAT_TRAINS,PARENT,switch_running_cost_BR_455, 1){
							return 2150;}

						switch(FEAT_TRAINS,PARENT,switch_running_cost_ET_425, 1){
							return 2250;}
														
						switch(FEAT_TRAINS, SELF, switch_FX_BR_455, position_in_vehid_chain % 6) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE,0, DISABLE_WAGON_POWER);
							1: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
							2: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);
							3: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE,0, DISABLE_WAGON_POWER);
							4: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
							5: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);									
							6: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC,-2, DISABLE_WAGON_POWER);
							7: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
							8: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}	

						switch (FEAT_TRAINS, SELF, random_choose_BR_455_front, switch_alternative_var_random_bits(1, 2)) {
							1: switch_spritestack_BR_455_front_COM1;
							2: switch_spritestack_BR_455_front;
							3: switch_spritestack_BR_455_front_COM2;
							   switch_spritestack_BR_455_front;}

						switch (FEAT_TRAINS, SELF, random_choose_BR_455_front_COM, switch_alternative_var_random_bits(1, 1)) {
							1: switch_spritestack_BR_455_front_COM1;
							   switch_spritestack_BR_455_front_COM2;}
							   
						switch (FEAT_TRAINS, SELF, random_choose_BR_455_middle, switch_alternative_var_random_bits(1, 2)) {
							1: switch_spritestack_BR_455_middle_COM1;
							2: switch_spritestack_BR_455_middle;
							3: switch_spritestack_BR_455_middle_COM2;
							   switch_spritestack_BR_455_middle;}

						switch (FEAT_TRAINS, SELF, random_choose_BR_455_middle_COM, switch_alternative_var_random_bits(1, 1)) {
							1: switch_spritestack_BR_455_middle_COM1;
							   switch_spritestack_BR_455_middle_COM2;}
							   							   
						switch (FEAT_TRAINS, SELF, random_choose_BR_455_back, switch_alternative_var_random_bits(1, 2)) {
							1: switch_spritestack_BR_455_back_COM1;
							2: switch_spritestack_BR_455_back;
							3: switch_spritestack_BR_455_back_COM2;
							   switch_spritestack_BR_455_back;}	
							   
						switch (FEAT_TRAINS, SELF, random_choose_BR_455_back_COM, switch_alternative_var_random_bits(1, 1)) {
							1: switch_spritestack_BR_455_back_COM1;
							   switch_spritestack_BR_455_back_COM2;}							   						   

					switch(FEAT_TRAINS, SELF, switch_BR_455_graphics, position_in_vehid_chain % 9) {
							0:	   spriteset_empty;
							1:     return random_choose_BR_455_front;
							2:     spriteset_empty;
							3:	   spriteset_empty;
							4:	   return random_choose_BR_455_middle;
							5:	   spriteset_empty;	
							6:	   spriteset_empty;
							7:	   return random_choose_BR_455_back;
							8:	   spriteset_empty;}
							
					switch (FEAT_TRAINS, SELF, switch_articulated_BR_455, extra_callback_info1) {
						1 .. 8: return ITEM_BR_455; 
						return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}							

item (FEAT_TRAINS , ITEM_BR_455, 4554)
		{
	//property Block
