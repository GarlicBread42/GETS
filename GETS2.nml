					{template_purchase(0, 0)}	
				
		alternative_sprites (spriteset_GL11_Purchase_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\GL11/GL11_DRG_MBH_1x_32bpp.png", "gfx\GL11/GL11_DRG_MBH_1x_mask.png")
					{template_purchase(0, 0)}	

