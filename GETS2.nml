spriteset(spriteset_BR_4010_front_purchase, "gfx/BR_4010/BR_4010_front_1x_8bpp.png")
									{ template_purchase(0, 0)}
	alternative_sprites (spriteset_BR_4010_front_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BR_4010/BR_4010_front_1x_32bpp.png", "gfx/BR_4010/BR_4010_front_1x_mask.png")
									{template_purchase(0, 0)}									

spriteset(spriteset_BR_4010_front_panto_purchase, "gfx/BR_4010/BR_4010_front_panto_up_1x_8bpp.png")
									{ template_purchase(0, 0)}
	alternative_sprites (spriteset_BR_4010_front_panto_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BR_4010/BR_4010_front_panto_up_1x_32bpp.png", "gfx/BR_4010/BR_4010_front_panto_up_1x_mask.png")
									{template_purchase(0, 0)}									
//Switches

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_4010_purchase, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_4010_front_purchase;
							1: spriteset_BR_4010_front_panto_purchase;}		
							
						switch(FEAT_TRAINS, SELF, switch_loadstack_BR_4010_front, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_4010_front;
							1: spritegroup_BR_4010_front_loading;
							2: spriteset_BR_4010_front_lights_front;
							3: spriteset_BR_4010_front_panto_down;}								

						switch(FEAT_TRAINS, SELF, switch_loadstack_BR_4010_front_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_4010_front_REV;
							1: spritegroup_BR_4010_front_loading_REV;
							2: spriteset_BR_4010_front_lights_back_REV;
							3: spriteset_BR_4010_front_panto_up_REV;}																

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_4010_middle1, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_4010_middle1;
							1: spritegroup_BR_4010_middle_loading;}	

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_4010_middle1_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_4010_middle1_REV;
							1: spritegroup_BR_4010_middle_loading_REV;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_4010_middle2, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_4010_middle2;
							1: spritegroup_BR_4010_middle_loading;}	

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_4010_middle2_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_4010_middle2_REV;
							1: spritegroup_BR_4010_middle_loading_REV;}
														
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_4010_middle3, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_4010_middle3;
							1: spritegroup_BR_4010_middle_loading;}	

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_4010_middle3_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_4010_middle3_REV;
							1: spritegroup_BR_4010_middle_loading_REV;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_4010_middle4, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_4010_middle4;
							1: spritegroup_BR_4010_middle_loading;}	

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_4010_middle4_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_4010_middle4_REV;
							1: spritegroup_BR_4010_middle_loading_REV;}														
							
						switch(FEAT_TRAINS, SELF, switch_loadstack_BR_4010_back, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_4010_back;
							1: spritegroup_BR_4010_back_loading;
							2: spriteset_BR_4010_back_lights_back;
							3: spriteset_BR_4010_back_panto_up;}								

						switch(FEAT_TRAINS, SELF, switch_loadstack_BR_4010_back_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_4010_back_REV;
							1: spritegroup_BR_4010_back_loading_REV;
							2: spriteset_BR_4010_back_lights_front_REV;
							3: spriteset_BR_4010_back_panto_down_REV;}

						switch(FEAT_TRAINS, SELF, switch_length_BR_4010, position_in_vehid_chain % 18) {
							0: 4;
							1: 6;
							2: 4;
							3: 4;
							4: 6;
							5: 4;
							6: 4;
							7: 6;
							8: 4;
							9: 4;
							10: 6;
							11: 4;
							12: 4;
							13: 6;
							14: 4;
							15: 4;
							16: 6;
							17: 4;}	
							
						switch(FEAT_TRAINS, SELF, switch_FX_BR_4010, position_in_vehid_chain % 18) {
								0 .. 14: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE,0, DISABLE_WAGON_POWER);
								15: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, -1, DISABLE_WAGON_POWER);
								16: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE,  0, DISABLE_WAGON_POWER);	
					            17: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE,  0, DISABLE_WAGON_POWER);}							
								
						switch(FEAT_TRAINS,PARENT,switch_running_cost_BR_4010, 1){
							return 5200;}
							
						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_4010_front, vehicle_is_reversed) {
							0: switch_loadstack_BR_4010_front;
								switch_loadstack_BR_4010_back_REV;}																

						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_4010_middle1, vehicle_is_reversed) {
							0: switch_spritestack_BR_4010_middle1;
								switch_spritestack_BR_4010_middle4_REV;}
								
						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_4010_middle2, vehicle_is_reversed) {
							0: switch_spritestack_BR_4010_middle2;
								switch_spritestack_BR_4010_middle3_REV;}
								
						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_4010_middle3, vehicle_is_reversed) {
							0: switch_spritestack_BR_4010_middle3;
								switch_spritestack_BR_4010_middle2_REV;}
								
						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_4010_middle4, vehicle_is_reversed) {
							0: switch_spritestack_BR_4010_middle4;
								switch_spritestack_BR_4010_middle1_REV;}																								
								
						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_4010_back, vehicle_is_reversed) {
							0: switch_loadstack_BR_4010_back;
								switch_loadstack_BR_4010_front_REV;}								

						switch(FEAT_TRAINS, SELF, switch_graphics_BR_4010, position_in_vehid_chain % 18) {
							0:	   spriteset_empty;
							1:     return switch_reverse_BR_4010_front;
							2:     spriteset_empty;
							3:	   spriteset_empty;
							4:	   return switch_reverse_BR_4010_middle1;
							5:	   spriteset_empty;
							6:	   spriteset_empty;
							7:	   return switch_reverse_BR_4010_middle2;
							8:	   spriteset_empty;							
							9:	   spriteset_empty;
							10:	   return switch_reverse_BR_4010_middle3;
							11:	   spriteset_empty;
							12:	   spriteset_empty;
							13:	   return switch_reverse_BR_4010_middle4;
							14:	   spriteset_empty;														
							15:	   spriteset_empty;
							16:	   return switch_reverse_BR_4010_back;
							17:	   spriteset_empty;}
						   
						switch (FEAT_TRAINS, SELF, switch_articulated_BR_4010, extra_callback_info1) {
							1 .. 17: return ITEM_BR_4010; 
							return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}


item (FEAT_TRAINS , ITEM_BR_4010, 4460)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_BR_4010);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);						
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(2022,01,01);
						model_life: 					VEHICLE_NEVER_EXPIRES;
						vehicle_life: 					40;
						retire_early: 					-10;							
						reliability_decay: 				20;
						cargo_allow_refit:              [PASS, TOUR];
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);
						cargo_capacity:                 27 ;
						loading_speed:					5;
						cost_factor: 					108;
						running_cost_base:				RUNNING_COST_STEAM;						
						running_cost_factor: 			90;

						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							200 km/h;
						refit_cost: 					0;
						track_type: 					AC15;	
						power:  						8160 hp;
						weight: 						354 ton;
						ai_engine_rank: 				0;
						engine_class: 					ENGINE_CLASS_ELECTRIC;
						visual_effect_and_powered: 		visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
						dual_headed: 					0;
						tractive_effort_coefficient: 	0.135;
						length: 						8;
			}

		//Vehicels Graphics
			graphics
			{
			default							: switch_graphics_BR_4010;
			additional_text					: string(STR_CONCAT_2, 
											  string(STR_TRACTION_EMU), 
											  string(STR_DESC_EXPRESS),);
			length							: switch_length_BR_4010;
			articulated_part				: switch_articulated_BR_4010;
			visual_effect_and_powered		: switch_FX_BR_4010;
			purchase						: switch_spritestack_BR_4010_purchase;
			cost_factor						: 500;
			running_cost_factor				: switch_running_cost_BR_4010;			
			}
	}

