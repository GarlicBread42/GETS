					{template_purchase(0, 0)}	
		alternative_sprites (spriteset_RS_Stuttgart_purchase1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\RS_Stuttgart/RS_Stuttgart_DRG_1x_32bpp.png", "gfx\RS_Stuttgart/RS_Stuttgart_DRG_1x_mask.png")
