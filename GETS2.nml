					switch (FEAT_TRAINS,SELF, switch_EB_41_purchase,current_year){
						 1900 .. 1931: spriteset_EB_41_purchase1;
						 1932 .. 1935: spriteset_EB_41_purchase2;
						 1936 .. 2050: spriteset_EB_41_purchase3;
							spriteset_EB_41_purchase3;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_EB_41_Twotone, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_EB_41_Twotone;
							1: spritegroup_EB_41_Twotone_loading;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_EB_41_Grau, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_EB_41_Grau;
							1: spritegroup_EB_41_Grau_loading;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_EB_41_Rot, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_EB_41_Rot;
							1: spritegroup_EB_41_Rot_loading;}																				
							
