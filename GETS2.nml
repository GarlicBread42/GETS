							1946 .. 1965 : spriteset_WR4ue_39_purchase_DSG;
							1966 .. 1973 : spriteset_WR4ue_39_purchase_rot;
							1974 .. 2050 : spriteset_WR4ue_39_purchase_ozeanblau;
								spriteset_WR4ue_39_purchase_ozeanblau;}	

						switch(FEAT_TRAINS, SELF, switch_spritestack_WR4ue_39_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_WR4ue_39_DRG;
							1: spritegroup_WR4ue_39_loading;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_WR4ue_39_DSG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
