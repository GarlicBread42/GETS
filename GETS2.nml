							1:     return switch_reverse_BR_465_front;
							2:     spriteset_empty;
							3:	   spriteset_empty;
							4:     return switch_reverse_BR_465_back;
							5:     spriteset_empty;}						
							
						switch (FEAT_TRAINS, SELF, switch_articulated_BR_465_2, extra_callback_info1) {
							1 .. 5: return ITEM_BR_465_2; 
							return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}

