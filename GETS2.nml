						visual_effect_and_powered: 		visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
						dual_headed: 					0;
						tractive_effort_coefficient: 	0.2;
						length: 						8;
			}

		//Vehicels Graphics
			graphics
			{
			default:						switch_ET_11_graphics_DB_rot;
			additional_text					: string(STR_CONCAT_2, 
											  string(STR_TRACTION_EMU), 
											  string(STR_DESC_EXPRESS),);
			length:							switch_length_ET_11;
			articulated_part:				switch_articulated_ET_11_DB_rot;
			visual_effect_and_powered:    	switch_FX_ET_11;
			purchase:						spriteset_ET_11_DB_rot_purchase;
			cost_factor:					79;
			running_cost_factor:			switch_running_cost_ET_11;			
			}
	}

					switch(FEAT_TRAINS, SELF, switch_ET_11_graphics_DB_blau, position_in_vehid_chain % 6) {
							0:	   spriteset_empty;
							1:     return switch_spritestack_ET_11_front_DB_blau;
							2:     spriteset_empty;
							3:	   spriteset_empty;
							4:	   return switch_spritestack_ET_11_back_DB_blau;
							5:	   spriteset_empty;}	

					switch (FEAT_TRAINS, SELF, switch_articulated_ET_11_DB_blau, extra_callback_info1) {
						1 .. 5: return ITEM_ET_11_DB_BLAU; 
						return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}

item (FEAT_TRAINS , ITEM_ET_11_DB_BLAU, 4114)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_ET_11_DB_BLAU);
						variant_group:					4110;
						extra_flags:					bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1946,01,01);
						model_life: 					29;
						vehicle_life: 					40;
						retire_early: 					-10;							
						reliability_decay: 				20;
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);
						cargo_allow_refit:              [PASS, TOUR];
						cargo_capacity:                 13 ;
						loading_speed:					5;
						cost_factor: 					108;
						running_cost_base:				RUNNING_COST_STEAM;						
						running_cost_factor: 			90;

						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							160 km/h;
						refit_cost: 					0;
						track_type: 					AC15;	
						power:  						1700 hp;
						weight: 						107 ton;
						ai_engine_rank: 				0;
						engine_class: 					ENGINE_CLASS_ELECTRIC;
						visual_effect_and_powered: 		visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
						dual_headed: 					0;
						tractive_effort_coefficient: 	0.2;
						length: 						8;
			}

		//Vehicels Graphics
			graphics
			{
			default:						switch_ET_11_graphics_DB_blau;
			additional_text					: string(STR_CONCAT_2, 
											  string(STR_TRACTION_EMU), 
											  string(STR_DESC_EXPRESS),);
			length:							switch_length_ET_11;
			articulated_part:				switch_articulated_ET_11_DB_blau;
			visual_effect_and_powered:    	switch_FX_ET_11;
			purchase:						spriteset_ET_11_DB_blau_purchase;
			cost_factor:					79;
			running_cost_factor:			switch_running_cost_ET_11;			
			}
	}
