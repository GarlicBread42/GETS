							0: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
							return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}
							
						switch(FEAT_TRAINS,PARENT,switch_running_cost_BR_103_2, 1){
						return 8500;}						
							
						switch(FEAT_TRAINS, SELF, switch_BR_103_2_graphics, position_in_vehid_chain % 3) {
							0:	   spriteset_empty;
							1:     return switch_BR_103_2_build_year;
							2:	   spriteset_empty;}	
							
						switch (FEAT_TRAINS, SELF, switch_articulated_BR_103_2, extra_callback_info1) {
							1 .. 2: return ITEM_BR_103_2; 				
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}
						
