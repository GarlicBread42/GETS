									{ template_purchase(0, 0)}
		alternative_sprites (spriteset_X_Wagen_DVT_Nuernberg_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\X_Wagen_DVT/X_Wagen_DVT_Nuernberg_1x_32bpp.png", "gfx\X_Wagen_DVT/X_Wagen_DVT_Nuernberg_1x_mask.png")
									{ template_purchase(0, 0)}  

spriteset(spriteset_X_Wagen_DVT_overlay_Jaeger_purchase, "gfx\X_Wagen_DVT/X_Wagen_DVT_overlay_Jaeger_1x_8bpp.png")
									{ template_purchase(0, 0)}
		alternative_sprites (spriteset_X_Wagen_DVT_overlay_Jaeger_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\X_Wagen_DVT/X_Wagen_DVT_overlay_Jaeger_1x_32bpp.png", "gfx\X_Wagen_DVT/X_Wagen_DVT_overlay_Jaeger_1x_mask.png")
									{ template_purchase(0, 0)}                


//Switches

    switch(FEAT_TRAINS, SELF, switch_spritestack_X_Wagen_DVT_Jaeger_purchase, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_X_Wagen_DVT_orange_purchase;
        1: spriteset_X_Wagen_DVT_overlay_Jaeger_purchase;}

    switch (FEAT_TRAINS,SELF, switch_X_Wagen_DVT_purchase,current_year){
       0 .. 1986: spriteset_X_Wagen_DVT_orange_purchase;
    1987 .. 1995: spriteset_X_Wagen_DVT_sbahn_purchase;	
    1996 .. 2045: spriteset_X_Wagen_DVT_verkehrsrot_purchase;														 					 
        spriteset_X_Wagen_DVT_verkehrsrot_purchase;} 

    switch(FEAT_TRAINS, SELF, switch_spritestack_X_Wagen_DVT_orange, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_X_Wagen_DVT_orange;
        1: spritegroup_X_Wagen_DVT_orange_loading;}  

    switch(FEAT_TRAINS, SELF, switch_spritestack_X_Wagen_DVT_Jaeger, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_X_Wagen_DVT_orange;
        1: spriteset_X_Wagen_DVT_overlay_Jaeger;
        2: spritegroup_X_Wagen_DVT_orange_loading;}    

    switch(FEAT_TRAINS, SELF, switch_spritestack_X_Wagen_DVT_sbahn, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_X_Wagen_DVT_sbahn;
        1: spritegroup_X_Wagen_DVT_sbahn_loading;}     
 
    switch(FEAT_TRAINS, SELF, switch_spritestack_X_Wagen_DVT_verkehrsrot, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_X_Wagen_DVT_verkehrsrot;
        1: spritegroup_X_Wagen_DVT_verkehrsrot_loading;}       

    switch(FEAT_TRAINS, SELF, switch_spritestack_X_Wagen_DVT_Nuernberg, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_X_Wagen_DVT_nuernberg;
        1: spritegroup_X_Wagen_DVT_verkehrsrot_loading;}    

    switch(FEAT_TRAINS, SELF, switch_length_X_Wagen_DVT, position_in_articulated_veh % 3) {
        0: 4;
        1: 6;
        2: 4;}

    switch(FEAT_TRAINS,PARENT,switch_running_cost_X_Wagen_DVT, 1){
        return 2100;}
        
    switch (FEAT_TRAINS,SELF,switch_build_year_X_Wagen_DVT,build_year) {
       0 .. 1986: switch_spritestack_X_Wagen_DVT_orange;
    1987 .. 1995: switch_spritestack_X_Wagen_DVT_sbahn;	
    1996 .. 2045: switch_spritestack_X_Wagen_DVT_verkehrsrot;														 					 
        switch_spritestack_X_Wagen_DVT_verkehrsrot;}           

    switch (FEAT_TRAINS,SELF,switch_current_year_X_Wagen_DVT,current_year) {
       0 .. 1986: switch_spritestack_X_Wagen_DVT_orange;
    1987 .. 1995: switch_spritestack_X_Wagen_DVT_sbahn;	
    1996 .. 2045: switch_spritestack_X_Wagen_DVT_verkehrsrot;														 					 
        switch_spritestack_X_Wagen_DVT_verkehrsrot;}    

    switch(FEAT_TRAINS, SELF, switch_X_Wagen_DVT_graphics_build, position_in_articulated_veh  % 3) {
        0:     spriteset_empty;
        1:     return switch_build_year_X_Wagen_DVT;
        2:     spriteset_empty;}	
            
    switch (FEAT_TRAINS, SELF, switch_articulated_X_Wagen_DVT_build, extra_callback_info1) {
        1 .. 2: return ITEM_X_WAGEN_DVTUILD;
            return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}     

item (FEAT_TRAINS , ITEM_X_WAGEN_DVTUILD, 7990)
		{
	//property Block
			property 
