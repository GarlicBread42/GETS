							   0 .. 1965 : spriteset_WRmh_132_purchase_DSG;
							1966 .. 1973 : spriteset_WRmh_132_purchase_DB_rot;
							1974 .. 1985 : spriteset_WRmh_132_purchase_ozeanblau;
							1986 .. 1995 : spriteset_WRmh_132_purchase_icalt;
							1996 .. 2050 : spriteset_WRmh_132_purchase_Fern;
								spriteset_WRmh_132_purchase_Fern;}	
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_WRmh_132_DB_rot, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_WRmh_132_DB_rot;
							1: spritegroup_WRmh_132_loading;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_WRmh_132_DSG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_WRmh_132_DSG;
							1: spritegroup_WRmh_132_loading;}							
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_WRmh_132_Fern, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_WRmh_132_Fern;
							1: spritegroup_WRmh_132_loading;}							
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_WRmh_132_IC79, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_WRmh_132_IC79;
							1: spritegroup_WRmh_132_loading;}							
																								
						switch(FEAT_TRAINS, SELF, switch_spritestack_WRmh_132_icalt, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_WRmh_132_icalt;
							1: spritegroup_WRmh_132_loading;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_WRmh_132_ozeanblau, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_WRmh_132_ozeanblau;
							1: spritegroup_WRmh_132_loading;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_WRmh_132_popfarben, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
