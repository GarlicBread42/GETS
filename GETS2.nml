//Switches


					switch(FEAT_TRAINS, SELF, switch_loadstack_BT_10_Beer, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_BT_10;
						1: spritegroup_BT_10_load_Beer;}

					switch(FEAT_TRAINS, SELF, switch_loadstack_BT_10_Bulk, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_BT_10;
						1: spritegroup_BT_10_load_Bulk;}
						
					switch(FEAT_TRAINS, SELF, switch_loadstack_BT_10_Cement, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_BT_10;
						1: spritegroup_BT_10_load_Cement;}
						
					switch(FEAT_TRAINS, SELF, switch_loadstack_BT_10_Liquid, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_BT_10;
						1: spritegroup_BT_10_load_Liquid;}

					switch(FEAT_TRAINS, SELF, switch_loadstack_BT_10_Piece, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_BT_10;
						1: spritegroup_BT_10_load_Piece;}												

					switch(FEAT_TRAINS, SELF, switch_BT_10_cargo_classes, cargo_classes) {
							bitmask(CC_PIECE_GOODS) : return switch_loadstack_BT_10_Piece;
							bitmask(CC_BULK) : return switch_loadstack_BT_10_Bulk;
							bitmask(CC_LIQUID) : return switch_loadstack_BT_10_Liquid;
								return switch_loadstack_BT_10_Piece;}									

					switch (FEAT_TRAINS, SELF, switch_BT_10_cargo_type, cargo_type_in_veh) {

							//FIRS-Cargos					
							BEER: return switch_loadstack_BT_10_Beer;
							
							BEAN: return switch_loadstack_BT_10_Bulk;
							CASS: return switch_loadstack_BT_10_Bulk;
							COAL: return switch_loadstack_BT_10_Bulk;
							COKE: return switch_loadstack_BT_10_Bulk;
							CORE: return switch_loadstack_BT_10_Bulk;
							FECR: return switch_loadstack_BT_10_Bulk;
							IORE: return switch_loadstack_BT_10_Bulk;
							LIME: return switch_loadstack_BT_10_Bulk;
							MNO2: return switch_loadstack_BT_10_Bulk;
							NITR: return switch_loadstack_BT_10_Bulk;
							PEAT: return switch_loadstack_BT_10_Bulk;
							PHOS: return switch_loadstack_BT_10_Bulk;
							POTA: return switch_loadstack_BT_10_Bulk;
							PORE: return switch_loadstack_BT_10_Bulk;
							SALT: return switch_loadstack_BT_10_Bulk;
							SAND: return switch_loadstack_BT_10_Bulk;
