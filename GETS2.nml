//Switches

					switch (FEAT_TRAINS,SELF, switch_Sahimms_900_purchase,current_year){
						1800 .. 1995: spriteset_Sahimms_900_purchase_braun;
						1996 .. 2050: spriteset_Sahimms_900_purchase_DBCargo;
							spriteset_Sahimms_900_purchase_DBCargo;}							

					switch(FEAT_TRAINS, SELF, switch_length_Sahimms_900, position_in_vehid_chain % 3) {
						0: 3;
						1: 3;
						2: 3;}							
																				
					switch(FEAT_TRAINS,PARENT,switch_running_cost_Sahimms_900, 1){
						return 700;}

					switch (FEAT_TRAINS,SELF, switch_Sahimms_900_current_year,current_year){
						00 .. 1995: spritegroup_Sahimms_900_braun;
					  1996 .. 2050: spritegroup_Sahimms_900_DBCargo;					 					 
							spritegroup_Sahimms_900_DBCargo;}
								
					switch(FEAT_TRAINS, SELF, switch_Sahimms_900_current_graphics, position_in_articulated_veh % 3) {
						0:	   spriteset_empty;
						1:     return switch_Sahimms_900_current_year;
						2:	   spriteset_empty;}

					switch (FEAT_TRAINS, SELF, switch_articulated_Sahimms_900_current, extra_callback_info1) {
						1 .. 2: return ITEM_SAHIMMS_900_CURRENT;
						return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}	
																			
