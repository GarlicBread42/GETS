		0: return switch_Ocw_Muenster_OBH_current_year;
		1: spritegroup_Ocw_Muenster_OBH_load_Timber;}
		
	switch(FEAT_TRAINS, SELF, switch_loadstack_Ocw_Muenster_OBH_Wood, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: return switch_Ocw_Muenster_OBH_current_year;
		1: spritegroup_Ocw_Muenster_OBH_load_Wood;}	

	switch (FEAT_TRAINS, SELF, random_choose_Ocw_Muenster_Barren, switch_alternative_var_random_bits(1, 1)) {
			1: switch_loadstack_Ocw_Muenster_OBH_Barren;
				switch_loadstack_Ocw_Muenster_MBH_Barren;}	

	switch (FEAT_TRAINS, SELF, random_choose_Ocw_Muenster_Box, switch_alternative_var_random_bits(1, 1)) {
			1: switch_loadstack_Ocw_Muenster_OBH_Box;
				switch_loadstack_Ocw_Muenster_MBH_Box;}	
				
	switch (FEAT_TRAINS, SELF, random_choose_Ocw_Muenster_Bulk, switch_alternative_var_random_bits(1, 1)) {
			1: switch_loadstack_Ocw_Muenster_OBH_Bulk;
				switch_loadstack_Ocw_Muenster_MBH_Bulk;}
																	
	switch (FEAT_TRAINS, SELF, random_choose_Ocw_Muenster_Bulk_covered, switch_alternative_var_random_bits(1, 1)) {
			1: switch_loadstack_Ocw_Muenster_OBH_Bulk_covered;
				switch_loadstack_Ocw_Muenster_MBH_Bulk_covered;}

	switch (FEAT_TRAINS, SELF, random_choose_Ocw_Muenster_COPR, switch_alternative_var_random_bits(1, 1)) {
			1: switch_loadstack_Ocw_Muenster_OBH_COPR;
				switch_loadstack_Ocw_Muenster_MBH_COPR;}	

	switch (FEAT_TRAINS, SELF, random_choose_Ocw_Muenster_Fass, switch_alternative_var_random_bits(1, 1)) {
			1: switch_loadstack_Ocw_Muenster_OBH_Fass;
				switch_loadstack_Ocw_Muenster_MBH_Fass;}

	switch (FEAT_TRAINS, SELF, random_choose_Ocw_Muenster_Rohr, switch_alternative_var_random_bits(1, 1)) {
			1: switch_loadstack_Ocw_Muenster_OBH_Rohr;
				switch_loadstack_Ocw_Muenster_MBH_Rohr;}				
				
	switch (FEAT_TRAINS, SELF, random_choose_Ocw_Muenster_Timber, switch_alternative_var_random_bits(1, 1)) {
			1: switch_loadstack_Ocw_Muenster_OBH_Timber;
				switch_loadstack_Ocw_Muenster_MBH_Timber;}
				
	switch (FEAT_TRAINS, SELF, random_choose_Ocw_Muenster_Wood, switch_alternative_var_random_bits(1, 1)) {
			1: switch_loadstack_Ocw_Muenster_OBH_Wood;
				switch_loadstack_Ocw_Muenster_MBH_Wood;}																																														

	switch(FEAT_TRAINS, SELF, switch_Ocw_Muenster_current_CC_Liquid, hasbit(cargo_classes, CC_LIQUID)) {
			0: random_choose_Ocw_Muenster_Box;
				random_choose_Ocw_Muenster_Fass;}	

	switch(FEAT_TRAINS, SELF, switch_Ocw_Muenster_current_CC_Piece, hasbit(cargo_classes, CC_PIECE_GOODS)) {
			0: switch_Ocw_Muenster_current_CC_Liquid;
				random_choose_Ocw_Muenster_Box;}		

	switch(FEAT_TRAINS, SELF, switch_Ocw_Muenster_current_CC_Bulk, hasbit(cargo_classes, CC_BULK)) {
		0: switch_Ocw_Muenster_current_CC_Piece;
			random_choose_Ocw_Muenster_Bulk;}

	switch(FEAT_TRAINS, SELF, switch_Ocw_Muenster_current_CC_Bulk_Covered, hasbit(cargo_classes, CC_COVERED & CC_BULK)) {
		0: switch_Ocw_Muenster_current_CC_Bulk;
			random_choose_Ocw_Muenster_Bulk_covered;}			

	switch (FEAT_TRAINS, SELF, switch_Ocw_Muenster_cargo_type, cargo_type_in_veh) {
			STEL: return random_choose_Ocw_Muenster_Barren;
			METL: return random_choose_Ocw_Muenster_Rohr;
			ZINC: return random_choose_Ocw_Muenster_Rohr;
			COPR: return random_choose_Ocw_Muenster_COPR;
			STST: return random_choose_Ocw_Muenster_Barren;
			STSH: return random_choose_Ocw_Muenster_Barren;
			STSE: return random_choose_Ocw_Muenster_Barren;
			STAL: return random_choose_Ocw_Muenster_Barren;
			STCB: return random_choose_Ocw_Muenster_Rohr;
			STWR: return random_choose_Ocw_Muenster_Rohr; 
			CSTI: return random_choose_Ocw_Muenster_Rohr;
			PIPE: return random_choose_Ocw_Muenster_Rohr;

			ENSP: return random_choose_Ocw_Muenster_Box;
			FMSP: return random_choose_Ocw_Muenster_Box;
			MNSP: return random_choose_Ocw_Muenster_Box;
			POWR: return random_choose_Ocw_Muenster_Box;
			VPTS: return random_choose_Ocw_Muenster_Box;
			MPTS: return random_choose_Ocw_Muenster_Box;
			GOOD: return random_choose_Ocw_Muenster_Box;
			PAPR: return random_choose_Ocw_Muenster_Box;
			TYRE: return random_choose_Ocw_Muenster_Box;
			WOOL: return random_choose_Ocw_Muenster_Box;
			TEXT: return random_choose_Ocw_Muenster_Box;	
			SEED: return random_choose_Ocw_Muenster_Box;	
			FERT: return random_choose_Ocw_Muenster_Box;

			FRVG: return random_choose_Ocw_Muenster_Bulk_covered;
			TATO: return random_choose_Ocw_Muenster_Bulk_covered;
			FRUT: return random_choose_Ocw_Muenster_Bulk_covered;
			CERE: return random_choose_Ocw_Muenster_Bulk_covered;
			FICR: return random_choose_Ocw_Muenster_Bulk_covered;
			OLSD: return random_choose_Ocw_Muenster_Bulk_covered;
			QLME: return random_choose_Ocw_Muenster_Bulk;
			MNO2: return random_choose_Ocw_Muenster_Bulk;

			BDMT: return random_choose_Ocw_Muenster_Timber;
			WDPR: return random_choose_Ocw_Muenster_Timber;
			WOOD: return random_choose_Ocw_Muenster_Wood;
			GLAS: return random_choose_Ocw_Muenster_Box;
			BRCK: return random_choose_Ocw_Muenster_Box;
				switch_Ocw_Muenster_current_CC_Bulk_Covered;}	

	switch(FEAT_TRAINS,PARENT,switch_running_cost_Ocw_Muenster, 1){
		return 44;}

item (FEAT_TRAINS , ITEM_OCW_MUENSTER, 8600)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_OCW_MUENSTER);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1883,01,01);
						model_life: 					70;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes: 		bitmask(CC_BULK, CC_COVERED, CC_PIECE_GOODS, CC_LIQUID);
						non_refittable_cargo_classes: 	bitmask(CC_REFRIGERATED, CC_HAZARDOUS, CC_OVERSIZED);
						cargo_allow_refit:              [WOOD, BDMT, WDPR, TWOD, FRUT ];
						cargo_disallow_refit: 			[LVST, FOOD, WATR, BEER, BOOM, FISH, IRON];
						misc_flags: 					bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_SPRITE_STACK);
						loading_speed:					10;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							45 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						8 ton;
						dual_headed: 					0;
						default_cargo_type:				COAL;
						cargo_capacity:					10;
						ai_engine_rank: 				0;
						length: 						5;
												
			}
			
	//Vehicels Graphics
			graphics
			{
			default							: switch_Ocw_Muenster_cargo_type;
			additional_text					: string(STR_DESC_GOODS);
			purchase						: switch_Ocw_Muenster_purchase;
			cost_factor						: 21;
			running_cost_factor				: switch_running_cost_Ocw_Muenster;
			colour_mapping					: switch_bulk_recolour;
			 }
		}
