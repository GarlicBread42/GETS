spriteset (spriteset_K_Elberfeld_DRG_purchase, "gfx\K_Elberfeld/K_Elberfeld_MBH_DRG_1x_8bpp.png")
					{template_purchase(0, 0)}	
		alternative_sprites (spriteset_K_Elberfeld_DRG_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\K_Elberfeld/K_Elberfeld_MBH_DRG_1x_32bpp.png", "gfx\K_Elberfeld/K_Elberfeld_MBH_DRG_1x_mask.png")
					{template_purchase(0, 0)}
					
spriteset (spriteset_K_Elberfeld_DB_purchase, "gfx\K_Elberfeld/K_Elberfeld_MBH_DB_1x_8bpp.png")
					{template_purchase(0, 0)}	
		alternative_sprites (spriteset_K_Elberfeld_DB_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\K_Elberfeld/K_Elberfeld_MBH_DB_1x_32bpp.png", "gfx\K_Elberfeld/K_Elberfeld_MBH_DB_1x_mask.png")
					{template_purchase(0, 0)}				


//Switches

					switch (FEAT_TRAINS,SELF, switch_K_Elberfeld_purchase,current_year){
						1800 .. 1919: spriteset_K_Elberfeld_KPEV_purchase;
						1920 .. 1945: spriteset_K_Elberfeld_DRG_purchase;
						1946 .. 2050: spriteset_K_Elberfeld_DB_purchase;				 					 
							spriteset_K_Elberfeld_DB_purchase;}

					switch (FEAT_TRAINS,SELF, switch_K_Elberfeld_MBH_current,current_year){
						1800 .. 1919: spritegroup_K_Elberfeld_MBH_KPEV;
						1920 .. 1945: spritegroup_K_Elberfeld_MBH_DRG;
						1946 .. 2050: spritegroup_K_Elberfeld_MBH_DB;				 					 
							spritegroup_K_Elberfeld_MBH_DB;}

					switch (FEAT_TRAINS,SELF, switch_K_Elberfeld_OBH_current,current_year){
						1800 .. 1919: spritegroup_K_Elberfeld_OBH_KPEV;
						1920 .. 1945: spritegroup_K_Elberfeld_OBH_DRG;
						1946 .. 2050: spritegroup_K_Elberfeld_OBH_DB;				 					 
							spritegroup_K_Elberfeld_OBH_DB;}							
							
					switch(FEAT_TRAINS, SELF, switch_K_Elberfeld_MBH_loadstack_current, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: return switch_K_Elberfeld_MBH_current;
						1: spritegroup_K_Elberfeld_MBH_open_loading;}

					switch(FEAT_TRAINS, SELF, switch_K_Elberfeld_OBH_loadstack_current, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: return switch_K_Elberfeld_OBH_current;
						1: spritegroup_K_Elberfeld_OBH_open_loading;}

					switch (FEAT_TRAINS, SELF, switch_graphics_K_Elberfeld, position_in_vehid_chain % 2) {
						1: switch_K_Elberfeld_MBH_loadstack_current;
							switch_K_Elberfeld_OBH_loadstack_current;}

					switch (FEAT_TRAINS, PARENT, switch_speed_K_Elberfeld,  switch_check_PWG_0()) {
						1: return 65;
						0: return 50;}
													
					switch(FEAT_TRAINS,PARENT,switch_running_cost_K_Elberfeld, 1){
						return 72;}

item (FEAT_TRAINS , ITEM_K_ELBERFELD, 8700)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_K_ELBERFELD);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1892,01,01);
						model_life: 					70;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes: 		bitmask(CC_BULK, CC_COVERED);
						cargo_allow_refit:              [CORE, AORE, CLAY, FECR, GRVL, KAOL, LIME, PHOS, PORE, POTA, SAND, SULP, URAN, CASS, MNO2, NICK, NITR, NKOR, QLME, SALT, SASH, TOFF, CMNT, FERT, FICR, RCYC, SALT, SGBT, SGCN, ];
						cargo_disallow_refit: 			[COAL, IORE, COKE, SLAG, GRAI, PEAT, BEAN, SCRP,  SUGR, BDMT, WOOL, RCYC, SCMT, TWOD, WOOD, WDPR, FRUT, CERE, FICR, OLSD, FOOD ];
						misc_flags: 					bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_SPRITE_STACK);
						loading_speed:					10;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							50 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						10 ton;
						dual_headed: 					0;
						default_cargo_type:				POTA;
						cargo_capacity:					15;
						ai_engine_rank: 				0;
						length: 						4;
												
			}
			
	//Vehicels Graphics
			graphics
			{
			default							: switch_graphics_K_Elberfeld;
			additional_text					: string(STR_DESC_CABOOSE_65);
			purchase						: switch_K_Elberfeld_purchase;
			cost_factor						: 34;
			running_cost_factor				: switch_running_cost_K_Elberfeld;
			speed							: switch_speed_K_Elberfeld; 				
			colour_mapping					: switch_bulk_recolour;

			 }
		}
