								switch_spritestack_BR_1002_HSL_REV;}										


						switch(FEAT_TRAINS,PARENT,switch_running_cost_BR_1002, 1){
							return 550;}														
							
item (FEAT_TRAINS , ITEM_BR_1002_DB, 2950)


		{
			//property Block
					property 
					{
					//common properties
								name: 							string(STR_NAME_BR_1002_DB);
								extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
								climates_available: 			ALL_CLIMATES;
								introduction_date: 				date(2015,01,01);
								model_life: 					VEHICLE_NEVER_EXPIRES;
								vehicle_life: 					40;
								retire_early: 					-10;									
								reliability_decay: 				20;
								misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);
								cargo_allow_refit: 				[PASS] ;
								cargo_capacity: 				1 ;
								cost_factor: 					54;
								running_cost_base: 				RUNNING_COST_STEAM;
								running_cost_factor: 			90;
								
					//Train specific properties
								sprite_id: 						SPRITE_ID_NEW_TRAIN;
								speed: 							100 km/h;
								refit_cost: 					0;
								track_type: 					RAIL;
								power:  						820 hp;
								weight: 						65 ton;
								ai_engine_rank: 				0;
								engine_class: 					ENGINE_CLASS_DIESEL;
								visual_effect_and_powered: 		visual_effect_and_powered(VISUAL_EFFECT_DIESEL, -1, DISABLE_WAGON_POWER);
								dual_headed: 					0;
								tractive_effort_coefficient: 	0.35;
								length: 						8;
			}
			
					graphics
				{
						default						   : switch_reverse_BR_1002_DB;
						additional_text:				string(STR_CONCAT_2, 
														string(STR_TRACTION_DIESELHYBRID), 
														string(STR_DESC_SHUNT),);
						purchase_cargo_capacity        : 0 ;
						cargo_capacity                 : return 0 ;
						purchase					   : spriteset_BR_1002_purchase_DB;
						cost_factor						:20;
						running_cost_factor				: switch_running_cost_BR_1002;	
			 }
		}							


							
							
