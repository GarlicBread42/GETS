							0: spriteset_VT_11_5_Restaurant_TEE;
							1: spritegroup_VT_11_5_loading_door_back;}	
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_VT_11_5_Restaurant_IC, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_VT_11_5_Restaurant;
							1: spritegroup_VT_11_5_loading_door_back;}	
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_VT_11_5_Graum, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_VT_11_5_Graum;
							1: spritegroup_VT_11_5_loading_door_back;}	
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_VT_11_5_back_TEE, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
