//Switches

						switch (FEAT_TRAINS,SELF, switch_Schuerze_purchase,current_year){
							   0 .. 1945: spriteset_Schuerze_purchase_DRG;
							1946 .. 2050: spriteset_Schuerze_purchase_DB_gruen;						
										spriteset_Schuerze_purchase_DB_gruen;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_Schuerze_DRG_B, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_Schuerze_DRG_B;
							1: spritegroup_Schuerze_Loading;}																					

						switch(FEAT_TRAINS, SELF, switch_spritestack_Schuerze_DRG_BC, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_Schuerze_DRG_BC;
							1: spritegroup_Schuerze_Loading;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_Schuerze_DRG_C, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_Schuerze_DRG_C;
							1: spritegroup_Schuerze_Loading;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_Schuerze_DB_Schrift_B, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_Schuerze_DB_Schrift_B;
							1: spritegroup_Schuerze_Loading;}																					

						switch(FEAT_TRAINS, SELF, switch_spritestack_Schuerze_DB_Schrift_BC, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_Schuerze_DB_Schrift_BC;
							1: spritegroup_Schuerze_Loading;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_Schuerze_DB_Schrift_C, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_Schuerze_DB_Schrift_C;
							1: spritegroup_Schuerze_Loading;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_Schuerze_DB_blau_B, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_Schuerze_DB_blau_B;
							1: spritegroup_Schuerze_Loading;}																					

						switch(FEAT_TRAINS, SELF, switch_spritestack_Schuerze_DB_blau_BC, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_Schuerze_DB_blau_BC;
							1: spritegroup_Schuerze_Loading;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_Schuerze_DB_blau_C, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_Schuerze_DB_blau_C;
							1: spritegroup_Schuerze_Loading;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_Schuerze_DB_gruen_B, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_Schuerze_DB_gruen_B;
							1: spritegroup_Schuerze_Loading;}																					

						switch(FEAT_TRAINS, SELF, switch_spritestack_Schuerze_DB_gruen_BC, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_Schuerze_DB_gruen_BC;
							1: spritegroup_Schuerze_Loading;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_Schuerze_DB_gruen_C, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_Schuerze_DB_gruen_C;
							1: spritegroup_Schuerze_Loading;}
																					
						switch (FEAT_TRAINS, SELF, random_choose_Schuerze_DRG, switch_alternative_var_random_bits(1, 2)) {
							1: switch_spritestack_Schuerze_DRG_B;
							2: switch_spritestack_Schuerze_DRG_BC;
							3: switch_spritestack_Schuerze_DRG_C;											
								 switch_spritestack_Schuerze_DRG_C;}
																					
						switch (FEAT_TRAINS, SELF, random_choose_Schuerze_DB_Schrift, switch_alternative_var_random_bits(1, 2)) {
							1: switch_spritestack_Schuerze_DB_Schrift_B;
							2: switch_spritestack_Schuerze_DB_Schrift_BC;
							3: switch_spritestack_Schuerze_DB_Schrift_C;											
								 switch_spritestack_Schuerze_DB_Schrift_C;}
																					
						switch (FEAT_TRAINS, SELF, random_choose_Schuerze_DB_blau, switch_alternative_var_random_bits(1, 2)) {
							1: switch_spritestack_Schuerze_DB_blau_B;
							2: switch_spritestack_Schuerze_DB_blau_BC;
							3: switch_spritestack_Schuerze_DB_blau_C;											
								 switch_spritestack_Schuerze_DB_blau_C;}
																					
						switch (FEAT_TRAINS, SELF, random_choose_Schuerze_DB_gruen, switch_alternative_var_random_bits(1, 2)) {
							1: switch_spritestack_Schuerze_DB_gruen_B;
							2: switch_spritestack_Schuerze_DB_gruen_BC;
							3: switch_spritestack_Schuerze_DB_gruen_C;											
								 switch_spritestack_Schuerze_DB_gruen_C;}								 								 
								 
						switch (FEAT_TRAINS,SELF, switch_Schuerze_current_year,current_year){
							   0 .. 1945: random_choose_Schuerze_DRG;
							1946 .. 2050: random_choose_Schuerze_DB_gruen;						
										random_choose_Schuerze_DB_gruen;}	
										
						switch (FEAT_TRAINS,SELF, switch_Schuerze_build_year,build_year){
							   0 .. 1945: random_choose_Schuerze_DRG;
							1946 .. 2050: random_choose_Schuerze_DB_gruen;						
										random_choose_Schuerze_DB_gruen;}													
					
						switch(FEAT_TRAINS, SELF, switch_length_Schuerze, position_in_vehid_chain % 3) {
							0: 4;
							1: 5;
							2: 4;}
							
						switch (FEAT_TRAINS, PARENT, switch_running_cost_Schuerze,  switch_check_Restaurant_0()) {
							1: return 0;
							0: return 2050;}	
							
						switch (FEAT_TRAINS, PARENT, switch_cargo_aging_Schuerze,  switch_check_Restaurant_0()) {
							1: return 233;
							0: return 185;}							
							
						switch(FEAT_TRAINS, SELF, switch_Schuerze_graphics_build, position_in_vehid_chain  % 3) {
							0:     spriteset_empty;
							1:     return switch_Schuerze_build_year;
							2:     spriteset_empty;}	

						switch (FEAT_TRAINS, SELF, switch_articulated_Schuerze_build, extra_callback_info1) {
							1 ..2 : return ITEM_SCHUERZE_BUILD;													
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}
																			
item (FEAT_TRAINS , ITEM_SCHUERZE_BUILD, 7630)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_SCHUERZE_BUILD);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1939,01,01);
						model_life: 					45;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes:		bitmask(CC_PASSENGERS);
						cargo_allow_refit:				[PASS, TOUR];
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);
						loading_speed:					9;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							180 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						40 ton;
						dual_headed: 					0;
						default_cargo_type:				PASS;
						cargo_capacity:					19;
						ai_engine_rank: 				0;
						length: 						8;												
			}
			
	//Vehicels Graphics
			graphics
			{
			default							: switch_Schuerze_graphics_build;
			additional_text					: string(STR_DESC_EXPRESS);
			length							: switch_length_Schuerze;
			articulated_part				: switch_articulated_Schuerze_build;
