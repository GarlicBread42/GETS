									{ template_purchase(0, 0)}
				
	alternative_sprites (spriteset_BR_54_8_purchase2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BR_54_8/BR_54_8_DRG_1x_32bpp.png", "gfx/BR_54_8/BR_54_8_DRG_1x_mask.png")
									{ template_purchase(0, 0)}
	
spriteset(spriteset_BR_54_8_purchase_anim, "gfx/BR_54_8/BR_54_8_anim1_1x_8bpp.png")
									{ template_purchase(0, 0)}
				
	alternative_sprites (spriteset_BR_54_8_purchase_anim, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BR_54_8/BR_54_8_anim1_1x_32bpp.png", "gfx/BR_54_8/BR_54_8_anim1_1x_mask.png")
									{ template_purchase(0, 0)}
																		
//Switches

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_54_8_purchase1, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_54_8_purchase1;
							1: spriteset_BR_54_8_purchase_anim;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_54_8_purchase2, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_54_8_purchase2;
							1: spriteset_BR_54_8_purchase_anim;}													

						switch (FEAT_TRAINS,SELF, switch_BR_54_8_purchase,current_year){
							  00 .. 1919: switch_spritestack_BR_54_8_purchase1;
							1920 .. 2050: switch_spritestack_BR_54_8_purchase2;
							switch_spritestack_BR_54_8_purchase2;}

						switch (FEAT_TRAINS, SELF, switch_animation_BR_54_8, motion_counter % 4) {
							0: spriteset_BR_54_8_anim1;
							1: spriteset_BR_54_8_anim2;
							2: spriteset_BR_54_8_anim3;
							3: spriteset_BR_54_8_anim4;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_54_8_KPEV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_54_8_KPEV;
							1: return switch_animation_BR_54_8;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_54_8_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_54_8_DRG;
							1: return switch_animation_BR_54_8;}														
							
						switch (FEAT_TRAINS,SELF, switch_BR_54_8_current_year,current_year){
							   00 .. 1919: switch_spritestack_BR_54_8_KPEV;
							 1920 .. 2050: switch_spritestack_BR_54_8_DRG; 						 					 
							 switch_spritestack_BR_54_8_DRG;}
							 
						switch (FEAT_TRAINS,SELF, switch_BR_54_8_build_year,build_year){
							   00 .. 1919: switch_spritestack_BR_54_8_KPEV;
							 1920 .. 2050: switch_spritestack_BR_54_8_DRG; 						 					 
							 switch_spritestack_BR_54_8_DRG;}	
							 
						switch (FEAT_TRAINS,SELF, switch_BR_54_8_Tender_current_year,current_year){
							   00 .. 1919: spriteset_Tender_PR3T12_KPEV;
							 1920 .. 2050: spriteset_Tender_PR3T12_DRG;				 					 
							 spriteset_Tender_PR3T12_DRG;}
							 
						switch (FEAT_TRAINS,SELF, switch_BR_54_8_Tender_build_year,build_year){
							   00 .. 1919: spriteset_Tender_PR3T12_KPEV;
							 1920 .. 2050: spriteset_Tender_PR3T12_DRG;				 					 
							 spriteset_Tender_PR3T12_DRG;}

						switch(FEAT_TRAINS, SELF, switch_length_BR_54_8, position_in_vehid_chain % 2) {
							0: 6;
							1: 4;}
							
						switch(FEAT_TRAINS, SELF, switch_FX_BR_54_8, position_in_vehid_chain % 2) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_STEAM, -4, DISABLE_WAGON_POWER);
							return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}
													
						switch (FEAT_TRAINS, PARENT, switch_running_cost_BR_54_8, 1) {
							return 725;}																									 						 

						switch(FEAT_TRAINS, SELF, switch_BR_54_8_graphics_build, position_in_vehid_chain % 2) {
							0:	   return switch_BR_54_8_build_year;
							1:     return switch_BR_54_8_Tender_build_year;}
							
						switch (FEAT_TRAINS, SELF, switch_articulated_BR_54_8_build, extra_callback_info1) {
							1: return ITEM_BR_54_8; 
							return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}								
							
