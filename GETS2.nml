					{template_purchase(0, 0)}		
				
		alternative_sprites (spriteset_Om_Ludwigshafen_1909_purchase_DRG, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\Om_Ludwigshafen_1909/Om_Ludwigshafen_1909_DRG_1x_32bpp.png", "gfx\Om_Ludwigshafen_1909/Om_Ludwigshafen_1909_DRG_1x_mask.png")
					{template_purchase(0, 0)}		

//Switches

					switch (FEAT_TRAINS,SELF, switch_Om_Ludwigshafen_1909_purchase,current_year){
						1800 .. 1919: spriteset_Om_Ludwigshafen_1909_purchase_KPEV;
						1920 .. 2050: spriteset_Om_Ludwigshafen_1909_purchase_DRG;			 					 
							spriteset_Om_Ludwigshafen_1909_purchase_DRG;}

					switch(FEAT_TRAINS, SELF, switch_loadstack_Om_Ludwigshafen_1909_KPEV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_Om_Ludwigshafen_1909_KPEV;
						1: spritegroup_Om_Ludwigshafen_1909_load;}

					switch(FEAT_TRAINS, SELF, switch_loadstack_Om_Ludwigshafen_1909_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_Om_Ludwigshafen_1909_DRG;
						1: spritegroup_Om_Ludwigshafen_1909_load;}																				

					switch (FEAT_TRAINS,SELF, switch_Om_Ludwigshafen_1909_current_year,current_year){
