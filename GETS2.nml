						speed: 							50 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						9 ton;
						dual_headed: 					0;
						default_cargo_type:				WOOD;
						cargo_capacity:					10;
						ai_engine_rank: 				0;
						length: 						8;
												
			}
			
	//Vehicels Graphics
			graphics
			{
			default							: switch_Rw_Stuttgart_cargo_type;
			additional_text					: string(STR_DESC_GOODS);
			purchase						: switch_Rw_Stuttgart_purchase;
