		alternative_sprites (spriteset_Fads176_purchase2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\Fads176/Fads176_late_1x_32bpp.png", "gfx\Fads176/Fads176_late_1x_mask.png")
