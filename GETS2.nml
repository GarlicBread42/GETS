//Switches

					switch (FEAT_TRAINS, SELF, random_choose_Uerdingen_4_CHEM, switch_alternative_var_random_bits(1, 3)) {
							1: spriteset_Uerdingen_4_GREEN;
							2: spriteset_Uerdingen_4_NEUT_MBH;
							3: spriteset_Uerdingen_4_NEUT_OBH;
