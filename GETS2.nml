item (FEAT_TRAINS , ITEM_BR_622_VERKEHRSROT, 6220)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_BR_622_VERKEHRSROT);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(2014,01,01);
						model_life: 					VEHICLE_NEVER_EXPIRES;
						vehicle_life: 					40;
						retire_early: 					-10;							
						reliability_decay: 				20;
						misc_flags						: bitmask(TRAIN_FLAG_SPRITE_STACK);	
						cargo_allow_refit:              [PASS, TOUR];
						cargo_capacity:                 30 ;
						loading_speed:					6;
						cost_factor: 					112;
						running_cost_base:				RUNNING_COST_STEAM;						
						running_cost_factor: 			89;	
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							140 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;	
						power:  						1590 hp;
						weight: 						98 ton;
						ai_engine_rank: 				0;
						engine_class: 					ENGINE_CLASS_DIESEL;
						visual_effect_and_powered: 		visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 2, DISABLE_WAGON_POWER);
						dual_headed: 					0;
						tractive_effort_coefficient: 	0.16;
						length: 						8;						
			}
		//Vehicels Graphics
			graphics
			{
			default							: switch_BR_622_verkehrsrot_graphics;
			additional_text					: string(STR_CONCAT_2, 
											  string(STR_TRACTION_DMU), 
											  string(STR_DESC_PASS),);
			length							: switch_BR_622_length;	
			articulated_part				: switch_articulated_BR_622_verkehrsrot;
			visual_effect_and_powered		: switch_BR_622_FX;
			purchase						: spriteset_BR_622_verkehrsrot_purchase;
			running_cost_factor				: switch_running_cost_BR_622_verkehrsrot;		
			}
	}

//Switches for Vareo

	switch(FEAT_TRAINS,PARENT,switch_running_cost_BR_622_Vareo, 1){
		return 1500;}								

	switch(FEAT_TRAINS, SELF, switch_BR_622_Vareo, position_in_vehid_chain % 6) {
