//Switches

						switch (FEAT_TRAINS,SELF, switch_Pw4ue_30_purchase,current_year){
							1900 .. 1945: spriteset_Pw4ue_30_purchase1;
							1946 .. 2000: spriteset_Pw4ue_30_purchase2;						
										spriteset_Pw4ue_30_purchase2;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_Pw4ue_30_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_Pw4ue_30_DRG;
							1: spritegroup_Pw4ue_30_loading_DRG;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_Pw4ue_30_DB, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_Pw4ue_30_DB;
							1: spritegroup_Pw4ue_30_loading_DB;}																																										

						switch (FEAT_TRAINS,SELF, switch_Pw4ue_30_current_year,current_year){
