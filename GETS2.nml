							0: spriteset_BR_58_2_purchase1;
							1: spriteset_BR_58_2_purchase_anim;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_58_2_purchase2, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_58_2_purchase2;
							1: spriteset_BR_58_2_purchase_anim;}							

