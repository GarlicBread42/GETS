						switch(FEAT_TRAINS,PARENT,switch_running_cost_BR_628_2, 1){
							return 1350;}						 																												

						switch(FEAT_TRAINS, SELF, switch_BR_628_2_graphics_build, position_in_vehid_chain % 6) {
							0: spriteset_empty;
							1: switch_BR_628_2_front_build_year;
							2: spriteset_empty;
							3: spriteset_empty;
							4: switch_BR_628_2_back_build_year;
							5: spriteset_empty;}

						switch (FEAT_TRAINS, SELF, switch_articulated_BR_628_2_build, extra_callback_info1) {
							1 .. 5: return ITEM_BR_628_2_BUILD; 
							return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}
														
item (FEAT_TRAINS , ITEM_BR_628_2_BUILD, 6285)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_BR_628_2_BUILD);
