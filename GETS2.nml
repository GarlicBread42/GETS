							5:     spriteset_empty;
							6:	   spriteset_empty;
							7:     return switch_spritestack_BR_462_middle_Regio;
							8:     spriteset_empty;														
							9:	   spriteset_empty;
						   10:     return switch_spritestack_BR_462_back_Regio;
						   11:     spriteset_empty;}						
							
						switch (FEAT_TRAINS, SELF, switch_articulated_BR_462_4_Regio, extra_callback_info1) {
