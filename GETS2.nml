		0: return switch_Ommru_Villach_MBH_current_year;
		1: spritegroup_Oc_Muenster_MBH_load_COPR;}						
		
	switch(FEAT_TRAINS, SELF, switch_loadstack_Ommru_Villach_MBH_Rohr, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: return switch_Ommru_Villach_MBH_current_year;
		1: spritegroup_Oc_Muenster_MBH_load_Rohr;}						
		
	switch(FEAT_TRAINS, SELF, switch_loadstack_Ommru_Villach_MBH_Timber, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
