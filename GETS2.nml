									{ template_purchase(0, 0)}
				
alternative_sprites (spriteset_BR_54_13_purchase1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BR_54_13/BR_54_13_BAY_1x_32bpp.png", "gfx/BR_54_13/BR_54_13_BAY_1x_mask.png")
									{ template_purchase(0, 0)}

spriteset(spriteset_BR_54_13_purchase2, "gfx/BR_54_13/BR_54_13_DRG_1x_8bpp.png")
									{ template_purchase(0, 0)}
				
alternative_sprites (spriteset_BR_54_13_purchase2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BR_54_13/BR_54_13_DRG_1x_32bpp.png", "gfx/BR_54_13/BR_54_13_DRG_1x_mask.png")
									{ template_purchase(0, 0)}

spriteset(spriteset_BR_54_13_purchase_BAY_anim, "gfx/BR_54_13/BR_54_13_BAY_anim1_1x_8bpp.png")
									{ template_purchase(0, 0)}
				
	alternative_sprites (spriteset_BR_54_13_purchase_BAY_anim, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BR_54_13/BR_54_13_BAY_anim1_1x_32bpp.png", "gfx/BR_54_13/BR_54_13_BAY_anim1_1x_mask.png")
									{ template_purchase(0, 0)}
									
spriteset(spriteset_BR_54_13_purchase_DRG_anim, "gfx/BR_54_13/BR_54_13_DRG_anim1_1x_8bpp.png")
									{ template_purchase(0, 0)}
				
	alternative_sprites (spriteset_BR_54_13_purchase_DRG_anim, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BR_54_13/BR_54_13_DRG_anim1_1x_32bpp.png", "gfx/BR_54_13/BR_54_13_DRG_anim1_1x_mask.png")
									{ template_purchase(0, 0)}									
									
//Switches
						switch (FEAT_TRAINS, SELF, switch_animation_BR_54_13_BAY, motion_counter % 4) {
							0: spriteset_BR_54_13_BAY_anim1;
							1: spriteset_BR_54_13_BAY_anim2;
							2: spriteset_BR_54_13_BAY_anim3;
							3: spriteset_BR_54_13_BAY_anim4;}
							
						switch (FEAT_TRAINS, SELF, switch_animation_BR_54_13_DRG, motion_counter % 4) {
							0: spriteset_BR_54_13_DRG_anim1;
							1: spriteset_BR_54_13_DRG_anim2;
							2: spriteset_BR_54_13_DRG_anim3;
							3: spriteset_BR_54_13_DRG_anim4;}							

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_54_13_purchase1, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_54_13_purchase1;
							1: spriteset_BR_54_13_purchase_BAY_anim;}	
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_54_13_purchase2, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_54_13_purchase2;
							1: spriteset_BR_54_13_purchase_DRG_anim;}							

						switch (FEAT_TRAINS,SELF, switch_BR_54_13_purchase,current_year){
							  00 .. 1919: switch_spritestack_BR_54_13_purchase1;
							1920 .. 2000: switch_spritestack_BR_54_13_purchase2;
							switch_spritestack_BR_54_13_purchase2;}							

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_54_13_BAY, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_54_13_BAY;
							1: return switch_animation_BR_54_13_BAY;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_54_13_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_54_13_DRG;
							1: return switch_animation_BR_54_13_DRG;}																														

						switch (FEAT_TRAINS,SELF, switch_BR_54_13_current_year,current_year){
							 1800 .. 1919: switch_spritestack_BR_54_13_BAY;
							 1920 .. 2000: switch_spritestack_BR_54_13_DRG;					 					 
							 switch_spritestack_BR_54_13_DRG;}							

						switch (FEAT_TRAINS,SELF, switch_BR_54_13_build_year,build_year){
							 1800 .. 1919: switch_spritestack_BR_54_13_BAY;
							 1920 .. 2000: switch_spritestack_BR_54_13_DRG;					 					 
							 switch_spritestack_BR_54_13_DRG;}															

						switch (FEAT_TRAINS,SELF, switch_BR_54_13_tender_current_year,current_year){
							   00 .. 1919: spriteset_Tender_BAY_22T18_BAY;
							 1920 .. 2000: spriteset_Tender_BAY_22T18_DRG;					 					 
							 spriteset_Tender_BAY_22T18_DRG;}	
							 
						switch (FEAT_TRAINS,SELF, switch_BR_54_13_tender_build_year,build_year){
							   00 .. 1919: spriteset_Tender_BAY_22T18_BAY;
							 1920 .. 2000: spriteset_Tender_BAY_22T18_DRG;					 					 
							 spriteset_Tender_BAY_22T18_DRG;}															

						switch(FEAT_TRAINS, SELF, switch_length_BR_54_13, position_in_vehid_chain % 2) {
							0: 6;
							1: 5;}
							
						switch(FEAT_TRAINS, SELF, switch_FX_BR_54_13, position_in_vehid_chain % 2) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_STEAM, -2, DISABLE_WAGON_POWER);
							return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}
						
						switch (FEAT_TRAINS, PARENT, switch_running_cost_BR_54_13, 1) {
							return 1000;}
							
							
						switch(FEAT_TRAINS, SELF, switch_BR_54_13_graphics_build, position_in_vehid_chain % 2) {
							0:	   switch_BR_54_13_build_year;
							1:     switch_BR_54_13_tender_build_year;}
														
						switch (FEAT_TRAINS, SELF, switch_articulated_BR_54_13_build, extra_callback_info1) {
							1: return ITEM_BR_54_13; 
							return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}
							
item (FEAT_TRAINS , ITEM_BR_54_13, 0540)
		{
	//property Block
