    switch(FEAT_TRAINS, SELF, switch_spritestack_X_Wagen_B_Nuernberg, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_X_Wagen_B_Nuernberg;
        1: spritegroup_X_Wagen_B_verkehrsrot_loading;}           

    switch(FEAT_TRAINS, SELF, switch_spritestack_X_Wagen_AB_Nuernberg, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_X_Wagen_AB_Nuernberg;
        1: spritegroup_X_Wagen_B_verkehrsrot_loading;}   

    switch (FEAT_TRAINS, SELF, random_choose_X_Wagen_orange, switch_alternative_var_random_bits(1, 2)) {
        1: switch_spritestack_X_Wagen_B_orange;
        2: switch_spritestack_X_Wagen_B_orange;
        3: switch_spritestack_X_Wagen_B_orange;
            switch_spritestack_X_Wagen_AB_orange;}                

    switch (FEAT_TRAINS, SELF, random_choose_X_Wagen_sbahn, switch_alternative_var_random_bits(1, 2)) {
        1: switch_spritestack_X_Wagen_B_sbahn;
