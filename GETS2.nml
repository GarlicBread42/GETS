		alternative_sprites (spriteset_K15_Elberfeld_OBH_open_DB, ZOOM_LEVEL_IN_2X, BIT_DEPTH_32BPP, "gfx\K15_Elberfeld/K15_Elberfeld_OBH_open_DB_2x_32bpp.png", "gfx\K15_Elberfeld/K15_Elberfeld_OBH_open_DB_2x_mask.png")
					{template_48trains_2x(0, 0)}					
