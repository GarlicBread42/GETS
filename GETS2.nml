							FOOD: random_choose_KW_Berlin_neutral;
							FRUT: random_choose_KW_Berlin_neutral; 
							BEER: random_choose_KW_Berlin_Bier;
							FISH: random_choose_KW_Berlin_Seefisch;
							MILK: random_choose_KW_Berlin_neutral; 
							CHSE: random_choose_KW_Berlin_neutral;
							FRVG: random_choose_KW_Berlin_neutral;
							MEAT: random_choose_KW_Berlin_neutral;
							OYST: random_choose_KW_Berlin_Seefisch;
							TATO: random_choose_KW_Berlin_neutral;
							SWET: random_choose_KW_Berlin_neutral;
							TOFF: random_choose_KW_Berlin_neutral;}

					switch(FEAT_TRAINS,PARENT,switch_running_cost_KW_BERLIN, 1){
						return 62;}						
						
item (FEAT_TRAINS , ITEM_KW_BERLIN, 8400)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_KW_BERLIN);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1892,01,01);
						model_life: 					65;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						cargo_allow_refit:              [FOOD, FRUT, BEER, FISH, MILK, CHSE, FRVG, MEAT, OYST, TATO, SWET, TOFF,];
						loading_speed:					6;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							65 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						16 ton;
						dual_headed: 					0;
						default_cargo_type:				FOOD;
						cargo_capacity:					10;
						ai_engine_rank: 				0;
						length: 						6;
												
			}
			
	//Vehicels Graphics
			graphics
			{
			default							: switch_KW_Berlin_sprite_choose;
			additional_text					: string(STR_DESC_GOODS);
			purchase						: spriteset_KW_Berlin_purchase;
			cost_factor						: 30;
			running_cost_factor				: switch_running_cost_KW_BERLIN;				
			
			 }
		}

