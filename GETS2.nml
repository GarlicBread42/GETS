							switch_spritestack_BR_37_purchase2;}

						switch (FEAT_TRAINS, SELF, switch_animation_BR_37, motion_counter % 4) {
							0: spriteset_BR_37_anim1;
							1: spriteset_BR_37_anim2;
							2: spriteset_BR_37_anim3;
							3: spriteset_BR_37_anim4;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_37_KPEV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_37_KPEV;
							1: return switch_animation_BR_37;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_37_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_37_DRG;
							1: return switch_animation_BR_37;}														
							
						switch (FEAT_TRAINS,SELF, switch_BR_37_current_year,current_year){
							   00 .. 1919: switch_spritestack_BR_37_KPEV;
							 1920 .. 2050: switch_spritestack_BR_37_DRG; 						 					 
							 switch_spritestack_BR_37_DRG;}
							 
						switch (FEAT_TRAINS,SELF, switch_BR_37_build_year,build_year){
							   00 .. 1919: switch_spritestack_BR_37_KPEV;
							 1920 .. 2050: switch_spritestack_BR_37_DRG; 						 					 
							 switch_spritestack_BR_37_DRG;}	
							 
						switch (FEAT_TRAINS,SELF, switch_BR_37_Tender_current_year,current_year){
								  00 .. 1919: spriteset_Tender_22T16_KPEV;
								1920 .. 1950: spriteset_Tender_22T16_DRG;
									spriteset_Tender_22T16_DRG;}
							 
						switch (FEAT_TRAINS,SELF, switch_BR_37_Tender_build_year,build_year){
								   0 .. 1919: spriteset_Tender_22T16_KPEV;
								1920 .. 1950: spriteset_Tender_22T16_DRG;
									spriteset_Tender_22T16_DRG;}

						switch(FEAT_TRAINS, SELF, switch_length_BR_37, position_in_vehid_chain % 2) {
							0: 7;
							1: 5;}
							
						switch(FEAT_TRAINS, SELF, switch_FX_BR_37, position_in_vehid_chain % 2) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_STEAM, -4, DISABLE_WAGON_POWER);
							return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}
													
						switch (FEAT_TRAINS, PARENT, switch_running_cost_BR_37, 1) {
							return 1700;}																									 						 

						switch(FEAT_TRAINS, SELF, switch_BR_37_graphics_build, position_in_vehid_chain % 2) {
							0:	   return switch_BR_37_build_year;
							1:     return switch_BR_37_Tender_build_year;}
							
						switch (FEAT_TRAINS, SELF, switch_articulated_BR_37_build, extra_callback_info1) {
							1: return ITEM_BR_37; 
							return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}								
							
