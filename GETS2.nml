//Spritesets purchase

spriteset (spriteset_G02_purchase_1, "gfx\G02/G02_KPEV_MBH_1x_8bpp.png")
					{template_purchase(0, 0)}	
				
		alternative_sprites (spriteset_G02_purchase_1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\G02/G02_KPEV_MBH_1x_32bpp.png", "gfx\G02/G02_KPEV_MBH_1x_mask.png")
					{template_purchase(0, 0)}				
					
spriteset (spriteset_G02_purchase_2, "gfx\G02/G02_DRG_MBH1_1x_8bpp.png")
					{template_purchase(0, 0)}		
				
		alternative_sprites (spriteset_G02_purchase_2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\G02/G02_DRG_MBH1_1x_32bpp.png", "gfx\G02/G02_DRG_MBH1_1x_mask.png")
					{template_purchase(0, 0)}	

spriteset (spriteset_G02_purchase_3, "gfx\G02/G02_BAY_MBH1_1x_8bpp.png")
					{template_purchase(0, 0)}	
				
		alternative_sprites (spriteset_G02_purchase_3, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\G02/G02_BAY_MBH1_1x_32bpp.png", "gfx\G02/G02_BAY_MBH1_1x_mask.png")
					{template_purchase(0, 0)}					

//Switches

					 switch (FEAT_TRAINS,SELF, switch_G02_purchase,current_year){
							1880 .. 1919: spriteset_G02_purchase_1;
							1920 .. 1990: spriteset_G02_purchase_2;				 					 
							spriteset_G02_purchase_1;}
						 
					switch (FEAT_TRAINS, SELF, random_choose_G02_KPEV, switch_alternative_var_random_bits(2, 2)) {
							1: spritegroup_G02_KPEV_MBH;
							2: spritegroup_G02_KPEV_MBH;
							3: spritegroup_G02_KPEV_OBH1;
								spritegroup_G02_KPEV_OBH2;}		
								
					switch (FEAT_TRAINS, SELF, random_choose_G02_BAY, switch_alternative_var_random_bits(2, 2)) {
							1: spritegroup_G02_BAY_OBH1;
							2: spritegroup_G02_BAY_MBH1;
							3: spritegroup_G02_BAY_OBH1;
								spritegroup_G02_BAY_MBH2;}	
								
					switch (FEAT_TRAINS, SELF, random_choose_G02_DRG, switch_alternative_var_random_bits(3, 3)) {
							1: spritegroup_G02_DRG_MBH1;
							2: spritegroup_G02_DRG_MBH2;
							3: spritegroup_G02_DRG_MBH1;
							4: spritegroup_G02_DRG_MBH3;
							5: spritegroup_G02_DRG_OBH1;
							6: spritegroup_G02_DRG_OBH2;
							7: spritegroup_G02_DRG_OBH1;
								spritegroup_G02_DRG_OBH1;}	
					
					//Switch checks for Bavarian/Wurttemberg locos - if not found, KPEV-variations will be triggered)							
					switch (FEAT_TRAINS,PARENT,switch_G02_check_BAYKWSE, switch_check_BAY_0()) {
							0: random_choose_G02_KPEV; 
								random_choose_G02_BAY;}
								
					switch (FEAT_TRAINS,SELF,switch_graphics_G02,current_year) {
						1880 .. 1919 : switch_G02_check_BAYKWSE;
						1920 .. 1955 : random_choose_G02_DRG;
						random_choose_G02_DRG;}
																																											 
					switch (FEAT_TRAINS, PARENT, switch_speed_G02,  switch_check_PWG_0()) {
						1: return 65;
						0: return 50;}
						
					switch(FEAT_TRAINS,PARENT,switch_running_cost_G02, 1){
						return 75;}						
						
item (FEAT_TRAINS , ITEM_G02, 8250)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_G02);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1892,01,01);
						model_life: 					71;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes:		bitmask(CC_PIECE_GOODS);
						cargo_allow_refit:              [MAIL,GOOD,VALU,PAPR,DIAM,BDMT,BEER,BOOM,BRCK,CERA,CERE,DYES,ENSP,FERT,FICR,FMSP,GLAS,JAVA,PLAS,TYRE,WDPR,WOOL,ZINC,ALUM,BAKE,CIGR,COAT,COBL,FURN,METL,MNSP,MPTS,NUTS,PCL_,PIPE,SEED,SESP,SOAP,STAL,STCB,STSE,STSH,STST,STWR,TATO,VENG,VPTS,BATT,BUBL,FZDR,TOYS,];
						loading_speed:					6;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							50 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						10 ton;
						dual_headed: 					0;
						default_cargo_type:				GOOD;
						cargo_capacity:					30;
						ai_engine_rank: 				0;
						length: 						6;
												
			}
			
	//Vehicels Graphics
			graphics
			{
			default							: switch_graphics_G02;
			additional_text					: string(STR_DESC_CABOOSE_65);
			purchase						: switch_G02_purchase;
			speed							: switch_speed_G02;
			cost_factor						: 34;
			running_cost_factor				: switch_running_cost_G02;				
			
			 }
		}
		
