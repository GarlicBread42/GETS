							PAPR: return switch_loadstack_Rnsz_643_Box;							
							
								switch_Rnsz_643_cargo_classes;}	
								
						switch(FEAT_TRAINS, SELF, switch_Rnsz_643_graphics, position_in_articulated_veh % 3) {
							0:	   spriteset_empty;
							1:     return switch_Rnsz_643_cargo_type;
							2:	   spriteset_empty;}

						switch(FEAT_TRAINS, SELF, switch_length_Rnsz_643, position_in_vehid_chain % 3) {
							0: 4;
							1: 6;
							2: 4;}													
						 		 
						switch (FEAT_TRAINS, SELF, switch_articulated_Rnsz_643, extra_callback_info1) {
							1 .. 2: return ITEM_RNSZ_643;
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}																																																																												

						switch(FEAT_TRAINS,PARENT,switch_running_cost_Rnsz_643, 1){
							return 500;}	
							
item (FEAT_TRAINS , ITEM_RNSZ_643, 8953)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_RNSZ_643);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1998,01,01);
						model_life: 					VEHICLE_NEVER_EXPIRES;
						vehicle_life: 					50;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes: 		bitmask(CC_PIECE_GOODS );
						cargo_allow_refit:              [STAL, ALUM, STCB, STST, STSH, POWR, VENG, VPTS, GOOD, GLAS, ENSP, FMSP, STWR, STEL, STSE, PIPE, BDMT, WDPR, WOOD, MNSP, MPTS, PAPR,];
						cargo_disallow_refit: 			[LVST, FOOD, WATR, BEER, BOOM, FISH, IRON, EOIL, FERT, FICR, FRVG, FRUT, VEHI];
						misc_flags: 					bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_SPRITE_STACK);
						loading_speed:					5;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							120 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						24 ton;
						dual_headed: 					0;
						default_cargo_type:				WOOD;
						cargo_capacity:					22;
						ai_engine_rank: 				0;
						length: 						8;
												
			}
			
	//Vehicels Graphics
			graphics
			{
			default							: switch_Rnsz_643_graphics;
			additional_text					: string(STR_DESC_GOODS);
			articulated_part			  	: switch_articulated_Rnsz_643;
			length							: switch_length_Rnsz_643;
			purchase						: spriteset_Rnsz_643_purchase;
			cost_factor						: 195;
			running_cost_factor				: switch_running_cost_Rnsz_643;
			colour_mapping					: switch_generic_recolour;
			 }
		}																												
																
