							0: spriteset_BR_55_0_DB_purchase;
							1: spriteset_BR_55_0_purchase_anim;}														

						switch (FEAT_TRAINS,SELF, switch_BR_55_0_purchase,current_year){
							  00 .. 1919: switch_spritestack_BR_55_0_KPEV_purchase;
							1920 .. 1945: switch_spritestack_BR_55_0_DRG_purchase;
							1946 .. 1990: switch_spritestack_BR_55_0_DB_purchase;	
							switch_spritestack_BR_55_0_DB_purchase;}

						switch (FEAT_TRAINS, SELF, switch_animation_BR_55_0, motion_counter % 4) {
							0: spriteset_BR_55_0_anim1;
							1: spriteset_BR_55_0_anim2;
							2: spriteset_BR_55_0_anim3;
							3: spriteset_BR_55_0_anim4;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_55_0_KPEV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_55_0_KPEV;
							1: return switch_animation_BR_55_0;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_55_0_KPEV_Brotan, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_55_0_KPEV_Brotan;
							1: return switch_animation_BR_55_0;}
														
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_55_0_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_55_0_DRG;
							1: return switch_animation_BR_55_0;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_55_0_DB, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_55_0_DB;
							1: return switch_animation_BR_55_0;}														
							
						switch (FEAT_TRAINS,SELF, switch_BR_55_0_current_year,current_year){
							   00 .. 1919: switch_spritestack_BR_55_0_KPEV;
							 1920 .. 1945: switch_spritestack_BR_55_0_DRG;
							 1946 .. 1990: switch_spritestack_BR_55_0_DB; 						 					 
							 switch_spritestack_BR_55_0_DB;}
							 
						switch (FEAT_TRAINS,SELF, switch_BR_55_0_build_year,build_year){
							   00 .. 1919: switch_spritestack_BR_55_0_KPEV;
							 1920 .. 1945: switch_spritestack_BR_55_0_DRG;
							 1946 .. 1990: switch_spritestack_BR_55_0_DB; 						 					 
							 switch_spritestack_BR_55_0_DB;}	
							 
						switch (FEAT_TRAINS,SELF, switch_BR_55_0_Tender_current_year,current_year){
							   00 .. 1919: spriteset_Tender_3T16_5_KPEV;
							 1920 .. 1945: spriteset_Tender_3T16_5_DRG;
							 1946 .. 1990: spriteset_Tender_3T16_5_DB; 						 					 
							 spriteset_Tender_3T16_5_DB;}
							 
						switch (FEAT_TRAINS,SELF, switch_BR_55_0_Tender_build_year,build_year){
							   00 .. 1919: spriteset_Tender_3T16_5_KPEV;
							 1920 .. 1945: spriteset_Tender_3T16_5_DRG;
							 1946 .. 1990: spriteset_Tender_3T16_5_DB; 						 					 
							 spriteset_Tender_3T16_5_DB;}

						switch(FEAT_TRAINS, SELF, switch_length_BR_55_0, position_in_vehid_chain % 2) {
							0: 7;
							1: 4;}
							
						switch(FEAT_TRAINS, SELF, switch_FX_BR_55_0, position_in_vehid_chain % 2) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_STEAM, -2, DISABLE_WAGON_POWER);
							return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}
													
						switch (FEAT_TRAINS, PARENT, switch_running_cost_BR_55_0, 1) {
							return 675;}																									 						 
													
						switch (FEAT_TRAINS, PARENT, switch_running_cost_BR_55_0_KPEV_Brotan, 1) {
							return 560;}
							
						switch(FEAT_TRAINS, SELF, switch_BR_55_0_graphics_build, position_in_vehid_chain % 2) {
							0:	   return switch_BR_55_0_build_year;
							1:     return switch_BR_55_0_Tender_build_year;}
							
						switch (FEAT_TRAINS, SELF, switch_articulated_BR_55_0_build, extra_callback_info1) {
							1: return ITEM_BR_55_0; 
							return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}								
							
item (FEAT_TRAINS , ITEM_BR_55_0, 0556)
