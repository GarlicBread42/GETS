//Spritegroups

spritegroup spritegroup_HWZ_Front_loading
		{loaded: 	[spriteset_empty];
			loading: 	[spriteset_HWZ_Front_loading];}

spritegroup spritegroup_HWZ_Middle_loading
		{loaded: 	[spriteset_empty];
			loading: 	[spriteset_HWZ_Middle_loading];}
			
spritegroup spritegroup_HWZ_Back_loading_DRG
		{loaded: 	[spriteset_empty];
			loading: 	[spriteset_HWZ_Back_loading_DRG];}
			
spritegroup spritegroup_HWZ_Back_loading_DB
		{loaded: 	[spriteset_empty];
			loading: 	[spriteset_HWZ_Back_loading_DB];}						

//Spriteset purchase

spriteset (spriteset_HWZ_purchase1, "gfx/HWZ/HWZ_Front_DRG_1x_8bpp.png")
					{template_purchase(0, 0)}	
				
		alternative_sprites (spriteset_HWZ_purchase1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/HWZ/HWZ_Front_DRG_1x_32bpp.png", "gfx/HWZ/HWZ_Front_DRG_1x_mask.png")
					{template_purchase(0,0)}				

spriteset (spriteset_HWZ_purchase2, "gfx/HWZ/HWZ_Front_DB_1x_8bpp.png")
					{template_purchase(0, 0)}	
				
		alternative_sprites (spriteset_HWZ_purchase2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/HWZ/HWZ_Front_DB_1x_32bpp.png", "gfx/HWZ/HWZ_Front_DB_1x_mask.png")
					{template_purchase(0,0)}							

//Switches

						switch (FEAT_TRAINS,SELF,switch_purchase_HWZ,current_year) {
							   0 .. 1945 : spriteset_HWZ_purchase1;
							1946 .. 2050 : spriteset_HWZ_purchase2;							
								spriteset_HWZ_purchase2;}	

						switch(FEAT_TRAINS, SELF, switch_spritestack_HWZ_Front_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_HWZ_Front_DRG;
							1: spritegroup_HWZ_Front_loading;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_HWZ_Front_DB, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_HWZ_Front_DB;
							1: spritegroup_HWZ_Front_loading;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_HWZ_Middle_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_HWZ_Middle_DRG;
							1: spritegroup_HWZ_Middle_loading;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_HWZ_Middle_DB, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_HWZ_Middle_DB;
							1: spritegroup_HWZ_Middle_loading;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_HWZ_Back_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_HWZ_Back_DRG;
							1: spritegroup_HWZ_Back_loading_DRG;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_HWZ_Back_DB, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_HWZ_Back_DB;
							1: spritegroup_HWZ_Back_loading_DB;}							

						switch (FEAT_TRAINS,SELF,switch_build_year_HWZ_Front,build_year) {
							   0 .. 1932 : switch_spritestack_HWZ_Front_DRG;
							1946 .. 2050 : switch_spritestack_HWZ_Front_DB;
								switch_spritestack_HWZ_Front_DB;}
								
						switch (FEAT_TRAINS,SELF,switch_current_year_HWZ_Front,current_year) {
							   0 .. 1932 : switch_spritestack_HWZ_Front_DRG;
							1946 .. 2050 : switch_spritestack_HWZ_Front_DB;
								switch_spritestack_HWZ_Front_DB;}								
								
						switch (FEAT_TRAINS,SELF,switch_build_year_HWZ_Middle,build_year) {
							   0 .. 1932 : switch_spritestack_HWZ_Middle_DRG;
							1946 .. 2050 : switch_spritestack_HWZ_Middle_DB;
								switch_spritestack_HWZ_Middle_DB;}	
								
						switch (FEAT_TRAINS,SELF,switch_current_year_HWZ_Middle,current_year) {
							   0 .. 1932 : switch_spritestack_HWZ_Middle_DRG;
							1946 .. 2050 : switch_spritestack_HWZ_Middle_DB;
								switch_spritestack_HWZ_Middle_DB;}								
								
						switch (FEAT_TRAINS,SELF,switch_build_year_HWZ_Back,build_year) {
							   0 .. 1932 : switch_spritestack_HWZ_Back_DRG;
							1946 .. 2050 : switch_spritestack_HWZ_Back_DB;
								switch_spritestack_HWZ_Back_DB;}
								
						switch (FEAT_TRAINS,SELF,switch_current_year_HWZ_Back,current_year) {
							   0 .. 1932 : switch_spritestack_HWZ_Back_DRG;
							1946 .. 2050 : switch_spritestack_HWZ_Back_DB;
								switch_spritestack_HWZ_Back_DB;}																														

//Switches for 4-part consist							
	
							
					switch(FEAT_TRAINS, SELF, switch_length_HWZ_4, position_in_vehid_chain % 12) {
						0: 4;
						1: 5;
						2: 4;
						3: 4;
						4: 5;
						5: 4;
						6: 4;
						7: 5;
						8: 4;
						9: 4;
