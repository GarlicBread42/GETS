									{template_118trains_4x(0, 0)}		
									
									
//Spriteset DB gruen

		spriteset(spriteset_BR_E_19_DB_gruen, "gfx/E_19/E_19_DB_gruen_1x_8bpp.png")
									{ template_118trains_1x(0, 0)}
				
