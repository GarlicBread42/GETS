									{ template_purchase(0, 0)}
									
//Switches

						switch (FEAT_TRAINS,SELF, switch_SVT_137_Hamburg_purchase,current_year){
							   0 .. 1945: spriteset_SVT_137_Hamburg_DRG_purchase;
							1946 .. 2050: spriteset_SVT_137_Hamburg_DB_rot_purchase;
								spriteset_SVT_137_Hamburg_DB_rot_purchase;}									
						 
						switch(FEAT_TRAINS, SELF, switch_spritestack_SVT_137_Hamburg_DRG_front, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SVT_137_Hamburg_DRG_front;
							1: spritegroup_SVT_137_Hamburg_front_loading;}						 									
																
						switch(FEAT_TRAINS, SELF, switch_spritestack_SVT_137_Hamburg_DRG_back, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SVT_137_Hamburg_DRG_back;
							1: spritegroup_SVT_137_Hamburg_back_loading;}	

						switch(FEAT_TRAINS, SELF, switch_spritestack_SVT_137_Hamburg_DB_blau_front, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SVT_137_Hamburg_DB_blau_front;
							1: spritegroup_SVT_137_Hamburg_front_loading;}						 									
																
						switch(FEAT_TRAINS, SELF, switch_spritestack_SVT_137_Hamburg_DB_blau_back, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SVT_137_Hamburg_DB_blau_back;
							1: spritegroup_SVT_137_Hamburg_back_loading;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_SVT_137_Hamburg_DB_rot_front, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SVT_137_Hamburg_DB_rot_front;
							1: spritegroup_SVT_137_Hamburg_front_loading;}						 									
																
						switch(FEAT_TRAINS, SELF, switch_spritestack_SVT_137_Hamburg_DB_rot_back, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SVT_137_Hamburg_DB_rot_back;
							1: spritegroup_SVT_137_Hamburg_back_loading;}			
							
						switch(FEAT_TRAINS, SELF, switch_length_SVT_137_Hamburg, position_in_vehid_chain % 6) {
							0: 4;
							1: 6;
							2: 4;
							3: 4;
							4: 6;
							5: 4;}											

						switch(FEAT_TRAINS,PARENT,switch_running_cost_SVT_137_Hamburg, 1){
							return 1250;}
							
						switch(FEAT_TRAINS, SELF, switch_FX_SVT_137_Hamburg, position_in_vehid_chain % 6) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
							1: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
							2: return visual_effect_and_powered(VISUAL_EFFECT_DIESEL, -2, DISABLE_WAGON_POWER);	
							3: return visual_effect_and_powered(VISUAL_EFFECT_DIESEL, -2, DISABLE_WAGON_POWER);
							4: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
							5: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}

						switch (FEAT_TRAINS,SELF, switch_SVT_137_Hamburg_front_build_year,build_year){
							   0 .. 1945: switch_spritestack_SVT_137_Hamburg_DRG_front;
							1946 .. 2050: switch_spritestack_SVT_137_Hamburg_DB_rot_front;
								switch_spritestack_SVT_137_Hamburg_DB_rot_front;}	
								
						switch (FEAT_TRAINS,SELF, switch_SVT_137_Hamburg_back_build_year,build_year){
							   0 .. 1945: switch_spritestack_SVT_137_Hamburg_DRG_back;
							1946 .. 2050: switch_spritestack_SVT_137_Hamburg_DB_rot_back;
								switch_spritestack_SVT_137_Hamburg_DB_rot_back;}		

					switch(FEAT_TRAINS, SELF, switch_SVT_137_Hamburg_graphics_build, position_in_vehid_chain % 6) {
							0:	   spriteset_empty;
							1:     return switch_SVT_137_Hamburg_front_build_year;
							2:     spriteset_empty;
							3:	   spriteset_empty;
							4:	   return switch_SVT_137_Hamburg_back_build_year;
							5:	   spriteset_empty;}	

					switch (FEAT_TRAINS, SELF, switch_articulated_SVT_137_Hamburg_build, extra_callback_info1) {
						1 .. 5: return ITEM_SVT_137_HAMBURG_BUILD; 
						return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}

item (FEAT_TRAINS , ITEM_SVT_137_HAMBURG_BUILD, 6045)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_SVT_137_HAMBURG_BUILD);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1935,01,01);
						model_life: 					40;
						vehicle_life: 					40;
						retire_early: 					-10;							
						reliability_decay: 				20;
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);
						cargo_allow_refit:              [PASS, TOUR];
						cargo_capacity:                 14 ;
						loading_speed:					5;
						cost_factor: 					108;
						running_cost_base:				RUNNING_COST_STEAM;						
						running_cost_factor: 			90;

						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							160 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;	
						power:  						820 hp;
						weight: 						92 ton;
