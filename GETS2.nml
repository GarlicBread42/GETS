									{ template_purchase(0, 0)}																								
//Switches	

						 switch (FEAT_TRAINS,SELF, switch_BR_120_purchase,current_year){
							1920 .. 1986: spriteset_BR_120_purchase1;
							1987 .. 1995: spriteset_BR_120_purchase2;	
							1996 .. 2050: spriteset_BR_120_purchase3;				 					 
								spriteset_BR_120_purchase3;}

					random_switch (FEAT_TRAINS, SELF, random_choose_BR_120_0,) {
							1: spriteset_BR_120_0_orientrot;
							1: spriteset_BR_120_0_TEE;}							
								
						 switch (FEAT_TRAINS,SELF, switch_BR_120_current_year,current_year){
						 1920 .. 1986: random_choose_BR_120_0;
						 1987 .. 1995: spriteset_BR_120_1_orientrot;	
						 1996 .. 2050: spriteset_BR_120_1_verkehrsrot;				 					 
						 spriteset_BR_120_1_verkehrsrot;}
	
						 switch (FEAT_TRAINS,SELF, switch_BR_120_build_year,build_year){
						 1920 .. 1986: random_choose_BR_120_0;
						 1987 .. 1995: spriteset_BR_120_1_orientrot;	
						 1996 .. 2050: spriteset_BR_120_1_verkehrsrot;				 					 
						 spriteset_BR_120_1_verkehrsrot;}								
					
						switch(FEAT_TRAINS, SELF, switch_length_BR_120, position_in_vehid_chain % 3) {
						0: 4;
						1: 4;
						2: 4;}
						
						switch(FEAT_TRAINS, SELF, switch_FX_BR_120, position_in_vehid_chain % 3) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
							return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}

						switch(FEAT_TRAINS,PARENT,switch_running_cost_BR_120, 1){
						return 7125;}						

						switch(FEAT_TRAINS, SELF, switch_BR_120_graphics_build, position_in_vehid_chain % 3) {
							0:	   spriteset_empty;
							1:     return switch_BR_120_build_year;
							2:     spriteset_empty;}

						switch (FEAT_TRAINS, SELF, switch_articulated_BR_120_build, extra_callback_info1) {
							1 .. 2: return ITEM_BR_120_BUILD; 
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}
												
