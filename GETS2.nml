											  string(STR_DESC_EXPRESS),);			
			purchase_cargo_capacity		    : 0 ;
			cargo_capacity	                : return 0 ;
			purchase						: switch_BR_E_01_purchase;
			cost_factor						: 38;
			running_cost_factor				: switch_running_cost_BR_E_01;
			}
	}


