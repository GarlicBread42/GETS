		alternative_sprites (spriteset_BR_610_purchase_mint, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\BR_610/BR_610_front_mint_1x_32bpp.png", "gfx\BR_610/BR_610_front_mint_1x_mask.png")
