//Switches
						switch (FEAT_TRAINS, SELF, switch_animation_BR_74_4, motion_counter % 4) {
								0: spriteset_BR_74_4_anim1;
								1: spriteset_BR_74_4_anim2;
								2: spriteset_BR_74_4_anim3;
								3: spriteset_BR_74_4_anim4;}

						switch (FEAT_TRAINS, SELF, switch_animation_BR_74_4_REV, motion_counter % 4) {
								0: spriteset_BR_74_4_anim1_REV;
								1: spriteset_BR_74_4_anim2_REV;
								2: spriteset_BR_74_4_anim3_REV;
								3: spriteset_BR_74_4_anim4_REV;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_74_4_purchase1, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_74_4_purchase1;
							1: spriteset_BR_74_4_anim_purchase;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_74_4_purchase2, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_74_4_purchase2;
							1: spriteset_BR_74_4_anim_purchase;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_74_4_purchase3, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_74_4_purchase3;
							1: spriteset_BR_74_4_anim_purchase;}	
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_74_4_purchase_SBER, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_74_4_purchase_SBER;
							1: spriteset_BR_74_4_anim_purchase;}	
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_74_4_purchase_SBER2, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_74_4_purchase_SBER2;
							1: spriteset_BR_74_4_anim_purchase;}																									
						
						switch (FEAT_TRAINS,SELF, switch_BR_74_4_purchase,current_year){
							1900 .. 1919: switch_spritestack_BR_74_4_purchase1;
							1920 .. 1945: switch_spritestack_BR_74_4_purchase2;	
							1946 .. 2000: switch_spritestack_BR_74_4_purchase3;															 					 
								switch_spritestack_BR_74_4_purchase3;}						

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_74_4_KPEV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_74_4_KPEV;
							1: return switch_animation_BR_74_4;}									

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_74_4_KPEV_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_74_4_KPEV_REV;
							1: return switch_animation_BR_74_4_REV;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_74_4_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_74_4_DRG;
							1: return switch_animation_BR_74_4;}									

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_74_4_DRG_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_74_4_DRG_REV;
							1: return switch_animation_BR_74_4_REV;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_74_4_DB, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_74_4_DB;
							1: return switch_animation_BR_74_4;}									

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_74_4_DB_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_74_4_DB_REV;
							1: return switch_animation_BR_74_4_REV;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_74_4_SBER, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_74_4_SBER;
							1: return switch_animation_BR_74_4;}									

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_74_4_SBER_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_74_4_SBER_REV;
							1: return switch_animation_BR_74_4_REV;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_74_4_SBER2, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_74_4_SBER2;
							1: return switch_animation_BR_74_4;}									

						switch(FEAT_TRAINS, SELF, switch_spritestack_BR_74_4_SBER2_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BR_74_4_SBER2_REV;
							1: return switch_animation_BR_74_4_REV;}

						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_74_4_KPEV, vehicle_is_reversed) {
							0: switch_spritestack_BR_74_4_KPEV;
								switch_spritestack_BR_74_4_KPEV_REV;}

						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_74_4_DRG, vehicle_is_reversed) {
							0: switch_spritestack_BR_74_4_DRG;
								switch_spritestack_BR_74_4_DRG_REV;}

						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_74_4_DB, vehicle_is_reversed) {
							0: switch_spritestack_BR_74_4_DB;
								switch_spritestack_BR_74_4_DB_REV;}

						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_74_4_SBER, vehicle_is_reversed) {
							0: switch_spritestack_BR_74_4_SBER;
								switch_spritestack_BR_74_4_SBER_REV;}

						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_74_4_SBER2, vehicle_is_reversed) {
							0: switch_spritestack_BR_74_4_SBER2;
								switch_spritestack_BR_74_4_SBER2_REV;}																																															

						switch (FEAT_TRAINS,PARENT,switch_enginecheck_BR_74_4_SBER,(count_veh_id(8816))) {
							0: switch_reverse_BR_74_4_KPEV; 
								switch_reverse_BR_74_4_SBER;}	
								
						switch (FEAT_TRAINS,PARENT,switch_enginecheck_BR_74_4_SBER2,(count_veh_id(8816))) {
							0: switch_reverse_BR_74_4_DRG; 
								switch_reverse_BR_74_4_SBER2;}															

						switch (FEAT_TRAINS,SELF, switch_BR_74_4_build_year,build_year){
							1900 .. 1919: switch_enginecheck_BR_74_4_SBER;
							1920 .. 1930: switch_enginecheck_BR_74_4_SBER2;
							1931 .. 1945: switch_reverse_BR_74_4_DRG;
							1946 .. 1990: switch_reverse_BR_74_4_DB;						 					 
								switch_reverse_BR_74_4_DB;}
							
						switch (FEAT_TRAINS,SELF, switch_BR_74_4_current_year,current_year){
							1900 .. 1919: switch_enginecheck_BR_74_4_SBER;
							1920 .. 1930: switch_enginecheck_BR_74_4_SBER2;
							1931 .. 1945: switch_reverse_BR_74_4_DRG;
							1946 .. 1990: switch_reverse_BR_74_4_DB;						 					 
								switch_reverse_BR_74_4_DB;}							
							
					switch(FEAT_TRAINS, PARENT, switch_FX_BR_74_4, vehicle_is_reversed) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_STEAM, -3, DISABLE_WAGON_POWER);
								return visual_effect_and_powered(VISUAL_EFFECT_STEAM, 2, DISABLE_WAGON_POWER);}							
						
					switch (FEAT_TRAINS, PARENT, switch_running_cost_BR_74_4, 1) {
							return 1000;}
							
item (FEAT_TRAINS , ITEM_BR_74_4, 0740)

		{//property Block
					property 
					{
					//common properties
								name: 							string(STR_NAME_BR_74_4);
								extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
								climates_available: 			ALL_CLIMATES;
								introduction_date: 				date(1902,01,01);
								model_life: 					66;
								vehicle_life: 					50;
								retire_early: 					-10;								
								reliability_decay: 				20;
								cargo_allow_refit: 				[PASS] ;
								cargo_capacity: 				1 ;
								cost_factor: 					30;
								misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);	
								running_cost_base: 				RUNNING_COST_STEAM;
								running_cost_factor: 			90;
								
					//Train specific properties
								sprite_id: 						SPRITE_ID_NEW_TRAIN;
								speed: 							80 km/h;
								refit_cost: 					0;
								track_type: 					RAIL;
								power:  						870 hp;
								weight: 						67 ton;
								ai_engine_rank: 				0;
								engine_class: 					ENGINE_CLASS_STEAM;
								visual_effect_and_powered: 		visual_effect_and_powered(VISUAL_EFFECT_STEAM, -3, DISABLE_WAGON_POWER);
								dual_headed: 					0;
								tractive_effort_coefficient: 	0.2;
								length: 						7;														
			}
			
			//Vehicels Graphics
					graphics
				{
						default						    : switch_BR_74_4_build_year;
			additional_text				   : string(STR_CONCAT_2, 
											string(STR_TRACTION_STEAM), 
											string(STR_DESC_PASS),);
						purchase_cargo_capacity         : 0 ;
						cargo_capacity                  : return 0 ;
						purchase					    : switch_BR_74_4_purchase;
						cost_factor						: 18;
						running_cost_factor				: switch_running_cost_BR_74_4;
						visual_effect_and_powered		: switch_FX_BR_74_4;
			 }
		}								

