							7: spritegroup_Shimmnstu_718_Cargo;													
								spritegroup_Shimmnstu_718_Cargo;}
																
					switch (FEAT_TRAINS, SELF, random_choose_Shimmnstu_718_PRIV, switch_alternative_var_random_bits(1, 2)) {
							1: spritegroup_Shimmnstu_718_Ermewa;
							2: spritegroup_Shimmnstu_718_Wascosa;
							3: spritegroup_Shimmnstu_718_VTG;														
								spritegroup_Shimmnstu_718_VTG;}																																
																				
					switch(FEAT_TRAINS,PARENT,switch_running_cost_Shimmnstu_718, 1){
						return 475;}
													
