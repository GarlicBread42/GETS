							VPTS: return switch_loadstack_Rnsz_643_Box;
							GOOD: return switch_loadstack_Rnsz_643_Box;
							GLAS: return switch_loadstack_Rnsz_643_Box;
							
							ENSP: return switch_loadstack_Rnsz_643_ENSP;
							FMSP: return switch_loadstack_Rnsz_643_Farm;
							
							STWR: return switch_loadstack_Rnsz_643_Draht;
							
							STEL: return switch_loadstack_Rnsz_643_Profile;
							STSE: return switch_loadstack_Rnsz_643_Profile;
							
							PIPE: return switch_loadstack_Rnsz_643_Pipe;
							
							BDMT: return switch_loadstack_Rnsz_643_Timber;
