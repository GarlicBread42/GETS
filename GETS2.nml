		alternative_sprites (spriteset_Om_Ludwigshafen_1909_purchase_KPEV, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\Om_Ludwigshafen_1909/Om_Ludwigshafen_1909_KPEV_1x_32bpp.png", "gfx\Om_Ludwigshafen_1909/Om_Ludwigshafen_1909_KPEV_1x_mask.png")
					{template_purchase(0, 0)}	

