				switch (FEAT_TRAINS, SELF, random_choose_R10_Stuttgart_DB_Barren, switch_alternative_var_random_bits(1, 1)) {
							1: switch_loadstack_R10_Stuttgart_DB_OBH_Barren;
								switch_loadstack_R10_Stuttgart_DB_MBH_Barren;}						

				switch (FEAT_TRAINS, SELF, random_choose_R10_Stuttgart_DB_Box, switch_alternative_var_random_bits(1, 1)) {
							1: switch_loadstack_R10_Stuttgart_DB_OBH_Box;
								switch_loadstack_R10_Stuttgart_DB_MBH_Box;}	
								
				switch (FEAT_TRAINS, SELF, random_choose_R10_Stuttgart_DB_ENSP, switch_alternative_var_random_bits(1, 1)) {
							1: switch_loadstack_R10_Stuttgart_DB_OBH_ENSP;
								switch_loadstack_R10_Stuttgart_DB_MBH_ENSP;}	
								
				switch (FEAT_TRAINS, SELF, random_choose_R10_Stuttgart_DB_Farm, switch_alternative_var_random_bits(1, 1)) {
							1: switch_loadstack_R10_Stuttgart_DB_OBH_Farm;
								switch_loadstack_R10_Stuttgart_DB_MBH_Farm;}	
								
				switch (FEAT_TRAINS, SELF, random_choose_R10_Stuttgart_DB_Draht, switch_alternative_var_random_bits(1, 1)) {
							1: switch_loadstack_R10_Stuttgart_DB_OBH_Draht;
								switch_loadstack_R10_Stuttgart_DB_MBH_Draht;}
								
				switch (FEAT_TRAINS, SELF, random_choose_R10_Stuttgart_DB_Pipe, switch_alternative_var_random_bits(1, 1)) {
							1: switch_loadstack_R10_Stuttgart_DB_OBH_Pipe;
								switch_loadstack_R10_Stuttgart_DB_MBH_Pipe;}
								
				switch (FEAT_TRAINS, SELF, random_choose_R10_Stuttgart_DB_Profile, switch_alternative_var_random_bits(1, 1)) {
							1: switch_loadstack_R10_Stuttgart_DB_OBH_Profile;
								switch_loadstack_R10_Stuttgart_DB_MBH_Profile;}	
								
				switch (FEAT_TRAINS, SELF, random_choose_R10_Stuttgart_DB_Timber, switch_alternative_var_random_bits(1, 1)) {
							1: switch_loadstack_R10_Stuttgart_DB_OBH_Timber;
								switch_loadstack_R10_Stuttgart_DB_MBH_Timber;}	
								
				switch (FEAT_TRAINS, SELF, random_choose_R10_Stuttgart_DB_Wood, switch_alternative_var_random_bits(1, 1)) {
							1: switch_loadstack_R10_Stuttgart_DB_OBH_Wood;
								switch_loadstack_R10_Stuttgart_DB_MBH_Wood;}	

					switch(FEAT_TRAINS, SELF, switch_R10_Stuttgart_DB_cargo_classes, cargo_classes) {
							bitmask(CC_PIECE_GOODS) : return random_choose_R10_Stuttgart_DB_Box;
								return random_choose_R10_Stuttgart_DB_Box;}									

					switch (FEAT_TRAINS, SELF, switch_R10_Stuttgart_DB_cargo_type, cargo_type_in_veh) {

//FIRS-Cargos					
							STAL: return random_choose_R10_Stuttgart_DB_Barren;
							ALUM: return random_choose_R10_Stuttgart_DB_Barren;
							STCB: return random_choose_R10_Stuttgart_DB_Barren;
							STST: return random_choose_R10_Stuttgart_DB_Barren;
							STSH: return random_choose_R10_Stuttgart_DB_Barren;
							
							POWR: return random_choose_R10_Stuttgart_DB_Box;
							VENG: return random_choose_R10_Stuttgart_DB_Box;
							VPTS: return random_choose_R10_Stuttgart_DB_Box;
							GOOD: return random_choose_R10_Stuttgart_DB_Box;
							GLAS: return random_choose_R10_Stuttgart_DB_Box;
							
							ENSP: return random_choose_R10_Stuttgart_DB_ENSP;
							FMSP: return random_choose_R10_Stuttgart_DB_Farm;
							
							STWR: return random_choose_R10_Stuttgart_DB_Draht;
							
							STEL: return random_choose_R10_Stuttgart_DB_Profile;
							STSE: return random_choose_R10_Stuttgart_DB_Profile;
							
							PIPE: return random_choose_R10_Stuttgart_DB_Pipe;
							
							BDMT: return random_choose_R10_Stuttgart_DB_Timber;
							WDPR: return random_choose_R10_Stuttgart_DB_Timber;
							
							WOOD: return random_choose_R10_Stuttgart_DB_Wood;
							
//Other Cargoes
							MNSP: return random_choose_R10_Stuttgart_DB_Box;
							MPTS: return random_choose_R10_Stuttgart_DB_Box;
							PAPR: return random_choose_R10_Stuttgart_DB_Box;							
							
								switch_R10_Stuttgart_DB_cargo_classes;}

item (FEAT_TRAINS , ITEM_R10_STUTTGART_DB, 8863)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_R10_STUTTGART_DB);
						variant_group:					8859;
						extra_flags:					bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1946,01,01);
						model_life: 					26;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes: 		bitmask(CC_PIECE_GOODS );
						cargo_allow_refit:              [STAL, ALUM, STCB, STST, STSH, POWR, VENG, VPTS, GOOD, GLAS, ENSP, FMSP, STWR, STEL, STSE, PIPE, BDMT, WDPR, WOOD, MNSP, MPTS, PAPR,];
						cargo_disallow_refit: 			[LVST, FOOD, WATR, BEER, BOOM, FISH, IRON, EOIL, FERT, FICR, FRVG, FRUT, VEHI];
						misc_flags: 					bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_SPRITE_STACK);
						loading_speed:					10;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							50 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						11 ton;
						dual_headed: 					0;
						default_cargo_type:				WOOD;
						cargo_capacity:					17;
						ai_engine_rank: 				0;
						length: 						8;
												
			}
			
	//Vehicels Graphics
			graphics
			{
			default							: switch_R10_Stuttgart_DB_cargo_type;
			additional_text					: string(STR_DESC_CABOOSE_65);
			purchase						: spriteset_R10_Stuttgart_purchase3;
			speed							: switch_speed_R10_Stuttgart;
			cost_factor						: 51;
			running_cost_factor				: switch_running_cost_R10_Stuttgart;
			colour_mapping					: switch_generic_recolour;
			 }
		}
