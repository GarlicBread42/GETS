	switch (FEAT_TRAINS, SELF, switch_articulated_BR_412_13_BRD, extra_callback_info1) {
		1 .. 38: return ITEM_BR_412_13_BRD; 
		return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}
						
item (FEAT_TRAINS , ITEM_BR_412_13_BRD, 4128)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_BR_412_13_BRD);
						variant_group:					4127;
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(2022,01,01);
						model_life: 					VEHICLE_NEVER_EXPIRES;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);
						refittable_cargo_classes:		bitmask(CC_PASSENGERS);
						cargo_allow_refit:				[PASS, TOUR];
						cargo_capacity:					23;
						loading_speed:					5;
						cost_factor:                    80;
						running_cost_base:              RUNNING_COST_STEAM;
						running_cost_factor: 			80;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							265 km/h;
						refit_cost: 					0;
						track_type: 					AC15;
						power:							15600 hp;						
						weight: 						736 ton;
						ai_engine_rank: 				0;
						engine_class:					ENGINE_CLASS_ELECTRIC;
						visual_effect_and_powered: 		visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
						dual_headed:					0;
						tractive_effort_coefficient:	0.063;
						length: 						8;
												
			}
			
	//Vehicels Graphics
			graphics
			{
			default:						switch_graphics_BR_412_13_BRD;
			additional_text:				string(STR_CONCAT_2, 
											string(STR_TRACTION_EMU), 
											string(STR_DESC_EXPRESS),);
			length:							switch_length_BR_412_13;
			articulated_part:				switch_articulated_BR_412_13_BRD;
			can_attach_wagon:				switch_COUPLING_BR_412_12;
			purchase:						spriteset_BR_412_13_BRD_purchase;
			visual_effect_and_powered:		switch_BR_412_13_FX;
			cost_factor:					1100;
			running_cost_factor:			switch_running_cost_BR_412_13;								
			 }
		}
