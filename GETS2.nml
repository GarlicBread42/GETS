			PAPR: return random_choose_Rw_Stuttgart_DRG_Box;							
			
			switch_Rw_Stuttgart_DRG_CC_Piece;}																	

item (FEAT_TRAINS , ITEM_RW_STUTTGART_DRG, 8853)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_RW_STUTTGART_DRG);
						variant_group:					8850;
						extra_flags:					bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW);	
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1920,01,01);
						model_life: 					24;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes: 		bitmask(CC_PIECE_GOODS );
						cargo_allow_refit:              [STAL, ALUM, STCB, STST, STSH, POWR, VENG, VPTS, GOOD, GLAS, ENSP, FMSP, STWR, STEL, STSE, PIPE, BDMT, WDPR, WOOD, MNSP, MPTS, PAPR,];
						cargo_disallow_refit: 			[LVST, FOOD, WATR, BEER, BOOM, FISH, IRON, EOIL, FERT, FICR, FRVG, FRUT, VEHI];
						misc_flags: 					bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_SPRITE_STACK);
						loading_speed:					10;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							50 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						9 ton;
						dual_headed: 					0;
						default_cargo_type:				WOOD;
						cargo_capacity:					10;
						ai_engine_rank: 				0;
						length: 						8;
												
			}
			
	//Vehicels Graphics
			graphics
			{
			default							: switch_Rw_Stuttgart_DRG_cargo_type;
			additional_text					: string(STR_DESC_GOODS);
			purchase						: spriteset_Rw_Stuttgart_purchase1;
			cost_factor						: 23;
			running_cost_factor				: switch_running_cost_Rw_Stuttgart;
			colour_mapping					: switch_generic_recolour;
			 }
		}
