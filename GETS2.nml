						switch(FEAT_TRAINS, SELF, switch_spritestack_Wue_POSTCI_KWSE, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_Wue_POSTCI_KWSE;
							1: spritegroup_Wue_POSTCI_loading;}
						 
						switch(FEAT_TRAINS, SELF, switch_spritestack_Wue_POSTCI_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_Wue_POSTCI_DRG;
