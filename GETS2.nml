							0: spriteset_BR_1002_HSL_REV;
							1: spriteset_BR_1002_flashlight_REV;}											
												
						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_1002_DB, vehicle_is_reversed) {
							0: switch_spritestack_BR_1002_DB;
								switch_spritestack_BR_1002_DB_REV;}							
					
						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_1002_DB_Eco, vehicle_is_reversed) {
							0: switch_spritestack_BR_1002_DB_Eco;
