							1950 .. 1974: spriteset_BR_151_purchase_1;
							1975 .. 1987: spriteset_BR_151_purchase_2;
							1988 .. 1995: spriteset_BR_151_purchase_3;
							1996 .. 2009: spriteset_BR_151_purchase_4;
							2010 .. 2050: spriteset_BR_151_purchase_5;
							spriteset_BR_151_purchase_5;}

						random_switch (FEAT_TRAINS, SELF, random_choose_BR_151_Priv,) {
							1: spriteset_BR_151_priv1;
							1: spriteset_BR_151_priv2;
							1: spriteset_BR_151_priv3; 
							1: spriteset_BR_151_priv4;
							1: spriteset_BR_151_priv5;
							1: spriteset_BR_151_priv6;}																					 
			
