							  00 .. 1995: spriteset_BR_143_orientrot_purchase;
							1996 .. 2050: spriteset_BR_143_Regio_purchase;					 					 
								spriteset_BR_143_Regio_purchase;}
					
						switch(FEAT_TRAINS, SELF, switch_length_BR_143, position_in_vehid_chain % 2) {
							0: 4;
							1: 6;}
						
						switch(FEAT_TRAINS, SELF, switch_FX_BR_143, position_in_vehid_chain % 3) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
							return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}						

						switch(FEAT_TRAINS,PARENT,switch_running_cost_BR_143, 1){
							return 2250;}	
																			 	
						 switch (FEAT_TRAINS,SELF, switch_BR_143_current_year,current_year){
							  00 .. 1995: spriteset_BR_143_orientrot;
							1996 .. 2050: spriteset_BR_143_Regio;					 					 
								spriteset_BR_143_Regio;}
	
						switch (FEAT_TRAINS,SELF,switch_BR_143_build_year,build_year){
