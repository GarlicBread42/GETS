							OILD: random_choose_Zacns_87_OIL;
							O2__: random_choose_Zacns_87_CHEM;
							SOAP: random_choose_Zacns_87_CHEM;
							PLST: random_choose_Zacns_87_OIL;
								random_choose_Zacns_87_CHEM;}

						switch(FEAT_TRAINS, SELF, switch_length_Zacns_87, position_in_vehid_chain % 3) {
							0: 3;
							1: 3;
							2: 3;}								

					switch(FEAT_TRAINS,PARENT,switch_running_cost_Zacns_87, 1){
						return 650;}								
																			
						switch(FEAT_TRAINS, SELF, switch_Zacns_87_Auto_graphics, position_in_articulated_veh % 3) {
							0:	   spriteset_empty;
							1:     return switch_Zacns_87_sprite_choose;
							2:	   spriteset_empty;}
						 		 
					switch (FEAT_TRAINS, SELF, switch_articulated_Zacns_87_Auto, extra_callback_info1) {
						1 .. 2: return ITEM_ZACNS_87_AUTO;
						return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}
													
item (FEAT_TRAINS , ITEM_ZACNS_87_AUTO, 9385)
