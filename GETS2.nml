									{ template_78trains_4x(0, 0)}	
									

//Spriteset Purchase

spriteset(spriteset_E_73_0_purchase1, "gfx/E_73_0/BR_E_73_0_BAY_1x_8bpp.png")
									{ template_purchase(0, 0)}
				
		alternative_sprites (spriteset_E_73_0_purchase1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/E_73_0/BR_E_73_0_BAY_1x_32bpp.png", "gfx/E_73_0/BR_E_73_0_BAY_1x_mask.png")
									{ template_purchase(0, 0)}
									
spriteset(spriteset_E_73_0_purchase3, "gfx/E_73_0/BR_E_73_0_DRG_1x_8bpp.png")
									{ template_purchase(0, 0)}
				
		alternative_sprites (spriteset_E_73_0_purchase3, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/E_73_0/BR_E_73_0_DRG_1x_32bpp.png", "gfx/E_73_0/BR_E_73_0_DRG_1x_mask.png")
									{ template_purchase(0, 0)}
									
spriteset(spriteset_E_73_0_purchase2, "gfx/E_73_0/BR_E_73_0_DRG2_1x_8bpp.png")
									{ template_purchase(0, 0)}
				
		alternative_sprites (spriteset_E_73_0_purchase2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/E_73_0/BR_E_73_0_DRG2_1x_32bpp.png", "gfx/E_73_0/BR_E_73_0_DRG2_1x_mask.png")
									{ template_purchase(0, 0)}																		
	
//Switches

						 switch (FEAT_TRAINS,SELF, switch_E_73_0_purchase,current_year){
							1900 .. 1919: spriteset_E_73_0_purchase1;
							1920 .. 1926: spriteset_E_73_0_purchase2;
							1927 .. 1999: spriteset_E_73_0_purchase3;				 					 
								spriteset_E_73_0_purchase3;}						 
						 		
						 switch (FEAT_TRAINS,SELF, switch_E_73_0_current_year,current_year){
							1900 .. 1919: spriteset_E_73_0_bay;
							1920 .. 1926: spriteset_E_73_0_DRG2;
							1927 .. 1999: spriteset_E_73_0_DRG;				 					 
								spriteset_E_73_0_DRG;}
	
						 switch (FEAT_TRAINS,SELF, switch_E_73_0_build_year,build_year){
							1900 .. 1919: spriteset_E_73_0_bay;
							1920 .. 1926: spriteset_E_73_0_DRG2;
							1927 .. 1999: spriteset_E_73_0_DRG;				 					 
								spriteset_E_73_0_DRG;}							
								
						switch(FEAT_TRAINS,PARENT,switch_running_cost_E_73_0, 1){
							return 400;}						
						
