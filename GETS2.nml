								1920 .. 2050: switch_spritestack_BR_13_10_purchase2;
								switch_spritestack_BR_13_10_purchase2;}																	

						switch (FEAT_TRAINS, SELF, switch_animation_BR_13_10, motion_counter % 4) {
							0: spriteset_BR_13_10_anim1;
							1: spriteset_BR_13_10_anim2;
							2: spriteset_BR_13_10_anim3;
							3: spriteset_BR_13_10_anim4;}	

