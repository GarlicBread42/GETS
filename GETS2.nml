						0: spriteset_SSK_Koeln;
						1: switch_SSK_Koeln_load_ENSP_current_year;}	
						
					switch(FEAT_TRAINS, SELF, switch_loadstack_SSK_Koeln_Farm, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_SSK_Koeln;
						1: switch_SSK_Koeln_load_Farm_current_year;}	
						
					switch(FEAT_TRAINS, SELF, switch_loadstack_SSK_Koeln_Draht, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_SSK_Koeln;
						1: spritegroup_SSK_Koeln_load_Draht;}
						
					switch(FEAT_TRAINS, SELF, switch_loadstack_SSK_Koeln_Pipe, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_SSK_Koeln;
						1: spritegroup_SSK_Koeln_load_Pipe;}
												
					switch(FEAT_TRAINS, SELF, switch_loadstack_SSK_Koeln_Profile, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_SSK_Koeln;
						1: spritegroup_SSK_Koeln_load_Profile;}							
						
					switch(FEAT_TRAINS, SELF, switch_loadstack_SSK_Koeln_Timber, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_SSK_Koeln;
						1: spritegroup_SSK_Koeln_load_Timber;}						
						
					switch(FEAT_TRAINS, SELF, switch_loadstack_SSK_Koeln_Wood, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_SSK_Koeln;
						1: spritegroup_SSK_Koeln_load_Wood;}				

					switch(FEAT_TRAINS, SELF, switch_SSK_Koeln_cargo_classes, cargo_classes) {
							bitmask(CC_PIECE_GOODS) : return switch_loadstack_SSK_Koeln_Box;
								return switch_loadstack_SSK_Koeln_Box;}									

					switch (FEAT_TRAINS, SELF, switch_SSK_Koeln_cargo_type, cargo_type_in_veh) {

//FIRS-Cargos					
							STAL: return switch_loadstack_SSK_Koeln_Barren;
							ALUM: return switch_loadstack_SSK_Koeln_Barren;
							STCB: return switch_loadstack_SSK_Koeln_Barren;
							STST: return switch_loadstack_SSK_Koeln_Barren;
							STSH: return switch_loadstack_SSK_Koeln_Barren;
							
							POWR: return switch_loadstack_SSK_Koeln_Box;
							VENG: return switch_loadstack_SSK_Koeln_Box;
							VPTS: return switch_loadstack_SSK_Koeln_Box;
							GOOD: return switch_loadstack_SSK_Koeln_Box;
							GLAS: return switch_loadstack_SSK_Koeln_Box;
							
							ENSP: return switch_loadstack_SSK_Koeln_ENSP;
							FMSP: return switch_loadstack_SSK_Koeln_Farm;
							
							STWR: return switch_loadstack_SSK_Koeln_Draht;
							
							STEL: return switch_loadstack_SSK_Koeln_Profile;
							STSE: return switch_loadstack_SSK_Koeln_Profile;
							
							PIPE: return switch_loadstack_SSK_Koeln_Pipe;
							
							BDMT: return switch_loadstack_SSK_Koeln_Timber;
							WDPR: return switch_loadstack_SSK_Koeln_Timber;
							
							WOOD: return switch_loadstack_SSK_Koeln_Wood;
							
//Other Cargoes
							MNSP: return switch_loadstack_SSK_Koeln_Box;
							MPTS: return switch_loadstack_SSK_Koeln_Box;
							PAPR: return switch_loadstack_SSK_Koeln_Box;							
							
								switch_SSK_Koeln_cargo_classes;}	
								
								
						switch(FEAT_TRAINS, SELF, switch_SSK_Koeln_graphics, position_in_articulated_veh % 3) {
							0:	   spriteset_empty;
							1:     return switch_SSK_Koeln_cargo_type;
							2:	   spriteset_empty;}

						switch(FEAT_TRAINS, SELF, switch_length_SSK_Koeln, position_in_vehid_chain % 3) {
							0: 3;
							1: 3;
							2: 3;}			
								
						switch (FEAT_TRAINS, PARENT, switch_speed_SSK_Koeln,  switch_check_PWG_0()) {
							1: return 65;
							0: return 50;}												
						 		 
						switch (FEAT_TRAINS, SELF, switch_articulated_SSK_Koeln, extra_callback_info1) {
							1 .. 2: return ITEM_SSK_KOELN;
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}																																																																												

						switch(FEAT_TRAINS,PARENT,switch_running_cost_SSK_Koeln, 1){
							return 140;}																				

item (FEAT_TRAINS , ITEM_SSK_KOELN, 8921)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_SSK_KOELN);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1898,01,01);
						model_life: 					50;
						vehicle_life: 					50;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes: 		bitmask(CC_PIECE_GOODS );
						cargo_allow_refit:              [STAL, ALUM, STCB, STST, STSH, POWR, VENG, VPTS, GOOD, GLAS, ENSP, FMSP, STWR, STEL, STSE, PIPE, BDMT, WDPR, WOOD, MNSP, MPTS, PAPR,];
						cargo_disallow_refit: 			[LVST, FOOD, WATR, BEER, BOOM, FISH, IRON, EOIL, FERT, FICR, FRVG, FRUT, VEHI];
						misc_flags: 					bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_SPRITE_STACK);
						loading_speed:					5;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							50 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						16 ton;
						dual_headed: 					0;
						default_cargo_type:				WOOD;
						cargo_capacity:					10;
						ai_engine_rank: 				0;
						length: 						8;
												
			}
			
	//Vehicels Graphics
			graphics
			{
			default							: switch_SSK_Koeln_graphics;
			additional_text					: string(STR_DESC_CABOOSE_65);
			articulated_part			  	: switch_articulated_SSK_Koeln;
			length							: switch_length_SSK_Koeln;
			purchase						: spriteset_SSK_Koeln_purchase;
			speed							: switch_speed_SSK_Koeln;
			cost_factor						: 67;
			running_cost_factor				: switch_running_cost_SSK_Koeln;
			colour_mapping					: switch_generic_recolour;
			 }
		}	
