							7: spriteset_Uerdingen_4_GREEN;													
								spriteset_Uerdingen_4_VTG_OLD;}									

					switch (FEAT_TRAINS, SELF, random_choose_Uerdingen_4_OIL, switch_alternative_var_random_bits(1, 3)) {
							1: spriteset_Uerdingen_4_ARAL;
							2: spriteset_Uerdingen_4_BP;
							3: spriteset_Uerdingen_4_BP2;
							4: spriteset_Uerdingen_4_ESSO;
							5: spriteset_Uerdingen_4_OMV;																												
							6: spriteset_Uerdingen_4_VALVOLINE;
							7: spriteset_Uerdingen_4_VALVOLINE;													
								spriteset_Uerdingen_4_OMV;}

					switch (FEAT_TRAINS, SELF, random_choose_Uerdingen_4_NEUT, switch_alternative_var_random_bits(1, 2)) {
							1: spriteset_Uerdingen_4_GREEN;
							2: spriteset_Uerdingen_4_NEUT_MBH;
								spriteset_Uerdingen_4_NEUT_OBH;}	

					switch (FEAT_TRAINS, SELF, random_choose_Uerdingen_4_VTG, switch_alternative_var_random_bits(1, 2)) {
							1: spriteset_Uerdingen_4_VTG_NEW;
							2: spriteset_Uerdingen_4_VTG_NEW_2;
								spriteset_Uerdingen_4_VTG_OLD;}	

					switch (FEAT_TRAINS, SELF, random_choose_Uerdingen_4_BP, switch_alternative_var_random_bits(1, 1)) {
							1: spriteset_Uerdingen_4_BP;
								spriteset_Uerdingen_4_BP2;}	
																					
					switch (FEAT_TRAINS, SELF, switch_Uerdingen_4_sprite_choose, cargo_type_in_veh) {
							OIL_: random_choose_Uerdingen_4_OIL;
							RUBR: random_choose_Uerdingen_4_OIL; 
							WATR: random_choose_Uerdingen_4_CHEM;
							BEER: random_choose_Uerdingen_4_CHEM;
							DYES: random_choose_Uerdingen_4_CHEM; 
							PETR: random_choose_Uerdingen_4_OIL;
							RFPR: random_choose_Uerdingen_4_OIL;
							SULP: random_choose_Uerdingen_4_CHEM;
							ACID: random_choose_Uerdingen_4_CHEM;
							CHLO: random_choose_Uerdingen_4_CHEM;
							COAT: random_choose_Uerdingen_4_CHEM;
							FUEL: random_choose_Uerdingen_4_CHEM;
							LYE_: random_choose_Uerdingen_4_CHEM;
							MOLS: random_choose_Uerdingen_4_CHEM;
							NH3_: random_choose_Uerdingen_4_CHEM;
							OILI: random_choose_Uerdingen_4_OIL;
							OILD: random_choose_Uerdingen_4_OIL;
							O2__: random_choose_Uerdingen_4_CHEM;
							SOAP: random_choose_Uerdingen_4_CHEM;
							PLST: random_choose_Uerdingen_4_OIL;
								random_choose_Uerdingen_4_CHEM;}									

					switch(FEAT_TRAINS,PARENT,switch_running_cost_Uerdingen_4, 1){
						return 675;}								

