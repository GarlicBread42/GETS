					switch(FEAT_TRAINS, SELF, switch_H02_Regensburg_graphics_BAY, position_in_vehid_chain % 3) {
						0:	   spriteset_empty;
						1:     return switch_H02_Regensburg_BAY_cargo_type;
						2:	   spriteset_empty;}	
						
					switch (FEAT_TRAINS, SELF, switch_articulated_H02_Regensburg_BAY, extra_callback_info1) {
						1 .. 2: return ITEM_H02_REGENSBURG_BAY;
						return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}				

item (FEAT_TRAINS , ITEM_H02_REGENSBURG_BAY, 8963)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_H02_REGENSBURG_BAY);
						variant_group:					8961;
						extra_flags:					bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1888,01,01);
						model_life: 					30;
						vehicle_life: 					50;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes: 		bitmask( 	);
						cargo_allow_refit:              [WOOD, WDPR, BDMT];
						cargo_disallow_refit: 			[LVST, FOOD, WATR, BEER, BOOM, FISH, IRON, EOIL, FERT, FICR, FRVG, FRUT, VEHI, CLAY, KAOL, SASH];
						misc_flags: 					bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_SPRITE_STACK);
						loading_speed:					10;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							45 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						17 ton;
						dual_headed: 					0;
						default_cargo_type:				WOOD;
						cargo_capacity:					10;
						ai_engine_rank: 				0;
						length: 						8;
												
			}
			
	//Vehicels Graphics
			graphics
			{
			default							: switch_H02_Regensburg_graphics_BAY;
			additional_text					: string(STR_DESC_GOODS);
			articulated_part			  	: switch_articulated_H02_Regensburg_BAY;
			length							: switch_length_H02_Regensburg;
			purchase						: spriteset_H02_Regensburg_purchase;
			cost_factor						: 60;
			running_cost_factor				: switch_running_cost_H02_Regensburg;
			colour_mapping					: switch_generic_recolour;
			 }
		}
