					 switch (FEAT_TRAINS,SELF, switch_V23_Altona_purchase,current_year){
							1800 .. 1945: spriteset_V23_Altona_purchase_1;
							1946 .. 2050: spriteset_V23_Altona_purchase_2;				 					 
							spriteset_V23_Altona_purchase_2;}					

					switch (FEAT_TRAINS, SELF, random_choose_V23_Altona_DRG, switch_alternative_var_random_bits(1, 1)) {
