					{template_purchase(0, 0)}	
				
		alternative_sprites (spriteset_O_Nuernberg_purchase1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\O_Nuernberg/O_Nuernberg_KPEV_MBH_1x_32bpp.png", "gfx\O_Nuernberg/O_Nuernberg_KPEV_MBH_1x_mask.png")
