					{template_purchase(0, 0)}	
				
		alternative_sprites (spriteset_Hbbills311_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\Hbbills311/Hbbills311_Var1_1x_32bpp.png", "gfx\Hbbills311/Hbbills311_Var1_1x_mask.png")
					{template_purchase(0, 0)}
					
					
//Switches

					switch (FEAT_TRAINS, SELF, random_choose_Hbbills311, switch_alternative_var_random_bits(1, 1)) {			
						0: spritegroup_Hbbills311_Var1;
						1: spritegroup_Hbbills311_Var2;}						

					switch(FEAT_TRAINS, SELF, switch_Hbbills311_graphics, position_in_articulated_veh % 2) {
						0:	   spriteset_empty;
						1:     random_choose_Hbbills311;}

					switch(FEAT_TRAINS, SELF, switch_length_Hbbills311, position_in_articulated_veh % 2) {
						0: 4;
						1: 6;}

					switch (FEAT_TRAINS, SELF, switch_articulated_Hbbills311, extra_callback_info1) {
						1: return ITEM_HBBILLS311;
							return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}

					switch(FEAT_TRAINS,PARENT,switch_running_cost_Hbbills311, 1){
						return 200;}								

