							1: spritegroup_GMHS_35_NEUT1;
							1: spritegroup_GMHS_35_NEUT2;}	
																					
					switch (FEAT_TRAINS, PARENT, switch_speed_GMHS_35,  switch_check_PWG_0()) {
						1: return 100;
						0: return 80;}
						
					switch(FEAT_TRAINS,PARENT,switch_running_cost_GMHS_35, 1){
						return 160;}							

item (FEAT_TRAINS , ITEM_GMHS_35, 8280)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_GMHS_35);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);						
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1943,01,01);
						model_life: 					24;
						vehicle_life: 					20;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes:		bitmask(CC_PIECE_GOODS);
						cargo_allow_refit:              [MAIL,GOOD,VALU,PAPR,DIAM,BDMT,BEER,BOOM,BRCK,CERA,CERE,DYES,ENSP,FERT,FICR,FMSP,GLAS,JAVA,PLAS,TYRE,WDPR,WOOL,ZINC,ALUM,BAKE,CIGR,COAT,COBL,FURN,METL,MNSP,MPTS,NUTS,PCL_,PIPE,SEED,SESP,SOAP,STAL,STCB,STSE,STSH,STST,STWR,TATO,VENG,VPTS,BATT,BUBL,FZDR,TOYS,];
						loading_speed:					6;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							80 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						10 ton;
						dual_headed: 					0;
						default_cargo_type:				GOOD;
						cargo_capacity:					40;
						ai_engine_rank: 				0;
						length: 						6;
												
			}
			
	//Vehicels Graphics
			graphics
			{
			default							: random_choose_GMHS_35;
			additional_text					: string(STR_DESC_CABOOSE_80);
			purchase						: spriteset_GMHS_35_purchase;
			speed							: switch_speed_GMHS_35;
			cost_factor						: 72;
			running_cost_factor				: switch_running_cost_GMHS_35;				
			
			 }
		}

