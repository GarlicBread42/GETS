item (FEAT_TRAINS , ITEM_BR_182_DB, 1821)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_BR_182_DB);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1999,01,01);
						model_life:						40;
						vehicle_life: 					40;
						retire_early: 					-10;							
						reliability_decay: 				20;
						cargo_allow_refit: 				[PASS] ;
						cargo_capacity: 				1 ;
						cost_factor: 					108;
						running_cost_base: 				RUNNING_COST_STEAM;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							230 km/h;
						refit_cost: 					0;
						track_type: 					ELEC;
						power:  						8704 hp;
						weight: 						88 ton;
						ai_engine_rank: 				0;
						engine_class: 					ENGINE_CLASS_ELECTRIC;
						visual_effect_and_powered: 		visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
						dual_headed: 					0;
						tractive_effort_coefficient: 	0.341;
						length: 						8;
												
			}

		//Vehicels Graphics
			graphics
			{
			default							: switch_BR_182_graphics_DB;
			additional_text					: string(STR_CONCAT_2, 
											  string(STR_TRACTION_MULTISYS), 
											  string(STR_DESC_UNIVERSAL),);
			length							: switch_length_BR_182;
			articulated_part				: switch_articulated_BR_182_DB;
			purchase_cargo_capacity		    : 0 ;
			cargo_capacity	                : return 0 ;
			purchase						: spriteset_BR_182_purchase_DB;
			cost_factor						: 320;
			running_cost_factor				: switch_running_cost_BR_182;
			visual_effect_and_powered		: switch_FX_BR_182;
			}
	}	

						switch (FEAT_TRAINS, SELF, random_choose_BR_182_Dispo, switch_alternative_var_random_bits(1, 2)) {
							1: spriteset_BR_182_Dispo;
							2: spriteset_BR_182_Dispo2;
							3: spriteset_BR_182_Dispo3;
								spriteset_BR_182_Dispo4;}

						switch(FEAT_TRAINS, SELF, switch_BR_182_graphics_Dispo, position_in_vehid_chain % 3) {
