		alternative_sprites (spriteset_E_10_purchase1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/E_10/BR_E10_blau_1x_32bpp.png", "gfx/E_10/BR_E10_blau_1x_mask.png")
									{ template_purchase(0, 0)}
									
spriteset(spriteset_E_10_purchase2, "gfx/E_10/BR_E10_ozeanblau_1x_8bpp.png")
									{ template_purchase(0, 0)}
				
		alternative_sprites (spriteset_E_10_purchase2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/E_10/BR_E10_ozeanblau_1x_32bpp.png", "gfx/E_10/BR_E10_ozeanblau_1x_mask.png")
									{ template_purchase(0, 0)}								
									
spriteset(spriteset_E_10_purchase3, "gfx/E_10/BR_E10_orientrot_1x_8bpp.png")
									{ template_purchase(0, 0)}
				
		alternative_sprites (spriteset_E_10_purchase3, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/E_10/BR_E10_orientrot_1x_32bpp.png", "gfx/E_10/BR_E10_orientrot_1x_mask.png")
									{ template_purchase(0, 0)}									
									
spriteset(spriteset_E_10_purchase4, "gfx/E_10/BR_E10_verkehrsrot_1x_8bpp.png")
									{ template_purchase(0, 0)}
				
		alternative_sprites (spriteset_E_10_purchase4, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/E_10/BR_E10_verkehrsrot_1x_32bpp.png", "gfx/E_10/BR_E10_verkehrsrot_1x_mask.png")
									{ template_purchase(0, 0)}								

spriteset(spriteset_E_10_purchase5, "gfx/E_10/BR_E10_001_1x_8bpp.png")
									{ template_purchase(0, 0)}
				
		alternative_sprites (spriteset_E_10_purchase5, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/E_10/BR_E10_001_1x_32bpp.png", "gfx/E_10/BR_E10_001_1x_mask.png")
									{ template_purchase(0, 0)}
									
//Switches	

						 switch (FEAT_TRAINS,SELF, switch_E_10_purchase,current_year){
							   0 .. 1956: spriteset_E_10_purchase5;
							1957 .. 1974: spriteset_E_10_purchase1;
							1975 .. 1987: spriteset_E_10_purchase2;
							1988 .. 1999: spriteset_E_10_purchase3;
							2009 .. 2050: spriteset_E_10_purchase4;					 					 
								spriteset_E_10_purchase4;}
						 	
						 switch (FEAT_TRAINS,SELF, switch_E_10_current_year,current_year){
								0 .. 1956: spriteset_E_10_001;
							1957 .. 1974: spriteset_E_10_blau;
							1975 .. 1987: spriteset_E_10_ozeanblau;
							1988 .. 1999: spriteset_E_10_orientrot;
							2009 .. 2050: spriteset_E_10_verkehrsrot;					 					 
								spriteset_E_10_blau;}
	
						switch (FEAT_TRAINS,SELF,switch_E_10_build_year,build_year){
								0 .. 1956: spriteset_E_10_001;
							1957 .. 1974: spriteset_E_10_blau;
							1975 .. 1987: spriteset_E_10_ozeanblau;
							1988 .. 1999: spriteset_E_10_orientrot;
							2009 .. 2050: spriteset_E_10_verkehrsrot;					 					 
								spriteset_E_10_blau;}	
					
						switch(FEAT_TRAINS, SELF, switch_length_E_10, position_in_vehid_chain % 2) {
							0: 4;
							1: 6;}
						
						switch(FEAT_TRAINS, SELF, switch_FX_E_10, position_in_vehid_chain % 2) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
							return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}

						switch(FEAT_TRAINS,PARENT,switch_running_cost_E_10, 1){
							return 4275;}						

						switch(FEAT_TRAINS, SELF, switch_E_10_graphics_build, position_in_vehid_chain % 2) {
							0:	   spriteset_empty;
							1:     return switch_E_10_build_year;}

						switch (FEAT_TRAINS, SELF, switch_articulated_E_10_build, extra_callback_info1) {
							1: return ITEM_E_10; 
							return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}
						
item (FEAT_TRAINS , ITEM_E_10, 1090)
		{
	//property Block
