									{ template_148trains_2x(0, 0)}
				
		alternative_sprites (spriteset_VT_137_025_loading, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP, "gfx\VT_137_025/VT_137_025_loading_4x_32bpp.png", "gfx\VT_137_025/VT_137_025_loading_4x_mask.png")
									{ template_148trains_4x(0, 0)}										

		spritegroup spritegroup_VT_137_025_loading
			{loaded: 	[spriteset_empty];
			loading: 	[spriteset_VT_137_025_loading];}
			
//Spriteset purchase

spriteset(spriteset_VT_137_025_purchase1, "gfx\VT_137_025/VT_137_025_DRG_1x_8bpp.png")
									{ template_purchase(0, 0)}
				
		alternative_sprites (spriteset_VT_137_025_purchase1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\VT_137_025/VT_137_025_DRG_1x_32bpp.png", "gfx\VT_137_025/VT_137_025_DRG_1x_mask.png")
