		alternative_sprites (spriteset_DOSTO_1GEN_purchase7, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\DOSTO_1GEN\Dosto_DBz_ideenzug_1x_32bpp.png", "gfx\DOSTO_1GEN\Dosto_DBz_ideenzug_1x_mask.png")
					{template_purchase(0, 0)}
															
//Switches
						switch (FEAT_TRAINS, SELF, switch_purchase_DOSTO_1GEN, current_year){
							   0 .. 1995 : spriteset_DOSTO_1GEN_purchase1;
							1996 .. 2050 : spriteset_DOSTO_1GEN_purchase2;
							spriteset_DOSTO_1GEN_purchase2;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_DOSTO_1GEN_Mint_B, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_DOSTO_1GEN_B_MINT;
							1: spritegroup_DOSTO_1GEN_MINT_loading;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_DOSTO_1GEN_Mint_AB, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_DOSTO_1GEN_AB_MINT;
							1: spritegroup_DOSTO_1GEN_MINT_loading;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_DOSTO_1GEN_Verkehrsrot_B, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_DOSTO_1GEN_B_VERKEHRSROT;
							1: spritegroup_DOSTO_1GEN_VERKEHRSROT_loading;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_DOSTO_1GEN_Verkehrsrot_AB, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_DOSTO_1GEN_AB_VERKEHRSROT;
							1: spritegroup_DOSTO_1GEN_VERKEHRSROT_loading;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_DOSTO_1GEN_FEX_B, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_DOSTO_1GEN_B_FEX;
							1: spritegroup_DOSTO_1GEN_FEX_loading;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_DOSTO_1GEN_FEX_AB, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_DOSTO_1GEN_AB_FEX;
							1: spritegroup_DOSTO_1GEN_FEX_loading;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_DOSTO_1GEN_Metronom_B, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_DOSTO_1GEN_B_Metronom;
							1: spritegroup_DOSTO_1GEN_Metronom_loading;}	
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_DOSTO_1GEN_NAHSH1_B, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_DOSTO_1GEN_B_NAHSH1;
							1: spritegroup_DOSTO_1GEN_NAHSH1_loading;}													
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_DOSTO_1GEN_NAHSH2_B, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_DOSTO_1GEN_B_NAHSH2;
							1: spritegroup_DOSTO_1GEN_NAHSH2_loading;}	
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_DOSTO_1GEN_ideenzug_B, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_DOSTO_1GEN_B_ideenzug;
							1: spritegroup_DOSTO_1GEN_ideenzug_loading;}								
																					   
						switch (FEAT_TRAINS, SELF, random_choose_DOSTO_1GEN_Mint, switch_alternative_var_random_bits(1, 1)) {
							1: switch_spritestack_DOSTO_1GEN_Mint_B;
							  switch_spritestack_DOSTO_1GEN_Mint_AB;}
							   
						switch (FEAT_TRAINS, SELF, random_choose_DOSTO_1GEN_Verkehrsrot, switch_alternative_var_random_bits(1, 1)) {
							1: switch_spritestack_DOSTO_1GEN_Verkehrsrot_B;
							  switch_spritestack_DOSTO_1GEN_Verkehrsrot_AB;}	
							   
						switch (FEAT_TRAINS, SELF, random_choose_DOSTO_1GEN_FEX, switch_alternative_var_random_bits(1, 1)) {
							1: switch_spritestack_DOSTO_1GEN_FEX_B;
							  switch_spritestack_DOSTO_1GEN_FEX_AB;}							  					

						switch (FEAT_TRAINS, SELF, switch_build_year_DOSTO_1GEN, build_year){
							   0 .. 1995 : random_choose_DOSTO_1GEN_Mint;
							1996 .. 2050 : random_choose_DOSTO_1GEN_Verkehrsrot;
								random_choose_DOSTO_1GEN_Verkehrsrot;}						
							
						switch (FEAT_TRAINS, SELF, switch_current_year_DOSTO_1GEN, current_year){
							   0 .. 1995 : random_choose_DOSTO_1GEN_Mint;
							1996 .. 2050 : random_choose_DOSTO_1GEN_Verkehrsrot;
								random_choose_DOSTO_1GEN_Verkehrsrot;}										
					
						switch(FEAT_TRAINS, SELF, switch_length_DOSTO_1GEN, position_in_articulated_veh % 3) {
							0: 4;
							1: 7;
							2: 4;}

						switch(FEAT_TRAINS,PARENT,switch_running_cost_Dosto_1GEN, 1){
							return 3000;}	
													
						switch(FEAT_TRAINS, SELF, switch_DOSTO_1GEN_graphics_build, position_in_articulated_veh  % 3) {
							0:     spriteset_empty;
							1:     return switch_build_year_DOSTO_1GEN;
							2:     spriteset_empty;}
							
						switch (FEAT_TRAINS, SELF, switch_articulated_DOSTO_1GEN_build, extra_callback_info1) {
							1 .. 2: return ITEM_DOSTO_1GEN_BUILD;	
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}

item (FEAT_TRAINS , ITEM_DOSTO_1GEN_BUILD, 7395)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_DOSTO_1GEN_BUILD);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1993,01,01);
						model_life: 					40;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);
						refittable_cargo_classes:		bitmask(CC_PASSENGERS);
						cargo_allow_refit:				[PASS, TOUR];
						loading_speed:					15;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							140 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						56 ton;
						dual_headed: 					0;
						default_cargo_type:				PASS;
						cargo_capacity:					46;
						ai_engine_rank: 				0;
						length: 						8;
												
			}
			
	//Vehicels Graphics
			graphics
			{
			default:						switch_DOSTO_1GEN_graphics_build;
			additional_text:				string(STR_DESC_PASS);
			length:							switch_length_DOSTO_1GEN;
			articulated_part:				switch_articulated_DOSTO_1GEN_build;
			purchase:						switch_purchase_DOSTO_1GEN;
			cost_factor:					615;
			running_cost_factor:			switch_running_cost_Dosto_1GEN;					
			 }
		}		

