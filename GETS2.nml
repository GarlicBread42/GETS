		0: return switch_Om_Ludwigshafen_MBH_current_year;
		1: spritegroup_Oc_Muenster_MBH_load_Barren;}																	

	switch(FEAT_TRAINS, SELF, switch_loadstack_Om_Ludwigshafen_MBH_Box, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
