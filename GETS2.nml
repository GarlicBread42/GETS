							4: 5;
							5: 4;}	


						switch(FEAT_TRAINS, SELF, switch_ET_65_2_FX_A, position_in_vehid_chain % 6) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, -5, DISABLE_WAGON_POWER);
							1 : return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
							2 : return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, -2, DISABLE_WAGON_POWER);
							3 .. 5 : return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}

						switch(FEAT_TRAINS, SELF, switch_ET_65_2_FX_B, position_in_vehid_chain % 6) {
							0 .. 2: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
							3 : return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, -2, DISABLE_WAGON_POWER);
							4 : return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
							5 : return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, -5, DISABLE_WAGON_POWER);}

						switch (FEAT_TRAINS, PARENT, switch_ET_65_2_FX, vehicle_is_reversed) {
							0: switch_ET_65_2_FX_A;
								switch_ET_65_2_FX_B;}
								
								
						switch(FEAT_TRAINS,PARENT,switch_running_cost_ET_65_2, 1){
							return 1775;}								

						switch(FEAT_TRAINS, SELF, switch_ET_65_2_graphics_build, position_in_vehid_chain % 6) {
							0:	   spriteset_empty;
							1:     return switch_ET_65_front_build_year;
							2:     spriteset_empty;
							3:	   spriteset_empty;
							4:     return switch_ET_65_back_build_year;
							5:     spriteset_empty;}				
							
						switch (FEAT_TRAINS, SELF, switch_articulated_ET_65_2_build, extra_callback_info1) {
							1 .. 5: return ITEM_ET_65_2_BUILD; 
							return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}							
							
item (FEAT_TRAINS , ITEM_ET_65_2_BUILD, 4650)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_ET_65_2_BUILD);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1933,01,01);
						model_life: 					28;
						vehicle_life: 					28;
						retire_early: 					-10;							
						reliability_decay: 				20;
						misc_flags						: bitmask(TRAIN_FLAG_SPRITE_STACK);	
						cargo_allow_refit:              [PASS, TOUR];
						cargo_capacity:                 24 ;
						loading_speed:					10;
						cost_factor: 					108;
						running_cost_base:				RUNNING_COST_STEAM;						
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							85 km/h;
						refit_cost: 					0;
						track_type: 					AC15;	
						power:  						1093 hp;
						weight: 						104 ton;
						ai_engine_rank: 				0;
						engine_class: 					ENGINE_CLASS_DIESEL;
						visual_effect_and_powered: 		visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
						dual_headed: 					0;
						tractive_effort_coefficient: 	0.244;
						length: 						8;
												
			}

		//Vehicels Graphics
			graphics
			{
			default							: switch_ET_65_2_graphics_build;
