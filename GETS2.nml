						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_460_middle_MRB_2008, vehicle_is_reversed) {
							0: switch_spritestack_BR_460_middle_MRB_2008;
								switch_spritestack_BR_460_middle_MRB_2008_REV;}
								
						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_460_back_MRB_2008, vehicle_is_reversed) {
							0: switch_spritestack_BR_460_back_MRB_2008;
								switch_spritestack_BR_460_front_MRB_2008_REV;}

						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_460_front_MRB_2016, vehicle_is_reversed) {
							0: switch_spritestack_BR_460_front_MRB_2016;
								switch_spritestack_BR_460_back_MRB_2016_REV;}																

						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_460_middle_MRB_2016, vehicle_is_reversed) {
							0: switch_spritestack_BR_460_middle_MRB_2016;
								switch_spritestack_BR_460_middle_MRB_2016_REV;}
								
						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_460_back_MRB_2016, vehicle_is_reversed) {
							0: switch_spritestack_BR_460_back_MRB_2016;
								switch_spritestack_BR_460_front_MRB_2016_REV;}
								
						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_460_front_MRB_2023, vehicle_is_reversed) {
							0: switch_spritestack_BR_460_front_MRB_2023;
								switch_spritestack_BR_460_back_MRB_2023_REV;}																
								
						switch (FEAT_TRAINS, PARENT, switch_reverse_BR_460_back_MRB_2023, vehicle_is_reversed) {
							0: switch_spritestack_BR_460_back_MRB_2023;
								switch_spritestack_BR_460_front_MRB_2023_REV;}					

						switch(FEAT_TRAINS, SELF, switch_length_BR_460_MRB, position_in_vehid_chain % 9) {
							0: 4;
							1: 6;
							2: 4;
							3: 4;
							4: 5;
							5: 4;
							6: 4;
							7: 6;
							8: 4;}	
															
						switch(FEAT_TRAINS, SELF, switch_graphics_BR_460_MRB_2008, position_in_vehid_chain % 9) {
							0:	   spriteset_empty;
							1:     return switch_reverse_BR_460_front_MRB_2008;
							2:     spriteset_empty;
							3:	   spriteset_empty;
							4:	   return switch_reverse_BR_460_middle_MRB_2008;
							5:	   spriteset_empty;
							6:	   spriteset_empty;
							7:	   return switch_reverse_BR_460_back_MRB_2008;
							8:	   spriteset_empty;}
						   
						switch (FEAT_TRAINS, SELF, switch_articulated_BR_460_MRB_2008, extra_callback_info1) {
							1 .. 8: return ITEM_BR_460_MRB_2008; 
							return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}


