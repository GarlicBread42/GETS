//Switches

					switch (FEAT_TRAINS,SELF,switch_purchase_KPEV_PR99,current_year) {
						   0 .. 1919 : spriteset_PR99_purchase1;
						1920 .. 1945 : spriteset_PR99_purchase2;
						1946 .. 1980 : spriteset_PR99_purchase3;
						spriteset_PR99_purchase3;}
						
					switch (FEAT_TRAINS, SELF, random_choose_PR99_KPEV, switch_alternative_var_random_bits(2, 2)) {
						1: spritegroup_PR99_AB_KPEV;
						2: spritegroup_PR99_BC_KPEV;
						3: spritegroup_PR99_D_KPEV;											
						spritegroup_PR99_C_KPEV;}
						
					random_switch (FEAT_TRAINS, SELF, random_choose_PR99_DRG,) {
						1: spritegroup_PR99_AB_DRG_MBH;
						1: spritegroup_PR99_AB_DRG_OBH; 
						1: spritegroup_PR99_BC_DRG_MBH;
						1: spritegroup_PR99_BC_DRG_OBH;
						2: spritegroup_PR99_C_DRG_MBH; 
						2: spritegroup_PR99_C_DRG_OBH;
						1: spritegroup_PR99_D_DRG_MBH;
						1: spritegroup_PR99_D_DRG_OBH;}	
							
					random_switch (FEAT_TRAINS, SELF, random_choose_PR99_DB,) {
						1: spritegroup_PR99_AB_DB_MBH;
						1: spritegroup_PR99_AB_DB_OBH; 
						1: spritegroup_PR99_BC_DB_MBH;
						1: spritegroup_PR99_BC_DB_OBH;
						2: spritegroup_PR99_C_DB_MBH; 
						2: spritegroup_PR99_C_DB_OBH;
						1: spritegroup_PR99_D_DB_MBH;
						1: spritegroup_PR99_D_DB_OBH;}	
							
					switch (FEAT_TRAINS,SELF,switch_current_year_KPEV_PR99,current_year) {
						   0 .. 1919 : random_choose_PR99_KPEV;
						1920 .. 1945 : random_choose_PR99_DRG;
						1946 .. 1990 : random_choose_PR99_DB;
						random_choose_PR99_DB;}	
						
					switch (FEAT_TRAINS,SELF,switch_build_year_KPEV_PR99,build_year) {
						   0 .. 1919 : random_choose_PR99_KPEV;
						1920 .. 1945 : random_choose_PR99_DRG;
						1946 .. 1990 : random_choose_PR99_DB;
						random_choose_PR99_DB;}

					switch(FEAT_TRAINS,PARENT,switch_running_cost_KPEV_PR99, 1){
						return 870;}

