									{ template_purchase(0, 0)}
				
	alternative_sprites (spriteset_BR_54_8_purchase1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BR_54_8/BR_54_8_KPEV_1x_32bpp.png", "gfx/BR_54_8/BR_54_8_KPEV_1x_mask.png")
