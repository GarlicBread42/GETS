									{ template_purchase(0, 0)}
	alternative_sprites (spriteset_BR_89_78_DRG_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BR_89_78/BR_89_78_DRG_1x_32bpp.png", "gfx/BR_89_78/BR_89_78_DRG_1x_mask.png")
