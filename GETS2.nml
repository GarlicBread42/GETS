	alternative_sprites (spriteset_V_140_DRG_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/V_140/V_140_DRG_1x_32bpp.png", "gfx/V_140/V_140_DRG_1x_mask.png")
									{template_purchase(0, 0)}

spriteset(spriteset_V_140_DB_purchase, "gfx/V_140/V_140_DB_1x_8bpp.png")
									{ template_purchase(0, 0)}
				
	alternative_sprites (spriteset_V_140_DB_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/V_140/V_140_DB_1x_32bpp.png", "gfx/V_140/V_140_DB_1x_mask.png")
									{template_purchase(0, 0)}									

spriteset(spriteset_V_140_anim_purchase, "gfx/V_140/V_140_anim1_1x_8bpp.png")
									{ template_purchase(0, 0)}
				
	alternative_sprites (spriteset_V_140_anim_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/V_140/V_140_anim1_1x_32bpp.png", "gfx/V_140/V_140_anim1_1x_mask.png")
									{template_purchase(0, 0)}
									
//Switches

						switch(FEAT_TRAINS, SELF, switch_spritestack_V_140_DRG_purchase, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_V_140_DRG_purchase;
							1: spriteset_V_140_anim_purchase;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_V_140_DB_purchase, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_V_140_DB_purchase;
							1: spriteset_V_140_anim_purchase;}

						switch (FEAT_TRAINS,SELF, switch_V_140_purchase,current_year){
							   0 .. 1945: switch_spritestack_V_140_DRG_purchase;
							1946 .. 2050: switch_spritestack_V_140_DB_purchase;														 					 
								switch_spritestack_V_140_DB_purchase;}

						switch (FEAT_TRAINS, SELF, switch_animation_V_140, motion_counter % 4) {
							0: spriteset_V_140_anim1;
							1: spriteset_V_140_anim2;
							2: spriteset_V_140_anim3;
							3: spriteset_V_140_anim4;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_V_140_DRG, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_V_140_DRG;
							1: switch_animation_V_140;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_V_140_DB, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_V_140_DB;
							1: switch_animation_V_140;}

						switch(FEAT_TRAINS, SELF, switch_length_V_140, position_in_vehid_chain % 3) {
							0: 3;
							1: 3;
							2: 3;}

					switch(FEAT_TRAINS, SELF, switch_FX_V_140, position_in_vehid_chain % 3) {
						0: return visual_effect_and_powered(VISUAL_EFFECT_DIESEL, -1, DISABLE_WAGON_POWER);
						1: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, -1, DISABLE_WAGON_POWER);
							return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}
						
					switch(FEAT_TRAINS,PARENT,switch_running_cost_V_140, 1){
						return 1625;}
		
					switch (FEAT_TRAINS,SELF, switch_V_140_build_year,build_year){
						    0 .. 1945: switch_spritestack_V_140_DRG;
						 1946 .. 2050: switch_spritestack_V_140_DB;							 					 
						 switch_spritestack_V_140_DB;}

					switch(FEAT_TRAINS, SELF, switch_V_140_graphics_build, position_in_vehid_chain % 3) {
						0:	   spriteset_empty;
						1:     return switch_V_140_build_year;
						2:	   spriteset_empty;}	

					switch (FEAT_TRAINS, SELF, switch_articulated_V_140_build, extra_callback_info1) {
						1: return ITEM_V_140_BUILD; 
						2: return ITEM_V_140_BUILD;
						return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}

