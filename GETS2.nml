						tractive_effort_coefficient: 	0.162;
						length: 						8;
			}

		//Vehicels Graphics
			graphics
			{
			default							: switch_ET_30_graphics_altrot;
			additional_text					: string(STR_CONCAT_2, 
											  string(STR_TRACTION_EMU), 
											  string(STR_DESC_PASS),);
			length							: switch_length_ET_30;
