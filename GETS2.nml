									{ template_purchase(0, 0)}	
									
//Switches

					 switch (FEAT_TRAINS,SELF, switch_BR_E_18_purchase,current_year){
							1920 .. 1945: spriteset_E_18_DRG_purchase;
							1946 .. 1955: spriteset_E_18_DB_gruen_purchase;	
							1956 .. 1964: spriteset_E_18_DB_blau_alt_purchase;	
							1965 .. 1974: spriteset_E_18_DB_blau_neu_purchase;
							1975 .. 2050: spriteset_E_18_DB_ozeanblau_purchase;			 					 
								spriteset_E_18_DB_ozeanblau_purchase;}
						 
					 switch (FEAT_TRAINS,SELF, switch_BR_E_18_build_year,build_year){
						 1920 .. 1945: spriteset_BR_E_18_DRG;
						 1946 .. 1955: spriteset_BR_E_18_DB_gruen;	
						 1956 .. 1964: spriteset_BR_E_18_DB_blau1;	
						 1965 .. 1974: spriteset_BR_E_18_DB_Blau2;
						 1975 .. 2050: spriteset_BR_E_18_DB_ozeanblau;			 					 
							spriteset_BR_E_18_DB_ozeanblau;}	
						 
					 switch (FEAT_TRAINS,SELF, switch_BR_E_18_current_year,current_year){
						 1920 .. 1945: spriteset_BR_E_18_DRG;
						 1946 .. 1955: spriteset_BR_E_18_DB_gruen;	
						 1956 .. 1964: spriteset_BR_E_18_DB_blau1;	
						 1965 .. 1974: spriteset_BR_E_18_DB_Blau2;
						 1975 .. 2050: spriteset_BR_E_18_DB_ozeanblau;			 					 
							spriteset_BR_E_18_DB_ozeanblau;}						 					 

					switch(FEAT_TRAINS, SELF, switch_length_BR_E_18, position_in_vehid_chain % 3) {
						0: 4;
						1: 3;
						2: 4;}	
						
					switch(FEAT_TRAINS, SELF, switch_FX_BR_E_18, position_in_vehid_chain % 3) {
						0: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
						return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}
						
					switch(FEAT_TRAINS,PARENT,switch_running_cost_BR_E_18, 1){
						return 4225;}	
													
					switch(FEAT_TRAINS, SELF, switch_BR_E_18_graphics_build, position_in_vehid_chain % 3) {
