			alternative_sprites (spriteset_BR_120_purchase1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BR_120/BR_120_0_TEE_1x_32bpp.png", "gfx/BR_120/BR_120_0_TEE_1x_mask.png")
									{ template_purchase(0, 0)}
									
spriteset(spriteset_BR_120_purchase2, "gfx/BR_120/BR_120_1_orientrot_1x_8bpp.png")
									{ template_purchase(0, 0)}
				
			alternative_sprites (spriteset_BR_120_purchase2, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BR_120/BR_120_1_orientrot_1x_32bpp.png", "gfx/BR_120/BR_120_1_orientrot_1x_mask.png")
									{ template_purchase(0, 0)}	
									
spriteset(spriteset_BR_120_purchase3, "gfx/BR_120/BR_120_1_verkehrsrot_1x_8bpp.png")
									{ template_purchase(0, 0)}
				
			alternative_sprites (spriteset_BR_120_purchase3, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BR_120/BR_120_1_verkehrsrot_1x_32bpp.png", "gfx/BR_120/BR_120_1_verkehrsrot_1x_mask.png")
									{ template_purchase(0, 0)}	
									
