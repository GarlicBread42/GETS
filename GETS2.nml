spriteset(spriteset_E_70_2_anim1, "gfx/E_70_2/E_70_2_anim1_1x_8bpp.png")
									{ template_88trains_1x(0, 0)}
				
		alternative_sprites (spriteset_E_70_2_anim1, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/E_70_2/E_70_2_anim1_1x_32bpp.png", "gfx/E_70_2/E_70_2_anim1_1x_mask.png")
