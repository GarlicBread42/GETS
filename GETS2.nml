					{template_purchase(0, 0)}	
				
		alternative_sprites (spriteset_Shimmnstu_718_purchase_Wascosa, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\Shimmnstu_718/Shimmnstu_718_Wascosa_1x_32bpp.png", "gfx\Shimmnstu_718/Shimmnstu_718_Wascosa_1x_mask.png")
					{template_purchase(0, 0)}					


//Switches

					switch (FEAT_TRAINS, SELF, random_choose_Shimmnstu_718, switch_alternative_var_random_bits(1, 3)) {
							1: spritegroup_Shimmnstu_718_Cargo;
							2: spritegroup_Shimmnstu_718_Ermewa;
							3: spritegroup_Shimmnstu_718_Cargo;
							4: spritegroup_Shimmnstu_718_Wascosa;
