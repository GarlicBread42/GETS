							0: spriteset_4iPR23_DB_CD;
							1: spritegroup_4iPR23_CD_loading;}								

						switch (FEAT_TRAINS, SELF, random_choose_4iPR23_DRG, switch_alternative_var_random_bits(1, 2)) {
							1: switch_loadstack_4iPR23_CD_DRG;
							2: switch_loadstack_4iPR23_C_DRG;
							3: switch_loadstack_4iPR23_BC_DRG;
							   switch_loadstack_4iPR23_CD_DRG;}
							   
						switch (FEAT_TRAINS, SELF, random_choose_4iPR23_DB, switch_alternative_var_random_bits(1, 2)) {
							1: switch_loadstack_4iPR23_CD_DB;
							2: switch_loadstack_4iPR23_C_DB;
							3: switch_loadstack_4iPR23_BC_DB;
							   switch_loadstack_4iPR23_CD_DB;}
							   
						switch (FEAT_TRAINS, SELF, switch_build_year_4iPR23, build_year){
							1900 .. 1945 : random_choose_4iPR23_DRG;
							1946 .. 2050 : random_choose_4iPR23_DB;
							random_choose_4iPR23_DB;}
							
						switch (FEAT_TRAINS, SELF, switch_current_year_4iPR23, current_year){
							1900 .. 1945 : random_choose_4iPR23_DRG;
							1946 .. 2050 : random_choose_4iPR23_DB;
							random_choose_4iPR23_DB;}														
					
						switch(FEAT_TRAINS, SELF, switch_length_4iPR23, position_in_articulated_veh % 3) {
							0: 3;
							1: 3;
							2: 3;}	
						
						switch(FEAT_TRAINS,PARENT,switch_running_cost_4IPR23, 1){
							return 950;}								
							
						switch(FEAT_TRAINS, SELF, switch_4iPR23_graphics_build, position_in_articulated_veh  % 3) {
							0:     spriteset_empty;
							1:     return switch_build_year_4iPR23;
							2:     spriteset_empty;}
							
						switch (FEAT_TRAINS, SELF, switch_articulated_4iPR23_build, extra_callback_info1) {
							1 .. 2: return ITEM_4IPR23_BUILD;
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}
															
