			 }
		}

						switch (FEAT_TRAINS, SELF, switch_articulated_uicx_bdms_Regio, extra_callback_info1) {
							1: return ITEM_UICX_BDMS_REGIO;
							2: return ITEM_UICX_BDMS_MAIL;
