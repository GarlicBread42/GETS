					switch(FEAT_TRAINS, SELF, switch_H10_Regensburg_graphics_current, position_in_vehid_chain % 3) {
						0:	   spriteset_empty;
						1:     return switch_H10_Regensburg_cargo_type;
						2:	   spriteset_empty;}	
						
